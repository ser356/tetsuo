fun main() -> u32 {
    let m: u64 = 6
    if (m & 2) != 0 {
        let i: u64 = 0
        let n: u64 = 2
        while (i + 1) < n { i = i + 1 }
        if i != 1 { return 1 }
    } else { return 2 }
    let x: u64 = 1
    if (x) { x = 2 }
    if x != 2 { return 3 }
    let a: u64 = 1
    if ((a)) == 1 { return 0 }
    return 4
}