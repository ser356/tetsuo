fun main() -> u32 {
    let buf: Buf1K
    let ruta: str = 'tests/hello.tt\0'
    let fd: u64 = io_open_read(ruta.ptr)
    let n: u64 = io_read(fd, &buf, 1024)

    let lx: Lexer
    lex_init(&lx, &buf, n)

    let count: u64 = 0
    while count < 10000 {
        let t: Tok
        lex_next(&lx, &t)
        if t.kind == TK_EOF { break }
        count = count + 1
    }

    io_close(fd)
    io_exit(count)
    return 0
}
