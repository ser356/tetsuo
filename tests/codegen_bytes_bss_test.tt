bss CGB_BSS_SRC: 8192

fun main() -> u32 {
    let prog_src: str = 'bss X: 64 fun main() -> u64 { let p: *u8 = X p[0] = 42 return p[0] }'
    let src: *u8 = CGB_BSS_SRC
    let n: u64 = prog_src.len
    mem_copy(src, prog_src.ptr, n)

    let ast_ar: *Arena = ast_init()
    let ir_ar: *Arena = ir_init()
    let prog: *Program = parse(ast_ar, src, n)
    let irhead: *IrFn = lower(ir_ar, prog)
    let bvsz: u64 = cgb_bss_layout(prog)
    codegen_bytes(prog, irhead)

    let path: str = '/tmp/tt_cgb_bss\0'
    let fd: u64 = io_open_write(path.ptr)
    if fd == 0 { return 1 }
    let clen: u64 = cb_pos()
    let entry: *u64 = CG_ENTRY
    emit_macho_code_bss(fd, prog, clen, entry[0], bvsz)
    io_close(fd)
    return 0
}
