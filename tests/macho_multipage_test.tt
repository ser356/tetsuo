// Hito 24.g Session C3a: reproductor minimo del layout que rompia con
// __TEXT multi-pagina + __bss grande, SIN depender del compilador entero.
//
// Genera al vuelo un programa cuyo unico contenido pesado es un literal de
// 100000 bytes (fuerza text_pages = 7, igual que los binarios de verify.sh) y
// dos simbolos bss separados por ~50MB (fuerza fixups ADRP/ADD contra paginas
// muy lejanas del inicio de __DATA). El binario emitido hace apenas cuatro
// accesos y devuelve 20: si muere (SIGKILL/SIGILL/SIGSEGV) el problema esta en
// el contenedor Mach-O o en los fixups, no en el volumen de codigo.

bss MP_SRC: 262144

fun main() -> u32 {
    let src: *u8 = MP_SRC
    let pos: u64 = 0

    let head: str = 'bss MP_BIG: 52428800 bss MP_TAIL: 64 fun main() -> u64 { let p: *u8 = MP_BIG let q: *u8 = MP_TAIL p[0] = 20 q[0] = 45 let s: str = \''
    mem_copy(src + pos, head.ptr, head.len)
    pos = pos + head.len

    let i: u64 = 0
    while i < 100000 {
        src[pos + i] = 65
        i = i + 1
    }
    pos = pos + 100000

    let tail: str = '\' let c: u64 = s.ptr[99999] if c != 65 { return 1 } if q[0] != 45 { return 2 } return p[0] }'
    mem_copy(src + pos, tail.ptr, tail.len)
    pos = pos + tail.len

    let ast_ar: *Arena = ast_init()
    let ir_ar: *Arena = ir_init()
    let prog: *Program = parse(ast_ar, src, pos)
    let irhead: *IrFn = lower(ir_ar, prog)
    let bvsz: u64 = cgb_bss_layout(prog)
    codegen_bytes(TGT_MACOS, prog, irhead)

    let path: str = '/tmp/tt_macho_multipage\0'
    let fd: u64 = io_open_write(path.ptr)
    if fd == 0 { return 1 }
    let clen: u64 = cb_pos()
    let entry: *u64 = CG_ENTRY
    emit_macho_code_bss(fd, prog, clen, entry[0], bvsz)
    io_close(fd)
    return 0
}
