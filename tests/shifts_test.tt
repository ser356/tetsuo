fun main() -> u32 {
    let x: u64 = 1 << 5
    if x != 32 { return 1 }
    let r: u64 = 1024 >> 3
    if r != 128 { return 2 }
    let y: u64 = 255
    let m: u64 = y & (1 << 3)
    if m != 8 { return 3 }
    let h: u64 = 0xdeadbeef
    let hs: u64 = h >> 8
    if hs != 0xdeadbe { return 4 }
    let n: u64 = 5
    let sh: u64 = 1 << n
    if sh != 32 { return 5 }
    return 0
}
