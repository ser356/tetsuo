struct SigInfo {
    count: u64,
    first_name_start: u64,
    first_name_len: u64,
}

struct NameList {
    starts: *u8,
    lens:   *u8,
    n:      u64,
    cap:    u64,
}

fun nl_init(nl: *NameList, ar: *Arena, cap: u64) {
    nl.starts = arena_take(ar, cap * 8)
    nl.lens   = arena_take(ar, cap * 8)
    nl.n = 0
    nl.cap = cap
}

fun nl_push(nl: *NameList, start: u64, len: u64) {
    if nl.n >= nl.cap { return }
    let s: *u64 = nl.starts + nl.n * 8
    let l: *u64 = nl.lens   + nl.n * 8
    @s = start
    @l = len
    nl.n = nl.n + 1
}

fun skip_fun_body(lx: *Lexer) {
    let t: Tok
    while 1 == 1 {
        lex_next(lx, &t)
        if t.kind == TK_LBRACE { break }
        if t.kind == TK_EOF { return }
    }
    let depth: u64 = 1
    while depth > 0 {
        lex_next(lx, &t)
        if t.kind == TK_EOF { return }
        if t.kind == TK_LBRACE { depth = depth + 1 }
        if t.kind == TK_RBRACE { depth = depth - 1 }
    }
}

fun parse_toplevel(lx: *Lexer, out: *SigInfo) {
    out.count = 0
    out.first_name_start = 0
    out.first_name_len = 0
    let first_seen: u32 = 0
    while 1 == 1 {
        let t: Tok
        lex_next(lx, &t)
        if t.kind == TK_EOF { break }
        if t.kind == TK_FUN {
            out.count = out.count + 1
            let nt: Tok
            lex_next(lx, &nt)
            if first_seen == 0 {
                if nt.kind == TK_IDENT {
                    out.first_name_start = nt.start
                    out.first_name_len = nt.tlen
                    first_seen = 1
                }
            }
            skip_fun_body(lx)
        }
    }
}

fun collect_fun_names(lx: *Lexer, nl: *NameList) {
    while 1 == 1 {
        let t: Tok
        lex_next(lx, &t)
        if t.kind == TK_EOF { break }
        if t.kind == TK_FUN {
            let nt: Tok
            lex_next(lx, &nt)
            if nt.kind == TK_IDENT {
                nl_push(nl, nt.start, nt.tlen)
            }
            skip_fun_body(lx)
        }
    }
}
