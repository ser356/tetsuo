struct MixedRuntime {
    a: u8,
    b: u32,
    c: *u8,
}

fun read_b(p: *MixedRuntime) -> u32 { return p.b }
fun read_c(p: *MixedRuntime) -> *u8 { return p.c }

fun main() -> u64 {
    let target: u8 = 7
    let value: MixedRuntime
    value.a = 3
    value.b = 42
    value.c = &target
    if read_b(&value) != 42 { return 1 }
    let p: *u8 = read_c(&value)
    if @p != 7 { return 2 }
    return 0
}
