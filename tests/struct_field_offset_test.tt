struct MixedOffset {
    a: u8,
    b: u32,
    c: *u8,
}

fun main() -> u64 {
    let src: str = 'struct MixedOffset { a: u8, b: u32, c: *u8 } fun get(p: *MixedOffset) -> *u8 { return p.c }'
    let ar: *Arena = ast_init()
    let prog: *Program = parse(ar, src.ptr, src.len)
    let f: *Func = prog.funcs
    let ret: *Expr = f.body.ret_val
    let add: *Expr = ret.inner
    if add.kind != EX_BIN { return 1 }
    if add.rhs.ival != 8 { return 2 }
    return 0
}
