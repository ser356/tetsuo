struct Pair {
    left: i32,
    right: i32,
}

fun sum(p: *Pair) -> i64 {
    return p.left as i64 + p.right as i64
}

fun main() -> u32 {
    let values: [4]u64
    let i: u64 = 0
    while i < 4 {
        values[i] = i + 1
        i = i + 1
    }
    let p: Pair
    p.left = values[1] as i32
    p.right = -values[3] as i32
    if sum(&p) != -2 { return 1 }
    let total: u64 = 0
    let j: u64 = 0
    while j < 4 {
        if j == 2 { j = j + 1; continue }
        total = total + values[j]
        j = j + 1
    }
    if total != 7 { return 2 }
    return 0
}