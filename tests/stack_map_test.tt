fun main() -> u64 {
    let src: str = 'fun f(a:u64)->u64{let x:u64=a+1;return x+2}'
    let aa: *Arena = ast_init()
    let ia: *Arena = ir_init()
    let prog: *Program = parse(aa, src.ptr, src.len)
    let fn: *IrFn = lower(ia, prog)
    if fn.stack_of[0] != 0 { return 1 }
    if fn.spill_slots >= fn.nslots { return 2 }
    let found_reg: u64 = 0
    let i: u64 = fn.nlocals
    while i < fn.nslots {
        if fn.reg_of[i] < NREGS {
            if fn.stack_of[i] == fn.nslots { found_reg = 1 }
        }
        i = i + 1
    }
    if found_reg == 0 { return 3 }
    if fn.frame_bytes >= ((fn.nslots * 8 + 15) / 16) * 16 { return 4 }
    return 0
}
