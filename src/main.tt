// ============================================================================
// src/main.tt - compiler driver and import preprocessor
// ============================================================================
//
// This is the entry point of tetsuoc and the place where all the stages are
// chained together:
//
//     file.tt
//        |  pp_expand          resolves the `import`s into a single buffer
//        v
//     PP_OUT
//        |  parse              lexer + parser -> *Program        (parser.tt)
//        v
//     AST
//        |  lower              -> list of IrFn                   (ir.tt)
//        v
//     IR
//        |  codegen            -> .s text                        (codegen.tt)
//        |  codegen_bytes      -> bytes + emit_macho_code_bss    (codegen_bytes.tt)
//        v
//     output
//
// INVOCATION MODES
//
//     tetsuoc --dump-tokens f.tt              dumps the token sequence
//     tetsuoc --dump-ir f.tt                  dumps the IR as text
//     tetsuoc [--target=macos] f.tt -o s.s    emits assembly
//     tetsuoc --emit=macho f.tt -o binary     emits a signed Mach-O, ready to
//                                             run on macOS/arm64
//
// The last one is what closes self-hosting: it needs neither clang, as, ld nor
// codesign.
//
// THE PREPROCESSOR
//
// `import 'path'` is textual: the line is replaced by the contents of the
// file, recursively, skipping whatever was already included (include guard by
// path, see pp_seen). There are no namespaces and no private symbols;
// everything ends up in a single flat buffer, and that is why the order of the
// imports matters (the first one to declare a bss slot gets offset 0).
//
// It is deliberately dumb: it recognizes a line that STARTS with "import " and
// extracts whatever sits between single quotes. An indented import, or one
// inside a comment, is not recognized.
//
// THE BUFFERS AND THEIR LIMITS
//
// Almost all of the compiler bss is declared here or in the arenas of the
// stages. The limits are hard and they are checked: going over aborts with a
// message, it does not truncate silently. That check was not always there:
// pp_expand read every file into a fixed 128KB buffer without checking whether
// it fit, and a larger source lost its tail, so the error showed up much later
// disguised as a syntax failure in the middle of the file.
// ============================================================================

bss SRC_BUF: 262144       // raw source, only for the --dump-* modes
bss OUT_BUF: 65536        // output buffer of the textual backend
bss OUT_STORAGE: 64       // the Out struct (does not fit in a local, returned)
bss DUMP_TOK_STORE: 40    // the Tok used by --dump-tokens
bss PP_OUT: 4194304       // already expanded source: what the parser sees
bss PP_OUT_LEN: 8
bss PP_ARENA_STORE: 24
bss PP_ARENA_BUF: 268435456  // preprocessor arena: paths and files read
bss PP_SEEN_VEC: 8

struct PPSeen {
    path: *u8,
    len: u64,
}

fun pp_arena_init() -> *Arena {
    let a: *Arena = PP_ARENA_STORE
    arena_init(a, PP_ARENA_BUF, 268435456)
    let out_len: *u64 = PP_OUT_LEN
    out_len[0] = 0
    let origin_count: *u64 = SRC_ORIGIN_COUNT
    origin_count[0] = 0
    let v: *Vec = arena_take(a, sizeof(Vec))
    let first: *u8 = arena_take(a, sizeof(PPSeen))
    vec_init(v, sizeof(PPSeen), first, 1)
    let vp: **Vec = PP_SEEN_VEC
    vp[0] = v
    return a
}

// maximum size of a single .tt file. pp_expand reserves this buffer per file
// and returns the unused part to the arena, so raising it costs no real
// memory.
fun pp_file_cap() -> u64 {
    return 1048576
}

fun pp_out_cap() -> u64 { return 4194304 }

// Include guard: 1 if this path was already included.
//
// The comparison is by path TEXT, not by real file. Two different paths
// pointing at the same file (a relative one and one with ./) would be included
// twice and would yield duplicate functions. In practice every entry point
// uses canonical paths from the repo root.
fun pp_seen(pth: *u8, plen: u64) -> u64 {
    let vp: **Vec = PP_SEEN_VEC
    let v: *Vec = vp[0]
    let i: u64 = 0
    while i < v.len {
        let seen: *PPSeen = vec_get(v, i)
        if seen.len == plen {
            if bytes_eq(seen.path, pth, plen) == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}

fun pp_mark(ar: *Arena, pth: *u8, plen: u64) {
    let seen: PPSeen
    seen.path = pth
    seen.len = plen
    let vp: **Vec = PP_SEEN_VEC
    vec_push(ar, vp[0], &seen)
}

fun pp_out_append(bytes: *u8, n: u64) {
    let lp: *u64 = PP_OUT_LEN
    let cur: u64 = lp[0]
    let cap: u64 = pp_out_cap()
    if cur > cap {
        let m: str = 'fuente expandida demasiado grande (PP_OUT)'
        die_line(m.ptr, m.len, 0)
    }
    if n > cap - cur {
        let m: str = 'fuente expandida demasiado grande (PP_OUT)'
        die_line(m.ptr, m.len, 0)
    }
    let dst: *u8 = PP_OUT
    let i: u64 = 0
    while i < n {
        dst[cur + i] = bytes[i]
        i = i + 1
    }
    lp[0] = cur + n
}

// Whether the line starting at `off` is an `import `. It requires the seven
// letters to be at the START of the line, with no indentation.
fun is_import_line(src: *u8, off: u64, srclen: u64) -> u64 {
    let kw: str = 'import '
    if off + 7 > srclen { return 0 }
    let i: u64 = 0
    while i < 7 {
        if src[off + i] != kw.ptr[i] { return 0 }
        i = i + 1
    }
    return 1
}

// Expands a file and its imports into PP_OUT.
//
// It walks the file line by line. If the line is an import, it extracts the
// path between single quotes and calls itself; otherwise it copies the line
// verbatim.
//
// The path is copied into the arena before being marked as seen, because
// `path` may point into the buffer of the file that contains it and, although
// that buffer is still alive, it is simpler not to depend on that.
//
// Import lines are NOT replaced by a blank line, so the line numbers in the
// errors refer to the EXPANDED file, not to the original one. It is the most
// visible limitation of the preprocessor.
fun pp_expand(ar: *Arena, path: *u8, plen: u64) {
    if pp_seen(path, plen) == 1 { return }
    let pcopy: *u8 = arena_take(ar, plen + 1)
    let pi: u64 = 0
    while pi < plen {
        pcopy[pi] = path[pi]
        pi = pi + 1
    }
    pcopy[plen] = 0
    pp_mark(ar, pcopy, plen)
    // The buffer is reserved at full size and the leftover is then returned to
    // the arena: reading with a fixed, unchecked cap truncated the file
    // silently and the error showed up much later, as a syntax failure in the
    // middle of the .tt.
    let cap: u64 = pp_file_cap()
    let buf_pos: u64 = ar.pos
    let buf: *u8 = arena_take(ar, cap)
    let read_err: u64 = 0
    let fd: u64 = io_open_read_checked(pcopy, &read_err)
    if read_err != 0 {
        let m: str = 'no se pudo abrir import'
        die_path_line(m.ptr, m.len, pcopy, plen, 0)
    }
    let total: u64 = 0
    loop {
        let n: u64 = io_read(fd, buf + total, cap - total)
        if n == 0 { break }
        total = total + n
    }
    io_close(fd)
    if total == cap {
        let m: str = 'fichero demasiado grande para el preprocesador'
        die_line(m.ptr, m.len, 0)
    }
    ar.pos = buf_pos + ((total + 7) / 8) * 8
    let src: *u8 = buf
    let i: u64 = 0
    let source_line: u64 = 1
    while i < total {
        let line_start: u64 = i
        while i < total {
            if src[i] == 10 { break }
            i = i + 1
        }
        let line_end: u64 = i
        if is_import_line(src, line_start, total) == 1 {
            let q1: u64 = line_start + 7
            while q1 < line_end {
                if src[q1] == 39 { break }
                q1 = q1 + 1
            }
            if q1 < line_end {
                let q2: u64 = q1 + 1
                while q2 < line_end {
                    if src[q2] == 39 { break }
                    q2 = q2 + 1
                }
                if q2 < line_end {
                    let plen2: u64 = q2 - q1 - 1
                    let ipath: *u8 = arena_take(ar, plen2 + 1)
                    let j: u64 = 0
                    while j < plen2 {
                        ipath[j] = src[q1 + 1 + j]
                        j = j + 1
                    }
                    ipath[plen2] = 0
                    pp_expand(ar, ipath, plen2)
                    let out_len: *u64 = PP_OUT_LEN
                    if out_len[0] > 0 {
                        let out: *u8 = PP_OUT
                        if out[out_len[0] - 1] != 10 {
                            source_origin_add(pcopy, plen, source_line)
                            let nl: str = '\n'
                            pp_out_append(nl.ptr, 1)
                        }
                    }
                }
            }
            if q1 == line_end {
                let m3: str = 'import sin comillas'
                die_path_line(m3.ptr, m3.len, pcopy, plen, source_line)
            }
            if q1 < line_end {
                let q3: u64 = q1 + 1
                while q3 < line_end {
                    if src[q3] == 39 { break }
                    q3 = q3 + 1
                }
                if q3 == line_end {
                    let m4: str = 'import sin comilla final'
                    die_path_line(m4.ptr, m4.len, pcopy, plen, source_line)
                }
            }
        } else {
            source_origin_add(pcopy, plen, source_line)
            pp_out_append(src + line_start, line_end - line_start)
            let nlbuf: *u8 = src + line_end
            if line_end < total {
                pp_out_append(nlbuf, 1)
            }
        }
        if i < total { i = i + 1 }
        source_line = source_line + 1
    }
}

// --dump-tokens mode: prints kind/start/len/line of every token up to EOF.
//
// It serves two purposes: debugging the lexer, and comparing compiler
// generations without depending on the generated code (bootstrap/verify.sh
// checks that two generations produce the same token sequence).
fun dump_tokens(o: *Out, src: *u8, srclen: u64) {
    let lx: *Lexer = LX_STATE
    lex_init(lx, src, srclen)
    let t: *Tok = DUMP_TOK_STORE
    loop {
        lex_next(lx, t)
        let sk: str = 'kind='
        out_bytes(o, sk.ptr, sk.len)
        out_u64(o, t.kind)
        let ss: str = ' start='
        out_bytes(o, ss.ptr, ss.len)
        out_u64(o, t.start)
        let sl: str = ' len='
        out_bytes(o, sl.ptr, sl.len)
        out_u64(o, t.tlen)
        let sn: str = ' line='
        out_bytes(o, sn.ptr, sn.len)
        out_u64(o, t.tline)
        out_byte(o, 10)
        if t.kind == TK_EOF { break }
    }
}

// Reads a whole file into a buffer. Only the --dump-* modes use it; the normal
// compilation path goes through pp_expand.
//
// Like pp_expand before the fix, it does not tell "a file of cap bytes" from
// "a larger file, truncated". It matters less here because the --dump-* modes
// are debugging tools.
fun read_all(path: *u8, buf: *u8, cap: u64) -> u64 {
    let err: u64 = 0
    let fd: u64 = io_open_read_checked(path, &err)
    if err != 0 { return 0 }
    let total: u64 = 0
    loop {
        let n: u64 = io_read_checked(fd, buf + total, cap - total, &err)
        if err != 0 { io_close(fd)  return 0 }
        if n == 0 { break }
        total = total + n
    }
    io_close(fd)
    return total
}

fun bytes_eq_lit(a: *u8, b: *u8, n: u64) -> u64 {
    let i: u64 = 0
    while i < n {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

fun cstr_eq(a: *u8, lit: *u8, n: u64) -> u64 {
    let i: u64 = 0
    while i < n {
        if a[i] != lit[i] { return 0 }
        i = i + 1
    }
    if a[n] != 0 { return 0 }
    return 1
}

// ---------------------------------------------------------------------------
// Driver
//
// Exit codes:
//   0  all good
//   2  not enough arguments (or a syntax error, through die_line)
//   3  the source is empty or could not be read
//   4  the output file could not be opened
//
// The arguments are read from the END (argv[argc-3] is the input and
// argv[argc-1] the output) so that the optional flags at the front do not
// shift the positions.
// ---------------------------------------------------------------------------
const EXIT_OK: u32 = 0
const EXIT_BAD_ARGS: u32 = 2
const EXIT_READ_FAIL: u32 = 3
const EXIT_OPEN_OUT_FAIL: u32 = 4

fun main(argc: u64, argv: **u8) -> u32 {
    if argc < 3 { return EXIT_BAD_ARGS }

    let a1: *u8 = argv[1]
    let flag_tok: str = '--dump-tokens'
    let flag_ir: str = '--dump-ir'
    let flag_macho: str = '--emit=macho'
    let flag_obj: str = '--emit=obj'
    let flag_elf: str = '--emit=elf'
    let flag_pe_arm64: str = '--emit=pe-arm64'
    let flag_macos: str = '--target=macos'
    let flag_linux: str = '--target=linux'
    let flag_json: str = '--diagnostics=json'
    let flag_windows_x64: str = '--target=windows-x64'
    let is_dump_tok: u64 = cstr_eq(a1, flag_tok.ptr, flag_tok.len)
    let is_dump_ir: u64 = cstr_eq(a1, flag_ir.ptr, flag_ir.len)

    if is_dump_tok == 1 {
        let path: *u8 = argv[2]
        let n: u64 = read_all(path, SRC_BUF, 262144)
        if n == 0 { return EXIT_READ_FAIL }
        let o: *Out = OUT_STORAGE
        out_init(o, 1, OUT_BUF, 65536)
        dump_tokens(o, SRC_BUF, n)
        out_flush(o)
        return EXIT_OK
    }
    if is_dump_ir == 1 {
        let path: *u8 = argv[2]
        let pp_ar: *Arena = pp_arena_init()
        let plen: u64 = 0
        loop {
            if path[plen] == 0 { break }
            plen = plen + 1
        }
        pp_expand(pp_ar, path, plen)
        let ppl: *u64 = PP_OUT_LEN
        let n: u64 = ppl[0]
        if n == 0 { return EXIT_READ_FAIL }
        let ast_ar: *Arena = ast_init()
        let ir_ar: *Arena = ir_init()
        diagnostics_reset()
        ps_init(PP_OUT, n)
        if check_interference() > 0 { diagnostics_flush() }
        let prog: *Program = parse(ast_ar, PP_OUT, n)
        if check(ast_ar, prog) != 0 { diagnostics_flush() }
        let irhead: *IrFn = lower(ir_ar, prog)
        let o: *Out = OUT_STORAGE
        out_init(o, 1, OUT_BUF, 65536)
        dump_ir(o, irhead)
        out_flush(o)
        return EXIT_OK
    }

    if argc < 4 { return EXIT_BAD_ARGS }
    let is_macho: u64 = 0
    let is_obj: u64 = 0
    let is_elf: u64 = 0
    let is_pe_arm64: u64 = 0
    let is_macos: u64 = 0
    let is_linux: u64 = 0
    let is_json: u64 = 0
    let is_windows_x64: u64 = 0
    let option_i: u64 = 1
    while option_i < argc - 3 {
        let option: *u8 = argv[option_i]
        let known: u64 = 0
        if cstr_eq(option, flag_macho.ptr, flag_macho.len) == 1 { is_macho = 1; known = 1 }
        if cstr_eq(option, flag_obj.ptr, flag_obj.len) == 1 { is_obj = 1; known = 1 }
        if cstr_eq(option, flag_elf.ptr, flag_elf.len) == 1 { is_elf = 1; known = 1 }
        if cstr_eq(option, flag_pe_arm64.ptr, flag_pe_arm64.len) == 1 { is_pe_arm64 = 1; known = 1 }
        if cstr_eq(option, flag_macos.ptr, flag_macos.len) == 1 { is_macos = 1; known = 1 }
        if cstr_eq(option, flag_linux.ptr, flag_linux.len) == 1 { is_linux = 1; known = 1 }
        if cstr_eq(option, flag_json.ptr, flag_json.len) == 1 { is_json = 1; known = 1 }
        if cstr_eq(option, flag_windows_x64.ptr, flag_windows_x64.len) == 1 { is_windows_x64 = 1; known = 1 }
        if known == 0 { return EXIT_BAD_ARGS }
        option_i = option_i + 1
    }
    if is_macho + is_elf + is_pe_arm64 > 1 { return EXIT_BAD_ARGS }
    if is_macos + is_linux + is_windows_x64 > 1 { return EXIT_BAD_ARGS }
    if is_macho + is_elf + is_pe_arm64 > 0 {
        if is_obj + is_macos + is_linux + is_windows_x64 > 0 { return EXIT_BAD_ARGS }
    }
    diagnostics_set_json(is_json)
    let input: *u8 = argv[argc - 3]
    let output: *u8 = argv[argc - 1]

    let pp_ar: *Arena = pp_arena_init()
    let plen_in: u64 = 0
    loop {
        if input[plen_in] == 0 { break }
        plen_in = plen_in + 1
    }
    pp_expand(pp_ar, input, plen_in)
    let ppl: *u64 = PP_OUT_LEN
    let n: u64 = ppl[0]
    if n == 0 { return EXIT_READ_FAIL }
    let src: *u8 = PP_OUT

    let ast_ar: *Arena = ast_init()
    let ir_ar: *Arena = ir_init()
    diagnostics_reset()
    ps_init(src, n)
    if check_interference() > 0 { diagnostics_flush() }
    let prog: *Program = parse(ast_ar, src, n)
    if check(ast_ar, prog) != 0 { diagnostics_flush() }
    let irhead: *IrFn = lower(ir_ar, prog)

    let out_err: u64 = 0
    let fd: u64 = io_open_write_checked(output, &out_err)
    if out_err != 0 { return EXIT_OPEN_OUT_FAIL }

    // --emit=macho path: bytes instead of text.
    //
    // The order matters. cgb_bss_layout has to run BEFORE codegen_bytes
    // because the generated code references the bss symbols by index and those
    // indices are assigned by the layout.
    if is_macho == 1 {
        let bvsz: u64 = cgb_bss_layout(prog)
        codegen_bytes(TGT_MACOS, prog, irhead)
        let clen: u64 = cb_pos()
        let entry: *u64 = CG_ENTRY
        emit_macho_code_bss(fd, prog, clen, entry[0], bvsz)
    } else if is_elf == 1 {
        let bvsz2: u64 = cgb_bss_layout(prog)
        codegen_bytes(TGT_LINUX, prog, irhead)
        let clen2: u64 = cb_pos()
        let entry2: *u64 = CG_ENTRY
        emit_elf_code_bss(fd, prog, clen2, entry2[0], bvsz2)
    } else if is_pe_arm64 == 1 {
        let bvsz3: u64 = cgb_bss_layout(prog)
        codegen_bytes(TGT_WINDOWS, prog, irhead)
        let clen3: u64 = cb_pos()
        let entry3: *u64 = CG_ENTRY
        emit_pe_arm64_code(fd, prog, clen3, entry3[0], bvsz3)
    } else {
        let o: *Out = OUT_STORAGE
        out_init(o, fd, OUT_BUF, 65536)
        if is_windows_x64 == 1 {
            codegen_x64(o, prog, irhead, is_obj)
            out_flush(o)
            io_close(fd)
            return EXIT_OK
        }
        let target: u64 = TGT_MACOS
        if is_linux == 1 { target = TGT_LINUX }
        codegen(o, target, is_obj, prog, irhead)
    }
    io_close(fd)
    return EXIT_OK
}
