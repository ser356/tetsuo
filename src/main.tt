// ============================================================================
// src/main.tt - driver del compilador y preprocesador de imports
// ============================================================================
//
// Es el punto de entrada de tetsuoc y el sitio donde se encadenan todas las
// fases:
//
//     fichero.tt
//        |  pp_expand          resuelve los `import` a un unico buffer
//        v
//     PP_OUT
//        |  parse              lexer + parser -> *Program        (parser.tt)
//        v
//     AST
//        |  lower              -> lista de IrFn                  (ir.tt)
//        v
//     IR
//        |  codegen            -> texto .s                       (codegen.tt)
//        |  codegen_bytes      -> bytes + emit_macho_code_bss    (codegen_bytes.tt)
//        v
//     salida
//
// MODOS DE INVOCACION
//
//     tetsuoc --dump-tokens f.tt              vuelca la secuencia de tokens
//     tetsuoc --dump-ir f.tt                  vuelca el IR en texto
//     tetsuoc [--target=macos] f.tt -o s.s    emite ensamblador
//     tetsuoc --emit=macho f.tt -o binario    emite un Mach-O firmado, listo
//                                             para ejecutar en macOS/arm64
//
// El ultimo es el que cierra el auto-hospedaje: no necesita clang, as, ld ni
// codesign.
//
// EL PREPROCESADOR
//
// `import 'ruta'` es textual: se sustituye la linea por el contenido del
// fichero, recursivamente, saltando lo ya incluido (guarda de inclusion por
// ruta, ver pp_seen). No hay espacios de nombres ni simbolos privados; todo
// acaba en un unico buffer plano, y por eso el orden de los import importa (el
// primero que declare un bss se lleva el offset 0).
//
// Es deliberadamente tonto: reconoce una linea que EMPIECE por "import " y
// extrae lo que hay entre comillas simples. Un import sangrado o dentro de un
// comentario no se reconoce.
//
// LOS BUFFERS Y SUS LIMITES
//
// Casi todo el bss del compilador se declara aqui o en los arenas de las fases.
// Los limites son duros y estan comprobados: pasarse aborta con un mensaje, no
// trunca en silencio. Esa comprobacion no siempre estuvo: pp_expand leia cada
// fichero en un buffer fijo de 128KB sin mirar si cabia, y una fuente mayor
// perdia la cola, con lo que el error salia mucho despues disfrazado de fallo
// de sintaxis en mitad del fichero.
// ============================================================================

bss SRC_BUF: 262144       // fuente cruda, solo para los modos --dump-*
bss OUT_BUF: 65536        // buffer de salida del backend textual
bss OUT_STORAGE: 64       // el struct Out (no cabe en un local por el retorno)
bss DUMP_TOK_STORE: 40    // el Tok de --dump-tokens
bss PP_OUT: 1048576       // fuente ya expandida: lo que ve el parser
bss PP_OUT_LEN: 8
bss PP_ARENA_STORE: 24
bss PP_ARENA_BUF: 16777216  // arena del preprocesador: rutas y ficheros leidos
bss PP_SEEN_COUNT: 8
bss PP_SEEN_PTRS: 256     // 32 rutas ya incluidas (guarda de inclusion)
bss PP_SEEN_LENS: 256

fun pp_arena_init() -> *Arena {
    let a: *Arena = PP_ARENA_STORE
    arena_init(a, PP_ARENA_BUF, 16777216)
    return a
}

// tamano maximo de un .tt suelto. pp_expand reserva este buffer por fichero y
// devuelve al arena lo que no use, asi que subirlo no cuesta memoria real.
fun pp_file_cap() -> u64 {
    return 1048576
}

fun pp_out_cap() -> u64 {
    return 1048576
}

// Guarda de inclusion: 1 si esta ruta ya se incluyo.
//
// La comparacion es por TEXTO de la ruta, no por fichero real. Dos rutas
// distintas que apunten al mismo fichero (una relativa y otra con ./) se
// incluirian dos veces y darian funciones duplicadas. En la practica todos los
// entries usan rutas canonicas desde la raiz del repo.
fun pp_seen(pth: *u8, plen: u64) -> u64 {
    let cnt_p: *u64 = PP_SEEN_COUNT
    let cnt: u64 = cnt_p[0]
    let paths: **u8 = PP_SEEN_PTRS
    let lens: *u64 = PP_SEEN_LENS
    let i: u64 = 0
    while i < cnt {
        if lens[i] == plen {
            if bytes_eq(paths[i], pth, plen) == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}

fun pp_mark(pth: *u8, plen: u64) {
    let cnt_p: *u64 = PP_SEEN_COUNT
    let cnt: u64 = cnt_p[0]
    if cnt == 32 {
        let m: str = 'demasiados import (max 32)'
        die_line(m.ptr, m.len, 0)
    }
    let paths: **u8 = PP_SEEN_PTRS
    let lens: *u64 = PP_SEEN_LENS
    paths[cnt] = pth
    lens[cnt] = plen
    cnt_p[0] = cnt + 1
}

fun pp_out_append(bytes: *u8, n: u64) {
    let lp: *u64 = PP_OUT_LEN
    let cur: u64 = lp[0]
    let cap: u64 = pp_out_cap()
    if cur > cap {
        let m: str = 'fuente expandida demasiado grande (PP_OUT)'
        die_line(m.ptr, m.len, 0)
    }
    if n > cap - cur {
        let m: str = 'fuente expandida demasiado grande (PP_OUT)'
        die_line(m.ptr, m.len, 0)
    }
    let dst: *u8 = PP_OUT
    let i: u64 = 0
    while i < n {
        dst[cur + i] = bytes[i]
        i = i + 1
    }
    lp[0] = cur + n
}

// Si la linea que empieza en `off` es un `import `. Exige que las siete letras
// esten al PRINCIPIO de la linea, sin sangrado.
fun is_import_line(src: *u8, off: u64, srclen: u64) -> u64 {
    let kw: str = 'import '
    if off + 7 > srclen { return 0 }
    let i: u64 = 0
    while i < 7 {
        if src[off + i] != kw.ptr[i] { return 0 }
        i = i + 1
    }
    return 1
}

// Expande un fichero y sus imports a PP_OUT.
//
// Recorre el fichero linea a linea. Si la linea es un import, extrae la ruta
// entre comillas simples y se llama a si misma; si no, copia la linea tal cual.
//
// La ruta se copia al arena antes de marcarla como vista, porque `path` puede
// apuntar al buffer del fichero que la contiene y ese buffer sigue vivo pero es
// mas simple no depender de ello.
//
// Las lineas de import NO se sustituyen por una linea en blanco, asi que los
// numeros de linea de los errores se refieren al fichero EXPANDIDO, no al
// original. Es la limitacion mas visible del preprocesador.
fun pp_expand(ar: *Arena, path: *u8, plen: u64) {
    if pp_seen(path, plen) == 1 { return }
    let pcopy: *u8 = arena_take(ar, plen + 1)
    let pi: u64 = 0
    while pi < plen {
        pcopy[pi] = path[pi]
        pi = pi + 1
    }
    pcopy[plen] = 0
    pp_mark(pcopy, plen)
    // El buffer se reserva al maximo y luego se devuelve el sobrante al arena:
    // leer con un tope fijo y sin comprobarlo truncaba el fichero en silencio y
    // el error salia mucho despues, como un fallo de sintaxis en mitad del .tt.
    let cap: u64 = pp_file_cap()
    let buf_pos: u64 = ar.pos
    let buf: *u8 = arena_take(ar, cap)
    let fd: u64 = io_open_read(pcopy)
    if fd == 0 { return }
    let total: u64 = 0
    loop {
        let n: u64 = io_read(fd, buf + total, cap - total)
        if n == 0 { break }
        total = total + n
    }
    io_close(fd)
    if total == cap {
        let m: str = 'fichero demasiado grande para el preprocesador'
        die_line(m.ptr, m.len, 0)
    }
    ar.pos = buf_pos + ((total + 7) / 8) * 8
    let src: *u8 = buf
    let i: u64 = 0
    while i < total {
        let line_start: u64 = i
        while i < total {
            if src[i] == 10 { break }
            i = i + 1
        }
        let line_end: u64 = i
        if is_import_line(src, line_start, total) == 1 {
            let q1: u64 = line_start + 7
            while q1 < line_end {
                if src[q1] == 39 { break }
                q1 = q1 + 1
            }
            if q1 < line_end {
                let q2: u64 = q1 + 1
                while q2 < line_end {
                    if src[q2] == 39 { break }
                    q2 = q2 + 1
                }
                if q2 < line_end {
                    let plen2: u64 = q2 - q1 - 1
                    let ipath: *u8 = arena_take(ar, plen2 + 1)
                    let j: u64 = 0
                    while j < plen2 {
                        ipath[j] = src[q1 + 1 + j]
                        j = j + 1
                    }
                    ipath[plen2] = 0
                    pp_expand(ar, ipath, plen2)
                }
            }
        } else {
            pp_out_append(src + line_start, line_end - line_start)
            let nlbuf: *u8 = src + line_end
            if line_end < total {
                pp_out_append(nlbuf, 1)
            }
        }
        if i < total { i = i + 1 }
    }
}

// Modo --dump-tokens: imprime kind/start/len/line de cada token hasta EOF.
//
// Sirve para dos cosas: depurar el lexer, y comparar generaciones del
// compilador sin depender del codigo generado (bootstrap/verify.sh comprueba
// que dos generaciones producen la misma secuencia de tokens).
fun dump_tokens(o: *Out, src: *u8, srclen: u64) {
    let lx: *Lexer = LX_STATE
    lex_init(lx, src, srclen)
    let t: *Tok = DUMP_TOK_STORE
    loop {
        lex_next(lx, t)
        let sk: str = 'kind='
        out_bytes(o, sk.ptr, sk.len)
        out_u64(o, t.kind)
        let ss: str = ' start='
        out_bytes(o, ss.ptr, ss.len)
        out_u64(o, t.start)
        let sl: str = ' len='
        out_bytes(o, sl.ptr, sl.len)
        out_u64(o, t.tlen)
        let sn: str = ' line='
        out_bytes(o, sn.ptr, sn.len)
        out_u64(o, t.tline)
        out_byte(o, 10)
        if t.kind == TK_EOF { break }
    }
}

// Lee un fichero entero a un buffer. Solo lo usan los modos --dump-*; la ruta
// normal de compilacion pasa por pp_expand.
//
// Como pp_expand antes del arreglo, no distingue "fichero de cap bytes" de
// "fichero mas grande truncado". Aqui importa menos porque los modos --dump-*
// son herramientas de depuracion.
fun read_all(path: *u8, buf: *u8, cap: u64) -> u64 {
    let fd: u64 = io_open_read(path)
    if fd == 0 { return 0 }
    let total: u64 = 0
    loop {
        let n: u64 = io_read(fd, buf + total, cap - total)
        if n == 0 { break }
        total = total + n
    }
    io_close(fd)
    return total
}

fun bytes_eq_lit(a: *u8, b: *u8, n: u64) -> u64 {
    let i: u64 = 0
    while i < n {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

fun cstr_eq(a: *u8, lit: *u8, n: u64) -> u64 {
    let i: u64 = 0
    while i < n {
        if a[i] != lit[i] { return 0 }
        i = i + 1
    }
    if a[n] != 0 { return 0 }
    return 1
}

// ---------------------------------------------------------------------------
// Driver
//
// Codigos de salida:
//   0  todo bien
//   2  argumentos insuficientes (o error de sintaxis, via die_line)
//   3  la fuente esta vacia o no se pudo leer
//   4  no se pudo abrir el fichero de salida
//
// Los argumentos se leen desde el FINAL (argv[argc-3] es la entrada y
// argv[argc-1] la salida) para que los flags opcionales del principio no
// desplacen las posiciones.
// ---------------------------------------------------------------------------
const EXIT_OK: u32 = 0
const EXIT_BAD_ARGS: u32 = 2
const EXIT_READ_FAIL: u32 = 3
const EXIT_OPEN_OUT_FAIL: u32 = 4

fun main(argc: u64, argv: **u8) -> u32 {
    if argc < 3 { return EXIT_BAD_ARGS }

    let a1: *u8 = argv[1]
    let flag_tok: str = '--dump-tokens'
    let flag_ir: str = '--dump-ir'
    let flag_macho: str = '--emit=macho'
    let flag_obj: str = '--emit=obj'
    let flag_linux: str = '--target=linux'
    let is_dump_tok: u64 = cstr_eq(a1, flag_tok.ptr, flag_tok.len)
    let is_dump_ir: u64 = cstr_eq(a1, flag_ir.ptr, flag_ir.len)
    let is_macho: u64 = cstr_eq(a1, flag_macho.ptr, flag_macho.len)
    let is_obj: u64 = cstr_eq(a1, flag_obj.ptr, flag_obj.len)
    let is_linux: u64 = cstr_eq(a1, flag_linux.ptr, flag_linux.len)

    if is_dump_tok == 1 {
        let path: *u8 = argv[2]
        let n: u64 = read_all(path, SRC_BUF, 262144)
        if n == 0 { return EXIT_READ_FAIL }
        let o: *Out = OUT_STORAGE
        out_init(o, 1, OUT_BUF, 65536)
        dump_tokens(o, SRC_BUF, n)
        out_flush(o)
        return EXIT_OK
    }
    if is_dump_ir == 1 {
        let path: *u8 = argv[2]
        let n: u64 = read_all(path, SRC_BUF, 262144)
        if n == 0 { return EXIT_READ_FAIL }
        let ast_ar: *Arena = ast_init()
        let ir_ar: *Arena = ir_init()
        let prog: *Program = parse(ast_ar, SRC_BUF, n)
        let irhead: *IrFn = lower(ir_ar, prog)
        let o: *Out = OUT_STORAGE
        out_init(o, 1, OUT_BUF, 65536)
        dump_ir(o, irhead)
        out_flush(o)
        return EXIT_OK
    }

    if argc < 4 { return EXIT_BAD_ARGS }
    let input: *u8 = argv[argc - 3]
    let output: *u8 = argv[argc - 1]

    let pp_ar: *Arena = pp_arena_init()
    let plen_in: u64 = 0
    loop {
        if input[plen_in] == 0 { break }
        plen_in = plen_in + 1
    }
    pp_expand(pp_ar, input, plen_in)
    let ppl: *u64 = PP_OUT_LEN
    let n: u64 = ppl[0]
    if n == 0 { return EXIT_READ_FAIL }
    let src: *u8 = PP_OUT

    let ast_ar: *Arena = ast_init()
    let ir_ar: *Arena = ir_init()
    let prog: *Program = parse(ast_ar, src, n)
    let irhead: *IrFn = lower(ir_ar, prog)

    let fd: u64 = io_open_write(output)
    if fd == 0 { return EXIT_OPEN_OUT_FAIL }

    // Camino --emit=macho: bytes en vez de texto.
    //
    // El orden importa. cgb_bss_layout tiene que ir ANTES de codegen_bytes
    // porque el codigo generado referencia los simbolos bss por indice y esos
    // indices los asigna el layout.
    if is_macho == 1 {
        let bvsz: u64 = cgb_bss_layout(prog)
        codegen_bytes(prog, irhead)
        let clen: u64 = cb_pos()
        let entry: *u64 = CG_ENTRY
        emit_macho_code_bss(fd, prog, clen, entry[0], bvsz)
    } else {
        let o: *Out = OUT_STORAGE
        out_init(o, fd, OUT_BUF, 65536)
        let target: u64 = TGT_MACOS
        if is_linux == 1 { target = TGT_LINUX }
        codegen(o, target, is_obj, prog, irhead)
    }
    io_close(fd)
    return EXIT_OK
}
