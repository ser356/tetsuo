// ============================================================================
// src/asm.tt - AArch64 instruction encoder (milestone 24.b)
// ============================================================================
//
// Every `enc_*` function returns the u32 of ONE already encoded ARM64
// instruction, ready to be written little-endian into the code buffer. It is
// the piece that replaces the assembler: where src/codegen.tt writes the text
// "add x9, x10, x11", src/codegen_bytes.tt calls enc_add_reg(9, 10, 11) and
// gets 0x8b0b014a.
//
// HOW TO READ THIS FILE
//
// Every function has the same shape:
//
//     return <BASE> | (field1 << pos1) | (field2 << pos2) | ...
//
// where BASE is the word with every variable field set to zero (the pure
// "opcode") and each field is masked before being shifted. The masking is not
// paranoia: a register out of range or a negative signed immediate
// (represented as a u64, that is, enormous) would overflow onto the opcode
// bits and produce ANOTHER instruction, valid and silently wrong. That is
// exactly the most expensive failure mode to debug in a compiler that emits
// bytes: `otool -tv` shows something that reads fine and the CPU does
// something else.
//
// The constants are in decimal because the language had no hex literals when
// this file was written. The equivalence table:
//
//     movz       0xd2800000      ldr_x      0xf9400000      adrp   0x90000000
//     movk       0xf2800000      ldr_w      0xb9400000      bl     0x94000000
//     orr/mov    0xaa000000      ldrb       0x39400000      b      0x14000000
//     stp_pre    0xa9800000      str_x      0xf9000000      cbz    0x34000000
//     ldp_post   0xa8c00000      str_w      0xb9000000      subs   0xeb000000
//     add_imm    0x91000000      strb       0x39000000      csinc  0x1a9f07e0
//     sub_imm    0xd1000000      madd       0x9b007c00      svc    0xd4000001
//     add_reg    0x8b000000      udiv       0x9ac00800      ret    0xd65f03c0
//     sub_reg    0xcb000000      lslv       0x9ac02000
//     and        0x8a000000      lsrv       0x9ac02400
//     eor        0xca000000
//
// REGISTER CONVENTION
//
// 0..30 are x0..x30 (or w0..w30 in the 32-bit variants). 31 is special and its
// meaning DEPENDS ON THE INSTRUCTION: in some it encodes xzr/wzr (the zero
// register) and in others sp. This ISA ambiguity caused a real bug in session
// C2: emitting `sub sp, sp, x16` with enc_sub_reg(31, 31, 16) produces
// `sub xzr, sp, x16`, which discards the result and leaves SP untouched, so
// the locals of the function trampled the caller's frame. Hence the separate
// enc_sub_ext_sp / enc_add_ext_sp (see below).
//
// The encoder is tested in tests/asm_test.tt, which compares the produced u32
// with the one clang emits for the same instruction.
// ============================================================================

// ---------------------------------------------------------------------------
// Field masks. m<N> trims to the N low bits.
//
// They serve two purposes at once: bounding unsigned values (a register never
// goes above 31) and converting a signed displacement to its two's complement
// of the right width. Since everything in tetsuo is a u64, an offset of -3
// arrives here as 0xFFFFFFFFFFFFFFFD and m26() trims it to 0x3FFFFFD, which is
// exactly what the imm26 field of a branch expects.
// ---------------------------------------------------------------------------
fun m5(v: u64) -> u64  { return v & 31 }
fun m7(v: u64) -> u64  { return v & 127 }
fun m12(v: u64) -> u64 { return v & 4095 }
fun m16(v: u64) -> u64 { return v & 65535 }
fun m19(v: u64) -> u64 { return v & 524287 }
fun m21(v: u64) -> u64 { return v & 2097151 }
fun m26(v: u64) -> u64 { return v & 67108863 }

// ---------------------------------------------------------------------------
// Constants into registers
// ---------------------------------------------------------------------------

// MOVZ Xd, #imm16, LSL #(16*hw)
//
// Puts imm16 in the 16-bit slice selected by hw (0..3) and ZERO in the rest of
// the register. It is the first instruction of any sequence that loads a large
// constant: movz for the low chunk, movk for the others.
// Fields: hw at bits 22:21, imm16 at 20:5, Rd at 4:0.
fun enc_movz(rd: u64, imm16: u64, hw: u64) -> u64 {
    return 3531603968 | (m5(hw) << 21) | (m16(imm16) << 5) | m5(rd)
}

// MOVK Xd, #imm16, LSL #(16*hw)
//
// Same as movz but it KEEPS the rest of the register. Chaining movz + movk*3
// builds any u64 in four instructions. See b_movi in codegen_bytes.tt, which
// skips the chunks that are zero.
fun enc_movk(rd: u64, imm16: u64, hw: u64) -> u64 {
    return 4068474880 | (m5(hw) << 21) | (m16(imm16) << 5) | m5(rd)
}

// MOV Xd, Xm  ==  ORR Xd, XZR, Xm
//
// AArch64 has no MOV opcode between registers: it is an alias of ORR with the
// zero register as the first operand. That is why 31 appears literally in the
// Rn position.
fun enc_mov_reg(rd: u64, rm: u64) -> u64 {
    return 2852126720 | (m5(rm) << 16) | (31 << 5) | m5(rd)
}

// ---------------------------------------------------------------------------
// Pairs (function prologue and epilogue)
// ---------------------------------------------------------------------------

// STP Xt, Xt2, [Xn, #imm7*8]!   (pre-index, with write-back)
//
// imm7 is the RAW field, already scaled and in 7-bit two's complement: the
// real displacement in bytes is imm7*8. The prologue uses imm7 = 126, which is
// -2 in 7 bits, that is `[sp, #-16]!`: it lowers SP by 16 bytes and stores
// x29/x30 there. Here Rn = 31 means SP.
fun enc_stp_pre(rt: u64, rt2: u64, rn: u64, imm7: u64) -> u64 {
    return 2843738112 | (m7(imm7) << 15) | (m5(rt2) << 10) | (m5(rn) << 5) | m5(rt)
}

// LDP Xt, Xt2, [Xn], #imm7*8    (post-index)
//
// The inverse of the previous one: it reads and THEN raises SP. The epilogue
// uses imm7 = 2, that is `[sp], #16`.
fun enc_ldp_post(rt: u64, rt2: u64, rn: u64, imm7: u64) -> u64 {
    return 2831155200 | (m7(imm7) << 15) | (m5(rt2) << 10) | (m5(rn) << 5) | m5(rt)
}

// ---------------------------------------------------------------------------
// Arithmetic
// ---------------------------------------------------------------------------

// ADD Xd, Xn, #imm12
//
// In the immediate form, Rd=31 and Rn=31 mean SP (not xzr), so this very
// function serves both for `mov x29, sp` (add x29, sp, #0) and for
// `sub sp, sp, #N` through enc_sub_imm. imm12 is unsigned: to subtract, use
// enc_sub_imm. The useful range is 0..4095 (there is an optional LSL #12 shift
// that is not used here; above 4095 the codegen loads the constant into x16
// and uses the extended register form).
fun enc_add_imm(rd: u64, rn: u64, imm12: u64) -> u64 {
    return 2432696320 | (m12(imm12) << 10) | (m5(rn) << 5) | m5(rd)
}

// SUB Xd, Xn, #imm12
fun enc_sub_imm(rd: u64, rn: u64, imm12: u64) -> u64 {
    return 3506438144 | (m12(imm12) << 10) | (m5(rn) << 5) | m5(rd)
}

// ADD Xd, Xn, Xm  (shifted register, LSL #0)
//
// MIND: in the SHIFTED register form, 31 encodes xzr, NOT sp. That is why this
// function is not usable to touch SP; see enc_add_ext_sp.
fun enc_add_reg(rd: u64, rn: u64, rm: u64) -> u64 {
    return 2332033024 | (m5(rm) << 16) | (m5(rn) << 5) | m5(rd)
}

// SUB Xd, Xn, Xm  (shifted register, LSL #0). Same warning about 31.
fun enc_sub_reg(rd: u64, rn: u64, rm: u64) -> u64 {
    return 3405774848 | (m5(rm) << 16) | (m5(rn) << 5) | m5(rd)
}

// SUB SP, SP, Xm   (extended register, UXTX #0)
//
// The only register form in which Rd=31 means SP is the EXTENDED one (bit 21
// set, option field = UXTX). The 0xcb2063ff base already has everything fixed:
//
//     bit 21     = 1        extended register form
//     option 3   = UXTX     (bits 15:13, "use the whole Xm, no extension")
//     imm3  0    = LSL #0   (bits 12:10)
//     Rn    31   = SP       (bits 9:5)
//     Rd    31   = SP       (bits 4:0)
//
// Only Rm at bits 20:16 is left to fill in. It exists because
// enc_sub_reg(31, 31, 16) encodes `sub xzr, sp, x16`, which does not modify
// SP: the session C2 bug, which left the frame unreserved in every function
// with more than 4095 bytes of locals.
fun enc_sub_ext_sp(rm: u64) -> u64 {
    return 3407897599 | (m5(rm) << 16)
}

// ADD SP, SP, Xm   (extended register, UXTX #0). The symmetric one, for the
// epilogue.
fun enc_add_ext_sp(rm: u64) -> u64 {
    return 2334155775 | (m5(rm) << 16)
}

// MUL Xd, Xn, Xm  ==  MADD Xd, Xn, Xm, XZR
//
// There is no three-operand MUL: it is an alias of multiply-and-accumulate
// with the accumulator set to xzr. Hence the `31 << 10` (the Ra field).
fun enc_mul(rd: u64, rn: u64, rm: u64) -> u64 {
    return 2600500224 | (m5(rm) << 16) | (31 << 10) | (m5(rn) << 5) | m5(rd)
}

// UDIV Xd, Xn, Xm  (unsigned integer division; division by zero yields 0, it
// does not trap)
fun enc_udiv(rd: u64, rn: u64, rm: u64) -> u64 {
    return 2596276224 | (m5(rm) << 16) | (m5(rn) << 5) | m5(rd)
}

fun enc_sdiv(rd: u64, rn: u64, rm: u64) -> u64 {
    return 2596277248 | (m5(rm) << 16) | (m5(rn) << 5) | m5(rd)
}

// ---------------------------------------------------------------------------
// Logical operations and shifts (milestone 24.a)
// ---------------------------------------------------------------------------

fun enc_and(rd: u64, rn: u64, rm: u64) -> u64 {
    return 2315255808 | (m5(rm) << 16) | (m5(rn) << 5) | m5(rd)
}

// Same base as enc_mov_reg: MOV is ORR with Rn=xzr.
fun enc_orr(rd: u64, rn: u64, rm: u64) -> u64 {
    return 2852126720 | (m5(rm) << 16) | (m5(rn) << 5) | m5(rd)
}

fun enc_eor(rd: u64, rn: u64, rm: u64) -> u64 {
    return 3388997632 | (m5(rm) << 16) | (m5(rn) << 5) | m5(rd)
}

// LSLV / LSRV: shift by REGISTER (variable). The shift by immediate is an
// alias of UBFM and is not used here: the codegen loads the constant into a
// register and always uses the variable form, which saves one case.
// Only the 6 low bits of Xm are looked at, as the ISA mandates.
fun enc_lslv(rd: u64, rn: u64, rm: u64) -> u64 {
    return 2596282368 | (m5(rm) << 16) | (m5(rn) << 5) | m5(rd)
}

fun enc_lsrv(rd: u64, rn: u64, rm: u64) -> u64 {
    return 2596283392 | (m5(rm) << 16) | (m5(rn) << 5) | m5(rd)
}

// ---------------------------------------------------------------------------
// Memory ("unsigned offset" form)
//
// In all of these, imm12 is the RAW field and the real displacement in bytes
// is imm12 * (access width): *8 for x, *4 for w, *1 for b. That is, the caller
// must DIVIDE the byte offset by the width before passing it, and the offset
// has to be a multiple of the width. See b_str_x / b_ldr_x in
// codegen_bytes.tt, which perform that division.
//
// Rn = 31 means SP here, which is exactly what is needed for the locals.
// ---------------------------------------------------------------------------

fun enc_ldr_x(rt: u64, rn: u64, imm12: u64) -> u64 {
    return 4181721088 | (m12(imm12) << 10) | (m5(rn) << 5) | m5(rt)
}

fun enc_ldr_w(rt: u64, rn: u64, imm12: u64) -> u64 {
    return 3107979264 | (m12(imm12) << 10) | (m5(rn) << 5) | m5(rt)
}

// LDRB Wt, [Xn, #imm12]. Zero-extends to 32 bits (and the rest of the X to 0).
fun enc_ldrb(rt: u64, rn: u64, imm12: u64) -> u64 {
    return 960495616 | (m12(imm12) << 10) | (m5(rn) << 5) | m5(rt)
}

fun enc_str_x(rt: u64, rn: u64, imm12: u64) -> u64 {
    return 4177526784 | (m12(imm12) << 10) | (m5(rn) << 5) | m5(rt)
}

fun enc_str_w(rt: u64, rn: u64, imm12: u64) -> u64 {
    return 3103784960 | (m12(imm12) << 10) | (m5(rn) << 5) | m5(rt)
}

fun enc_strb(rt: u64, rn: u64, imm12: u64) -> u64 {
    return 956301312 | (m12(imm12) << 10) | (m5(rn) << 5) | m5(rt)
}

fun enc_sxtb(rd: u64, rn: u64) -> u64 {
    return 2470452224 | (m5(rn) << 5) | m5(rd)
}

fun enc_sxtw(rd: u64, rn: u64) -> u64 {
    return 2470476800 | (m5(rn) << 5) | m5(rd)
}

fun enc_uxtb(rd: u64, rn: u64) -> u64 {
    return 1392516096 | (m5(rn) << 5) | m5(rd)
}

fun enc_uxtw(rd: u64, rn: u64) -> u64 {
    return enc_mov_reg(rd, rn) & 2147483647
}

// ---------------------------------------------------------------------------
// Addresses (the adrp + add pair)
// ---------------------------------------------------------------------------

// ADRP Xd, #imm21
//
// Puts in Xd the address of the 4KB PAGE that sits imm21 pages beyond the page
// of the PC. imm21 is signed and gives a +-4GB reach.
//
// The field is SPLIT into two non-contiguous chunks, which is the peculiarity
// of this instruction: the 2 low bits go to 30:29 (immlo) and the 19 high ones
// to 23:5 (immhi). Hence the lo/hi splitting.
//
// The normal use is the canonical pair
//     adrp x9, symbol            // page
//     add  x9, x9, #(sym & 4095) // displacement within the page
// which is what the FX_ADRP/FX_PGOF and FX_ADRPB/FX_PGOFB fixups of
// codegen_bytes.tt emit for string literals and for bss symbols.
//
// Since it is PC-relative, the resulting binary is still correct if the loader
// slides the image (MH_PIE), as long as __TEXT and __DATA slide together,
// which is what macOS does.
fun enc_adrp(rd: u64, imm21: u64) -> u64 {
    let v: u64 = m21(imm21)
    let lo: u64 = v & 3
    let hi: u64 = v >> 2
    return 2415919104 | (lo << 29) | (hi << 5) | m5(rd)
}

// The second half of the adrp+add pair. It is literally enc_add_imm; it exists
// under its own name so that the call site reads as what it is.
fun enc_add_pageoff(rd: u64, rn: u64, imm12: u64) -> u64 {
    return enc_add_imm(rd, rn, imm12)
}

// ---------------------------------------------------------------------------
// Branches
//
// In every branch the displacement is counted in INSTRUCTIONS (4-byte words),
// not in bytes, and it is relative to the PC of the instruction itself. The
// caller computes (target - here) / 4 and lets the mask do the two's
// complement.
// ---------------------------------------------------------------------------

// BL #imm26 - call. Saves the return address in x30. Reach +-128MB, plenty for
// a 106KB __text like the compiler's own.
fun enc_bl(imm26: u64) -> u64 {
    return 2483027968 | m26(imm26)
}

// B #imm26 - unconditional branch. Same reach.
fun enc_b(imm26: u64) -> u64 {
    return 335544320 | m26(imm26)
}

// CBZ Wt, #imm19 - branches if Wt is zero. Reach +-1MB.
//
// It is the only conditional branch the byte backend emits: comparisons
// produce a 0/1 in a register (see enc_cset) and control flow is decided with
// cbz on that 0/1, instead of with b.cond on the flags. That decouples the
// comparison from the branch and avoids having to preserve NZCV between IR
// instructions.
fun enc_cbz_w(rt: u64, imm19: u64) -> u64 {
    return 872415232 | (m19(imm19) << 5) | m5(rt)
}

fun enc_cbz_x(rt: u64, imm19: u64) -> u64 {
    return 3019898880 | (m19(imm19) << 5) | m5(rt)
}

// ---------------------------------------------------------------------------
// Comparison and materialization of conditions
// ---------------------------------------------------------------------------

// CMP Xn, Xm  ==  SUBS XZR, Xn, Xm
//
// Subtracts, discarding the result and keeping only the NZCV flags. The
// literal 31 at the end is Rd = xzr.
fun enc_cmp_reg(rn: u64, rm: u64) -> u64 {
    return 3942645760 | (m5(rm) << 16) | (m5(rn) << 5) | 31
}

// CSET Wd, cond  ==  CSINC Wd, WZR, WZR, invert(cond)
//
// Puts 1 in Wd if `cond` holds and 0 otherwise. The trick behind the alias is
// that CSINC writes "Rn if the condition holds, Rm+1 otherwise", so with
// Rn=Rm=wzr it gives 0 when it holds and 1 when it does not; that is why the
// condition has to be passed INVERTED.
//
// The caller already performs that inversion: for `cset w10, eq` it passes
// invcond = NE = 1. The ARM condition table is EQ=0, NE=1, HS/CS=2, LO/CC=3,
// MI=4, PL=5, VS=6, VC=7, HI=8, LS=9, GE=10, LT=11, GT=12, LE=13, AL=14; and
// inverting a condition means setting its bit 0. See cgb_i_cmp in
// codegen_bytes.tt.
fun enc_cset(rd: u64, invcond: u64) -> u64 {
    return 446629856 | ((invcond & 15) << 12) | m5(rd)
}

// ---------------------------------------------------------------------------
// System
// ---------------------------------------------------------------------------

// SVC #imm16 - supervisor call. macOS always uses #0x80, with the syscall
// number in x16. See src/runtime/io.tt.
fun enc_svc(imm16: u64) -> u64 {
    return 3556769793 | (m16(imm16) << 5)
}

// RET - returns to the address in x30. The register is explicit in the
// encoding (bits 9:5), even though the assembler omits it when it is x30.
fun enc_ret() -> u64 {
    return 3596551104 | (30 << 5)
}
