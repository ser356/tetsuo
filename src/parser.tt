// ============================================================================
// src/parser.tt - types, AST and syntactic analyzer
// ============================================================================
//
// Takes the tokens from the lexer and produces a *Program: lists of functions,
// constants, bss blocks, structs and string literals.
//
// THE PARSER DOES MORE THAN PARSE
//
// There is no separate semantic analysis stage. The parser also:
//
//   - resolves names to indices (a variable becomes a local number, see
//     add_local / lookup_local),
//   - propagates types upwards through the expressions, just enough to know
//     the width of every memory access,
//   - DESUGARS field access and indexing.
//
// That last point is the most important design decision of the file. `p.field`
// and `p[i]` do not reach the IR as such: parse_postfix turns them into
// pointer arithmetic with a DEREF on top, using the struct layout it already
// knows. Consequence: neither the lowering nor the backends know what a struct
// or a field is, and that is why both backends fit in so little code.
//
// STRUCT LAYOUT
//
// Deliberately trivial: EVERY field takes 8 bytes, whatever its type. Field i
// sits at offset i*8. That wastes memory in structs with u8 fields, but it
// removes alignment and padding computations, and it makes the offset of a
// field its index times 8.
//
// The exception is `str`, which takes 16 (two fields: ptr and len) and is
// desugared into two separate accesses.
//
// EXPRESSION GRAMMAR
//
// Pratt / precedence climbing (parse_expr with min_prec). The levels, from
// weakest to strongest:
//
//     1  == != < <= > >=      comparisons
//     2  |                    or
//     3  ^                    xor
//     4  &                    and
//     5  + - << >>            addition and shifts
//     6  * /                  product
//
// Having << and >> share a level with + - is unconventional (in C they bind
// more weakly), but it is consistent within the language and it is documented
// here so that nobody is surprised: `a + b << c` is `(a + b) << c`.
//
// There are no logical operators && or ||, no ternary, and no assignment as an
// expression. Hence the nested `if`s seen all over the tree.
//
// GLOBAL STATE
//
// The parser keeps its state in bss (LX_STATE, TOK_CUR, CUR_FUNC, CUR_PROG)
// instead of passing it as a parameter. It is ugly but deliberate: it saves a
// parameter in each of the dozens of mutually recursive grammar functions. The
// consequence is that only one file can be parsed at a time.
//
// LX_STATE in particular outlives the parser: the lowering and the backends
// read from it to recover the names, which are stored as ranges (start, len)
// inside the source buffer, never as copies. See the note in src/lexer.tt.
// ============================================================================

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

const T_U8: u64 = 0
const T_U32: u64 = 1
const T_U64: u64 = 2
const T_PTR: u64 = 3
const T_STR: u64 = 4
const T_STRUCT: u64 = 5
const T_I8: u64 = 6
const T_I32: u64 = 7
const T_I64: u64 = 8
const T_BOOL: u64 = 9
const T_ARRAY: u64 = 10

// A type. `inner` is only used by pointers (the pointee) and `decl` points at
// the StructDecl when kind is T_STRUCT.
//
// Types are NOT shared and NOT interned: every mention creates a fresh Type in
// the arena. Comparing two types by pointer identity does not work; the kind
// has to be inspected.
struct Type {
    kind:  u64,
    inner: *Type,
    decl:  *u8,
    arr_len: u64,
}

struct Field {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    offset:     u64,
    next:       *Field,
}

struct StructDecl {
    name_start: u64,
    name_len:   u64,
    fields:     *Field,
    nfields:    u64,
    size:       u64,
    align:      u64,
    next:       *StructDecl,
}

fun mk_prim(ar: *Arena, kind: u64) -> *Type {
    let t: *Type = arena_take(ar, sizeof(Type))
    t.kind = kind
    t.inner = nil
    t.decl = nil
    t.arr_len = 0
    return t
}

fun mk_ptr(ar: *Arena, inner: *Type) -> *Type {
    let t: *Type = arena_take(ar, sizeof(Type))
    t.kind = T_PTR
    t.inner = inner
    t.decl = nil
    t.arr_len = 0
    return t
}

fun mk_array(ar: *Arena, inner: *Type, n: u64) -> *Type {
    let t: *Type = arena_take(ar, sizeof(Type))
    t.kind = T_ARRAY
    t.inner = inner
    t.decl = nil
    t.arr_len = n
    return t
}

// Width in bytes. It decides which load or store instruction the backend emits
// (ldrb / ldr w / ldr x).
//
//   u8 -> 1, u32 -> 4, u64 and pointers -> 8
//   str -> 16, because they are two fields (ptr and len)
//   struct -> nfields * 8, from the 8-bytes-per-field layout
//
// The trailing 8 is the conservative case for an unknown type.
fun type_width(t: *Type) -> u64 {
    if t.kind == T_U8  { return 1 }
    if t.kind == T_U32 { return 4 }
    if t.kind == T_U64 { return 8 }
    if t.kind == T_I8  { return 1 }
    if t.kind == T_I32 { return 4 }
    if t.kind == T_I64 { return 8 }
    if t.kind == T_BOOL { return 1 }
    if t.kind == T_PTR { return 8 }
    if t.kind == T_STR { return 16 }
    if t.kind == T_ARRAY { return t.arr_len * type_width(t.inner) }
    if t.kind == T_STRUCT {
        let d: *StructDecl = t.decl
        if d != nil { return d.size }
    }
    return 8
}

fun type_is_signed(t: *Type) -> u64 {
    if t == nil { return 0 }
    if t.kind == T_I8 { return 1 }
    if t.kind == T_I32 { return 1 }
    if t.kind == T_I64 { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Expressions
//
// EX_EXTERN is the case of a name that is neither a local nor a constant: it
// is assumed to be a bss symbol and resolved in the backend, which is what
// allows writing `let p: *u8 = MY_BSS`.
// ---------------------------------------------------------------------------
const EX_INT:    u64 = 0
const EX_VAR:    u64 = 1
const EX_CALL:   u64 = 2
const EX_DEREF:  u64 = 3
const EX_BIN:    u64 = 4
const EX_EQ:     u64 = 5
const EX_NE:     u64 = 6
const EX_LT:     u64 = 7
const EX_LE:     u64 = 8
const EX_GT:     u64 = 9
const EX_GE:     u64 = 10
const EX_STRLIT: u64 = 11
const EX_ADDR:   u64 = 12
const EX_EXTERN: u64 = 13
const EX_CAST:   u64 = 14
const EX_LOGAND: u64 = 15
const EX_LOGOR:  u64 = 16

fun type_is_scalar(t: *Type) -> u64 {
    if t == nil { return 0 }
    if t.kind == T_U8 { return 1 }
    if t.kind == T_U32 { return 1 }
    if t.kind == T_U64 { return 1 }
    if t.kind == T_I8 { return 1 }
    if t.kind == T_I32 { return 1 }
    if t.kind == T_I64 { return 1 }
    if t.kind == T_BOOL { return 1 }
    if t.kind == T_PTR { return 1 }
    return 0
}

// Arithmetic and bitwise binary operators. Comparisons are not here: they are
// expression kinds of their own (EX_EQ, EX_LT, ...).
const OP_ADD: u64 = 0
const OP_SUB: u64 = 1
const OP_MUL: u64 = 2
const OP_DIV: u64 = 3
const OP_AND: u64 = 4
const OP_OR:  u64 = 5
const OP_XOR: u64 = 6
const OP_SHL: u64 = 7
const OP_SHR: u64 = 8
const OP_MOD: u64 = 9

// An expression node. As in the IR, a single struct with every possible field
// and no unions; which fields are valid depends on `kind`.
//
//   EX_INT     ival
//   EX_VAR     var_index (already resolved), var_start/var_len (original name)
//   EX_CALL    callee_start/callee_len, args, nargs
//   EX_DEREF   inner
//   EX_BIN     lhs, rhs, op
//   EX_EQ..GE  lhs, rhs
//   EX_STRLIT  str_bytes, str_len, str_id
//   EX_ADDR    inner
//   EX_EXTERN  var_start/var_len (name of a bss symbol)
//
// `type` is filled in by the parser on the way up, and it is what the lowering
// later uses to pick widths.
struct Expr {
    kind:         u64,
    type:         *Type,
    ival:         u64,
    var_start:    u64,
    var_len:      u64,
    inner:        *Expr,
    lhs:          *Expr,
    rhs:          *Expr,
    op:           u64,
    args:         **Expr,
    nargs:        u64,
    callee_start: u64,
    callee_len:   u64,
    str_bytes:    *u8,
    str_len:      u64,
    var_index:    u64,
    str_id:       u64,
    source_start: u64,
    source_len:   u64,
    is_volatile:  u64,
}

// Global parser state.
//
//   LX_STATE   the Lexer. It outlives the parser: the lowering and the
//              backends read the source buffer from here to resolve names.
//   TOK_CUR    the ONLY lookahead token. The grammar parses with one.
//   STR_*      string literal table (head, tail and counter), to assign
//              consecutive ids and to be able to walk them in order later.
bss LX_STATE: 32
bss TOK_CUR:  40
bss STR_HEAD: 8
bss STR_COUNT: 8
bss STR_TAIL: 8
bss SRC_ORIGIN_COUNT: 8
bss SRC_ORIGIN_PATHS: 524288
bss SRC_ORIGIN_LENS: 524288
bss SRC_ORIGIN_LINES: 524288
bss PARSER_RECOVER: 8
bss PARSER_FAILED: 8

fun source_origin_add(path: *u8, plen: u64, line: u64) {
    let cp: *u64 = SRC_ORIGIN_COUNT
    let n: u64 = cp[0]
    if n == 65536 {
        let m: str = 'demasiadas lineas expandidas'
        die_line(m.ptr, m.len, line)
    }
    let paths: **u8 = SRC_ORIGIN_PATHS
    let lens: *u64 = SRC_ORIGIN_LENS
    let lines: *u64 = SRC_ORIGIN_LINES
    paths[n] = path
    lens[n] = plen
    lines[n] = line
    cp[0] = n + 1
}

fun parser_failed() -> u64 {
    let failed: *u64 = PARSER_FAILED
    return failed[0]
}

fun parser_clear_failed() {
    let failed: *u64 = PARSER_FAILED
    failed[0] = 0
}

fun current_diagnostic_site(site: *DiagnosticSite) -> u64 {
    let t: *Tok = TOK_CUR
    let cp: *u64 = SRC_ORIGIN_COUNT
    if t.tline > 0 {
        if t.tline <= cp[0] {
            let paths: **u8 = SRC_ORIGIN_PATHS
            let lens: *u64 = SRC_ORIGIN_LENS
            let lines: *u64 = SRC_ORIGIN_LINES
            let i: u64 = t.tline - 1
            let lx: *Lexer = LX_STATE
            let begin: u64 = t.start
            while begin > 0 {
                if lx.src[begin - 1] == 10 { break }
                begin = begin - 1
            }
            let end: u64 = t.start
            while end < lx.len {
                if lx.src[end] == 10 { break }
                end = end + 1
            }
            site.path = paths[i]
            site.plen = lens[i]
            site.line = lines[i]
            site.col = t.start - begin + 1
            site.src = lx.src + begin
            site.slen = end - begin
            site.tok = lx.src + t.start
            site.tlen = t.tlen
            site.byte_start = t.start
            site.byte_len = t.tlen
            return 1
        }
    }
    return 0
}

// Fatal error at the position of the current token. Does not return.
fun die_here(msg: *u8, mlen: u64) {
    let t: *Tok = TOK_CUR
    let site: DiagnosticSite
    if current_diagnostic_site(&site) == 1 {
        let recover: *u64 = PARSER_RECOVER
        if recover[0] == 1 {
            diagnostics_add(msg, mlen, &site)
            let failed: *u64 = PARSER_FAILED
            failed[0] = 1
            return
        }
        die_source_line(msg, mlen, &site)
    }
    die_line(msg, mlen, t.tline)
}

struct StrLit {
    id:    u64,
    bytes: *u8,
    slen:  u64,
    next:  *StrLit,
}

struct Stmt {
    kind:        u64,
    name_start:  u64,
    name_len:    u64,
    type:        *Type,
    init:        *Expr,
    cond:        *Expr,
    body:        *Stmt,
    else_body:   *Stmt,
    ret_val:     *Expr,
    expr:        *Expr,
    next:        *Stmt,
    local_index: u64,
    is_volatile: u64,
}

struct Param {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    next:       *Param,
}

struct Local {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    active:     u64,
    initialized: u64,
}

struct Func {
    name_start: u64,
    name_len:   u64,
    params:     *Param,
    nparams:    u64,
    ret_type:   *Type,
    body:       *Stmt,
    next:       *Func,
    locals:     **Local,
    nlocals:    u64,
}

struct ConstItem {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    value:      u64,
    next:       *ConstItem,
}

struct BssItem {
    name_start: u64,
    name_len:   u64,
    size:       u64,
    next:       *BssItem,
}

// The result of parsing. Five lists and a counter, which is all the following
// stages need.
struct Program {
    funcs:   *Func,
    consts:  *ConstItem,
    bsses:   *BssItem,
    structs: *StructDecl,
    strs:    *StrLit,
    nstrs:   u64,
}

bss CUR_FUNC: 8
bss CUR_PROG: 8

fun cur_func_set(f: *Func) {
    let p: **Func = CUR_FUNC
    p[0] = f
}

fun cur_func() -> *Func {
    let p: **Func = CUR_FUNC
    return p[0]
}

fun cur_prog_set(p: *Program) {
    let q: **Program = CUR_PROG
    q[0] = p
}

fun cur_prog() -> *Program {
    let q: **Program = CUR_PROG
    return q[0]
}

// Compares two ranges of the source buffer. It is the basic operation behind
// every name lookup in the parser, since names are never copied.
fun bytes_eq_off(a_off: u64, a_len: u64, b_off: u64, b_len: u64) -> u32 {
    if a_len != b_len { return 0 }
    let lx: *Lexer = LX_STATE
    return bytes_eq(lx.src + a_off, lx.src + b_off, a_len)
}

// Declares a local and returns its index. Parameters are the first locals, in
// order, which makes the index of a parameter match its argument number.
fun add_local(ar: *Arena, f: *Func, ns: u64, nl: u64, ty: *Type) -> u64 {
    let idx: u64 = f.nlocals
    let loc: *Local = arena_take(ar, sizeof(Local))
    loc.name_start = ns
    loc.name_len = nl
    loc.type = ty
    loc.active = 1
    loc.initialized = 0
    let arr: **Local = f.locals
    arr[idx] = loc
    f.nlocals = idx + 1
    let extras: u64 = 0
    if ty != nil {
        if ty.kind == T_STR { extras = 1 }
        if ty.kind == T_ARRAY {
            let slots0: u64 = (type_width(ty) + 7) / 8
            if slots0 > 0 { extras = slots0 - 1 }
        }
        if ty.kind == T_STRUCT {
            let d: *StructDecl = ty.decl
            if d != nil {
                let slots: u64 = (d.size + 7) / 8
                if slots > 0 { extras = slots - 1 }
            }
        }
    }
    let k: u64 = 0
    while k < extras {
        let loc2: *Local = arena_take(ar, sizeof(Local))
        loc2.name_start = 0
        loc2.name_len = 0
        loc2.type = mk_prim(ar, T_U64)
        loc2.active = 1
        loc2.initialized = 0
        arr[f.nlocals] = loc2
        f.nlocals = f.nlocals + 1
        k = k + 1
    }
    return idx
}

// Looks a local up by name and returns its index, or something out of range if
// it does not exist.
//
// It walks BACKWARDS, from the last declared to the first. This is not a
// cosmetic detail: with two declarations of the same name (in different
// blocks, since there are no truly nested scopes) the most recent one has to
// win. Searching forwards returned the first one and was the cause of a SEGV
// in milestone 15.7 that took two sessions to find.
fun lookup_local(f: *Func, ns: u64, nl: u64) -> u64 {
    let n: u64 = f.nlocals
    let i: u64 = n
    while i > 0 {
        i = i - 1
        let arr: **Local = f.locals
        let loc: *Local = arr[i]
        if loc.active == 1 {
            if bytes_eq_off(loc.name_start, loc.name_len, ns, nl) == 1 { return i }
        }
    }
    return n
}

fun mark_local_initialized(f: *Func, idx: u64) {
    let arr: **Local = f.locals
    let loc: *Local = arr[idx]
    let slots: u64 = 1
    if loc.type != nil {
        let w: u64 = type_width(loc.type)
        if w > 8 { slots = w / 8 }
    }
    let i: u64 = 0
    while i < slots {
        let part: *Local = arr[idx + i]
        part.initialized = 1
        i = i + 1
    }
}

fun lookup_const(pg: *Program, ns: u64, nl: u64) -> *ConstItem {
    let c: *ConstItem = pg.consts
    while c != nil {
        if bytes_eq_off(c.name_start, c.name_len, ns, nl) == 1 { return c }
        c = c.next
    }
    return nil
}

fun lookup_bss(pg: *Program, ns: u64, nl: u64) -> *BssItem {
    let b: *BssItem = pg.bsses
    while b != nil {
        if bytes_eq_off(b.name_start, b.name_len, ns, nl) == 1 { return b }
        b = b.next
    }
    return nil
}

fun lookup_struct(pg: *Program, ns: u64, nl: u64) -> *StructDecl {
    let d: *StructDecl = pg.structs
    while d != nil {
        if bytes_eq_off(d.name_start, d.name_len, ns, nl) == 1 { return d }
        d = d.next
    }
    return nil
}

fun struct_field_index(d: *StructDecl, ns: u64, nl: u64) -> u64 {
    let i: u64 = 0
    let fd: *Field = d.fields
    while fd != nil {
        if bytes_eq_off(fd.name_start, fd.name_len, ns, nl) == 1 { return i }
        i = i + 1
        fd = fd.next
    }
    return d.nfields
}

fun struct_field_type(d: *StructDecl, idx: u64) -> *Type {
    let i: u64 = 0
    let fd: *Field = d.fields
    while fd != nil {
        if i == idx { return fd.type }
        i = i + 1
        fd = fd.next
    }
    return nil
}

fun struct_field_offset(d: *StructDecl, idx: u64) -> u64 {
    let i: u64 = 0
    let fd: *Field = d.fields
    while fd != nil {
        if i == idx { return fd.offset }
        i = i + 1
        fd = fd.next
    }
    return 0
}

fun str_table_init() {
    let h: **StrLit = STR_HEAD
    let c: *u64 = STR_COUNT
    let ta: **StrLit = STR_TAIL
    h[0] = nil
    c[0] = 0
    ta[0] = nil
}

// Registers a string literal and returns its id.
//
// The ids are consecutive and the list is kept in ORDER OF APPEARANCE (which
// is why there is a tail as well as a head). The order matters: the backends
// walk prog.strs to place the literals in memory and the layout has to be
// deterministic so that the fixpoint compares equal.
//
// Equal literals are not deduplicated. It costs a few bytes of __TEXT and
// saves one lookup per string in the program.
fun str_table_add(ar: *Arena, bytes: *u8, slen: u64) -> u64 {
    let c: *u64 = STR_COUNT
    let id: u64 = c[0]
    let s: *StrLit = arena_take(ar, sizeof(StrLit))
    s.id = id
    s.bytes = bytes
    s.slen = slen
    s.next = nil
    let h: **StrLit = STR_HEAD
    let ta: **StrLit = STR_TAIL
    if h[0] == nil {
        h[0] = s
        ta[0] = s
    } else {
        let t: *StrLit = ta[0]
        t.next = s
        ta[0] = s
    }
    c[0] = id + 1
    return id
}

// Translates the escapes of a literal and stores the resolved bytes.
//
// The lexer unescapes nothing (it only skips the character after a backslash
// so as not to close the string too early); here is where \n really becomes
// byte 10. `raw` includes the opening and closing quotes.
fun str_unescape(ar: *Arena, e: *Expr, raw: *u8, rawlen: u64) {
    let buf: *u8 = arena_take(ar, rawlen + 8)
    let i: u64 = 0
    let n: u64 = 0
    while i < rawlen {
        let c: u8 = raw[i]
        if c == 92 {
            i = i + 1
            let d: u8 = raw[i]
            let v: u64 = 0
            if d == 110 { v = 10 }
            if d == 116 { v = 9 }
            if d == 92  { v = 92 }
            if d == 39  { v = 39 }
            if d == 120 {
                let h1: u64 = hex_val(raw[i + 1])
                let h2: u64 = hex_val(raw[i + 2])
                v = h1 * 16 + h2
                i = i + 2
            }
            buf[n] = v
            i = i + 1
            n = n + 1
        } else {
            buf[n] = c
            i = i + 1
            n = n + 1
        }
    }
    e.str_bytes = buf
    e.str_len = n
}

fun ps_init(src: *u8, srclen: u64) {
    let lx: *Lexer = LX_STATE
    lex_init(lx, src, srclen)
    let t: *Tok = TOK_CUR
    lex_next(lx, t)
}

// Advances to the next token. Together with ps_kind these are the whole
// interface between parser and lexer; nobody else touches TOK_CUR except to
// read start/tlen.
fun ps_advance() {
    let lx: *Lexer = LX_STATE
    let t: *Tok = TOK_CUR
    lex_next(lx, t)
}

fun ps_kind() -> u32 {
    let t: *Tok = TOK_CUR
    return t.kind
}

fun mk_expr(ar: *Arena, kind: u64) -> *Expr {
    let e: *Expr = arena_take(ar, sizeof(Expr))
    e.kind = kind
    e.type = nil
    e.ival = 0
    e.var_start = 0
    e.var_len = 0
    e.inner = nil
    e.lhs = nil
    e.rhs = nil
    e.op = 0
    e.args = nil
    e.nargs = 0
    e.callee_start = 0
    e.callee_len = 0
    e.str_bytes = nil
    e.str_len = 0
    e.var_index = 0
    e.str_id = 0
    e.source_start = 0
    e.source_len = 0
    e.is_volatile = 0
    return e
}

// ---------------------------------------------------------------------------
// Expressions, from the inside out:
//
//   parse_primary  literals, names, calls, parentheses, sizeof, nil
//   parse_postfix  chains `.field` and `[index]` on top of the above
//   parse_unary    @ (deref) and & (address of)
//   parse_expr     binary operators by precedence
// ---------------------------------------------------------------------------

// A name can resolve to four things, and they are tried in this order:
// local -> constant -> bss (EX_EXTERN) -> error. That order is what defines
// scoping: a local shadows a constant of the same name.
fun parse_primary(ar: *Arena) -> *Expr {
    let t: *Tok = TOK_CUR
    let k: u32 = t.kind
    if k == TK_NUM {
        let e: *Expr = mk_expr(ar, EX_INT)
        e.source_start = t.start
        e.source_len = t.tlen
        e.ival = t.ival
        e.type = mk_prim(ar, T_U64)
        ps_advance()
        return e
    }
    if k == TK_NIL {
        let e: *Expr = mk_expr(ar, EX_INT)
        e.source_start = t.start
        e.source_len = t.tlen
        e.ival = 0
        e.type = mk_prim(ar, T_U64)
        ps_advance()
        return e
    }
    if k == TK_SIZEOF {
        let sizeof_start: u64 = t.start
        let sizeof_len: u64 = t.tlen
        ps_advance()
        ps_expect(TK_LPAREN)
        if parser_failed() == 1 { return nil }
        let ty: *Type = parse_type(ar)
        if ty == nil { return nil }
        ps_expect(TK_RPAREN)
        if parser_failed() == 1 { return nil }
        let e: *Expr = mk_expr(ar, EX_INT)
        e.source_start = sizeof_start
        e.source_len = sizeof_len
        e.ival = type_width(ty)
        e.type = mk_prim(ar, T_U64)
        return e
    }
    if k == TK_LPAREN {
        ps_advance()
        let e: *Expr = parse_expr(ar, 1)
        if e == nil { return nil }
        ps_expect(TK_RPAREN)
        if parser_failed() == 1 { return nil }
        return e
    }
    if k == TK_IDENT {
        let name_start: u64 = t.start
        let name_len:   u64 = t.tlen
        ps_advance()
        if ps_kind() == TK_LPAREN {
            ps_advance()
            let e: *Expr = mk_expr(ar, EX_CALL)
            e.source_start = name_start
            e.source_len = name_len
            e.callee_start = name_start
            e.callee_len   = name_len
            let av: Vec
            let first_arg: *u8 = arena_take(ar, 64)
            vec_init(&av, 8, first_arg, 8)
            let n: u64 = 0
            while ps_kind() != TK_RPAREN {
                let arg: *Expr = parse_expr(ar, 1)
                if arg == nil { return nil }
                let argp: *Expr = arg
                vec_push(ar, &av, &argp)
                n = n + 1
                if ps_kind() != TK_RPAREN { ps_expect(TK_COMMA) }
                if parser_failed() == 1 { return nil }
            }
            ps_expect(TK_RPAREN)
            if parser_failed() == 1 { return nil }
            e.args = av.data
            e.nargs = n
            let syskw: str = 'syscall'
            let sysck: str = 'syscall_checked'
            if bytes_eq_at(name_start, name_len, syskw.ptr, 7) == 1 {
                e.type = mk_prim(ar, T_U64)
            } else if bytes_eq_at(name_start, name_len, sysck.ptr, 15) == 1 {
                e.type = mk_prim(ar, T_U64)
            } else {
                e.type = mk_prim(ar, T_U32)
            }
            return e
        }
        let fn: *Func = cur_func()
        if fn != nil {
            let idx: u64 = lookup_local(fn, name_start, name_len)
            if idx < fn.nlocals {
                let e: *Expr = mk_expr(ar, EX_VAR)
                e.source_start = name_start
                e.source_len = name_len
                e.var_start = name_start
                e.var_len = name_len
                e.var_index = idx
                let arr: **Local = fn.locals
                let loc: *Local = arr[idx]
                e.type = loc.type
                return e
            }
        }
        let pg: *Program = cur_prog()
        if pg != nil {
            let ci: *ConstItem = lookup_const(pg, name_start, name_len)
            if ci != nil {
                let e: *Expr = mk_expr(ar, EX_INT)
                e.source_start = name_start
                e.source_len = name_len
                e.ival = ci.value
                e.type = ci.type
                return e
            }
            let bi: *BssItem = lookup_bss(pg, name_start, name_len)
            if bi != nil {
                let e: *Expr = mk_expr(ar, EX_EXTERN)
                e.source_start = name_start
                e.source_len = name_len
                e.callee_start = name_start
                e.callee_len = name_len
                e.type = mk_ptr(ar, mk_prim(ar, T_U8))
                return e
            }
        }
        let m96: str = 'identificador no resuelto'
        die_here(m96.ptr, m96.len)
        return nil
    }
    if k == TK_STRING {
        let t2: *Tok = TOK_CUR
        let lx: *Lexer = LX_STATE
        let e: *Expr = mk_expr(ar, EX_STRLIT)
        e.source_start = t2.start
        e.source_len = t2.tlen
        str_unescape(ar, e, lx.src + t2.start + 1, t2.tlen - 2)
        e.str_id = str_table_add(ar, e.str_bytes, e.str_len)
        e.type = mk_prim(ar, T_STR)
        ps_advance()
        return e
    }
    let m80: str = 'expresion primaria invalida'
    die_here(m80.ptr, m80.len)
    return nil
}

// Here is where the desugaring that keeps the rest of the compiler from
// knowing about structs happens.
//
//   p.field   ->  DEREF(ADD(p, field_index * 8))
//   p[i]      ->  DEREF(ADD(p, i * pointee_width))
//
// with the type of the result propagated so that the lowering emits the right
// width.
//
// The special case is `str`, which is not a struct but a pair: `s.ptr` and
// `s.len` become accesses to two consecutive locals, not pointer arithmetic.
// That is why a `str` takes two slots and type_width returns 16.
//
// The `while 1 == 1` loop chains postfixes, so that `a.b[i].c` works.
fun parse_postfix(ar: *Arena) -> *Expr {
    let e: *Expr = parse_primary(ar)
    if e == nil { return nil }
    while 1 == 1 {
        let k: u32 = ps_kind()
        if k == TK_DOT {
            ps_advance()
            if ps_kind() != TK_IDENT {
                let m91: str = 'se esperaba identificador tras .'
                die_here(m91.ptr, m91.len)
                return nil
            }
            let t: *Tok = TOK_CUR
            let fstart: u64 = t.start
            let flen: u64 = t.tlen
            ps_advance()
            let ty: *Type = e.type
            let handled: u64 = 0
            if ty != nil {
                if ty.kind == T_STR {
                    if e.kind == EX_VAR {
                        let ptrkw: str = 'ptr'
                        if bytes_eq_at(fstart, flen, ptrkw.ptr, 3) == 1 {
                            let fe: *Expr = mk_expr(ar, EX_VAR)
                            fe.source_start = e.source_start
                            fe.source_len = e.source_len
                            fe.var_index = e.var_index
                            fe.type = mk_ptr(ar, mk_prim(ar, T_U8))
                            e = fe
                            handled = 1
                        }
                        if handled == 0 {
                            let lenkw: str = 'len'
                            if bytes_eq_at(fstart, flen, lenkw.ptr, 3) == 1 {
                                let fe2: *Expr = mk_expr(ar, EX_VAR)
                                fe2.source_start = e.source_start
                                fe2.source_len = e.source_len
                                fe2.var_index = e.var_index + 1
                                fe2.type = mk_prim(ar, T_U64)
                                e = fe2
                                handled = 1
                            }
                        }
                    }
                }
                if handled == 0 {
                    if ty.kind == T_STRUCT {
                        let d: *StructDecl = ty.decl
                        if d != nil {
                            if e.kind == EX_VAR {
                                let fi: u64 = struct_field_index(d, fstart, flen)
                                if fi >= d.nfields {
                                    let m95a: str = 'campo desconocido en struct'
                                    die_here(m95a.ptr, m95a.len)
                                    return nil
                                }
                                let ft0: *Type = struct_field_type(d, fi)
                                let ae0: *Expr = mk_expr(ar, EX_ADDR)
                                ae0.inner = e
                                ae0.type = mk_ptr(ar, ty)
                                let oe0: *Expr = mk_expr(ar, EX_INT)
                                oe0.ival = struct_field_offset(d, fi)
                                oe0.type = mk_prim(ar, T_U64)
                                let pe0: *Expr = mk_expr(ar, EX_BIN)
                                pe0.op = OP_ADD
                                pe0.lhs = ae0
                                pe0.rhs = oe0
                                pe0.type = mk_ptr(ar, ft0)
                                let de0: *Expr = mk_expr(ar, EX_DEREF)
                                de0.inner = pe0
                                de0.type = ft0
                                de0.source_start = e.source_start
                                de0.source_len = e.source_len
                                e = de0
                                handled = 1
                            }
                            if handled == 0 {
                            if e.kind == EX_DEREF {
                                let fi0: u64 = struct_field_index(d, fstart, flen)
                                if fi0 >= d.nfields {
                                    let mf0: str = 'campo desconocido en struct'
                                    die_here(mf0.ptr, mf0.len)
                                    return nil
                                }
                                let ft1: *Type = struct_field_type(d, fi0)
                                let oe1: *Expr = mk_expr(ar, EX_INT)
                                oe1.ival = struct_field_offset(d, fi0)
                                oe1.type = mk_prim(ar, T_U64)
                                let pe1: *Expr = mk_expr(ar, EX_BIN)
                                pe1.op = OP_ADD
                                pe1.lhs = e.inner
                                pe1.rhs = oe1
                                pe1.type = mk_ptr(ar, ft1)
                                let de1: *Expr = mk_expr(ar, EX_DEREF)
                                de1.inner = pe1
                                de1.type = ft1
                                de1.source_start = e.source_start
                                de1.source_len = e.source_len
                                e = de1
                                handled = 1
                            }
                            }
                        }
                    }
                }
                if handled == 0 {
                    if ty.kind == T_PTR {
                        let it: *Type = ty.inner
                        if it != nil {
                            if it.kind == T_STRUCT {
                                let d2: *StructDecl = it.decl
                                if d2 != nil {
                                    let fi2: u64 = struct_field_index(d2, fstart, flen)
                                    if fi2 >= d2.nfields {
                                        let m95b: str = 'campo desconocido en struct'
                                        die_here(m95b.ptr, m95b.len)
                                        return nil
                                    }
                                    let ft: *Type = struct_field_type(d2, fi2)
                                    let off_e: *Expr = mk_expr(ar, EX_INT)
                                    off_e.ival = struct_field_offset(d2, fi2)
                                    off_e.type = mk_prim(ar, T_U64)
                                    let ptr_e: *Expr = mk_expr(ar, EX_BIN)
                                    ptr_e.op = OP_ADD
                                    ptr_e.lhs = e
                                    ptr_e.rhs = off_e
                                    ptr_e.type = mk_ptr(ar, ft)
                                    let d_e: *Expr = mk_expr(ar, EX_DEREF)
                                    d_e.inner = ptr_e
                                    d_e.type = ft
                                    e = d_e
                                    handled = 1
                                }
                            }
                        }
                    }
                }
            }
            if handled == 0 {
                let mh: str = 'postfix no soportado'
                die_here(mh.ptr, mh.len)
                return nil
            }
        } else {
            if k == TK_AS {
                ps_advance()
                let target: *Type = parse_type(ar)
                if target == nil { return nil }
                if type_is_scalar(e.type) == 0 {
                    let mc1: str = 'cast requiere origen escalar'
                    die_here(mc1.ptr, mc1.len)
                    return nil
                }
                if type_is_scalar(target) == 0 {
                    let mc2: str = 'cast requiere destino escalar'
                    die_here(mc2.ptr, mc2.len)
                    return nil
                }
                let ce: *Expr = mk_expr(ar, EX_CAST)
                ce.inner = e
                ce.type = target
                e = ce
            } else if k == TK_LBRACK {
                ps_advance()
                let idx: *Expr = parse_expr(ar, 1)
                if idx == nil { return nil }
                ps_expect(TK_RBRACK)
                if parser_failed() == 1 { return nil }
                let bty: *Type = e.type
                if bty == nil {
                    let mb1: str = 'deref sobre expresion sin tipo'
                    die_here(mb1.ptr, mb1.len)
                    return nil
                }
                if bty.kind == T_ARRAY {
                    if e.kind != EX_VAR {
                        let mba: str = 'indexacion de array requiere local'
                        die_here(mba.ptr, mba.len)
                        return nil
                    }
                    let ae: *Expr = mk_expr(ar, EX_ADDR)
                    ae.inner = e
                    ae.type = mk_ptr(ar, bty.inner)
                    e = ae
                    bty = ae.type
                }
                if bty.kind != T_PTR {
                    let mb2: str = 'deref sobre no-puntero'
                    die_here(mb2.ptr, mb2.len)
                    return nil
                }
                let sz: u64 = type_width(bty.inner)
                let scaled: *Expr = idx
                if sz != 1 {
                    let sz_e: *Expr = mk_expr(ar, EX_INT)
                    sz_e.ival = sz
                    sz_e.type = mk_prim(ar, T_U64)
                    let m: *Expr = mk_expr(ar, EX_BIN)
                    m.op = OP_MUL
                    m.lhs = idx
                    m.rhs = sz_e
                    m.type = mk_prim(ar, T_U64)
                    scaled = m
                }
                let ptr2: *Expr = mk_expr(ar, EX_BIN)
                ptr2.op = OP_ADD
                ptr2.lhs = e
                ptr2.rhs = scaled
                ptr2.type = bty
                let de: *Expr = mk_expr(ar, EX_DEREF)
                de.inner = ptr2
                de.type = bty.inner
                e = de
            } else {
                return e
            }
        }
    }
    return e
}

// Prefixes: `@e` dereferences and `&e` takes the address. They bind more
// tightly than any binary operator and more loosely than the postfixes, that
// is, `@p[0]` is `@(p[0])`.
fun parse_unary(ar: *Arena) -> *Expr {
    let k: u32 = ps_kind()
    if k == TK_BANG {
        ps_advance()
        let innerb: *Expr = parse_unary(ar)
        if innerb == nil { return nil }
        let zerob: *Expr = mk_expr(ar, EX_INT)
        zerob.ival = 0
        zerob.type = innerb.type
        let notb: *Expr = mk_expr(ar, EX_EQ)
        notb.lhs = innerb
        notb.rhs = zerob
        notb.type = mk_prim(ar, T_U32)
        return notb
    }
    if k == TK_MINUS {
        ps_advance()
        let inner0: *Expr = parse_unary(ar)
        if inner0 == nil { return nil }
        let zero: *Expr = mk_expr(ar, EX_INT)
        zero.ival = 0
        zero.type = inner0.type
        let neg: *Expr = mk_expr(ar, EX_BIN)
        neg.op = OP_SUB
        neg.lhs = zero
        neg.rhs = inner0
        neg.type = inner0.type
        return neg
    }
    if k == TK_AT {
        ps_advance()
        let inner: *Expr = parse_unary(ar)
        if inner == nil { return nil }
        let e: *Expr = mk_expr(ar, EX_DEREF)
        e.inner = inner
        e.is_volatile = 1
        let ity: *Type = inner.type
        if ity != nil {
            if ity.kind == T_PTR { e.type = ity.inner }
        }
        return e
    }
    if k == TK_AMP {
        ps_advance()
        let inner2: *Expr = parse_unary(ar)
        if inner2 == nil { return nil }
        if inner2.kind == EX_VAR {
            let fn: *Func = cur_func()
            if fn != nil { mark_local_initialized(fn, inner2.var_index) }
        }
        let e2: *Expr = mk_expr(ar, EX_ADDR)
        e2.inner = inner2
        e2.type = mk_ptr(ar, inner2.type)
        return e2
    }
    return parse_postfix(ar)
}

// Precedence of the binary operators. 0 means "not a binary operator" and ends
// the parse_expr loop.
//
// See the table in the header. Note: << and >> share a level with + and -.
fun bin_prec(k: u32) -> u64 {
    if k == TK_STAR   { return 8 }
    if k == TK_SLASH  { return 8 }
    if k == TK_PERCENT { return 8 }
    if k == TK_PLUS   { return 7 }
    if k == TK_MINUS  { return 7 }
    if k == TK_LSHIFT { return 7 }
    if k == TK_RSHIFT { return 7 }
    if k == TK_AMP    { return 6 }
    if k == TK_CARET  { return 5 }
    if k == TK_PIPE   { return 4 }
    if k == TK_EQEQ   { return 3 }
    if k == TK_BANGEQ { return 3 }
    if k == TK_LT     { return 3 }
    if k == TK_LE     { return 3 }
    if k == TK_GT     { return 3 }
    if k == TK_GE     { return 3 }
    if k == TK_ANDAND { return 2 }
    if k == TK_PIPEPIPE { return 1 }
    return 0
}

// Precedence climbing.
//
// It parses an operand and then, while the incoming operator binds at least as
// tightly as min_prec, consumes it and parses the right-hand side with
// `pr + 1`. That +1 is what makes every operator LEFT ASSOCIATIVE: with a bare
// `pr` they would be right associative.
//
// The type of the result is that of the left-hand side for the arithmetic
// operators, and u32 for the comparisons (which produce 0 or 1).
fun parse_expr(ar: *Arena, min_prec: u64) -> *Expr {
    let lhs: *Expr = parse_unary(ar)
    if lhs == nil { return nil }
    while bin_prec(ps_kind()) >= min_prec {
        let k: u32 = ps_kind()
        let pr: u64 = bin_prec(k)
        ps_advance()
        let rhs: *Expr = parse_expr(ar, pr + 1)
        if rhs == nil { return nil }
        let e: *Expr = mk_expr(ar, EX_BIN)
        if k == TK_STAR   { e.op = OP_MUL }
        if k == TK_SLASH  { e.op = OP_DIV }
        if k == TK_PERCENT { e.op = OP_MOD }
        if k == TK_PLUS   { e.op = OP_ADD }
        if k == TK_MINUS  { e.op = OP_SUB }
        if k == TK_AMP    { e.op = OP_AND }
        if k == TK_CARET  { e.op = OP_XOR }
        if k == TK_PIPE   { e.op = OP_OR }
        if k == TK_LSHIFT { e.op = OP_SHL }
        if k == TK_RSHIFT { e.op = OP_SHR }
        if k == TK_ANDAND { e.kind = EX_LOGAND }
        if k == TK_PIPEPIPE { e.kind = EX_LOGOR }
        if k == TK_EQEQ   { e.kind = EX_EQ }
        if k == TK_BANGEQ { e.kind = EX_NE }
        if k == TK_LT     { e.kind = EX_LT }
        if k == TK_LE     { e.kind = EX_LE }
        if k == TK_GT     { e.kind = EX_GT }
        if k == TK_GE     { e.kind = EX_GE }
        e.lhs = lhs
        e.rhs = rhs
        if e.kind == EX_BIN {
            e.type = lhs.type
        } else {
            e.type = mk_prim(ar, T_U32)
        }
        lhs = e
    }
    return lhs
}

// ---------------------------------------------------------------------------
// Statements
//
// ST_STORE and ST_ASSIGN are told apart by the destination: ST_ASSIGN writes
// to a variable (`x = e`) and ST_STORE to memory through a pointer (`@p = e`
// or `p[i] = e`).
// ---------------------------------------------------------------------------
const ST_LET:    u64 = 0
const ST_STORE:  u64 = 1
const ST_ASSIGN: u64 = 2
const ST_LOOP:   u64 = 3
const ST_WHILE:  u64 = 4
const ST_IF:     u64 = 5
const ST_BREAK:  u64 = 6
const ST_RETURN: u64 = 7
const ST_EXPR:   u64 = 8
const ST_CONTINUE: u64 = 9

fun mk_stmt(ar: *Arena, kind: u64) -> *Stmt {
    let s: *Stmt = arena_take(ar, sizeof(Stmt))
    s.kind = kind
    s.name_start = 0
    s.name_len = 0
    s.type = nil
    s.init = nil
    s.cond = nil
    s.body = nil
    s.else_body = nil
    s.ret_val = nil
    s.expr = nil
    s.next = nil
    s.local_index = 0
    s.is_volatile = 0
    return s
}

// Consumes a token of the expected kind or dies. `ps_accept` is the version
// that does not die: it consumes and returns 1 on a match, or leaves the token
// alone and returns 0.
fun ps_expect(k: u32) {
    if ps_kind() != k {
        let m81: str = 'se esperaba token'
        die_here(m81.ptr, m81.len)
        return
    }
    ps_advance()
}

fun ps_accept(k: u32) -> u32 {
    if ps_kind() == k { ps_advance(); return 1 }
    return 0
}

fun bytes_eq_at(src_off: u64, tlen: u64, kw: *u8, kwlen: u64) -> u32 {
    if tlen != kwlen { return 0 }
    let lx: *Lexer = LX_STATE
    return bytes_eq(lx.src + src_off, kw, kwlen)
}

// A type: u8, u32, u64, str, a struct name, or `*` followed by another type.
// Pointers nest to the left, so `**u8` is a pointer to a pointer to a byte.
fun parse_type(ar: *Arena) -> *Type {
    if ps_kind() == TK_LBRACK {
        ps_advance()
        let nt: *Tok = TOK_CUR
        if ps_kind() != TK_NUM {
            let ma2: str = 'array requiere longitud constante'
            die_here(ma2.ptr, ma2.len)
            return nil
        }
        let n: u64 = nt.ival
        if n == 0 {
            let ma3: str = 'array vacio no soportado'
            die_here(ma3.ptr, ma3.len)
            return nil
        }
        ps_advance()
        ps_expect(TK_RBRACK)
        if parser_failed() == 1 { return nil }
        let elem: *Type = parse_type(ar)
        if elem == nil { return nil }
        return mk_array(ar, elem, n)
    }
    if ps_kind() == TK_STAR {
        ps_advance()
        let inner: *Type = parse_type(ar)
        if inner == nil { return nil }
        return mk_ptr(ar, inner)
    }
    if ps_kind() != TK_IDENT {
        let m82: str = 'se esperaba tipo'
        die_here(m82.ptr, m82.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let u8kw:  str = 'u8'
    let u32kw: str = 'u32'
    let u64kw: str = 'u64'
    let i8kw:  str = 'i8'
    let i32kw: str = 'i32'
    let i64kw: str = 'i64'
    let boolkw: str = 'bool'
    let strkw: str = 'str'
    let result: *Type = nil
    if bytes_eq_at(t.start, t.tlen, u8kw.ptr, 2) == 1 { result = mk_prim(ar, T_U8) }
    if bytes_eq_at(t.start, t.tlen, u32kw.ptr, 3) == 1 { result = mk_prim(ar, T_U32) }
    if bytes_eq_at(t.start, t.tlen, u64kw.ptr, 3) == 1 { result = mk_prim(ar, T_U64) }
    if bytes_eq_at(t.start, t.tlen, i8kw.ptr, 2) == 1 { result = mk_prim(ar, T_I8) }
    if bytes_eq_at(t.start, t.tlen, i32kw.ptr, 3) == 1 { result = mk_prim(ar, T_I32) }
    if bytes_eq_at(t.start, t.tlen, i64kw.ptr, 3) == 1 { result = mk_prim(ar, T_I64) }
    if bytes_eq_at(t.start, t.tlen, boolkw.ptr, 4) == 1 { result = mk_prim(ar, T_BOOL) }
    if bytes_eq_at(t.start, t.tlen, strkw.ptr, 3) == 1 { result = mk_prim(ar, T_STR) }
    if result == nil {
        result = mk_prim(ar, T_STRUCT)
        let pg: *Program = cur_prog()
        if pg != nil {
            let d: *StructDecl = lookup_struct(pg, t.start, t.tlen)
            result.decl = d
        }
    }
    ps_advance()
    return result
}

fun ps_sync_stmt(failed_line: u64) {
    while ps_kind() != TK_EOF {
        if ps_kind() == TK_RBRACE { return }
        if ps_kind() == TK_SEMI { ps_advance()  return }
        let t: *Tok = TOK_CUR
        if t.tline > failed_line { return }
        ps_advance()
    }
}

fun parse_block(ar: *Arena) -> *Stmt {
    let fn: *Func = cur_func()
    let scope_start: u64 = 0
    if fn != nil { scope_start = fn.nlocals }
    let recover: *u64 = PARSER_RECOVER
    let previous_recover: u64 = recover[0]
    recover[0] = 1
    ps_expect(TK_LBRACE)
    if parser_failed() == 1 {
        parser_clear_failed()
        recover[0] = previous_recover
        return nil
    }
    let head: *Stmt = nil
    let tail: *Stmt = nil
    while ps_kind() != TK_RBRACE {
        if ps_kind() == TK_EOF { break }
        let current: *Tok = TOK_CUR
        let failed_line: u64 = current.tline
        let s: *Stmt = parse_stmt(ar)
        if parser_failed() == 1 {
            ps_sync_stmt(failed_line)
            parser_clear_failed()
            if diagnostics_count() == 20 { diagnostics_flush() }
        } else if s != nil {
            if head == nil { head = s } else { tail.next = s }
            tail = s
        }
        while ps_kind() == TK_SEMI { ps_advance() }
    }
    ps_expect(TK_RBRACE)
    if parser_failed() == 1 { parser_clear_failed() }
    recover[0] = previous_recover
    if fn != nil {
        let arr: **Local = fn.locals
        let i: u64 = scope_start
        while i < fn.nlocals {
            let loc: *Local = arr[i]
            loc.active = 0
            i = i + 1
        }
    }
    return head
}

fun require_initialized(e: *Expr) {
    if e == nil { return }
    if e.kind == EX_ADDR { return }
    if e.kind == EX_VAR {
        let fn: *Func = cur_func()
        let arr: **Local = fn.locals
        let loc: *Local = arr[e.var_index]
        if loc.initialized == 0 {
            let mu: str = 'lectura de local no inicializado'
            die_here(mu.ptr, mu.len)
            return
        }
        return
    }
    require_initialized(e.inner)
    require_initialized(e.lhs)
    require_initialized(e.rhs)
    if e.kind == EX_CALL {
        let args: **Expr = e.args
        let i: u64 = 0
        while i < e.nargs { require_initialized(args[i]); i = i + 1 }
    }
}

// A statement. There is no mandatory semicolon: the end of a statement is
// deduced from the grammar, which forces the decision to be made on the first
// token.
//
// The ambiguous case is an identifier at the start: it can be an assignment
// (`x = ...`), an indexed store (`p[i] = ...`) or a bare expression (a call).
// It is resolved by parsing the expression and checking whether an `=` follows.
fun parse_stmt(ar: *Arena) -> *Stmt {
    let k: u32 = ps_kind()
    if k == TK_LET {
        ps_advance()
        let t: *Tok = TOK_CUR
        if ps_kind() != TK_IDENT {
            let m83: str = 'let requiere identificador'
            die_here(m83.ptr, m83.len)
            return nil
        }
        let s: *Stmt = mk_stmt(ar, ST_LET)
        s.name_start = t.start
        s.name_len = t.tlen
        ps_advance()
        if ps_accept(TK_COLON) == 1 {
            s.type = parse_type(ar)
            if s.type == nil { return nil }
        }
        if ps_accept(TK_EQ) == 1 {
            if s.type != nil {
                if s.type.kind == T_ARRAY {
                    let ma4: str = 'inicializador de array no soportado'
                    die_here(ma4.ptr, ma4.len)
                    return nil
                }
            }
            s.init = parse_expr(ar, 1)
            if s.init == nil { return nil }
            require_initialized(s.init)
            if parser_failed() == 1 { return nil }
        }
        let fn: *Func = cur_func()
        if fn != nil {
            s.local_index = add_local(ar, fn, s.name_start, s.name_len, s.type)
            if s.init != nil {
                mark_local_initialized(fn, s.local_index)
            }
        }
        return s
    }
    if k == TK_RETURN {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_RETURN)
        if ps_kind() != TK_SEMI {
            if ps_kind() != TK_RBRACE {
                s.ret_val = parse_expr(ar, 1)
                if s.ret_val == nil { return nil }
                require_initialized(s.ret_val)
                if parser_failed() == 1 { return nil }
            }
        }
        return s
    }
    if k == TK_IF {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_IF)
        s.cond = parse_expr(ar, 1)
        if s.cond == nil { return nil }
        require_initialized(s.cond)
        if parser_failed() == 1 { return nil }
        s.body = parse_block(ar)
        if parser_failed() == 1 { return nil }
        if ps_kind() == TK_ELSE {
            ps_advance()
            if ps_kind() == TK_IF {
                s.else_body = parse_stmt(ar)
                if parser_failed() == 1 { return nil }
            } else {
                s.else_body = parse_block(ar)
                if parser_failed() == 1 { return nil }
            }
        }
        return s
    }
    if k == TK_WHILE {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_WHILE)
        s.cond = parse_expr(ar, 1)
        if s.cond == nil { return nil }
        require_initialized(s.cond)
        if parser_failed() == 1 { return nil }
        s.body = parse_block(ar)
        return s
    }
    if k == TK_LOOP {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_LOOP)
        s.body = parse_block(ar)
        return s
    }
    if k == TK_BREAK {
        ps_advance()
        return mk_stmt(ar, ST_BREAK)
    }
    if k == TK_CONTINUE {
        ps_advance()
        return mk_stmt(ar, ST_CONTINUE)
    }
    let e: *Expr = parse_expr(ar, 1)
    if e == nil { return nil }
    if ps_accept(TK_EQ) == 1 {
        if e.type != nil {
            if e.type.kind == T_ARRAY {
                let ma5: str = 'asignacion de array no soportada'
                die_here(ma5.ptr, ma5.len)
                return nil
            }
        }
        let rhs: *Expr = parse_expr(ar, 1)
        if rhs == nil { return nil }
        require_initialized(rhs)
        if parser_failed() == 1 { return nil }
        if e.kind == EX_DEREF {
            let s2: *Stmt = mk_stmt(ar, ST_STORE)
            s2.expr = e.inner
            s2.init = rhs
            s2.is_volatile = e.is_volatile
            return s2
        }
        let s: *Stmt = mk_stmt(ar, ST_ASSIGN)
        s.expr = e
        s.init = rhs
        if e.kind == EX_VAR {
            s.local_index = e.var_index
            let fn: *Func = cur_func()
            mark_local_initialized(fn, e.var_index)
        } else { require_initialized(e) }
        if parser_failed() == 1 { return nil }
        return s
    }
    require_initialized(e)
    if parser_failed() == 1 { return nil }
    let s: *Stmt = mk_stmt(ar, ST_EXPR)
    s.expr = e
    return s
}

fun mk_program(ar: *Arena) -> *Program {
    let p: *Program = arena_take(ar, sizeof(Program))
    p.funcs = nil
    p.consts = nil
    p.bsses = nil
    p.structs = nil
    p.strs = nil
    p.nstrs = 0
    return p
}

// Function declaration: name, parameters, optional return type after `->` and
// body.
//
// The parameters are registered as locals as they are parsed, so they are
// already visible inside the body and their index matches their position.
fun parse_fun(ar: *Arena) -> *Func {
    ps_expect(TK_FUN)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_IDENT {
        let m84: str = 'fun requiere identificador'
        die_here(m84.ptr, m84.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let f: *Func = arena_take(ar, sizeof(Func))
    f.name_start = t.start
    f.name_len = t.tlen
    f.params = nil
    f.nparams = 0
    f.ret_type = nil
    f.body = nil
    f.next = nil
    f.locals = arena_take(ar, 32768)
    f.nlocals = 0
    cur_func_set(f)
    ps_advance()
    ps_expect(TK_LPAREN)
    if parser_failed() == 1 { cur_func_set(nil)  return nil }
    let phead: *Param = nil
    let ptail: *Param = nil
    while ps_kind() != TK_RPAREN {
        if ps_kind() != TK_IDENT {
            let m85: str = 'parametro requiere identificador'
            die_here(m85.ptr, m85.len)
            cur_func_set(nil)
            return nil
        }
        let pt: *Tok = TOK_CUR
        let p: *Param = arena_take(ar, sizeof(Param))
        p.name_start = pt.start
        p.name_len = pt.tlen
        p.next = nil
        ps_advance()
        ps_expect(TK_COLON)
        if parser_failed() == 1 { cur_func_set(nil)  return nil }
        p.type = parse_type(ar)
        if p.type == nil { cur_func_set(nil)  return nil }
        if phead == nil { phead = p } else { ptail.next = p }
        ptail = p
        let pty: *Type = p.type
        if pty.kind == T_STR {
            f.nparams = f.nparams + 2
        } else {
            f.nparams = f.nparams + 1
        }
        let pidx: u64 = add_local(ar, f, p.name_start, p.name_len, p.type)
        mark_local_initialized(f, pidx)
        if ps_kind() != TK_RPAREN { ps_expect(TK_COMMA) }
        if parser_failed() == 1 { cur_func_set(nil)  return nil }
    }
    ps_expect(TK_RPAREN)
    if parser_failed() == 1 { cur_func_set(nil)  return nil }
    f.params = phead
    if ps_kind() == TK_ARROW {
        ps_advance()
        f.ret_type = parse_type(ar)
        if f.ret_type == nil { cur_func_set(nil)  return nil }
    }
    f.body = parse_block(ar)
    cur_func_set(nil)
    return f
}

fun parse_const_decl(ar: *Arena) -> *ConstItem {
    ps_expect(TK_CONST)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_IDENT {
        let m86a: str = 'const requiere identificador'
        die_here(m86a.ptr, m86a.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let c: *ConstItem = arena_take(ar, sizeof(ConstItem))
    c.name_start = t.start
    c.name_len = t.tlen
    c.next = nil
    ps_advance()
    ps_expect(TK_COLON)
    if parser_failed() == 1 { return nil }
    c.type = parse_type(ar)
    if c.type == nil { return nil }
    ps_expect(TK_EQ)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_NUM {
        let m86b: str = 'const requiere valor entero'
        die_here(m86b.ptr, m86b.len)
        return nil
    }
    let nt: *Tok = TOK_CUR
    c.value = nt.ival
    ps_advance()
    return c
}

// `bss NAME: size`. Reserves a block of zero-filled static memory.
//
// It is the only global storage in the language: there are no initialized
// global variables, because that would require a __data section with contents
// and here __DATA is always S_ZEROFILL.
//
// The declaration order determines the order in memory (see cgb_bss_layout in
// codegen_bytes.tt).
fun parse_bss_decl(ar: *Arena) -> *BssItem {
    ps_expect(TK_BSS)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_IDENT {
        let m87: str = 'bss requiere identificador'
        die_here(m87.ptr, m87.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let b: *BssItem = arena_take(ar, sizeof(BssItem))
    b.name_start = t.start
    b.name_len = t.tlen
    b.next = nil
    ps_advance()
    ps_expect(TK_COLON)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_NUM {
        let m88: str = 'bss requiere tamaño'
        die_here(m88.ptr, m88.len)
        return nil
    }
    let nt: *Tok = TOK_CUR
    b.size = nt.ival
    ps_advance()
    return b
}

// `struct Name { field: type, ... }`. Every field takes 8 bytes; see the note
// about the layout in the header.
fun parse_struct_decl(ar: *Arena) -> *StructDecl {
    ps_expect(TK_STRUCT)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_IDENT {
        let m89: str = 'struct requiere identificador'
        die_here(m89.ptr, m89.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let sd: *StructDecl = arena_take(ar, sizeof(StructDecl))
    sd.name_start = t.start
    sd.name_len = t.tlen
    sd.fields = nil
    sd.nfields = 0
    sd.size = 0
    sd.align = 1
    sd.next = nil
    ps_advance()
    let pg: *Program = cur_prog()
    if pg != nil {
        if pg.structs == nil {
            pg.structs = sd
        } else {
            let tail: *StructDecl = pg.structs
            while tail.next != nil { tail = tail.next }
            tail.next = sd
        }
    }
    ps_expect(TK_LBRACE)
    if parser_failed() == 1 { return nil }
    let fhead: *Field = nil
    let ftail: *Field = nil
    while ps_kind() != TK_RBRACE {
        if ps_kind() != TK_IDENT {
            let m90: str = 'campo requiere identificador'
            die_here(m90.ptr, m90.len)
            return nil
        }
        let ft: *Tok = TOK_CUR
        let fd: *Field = arena_take(ar, sizeof(Field))
        fd.name_start = ft.start
        fd.name_len = ft.tlen
        fd.offset = 0
        fd.next = nil
        ps_advance()
        ps_expect(TK_COLON)
        if parser_failed() == 1 { return nil }
        fd.type = parse_type(ar)
        if fd.type == nil { return nil }
        let field_align: u64 = type_width(fd.type)
        if field_align > 8 { field_align = 8 }
        if field_align > sd.align { sd.align = field_align }
        sd.size = ((sd.size + field_align - 1) / field_align) * field_align
        fd.offset = sd.size
        sd.size = sd.size + type_width(fd.type)
        if fhead == nil { fhead = fd } else { ftail.next = fd }
        ftail = fd
        sd.nfields = sd.nfields + 1
        sd.fields = fhead
        if ps_kind() == TK_COMMA { ps_advance() }
    }
    ps_expect(TK_RBRACE)
    if parser_failed() == 1 { return nil }
    sd.fields = fhead
    sd.size = ((sd.size + sd.align - 1) / sd.align) * sd.align
    return sd
}

fun resolve_call_types_expr(pg: *Program, e: *Expr) {
    if e == nil { return }
    if e.kind == EX_CALL {
        let syskw: str = 'syscall'
        let sysck: str = 'syscall_checked'
        if bytes_eq_at(e.callee_start, e.callee_len, syskw.ptr, 7) == 0 {
            if bytes_eq_at(e.callee_start, e.callee_len, sysck.ptr, 15) == 0 {
            let f: *Func = pg.funcs
            while f != nil {
                if bytes_eq_off(f.name_start, f.name_len, e.callee_start, e.callee_len) == 1 {
                    if f.ret_type != nil { e.type = f.ret_type }
                    break
                }
                f = f.next
            }
            }
        }
        let i: u64 = 0
        while i < e.nargs {
            let args: **Expr = e.args
            resolve_call_types_expr(pg, args[i])
            i = i + 1
        }
    }
    resolve_call_types_expr(pg, e.inner)
    resolve_call_types_expr(pg, e.lhs)
    resolve_call_types_expr(pg, e.rhs)
}

fun resolve_call_types_stmt(pg: *Program, s: *Stmt) {
    let it: *Stmt = s
    while it != nil {
        resolve_call_types_expr(pg, it.init)
        resolve_call_types_expr(pg, it.cond)
        resolve_call_types_expr(pg, it.ret_val)
        resolve_call_types_expr(pg, it.expr)
        resolve_call_types_stmt(pg, it.body)
        resolve_call_types_stmt(pg, it.else_body)
        it = it.next
    }
}

fun ps_is_top(k: u32) -> u64 {
    if k == TK_FUN { return 1 }
    if k == TK_CONST { return 1 }
    if k == TK_BSS { return 1 }
    if k == TK_STRUCT { return 1 }
    return 0
}

fun ps_sync_top() {
    while ps_kind() != TK_EOF {
        if ps_is_top(ps_kind()) == 1 { return }
        ps_advance()
    }
}

// Entry point: parses a whole file and returns the Program.
//
// At the top level only five things are possible: fun, const, bss, struct and
// the end of the file.
fun parse(ar: *Arena, src: *u8, srclen: u64) -> *Program {
    diagnostics_reset()
    parser_clear_failed()
    let recover: *u64 = PARSER_RECOVER
    recover[0] = 1
    ps_init(src, srclen)
    str_table_init()
    let p: *Program = mk_program(ar)
    cur_prog_set(p)
    let ftail: *Func = nil
    let ctail: *ConstItem = nil
    let btail: *BssItem = nil
    while ps_kind() != TK_EOF {
        while ps_kind() == TK_SEMI { ps_advance() }
        if ps_kind() == TK_EOF { break }
        let k: u32 = ps_kind()
        if k == TK_FUN {
            let f: *Func = parse_fun(ar)
            if parser_failed() == 0 {
                if p.funcs == nil { p.funcs = f } else { ftail.next = f }
                ftail = f
            }
        } else if k == TK_CONST {
            let c: *ConstItem = parse_const_decl(ar)
            if parser_failed() == 0 {
                if p.consts == nil { p.consts = c } else { ctail.next = c }
                ctail = c
            }
        } else if k == TK_BSS {
            let b: *BssItem = parse_bss_decl(ar)
            if parser_failed() == 0 {
                if p.bsses == nil { p.bsses = b } else { btail.next = b }
                btail = b
            }
        } else if k == TK_STRUCT {
            parse_struct_decl(ar)
        } else {
            let m97: str = 'declaracion superior invalida'
            die_here(m97.ptr, m97.len)
        }
        if parser_failed() == 1 {
            ps_sync_top()
            parser_clear_failed()
            cur_func_set(nil)
            if diagnostics_count() == 20 { diagnostics_flush() }
        }
    }
    let hh: **StrLit = STR_HEAD
    let cc: *u64 = STR_COUNT
    p.strs = hh[0]
    p.nstrs = cc[0]
    if diagnostics_count() > 0 { diagnostics_flush() }
    let rf: *Func = p.funcs
    while rf != nil {
        resolve_call_types_stmt(p, rf.body)
        rf = rf.next
    }
    return p
}
