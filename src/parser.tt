// ============================================================================
// src/parser.tt - tipos, AST y analizador sintactico
// ============================================================================
//
// Toma los tokens del lexer y produce un *Program: listas de funciones,
// constantes, bloques bss, structs y literales de cadena.
//
// EL PARSER HACE MAS QUE PARSEAR
//
// No hay una fase de analisis semantico separada. El parser tambien:
//
//   - resuelve nombres a indices (una variable pasa a ser un numero de local,
//     ver add_local / lookup_local),
//   - propaga tipos hacia arriba en las expresiones, lo justo para saber el
//     ancho de cada acceso a memoria,
//   - DESAZUCARA el acceso a campos y la indexacion.
//
// Ese ultimo punto es la decision de diseno mas importante del fichero.
// `p.campo` y `p[i]` no llegan al IR como tales: parse_postfix los convierte en
// aritmetica de punteros con un DEREF encima, usando el layout del struct que
// ya conoce. Consecuencia: ni el lowering ni los backends saben lo que es un
// struct ni un campo, y por eso los dos backends caben en tan poco codigo.
//
// LAYOUT DE STRUCTS
//
// Deliberadamente trivial: TODOS los campos ocupan 8 bytes, sea cual sea su
// tipo. El campo i esta en el offset i*8. Eso desperdicia memoria en structs
// con u8, pero elimina el calculo de alineacion y padding, y hace que el offset
// de un campo sea su indice por 8.
//
// La excepcion es `str`, que ocupa 16 (dos campos: ptr y len) y se desazucara
// en dos accesos separados.
//
// GRAMATICA DE EXPRESIONES
//
// Pratt / precedencia por escalada (parse_expr con min_prec). Los niveles, de
// menos a mas fuerte:
//
//     1  == != < <= > >=      comparaciones
//     2  |                    or
//     3  ^                    xor
//     4  &                    and
//     5  + - << >>            suma y desplazamientos
//     6  * /                  producto
//
// Que << y >> compartan nivel con + - es poco convencional (en C ligan mas
// flojo), pero es coherente dentro del lenguaje y se documenta aqui para que
// nadie se sorprenda: `a + b << c` es `(a + b) << c`.
//
// No hay operadores logicos && ni ||, ni ternario, ni asignacion como
// expresion. De ahi los `if` anidados que se ven por todo el arbol.
//
// ESTADO GLOBAL
//
// El parser guarda su estado en bss (LX_STATE, TOK_CUR, CUR_FUNC, CUR_PROG) en
// vez de pasarlo por parametro. Es feo pero deliberado: ahorra un parametro en
// cada una de las decenas de funciones mutuamente recursivas de la gramatica.
// La consecuencia es que solo se puede parsear un fichero a la vez.
//
// LX_STATE en concreto sobrevive al parser: el lowering y los backends leen de
// el para recuperar los nombres, que se guardan como rangos (start, len) dentro
// del buffer de fuente, nunca como copias. Ver la nota de src/lexer.tt.
// ============================================================================

// ---------------------------------------------------------------------------
// Tipos
// ---------------------------------------------------------------------------

const T_U8: u64 = 0
const T_U32: u64 = 1
const T_U64: u64 = 2
const T_PTR: u64 = 3
const T_STR: u64 = 4
const T_STRUCT: u64 = 5
const T_I8: u64 = 6
const T_I32: u64 = 7
const T_I64: u64 = 8
const T_BOOL: u64 = 9
const T_ARRAY: u64 = 10

// Un tipo. `inner` solo lo usan los punteros (el apuntado) y `decl` apunta al
// StructDecl cuando kind es T_STRUCT.
//
// Los tipos NO se comparten ni se internalizan: cada mencion crea un Type nuevo
// en el arena. Comparar dos tipos por identidad de puntero no funciona; hay que
// mirar el kind.
struct Type {
    kind:  u64,
    inner: *Type,
    decl:  *u8,
    arr_len: u64,
}

struct Field {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    offset:     u64,
    next:       *Field,
}

struct StructDecl {
    name_start: u64,
    name_len:   u64,
    fields:     *Field,
    nfields:    u64,
    size:       u64,
    align:      u64,
    next:       *StructDecl,
}

fun mk_prim(ar: *Arena, kind: u64) -> *Type {
    let t: *Type = arena_take(ar, sizeof(Type))
    t.kind = kind
    t.inner = nil
    t.decl = nil
    t.arr_len = 0
    return t
}

fun mk_ptr(ar: *Arena, inner: *Type) -> *Type {
    let t: *Type = arena_take(ar, sizeof(Type))
    t.kind = T_PTR
    t.inner = inner
    t.decl = nil
    t.arr_len = 0
    return t
}

fun mk_array(ar: *Arena, inner: *Type, n: u64) -> *Type {
    let t: *Type = arena_take(ar, sizeof(Type))
    t.kind = T_ARRAY
    t.inner = inner
    t.decl = nil
    t.arr_len = n
    return t
}

// Ancho en bytes. Decide que instruccion de carga o almacenamiento emite el
// backend (ldrb / ldr w / ldr x).
//
//   u8 -> 1, u32 -> 4, u64 y punteros -> 8
//   str -> 16, porque son dos campos (ptr y len)
//   struct -> nfields * 8, por el layout de 8 bytes por campo
//
// El 8 del final es el caso conservador para un tipo desconocido.
fun type_width(t: *Type) -> u64 {
    if t.kind == T_U8  { return 1 }
    if t.kind == T_U32 { return 4 }
    if t.kind == T_U64 { return 8 }
    if t.kind == T_I8  { return 1 }
    if t.kind == T_I32 { return 4 }
    if t.kind == T_I64 { return 8 }
    if t.kind == T_BOOL { return 1 }
    if t.kind == T_PTR { return 8 }
    if t.kind == T_STR { return 16 }
    if t.kind == T_ARRAY { return t.arr_len * type_width(t.inner) }
    if t.kind == T_STRUCT {
        let d: *StructDecl = t.decl
        if d != nil { return d.size }
    }
    return 8
}

fun type_is_signed(t: *Type) -> u64 {
    if t == nil { return 0 }
    if t.kind == T_I8 { return 1 }
    if t.kind == T_I32 { return 1 }
    if t.kind == T_I64 { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Expresiones
//
// EX_EXTERN es el caso de un nombre que no es ni local ni constante: se asume
// que es un simbolo bss y se resuelve en el backend, que es lo que permite
// escribir `let p: *u8 = MI_BSS`.
// ---------------------------------------------------------------------------
const EX_INT:    u64 = 0
const EX_VAR:    u64 = 1
const EX_CALL:   u64 = 2
const EX_DEREF:  u64 = 3
const EX_BIN:    u64 = 4
const EX_EQ:     u64 = 5
const EX_NE:     u64 = 6
const EX_LT:     u64 = 7
const EX_LE:     u64 = 8
const EX_GT:     u64 = 9
const EX_GE:     u64 = 10
const EX_STRLIT: u64 = 11
const EX_ADDR:   u64 = 12
const EX_EXTERN: u64 = 13
const EX_CAST:   u64 = 14
const EX_LOGAND: u64 = 15
const EX_LOGOR:  u64 = 16

fun type_is_scalar(t: *Type) -> u64 {
    if t == nil { return 0 }
    if t.kind == T_U8 { return 1 }
    if t.kind == T_U32 { return 1 }
    if t.kind == T_U64 { return 1 }
    if t.kind == T_I8 { return 1 }
    if t.kind == T_I32 { return 1 }
    if t.kind == T_I64 { return 1 }
    if t.kind == T_BOOL { return 1 }
    if t.kind == T_PTR { return 1 }
    return 0
}

// Operadores binarios aritmeticos y de bits. Las comparaciones no estan aqui:
// son kinds de expresion propios (EX_EQ, EX_LT, ...).
const OP_ADD: u64 = 0
const OP_SUB: u64 = 1
const OP_MUL: u64 = 2
const OP_DIV: u64 = 3
const OP_AND: u64 = 4
const OP_OR:  u64 = 5
const OP_XOR: u64 = 6
const OP_SHL: u64 = 7
const OP_SHR: u64 = 8
const OP_MOD: u64 = 9

// Un nodo de expresion. Como en el IR, un solo struct con todos los campos
// posibles y sin uniones; que campos valen depende de `kind`.
//
//   EX_INT     ival
//   EX_VAR     var_index (ya resuelto), var_start/var_len (nombre original)
//   EX_CALL    callee_start/callee_len, args, nargs
//   EX_DEREF   inner
//   EX_BIN     lhs, rhs, op
//   EX_EQ..GE  lhs, rhs
//   EX_STRLIT  str_bytes, str_len, str_id
//   EX_ADDR    inner
//   EX_EXTERN  var_start/var_len (nombre de un simbolo bss)
//
// `type` lo rellena el parser segun va subiendo, y es lo que luego usa el
// lowering para elegir anchos.
struct Expr {
    kind:         u64,
    type:         *Type,
    ival:         u64,
    var_start:    u64,
    var_len:      u64,
    inner:        *Expr,
    lhs:          *Expr,
    rhs:          *Expr,
    op:           u64,
    args:         **Expr,
    nargs:        u64,
    callee_start: u64,
    callee_len:   u64,
    str_bytes:    *u8,
    str_len:      u64,
    var_index:    u64,
    str_id:       u64,
    source_start: u64,
    source_len:   u64,
    is_volatile:  u64,
}

// Estado global del parser.
//
//   LX_STATE   el Lexer. Sobrevive al parser: el lowering y los backends leen
//              de aqui el buffer de fuente para resolver nombres.
//   TOK_CUR    UNICO token de anticipacion. La gramatica se parsea con uno.
//   STR_*      tabla de literales de cadena (cabeza, cola y contador), para
//              asignar ids consecutivos y poder recorrerlos luego en orden.
bss LX_STATE: 32
bss TOK_CUR:  40
bss STR_HEAD: 8
bss STR_COUNT: 8
bss STR_TAIL: 8
bss SRC_ORIGIN_COUNT: 8
bss SRC_ORIGIN_PATHS: 524288
bss SRC_ORIGIN_LENS: 524288
bss SRC_ORIGIN_LINES: 524288
bss PARSER_RECOVER: 8
bss PARSER_FAILED: 8

fun source_origin_add(path: *u8, plen: u64, line: u64) {
    let cp: *u64 = SRC_ORIGIN_COUNT
    let n: u64 = cp[0]
    if n == 65536 {
        let m: str = 'demasiadas lineas expandidas'
        die_line(m.ptr, m.len, line)
    }
    let paths: **u8 = SRC_ORIGIN_PATHS
    let lens: *u64 = SRC_ORIGIN_LENS
    let lines: *u64 = SRC_ORIGIN_LINES
    paths[n] = path
    lens[n] = plen
    lines[n] = line
    cp[0] = n + 1
}

fun parser_failed() -> u64 {
    let failed: *u64 = PARSER_FAILED
    return failed[0]
}

fun parser_clear_failed() {
    let failed: *u64 = PARSER_FAILED
    failed[0] = 0
}

fun current_diagnostic_site(site: *DiagnosticSite) -> u64 {
    let t: *Tok = TOK_CUR
    let cp: *u64 = SRC_ORIGIN_COUNT
    if t.tline > 0 {
        if t.tline <= cp[0] {
            let paths: **u8 = SRC_ORIGIN_PATHS
            let lens: *u64 = SRC_ORIGIN_LENS
            let lines: *u64 = SRC_ORIGIN_LINES
            let i: u64 = t.tline - 1
            let lx: *Lexer = LX_STATE
            let begin: u64 = t.start
            while begin > 0 {
                if lx.src[begin - 1] == 10 { break }
                begin = begin - 1
            }
            let end: u64 = t.start
            while end < lx.len {
                if lx.src[end] == 10 { break }
                end = end + 1
            }
            site.path = paths[i]
            site.plen = lens[i]
            site.line = lines[i]
            site.col = t.start - begin + 1
            site.src = lx.src + begin
            site.slen = end - begin
            site.tok = lx.src + t.start
            site.tlen = t.tlen
            site.byte_start = t.start
            site.byte_len = t.tlen
            return 1
        }
    }
    return 0
}

// Error fatal en la posicion del token actual. No retorna.
fun die_here(msg: *u8, mlen: u64) {
    let t: *Tok = TOK_CUR
    let site: DiagnosticSite
    if current_diagnostic_site(&site) == 1 {
        let recover: *u64 = PARSER_RECOVER
        if recover[0] == 1 {
            diagnostics_add(msg, mlen, &site)
            let failed: *u64 = PARSER_FAILED
            failed[0] = 1
            return
        }
        die_source_line(msg, mlen, &site)
    }
    die_line(msg, mlen, t.tline)
}

struct StrLit {
    id:    u64,
    bytes: *u8,
    slen:  u64,
    next:  *StrLit,
}

struct Stmt {
    kind:        u64,
    name_start:  u64,
    name_len:    u64,
    type:        *Type,
    init:        *Expr,
    cond:        *Expr,
    body:        *Stmt,
    else_body:   *Stmt,
    ret_val:     *Expr,
    expr:        *Expr,
    next:        *Stmt,
    local_index: u64,
    is_volatile: u64,
}

struct Param {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    next:       *Param,
}

struct Local {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    active:     u64,
    initialized: u64,
}

struct Func {
    name_start: u64,
    name_len:   u64,
    params:     *Param,
    nparams:    u64,
    ret_type:   *Type,
    body:       *Stmt,
    next:       *Func,
    locals:     **Local,
    nlocals:    u64,
}

struct ConstItem {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    value:      u64,
    next:       *ConstItem,
}

struct BssItem {
    name_start: u64,
    name_len:   u64,
    size:       u64,
    next:       *BssItem,
}

// El resultado del parseo. Cinco listas y un contador, que es todo lo que
// necesitan las fases siguientes.
struct Program {
    funcs:   *Func,
    consts:  *ConstItem,
    bsses:   *BssItem,
    structs: *StructDecl,
    strs:    *StrLit,
    nstrs:   u64,
}

bss CUR_FUNC: 8
bss CUR_PROG: 8

fun cur_func_set(f: *Func) {
    let p: **Func = CUR_FUNC
    p[0] = f
}

fun cur_func() -> *Func {
    let p: **Func = CUR_FUNC
    return p[0]
}

fun cur_prog_set(p: *Program) {
    let q: **Program = CUR_PROG
    q[0] = p
}

fun cur_prog() -> *Program {
    let q: **Program = CUR_PROG
    return q[0]
}

// Compara dos rangos del buffer de fuente. Es la operacion basica de todas las
// busquedas por nombre del parser, ya que los nombres nunca se copian.
fun bytes_eq_off(a_off: u64, a_len: u64, b_off: u64, b_len: u64) -> u32 {
    if a_len != b_len { return 0 }
    let lx: *Lexer = LX_STATE
    return bytes_eq(lx.src + a_off, lx.src + b_off, a_len)
}

// Declara un local y devuelve su indice. Los parametros son los primeros
// locales, en orden, lo que hace que el indice de un parametro coincida con su
// numero de argumento.
fun add_local(ar: *Arena, f: *Func, ns: u64, nl: u64, ty: *Type) -> u64 {
    let idx: u64 = f.nlocals
    let loc: *Local = arena_take(ar, sizeof(Local))
    loc.name_start = ns
    loc.name_len = nl
    loc.type = ty
    loc.active = 1
    loc.initialized = 0
    let arr: **Local = f.locals
    arr[idx] = loc
    f.nlocals = idx + 1
    let extras: u64 = 0
    if ty != nil {
        if ty.kind == T_STR { extras = 1 }
        if ty.kind == T_ARRAY {
            let slots0: u64 = (type_width(ty) + 7) / 8
            if slots0 > 0 { extras = slots0 - 1 }
        }
        if ty.kind == T_STRUCT {
            let d: *StructDecl = ty.decl
            if d != nil {
                let slots: u64 = (d.size + 7) / 8
                if slots > 0 { extras = slots - 1 }
            }
        }
    }
    let k: u64 = 0
    while k < extras {
        let loc2: *Local = arena_take(ar, sizeof(Local))
        loc2.name_start = 0
        loc2.name_len = 0
        loc2.type = mk_prim(ar, T_U64)
        loc2.active = 1
        loc2.initialized = 0
        arr[f.nlocals] = loc2
        f.nlocals = f.nlocals + 1
        k = k + 1
    }
    return idx
}

// Busca un local por nombre y devuelve su indice, o algo fuera de rango si no
// existe.
//
// Recorre HACIA ATRAS, del ultimo declarado al primero. No es un detalle
// estetico: con dos declaraciones del mismo nombre (en bloques distintos, ya
// que no hay ambitos anidados de verdad) hay que quedarse con la mas reciente.
// Buscar hacia delante devolvia la primera y fue la causa de un SEGV en el
// hito 15.7 que costo dos sesiones encontrar.
fun lookup_local(f: *Func, ns: u64, nl: u64) -> u64 {
    let n: u64 = f.nlocals
    let i: u64 = n
    while i > 0 {
        i = i - 1
        let arr: **Local = f.locals
        let loc: *Local = arr[i]
        if loc.active == 1 {
            if bytes_eq_off(loc.name_start, loc.name_len, ns, nl) == 1 { return i }
        }
    }
    return n
}

fun mark_local_initialized(f: *Func, idx: u64) {
    let arr: **Local = f.locals
    let loc: *Local = arr[idx]
    let slots: u64 = 1
    if loc.type != nil {
        let w: u64 = type_width(loc.type)
        if w > 8 { slots = w / 8 }
    }
    let i: u64 = 0
    while i < slots {
        let part: *Local = arr[idx + i]
        part.initialized = 1
        i = i + 1
    }
}

fun lookup_const(pg: *Program, ns: u64, nl: u64) -> *ConstItem {
    let c: *ConstItem = pg.consts
    while c != nil {
        if bytes_eq_off(c.name_start, c.name_len, ns, nl) == 1 { return c }
        c = c.next
    }
    return nil
}

fun lookup_bss(pg: *Program, ns: u64, nl: u64) -> *BssItem {
    let b: *BssItem = pg.bsses
    while b != nil {
        if bytes_eq_off(b.name_start, b.name_len, ns, nl) == 1 { return b }
        b = b.next
    }
    return nil
}

fun lookup_struct(pg: *Program, ns: u64, nl: u64) -> *StructDecl {
    let d: *StructDecl = pg.structs
    while d != nil {
        if bytes_eq_off(d.name_start, d.name_len, ns, nl) == 1 { return d }
        d = d.next
    }
    return nil
}

fun struct_field_index(d: *StructDecl, ns: u64, nl: u64) -> u64 {
    let i: u64 = 0
    let fd: *Field = d.fields
    while fd != nil {
        if bytes_eq_off(fd.name_start, fd.name_len, ns, nl) == 1 { return i }
        i = i + 1
        fd = fd.next
    }
    return d.nfields
}

fun struct_field_type(d: *StructDecl, idx: u64) -> *Type {
    let i: u64 = 0
    let fd: *Field = d.fields
    while fd != nil {
        if i == idx { return fd.type }
        i = i + 1
        fd = fd.next
    }
    return nil
}

fun struct_field_offset(d: *StructDecl, idx: u64) -> u64 {
    let i: u64 = 0
    let fd: *Field = d.fields
    while fd != nil {
        if i == idx { return fd.offset }
        i = i + 1
        fd = fd.next
    }
    return 0
}

fun str_table_init() {
    let h: **StrLit = STR_HEAD
    let c: *u64 = STR_COUNT
    let ta: **StrLit = STR_TAIL
    h[0] = nil
    c[0] = 0
    ta[0] = nil
}

// Registra un literal de cadena y devuelve su id.
//
// Los ids son consecutivos y la lista se mantiene en ORDEN DE APARICION (por
// eso hay tail ademas de head). El orden importa: los backends recorren
// prog.strs para colocar los literales en memoria y el layout tiene que ser
// determinista para que el fixpoint compare igual.
//
// No se deduplican literales iguales. Cuesta unos bytes de __TEXT y ahorra una
// busqueda por cada cadena del programa.
fun str_table_add(ar: *Arena, bytes: *u8, slen: u64) -> u64 {
    let c: *u64 = STR_COUNT
    let id: u64 = c[0]
    let s: *StrLit = arena_take(ar, sizeof(StrLit))
    s.id = id
    s.bytes = bytes
    s.slen = slen
    s.next = nil
    let h: **StrLit = STR_HEAD
    let ta: **StrLit = STR_TAIL
    if h[0] == nil {
        h[0] = s
        ta[0] = s
    } else {
        let t: *StrLit = ta[0]
        t.next = s
        ta[0] = s
    }
    c[0] = id + 1
    return id
}

// Traduce los escapes de un literal y guarda los bytes ya resueltos.
//
// El lexer no desescapa nada (solo se salta el caracter siguiente a una barra
// para no cerrar la cadena antes de tiempo); aqui es donde \n se convierte de
// verdad en el byte 10. `raw` incluye las comillas de apertura y cierre.
fun str_unescape(ar: *Arena, e: *Expr, raw: *u8, rawlen: u64) {
    let buf: *u8 = arena_take(ar, rawlen + 8)
    let i: u64 = 0
    let n: u64 = 0
    while i < rawlen {
        let c: u8 = raw[i]
        if c == 92 {
            i = i + 1
            let d: u8 = raw[i]
            let v: u64 = 0
            if d == 110 { v = 10 }
            if d == 116 { v = 9 }
            if d == 92  { v = 92 }
            if d == 39  { v = 39 }
            if d == 120 {
                let h1: u64 = hex_val(raw[i + 1])
                let h2: u64 = hex_val(raw[i + 2])
                v = h1 * 16 + h2
                i = i + 2
            }
            buf[n] = v
            i = i + 1
            n = n + 1
        } else {
            buf[n] = c
            i = i + 1
            n = n + 1
        }
    }
    e.str_bytes = buf
    e.str_len = n
}

fun ps_init(src: *u8, srclen: u64) {
    let lx: *Lexer = LX_STATE
    lex_init(lx, src, srclen)
    let t: *Tok = TOK_CUR
    lex_next(lx, t)
}

// Avanza al siguiente token. Junto con ps_kind son toda la interfaz del parser
// con el lexer; nadie mas toca TOK_CUR salvo para leer start/tlen.
fun ps_advance() {
    let lx: *Lexer = LX_STATE
    let t: *Tok = TOK_CUR
    lex_next(lx, t)
}

fun ps_kind() -> u32 {
    let t: *Tok = TOK_CUR
    return t.kind
}

fun mk_expr(ar: *Arena, kind: u64) -> *Expr {
    let e: *Expr = arena_take(ar, sizeof(Expr))
    e.kind = kind
    e.type = nil
    e.ival = 0
    e.var_start = 0
    e.var_len = 0
    e.inner = nil
    e.lhs = nil
    e.rhs = nil
    e.op = 0
    e.args = nil
    e.nargs = 0
    e.callee_start = 0
    e.callee_len = 0
    e.str_bytes = nil
    e.str_len = 0
    e.var_index = 0
    e.str_id = 0
    e.source_start = 0
    e.source_len = 0
    e.is_volatile = 0
    return e
}

// ---------------------------------------------------------------------------
// Expresiones, de dentro afuera:
//
//   parse_primary  literales, nombres, llamadas, parentesis, sizeof, nil
//   parse_postfix  encadena `.campo` y `[indice]` sobre lo anterior
//   parse_unary    @ (deref) y & (direccion)
//   parse_expr     operadores binarios por precedencia
// ---------------------------------------------------------------------------

// Un nombre puede resolverse a cuatro cosas, y se prueban en este orden:
// local -> constante -> bss (EX_EXTERN) -> error. Ese orden es el que da el
// ambito: un local tapa a una constante del mismo nombre.
fun parse_primary(ar: *Arena) -> *Expr {
    let t: *Tok = TOK_CUR
    let k: u32 = t.kind
    if k == TK_NUM {
        let e: *Expr = mk_expr(ar, EX_INT)
        e.source_start = t.start
        e.source_len = t.tlen
        e.ival = t.ival
        e.type = mk_prim(ar, T_U64)
        ps_advance()
        return e
    }
    if k == TK_NIL {
        let e: *Expr = mk_expr(ar, EX_INT)
        e.source_start = t.start
        e.source_len = t.tlen
        e.ival = 0
        e.type = mk_prim(ar, T_U64)
        ps_advance()
        return e
    }
    if k == TK_SIZEOF {
        let sizeof_start: u64 = t.start
        let sizeof_len: u64 = t.tlen
        ps_advance()
        ps_expect(TK_LPAREN)
        if parser_failed() == 1 { return nil }
        let ty: *Type = parse_type(ar)
        if ty == nil { return nil }
        ps_expect(TK_RPAREN)
        if parser_failed() == 1 { return nil }
        let e: *Expr = mk_expr(ar, EX_INT)
        e.source_start = sizeof_start
        e.source_len = sizeof_len
        e.ival = type_width(ty)
        e.type = mk_prim(ar, T_U64)
        return e
    }
    if k == TK_LPAREN {
        ps_advance()
        let e: *Expr = parse_expr(ar, 1)
        if e == nil { return nil }
        ps_expect(TK_RPAREN)
        if parser_failed() == 1 { return nil }
        return e
    }
    if k == TK_IDENT {
        let name_start: u64 = t.start
        let name_len:   u64 = t.tlen
        ps_advance()
        if ps_kind() == TK_LPAREN {
            ps_advance()
            let e: *Expr = mk_expr(ar, EX_CALL)
            e.source_start = name_start
            e.source_len = name_len
            e.callee_start = name_start
            e.callee_len   = name_len
            let av: Vec
            let first_arg: *u8 = arena_take(ar, 64)
            vec_init(&av, 8, first_arg, 8)
            let n: u64 = 0
            while ps_kind() != TK_RPAREN {
                let arg: *Expr = parse_expr(ar, 1)
                if arg == nil { return nil }
                let argp: *Expr = arg
                vec_push(ar, &av, &argp)
                n = n + 1
                if ps_kind() != TK_RPAREN { ps_expect(TK_COMMA) }
                if parser_failed() == 1 { return nil }
            }
            ps_expect(TK_RPAREN)
            if parser_failed() == 1 { return nil }
            e.args = av.data
            e.nargs = n
            let syskw: str = 'syscall'
            let sysck: str = 'syscall_checked'
            if bytes_eq_at(name_start, name_len, syskw.ptr, 7) == 1 {
                e.type = mk_prim(ar, T_U64)
            } else if bytes_eq_at(name_start, name_len, sysck.ptr, 15) == 1 {
                e.type = mk_prim(ar, T_U64)
            } else {
                e.type = mk_prim(ar, T_U32)
            }
            return e
        }
        let fn: *Func = cur_func()
        if fn != nil {
            let idx: u64 = lookup_local(fn, name_start, name_len)
            if idx < fn.nlocals {
                let e: *Expr = mk_expr(ar, EX_VAR)
                e.source_start = name_start
                e.source_len = name_len
                e.var_start = name_start
                e.var_len = name_len
                e.var_index = idx
                let arr: **Local = fn.locals
                let loc: *Local = arr[idx]
                e.type = loc.type
                return e
            }
        }
        let pg: *Program = cur_prog()
        if pg != nil {
            let ci: *ConstItem = lookup_const(pg, name_start, name_len)
            if ci != nil {
                let e: *Expr = mk_expr(ar, EX_INT)
                e.source_start = name_start
                e.source_len = name_len
                e.ival = ci.value
                e.type = ci.type
                return e
            }
            let bi: *BssItem = lookup_bss(pg, name_start, name_len)
            if bi != nil {
                let e: *Expr = mk_expr(ar, EX_EXTERN)
                e.source_start = name_start
                e.source_len = name_len
                e.callee_start = name_start
                e.callee_len = name_len
                e.type = mk_ptr(ar, mk_prim(ar, T_U8))
                return e
            }
        }
        let m96: str = 'identificador no resuelto'
        die_here(m96.ptr, m96.len)
        return nil
    }
    if k == TK_STRING {
        let t2: *Tok = TOK_CUR
        let lx: *Lexer = LX_STATE
        let e: *Expr = mk_expr(ar, EX_STRLIT)
        e.source_start = t2.start
        e.source_len = t2.tlen
        str_unescape(ar, e, lx.src + t2.start + 1, t2.tlen - 2)
        e.str_id = str_table_add(ar, e.str_bytes, e.str_len)
        e.type = mk_prim(ar, T_STR)
        ps_advance()
        return e
    }
    let m80: str = 'expresion primaria invalida'
    die_here(m80.ptr, m80.len)
    return nil
}

// Aqui ocurre el desazucarado que evita que el resto del compilador conozca los
// structs.
//
//   p.campo   ->  DEREF(ADD(p, indice_del_campo * 8))
//   p[i]      ->  DEREF(ADD(p, i * ancho_del_apuntado))
//
// con el tipo del resultado propagado para que el lowering emita el ancho
// correcto.
//
// El caso especial es `str`, que no es un struct sino un par: `s.ptr` y `s.len`
// se convierten en accesos a dos locales consecutivos, no en aritmetica de
// punteros. Por eso un `str` ocupa dos huecos y type_width devuelve 16.
//
// El bucle `while 1 == 1` encadena postfijos, de modo que `a.b[i].c` funciona.
fun parse_postfix(ar: *Arena) -> *Expr {
    let e: *Expr = parse_primary(ar)
    if e == nil { return nil }
    while 1 == 1 {
        let k: u32 = ps_kind()
        if k == TK_DOT {
            ps_advance()
            if ps_kind() != TK_IDENT {
                let m91: str = 'se esperaba identificador tras .'
                die_here(m91.ptr, m91.len)
                return nil
            }
            let t: *Tok = TOK_CUR
            let fstart: u64 = t.start
            let flen: u64 = t.tlen
            ps_advance()
            let ty: *Type = e.type
            let handled: u64 = 0
            if ty != nil {
                if ty.kind == T_STR {
                    if e.kind == EX_VAR {
                        let ptrkw: str = 'ptr'
                        if bytes_eq_at(fstart, flen, ptrkw.ptr, 3) == 1 {
                            let fe: *Expr = mk_expr(ar, EX_VAR)
                            fe.source_start = e.source_start
                            fe.source_len = e.source_len
                            fe.var_index = e.var_index
                            fe.type = mk_ptr(ar, mk_prim(ar, T_U8))
                            e = fe
                            handled = 1
                        }
                        if handled == 0 {
                            let lenkw: str = 'len'
                            if bytes_eq_at(fstart, flen, lenkw.ptr, 3) == 1 {
                                let fe2: *Expr = mk_expr(ar, EX_VAR)
                                fe2.source_start = e.source_start
                                fe2.source_len = e.source_len
                                fe2.var_index = e.var_index + 1
                                fe2.type = mk_prim(ar, T_U64)
                                e = fe2
                                handled = 1
                            }
                        }
                    }
                }
                if handled == 0 {
                    if ty.kind == T_STRUCT {
                        let d: *StructDecl = ty.decl
                        if d != nil {
                            if e.kind == EX_VAR {
                                let fi: u64 = struct_field_index(d, fstart, flen)
                                if fi >= d.nfields {
                                    let m95a: str = 'campo desconocido en struct'
                                    die_here(m95a.ptr, m95a.len)
                                    return nil
                                }
                                let ft0: *Type = struct_field_type(d, fi)
                                let ae0: *Expr = mk_expr(ar, EX_ADDR)
                                ae0.inner = e
                                ae0.type = mk_ptr(ar, ty)
                                let oe0: *Expr = mk_expr(ar, EX_INT)
                                oe0.ival = struct_field_offset(d, fi)
                                oe0.type = mk_prim(ar, T_U64)
                                let pe0: *Expr = mk_expr(ar, EX_BIN)
                                pe0.op = OP_ADD
                                pe0.lhs = ae0
                                pe0.rhs = oe0
                                pe0.type = mk_ptr(ar, ft0)
                                let de0: *Expr = mk_expr(ar, EX_DEREF)
                                de0.inner = pe0
                                de0.type = ft0
                                de0.source_start = e.source_start
                                de0.source_len = e.source_len
                                e = de0
                                handled = 1
                            }
                            if handled == 0 {
                            if e.kind == EX_DEREF {
                                let fi0: u64 = struct_field_index(d, fstart, flen)
                                if fi0 >= d.nfields {
                                    let mf0: str = 'campo desconocido en struct'
                                    die_here(mf0.ptr, mf0.len)
                                    return nil
                                }
                                let ft1: *Type = struct_field_type(d, fi0)
                                let oe1: *Expr = mk_expr(ar, EX_INT)
                                oe1.ival = struct_field_offset(d, fi0)
                                oe1.type = mk_prim(ar, T_U64)
                                let pe1: *Expr = mk_expr(ar, EX_BIN)
                                pe1.op = OP_ADD
                                pe1.lhs = e.inner
                                pe1.rhs = oe1
                                pe1.type = mk_ptr(ar, ft1)
                                let de1: *Expr = mk_expr(ar, EX_DEREF)
                                de1.inner = pe1
                                de1.type = ft1
                                de1.source_start = e.source_start
                                de1.source_len = e.source_len
                                e = de1
                                handled = 1
                            }
                            }
                        }
                    }
                }
                if handled == 0 {
                    if ty.kind == T_PTR {
                        let it: *Type = ty.inner
                        if it != nil {
                            if it.kind == T_STRUCT {
                                let d2: *StructDecl = it.decl
                                if d2 != nil {
                                    let fi2: u64 = struct_field_index(d2, fstart, flen)
                                    if fi2 >= d2.nfields {
                                        let m95b: str = 'campo desconocido en struct'
                                        die_here(m95b.ptr, m95b.len)
                                        return nil
                                    }
                                    let ft: *Type = struct_field_type(d2, fi2)
                                    let off_e: *Expr = mk_expr(ar, EX_INT)
                                    off_e.ival = struct_field_offset(d2, fi2)
                                    off_e.type = mk_prim(ar, T_U64)
                                    let ptr_e: *Expr = mk_expr(ar, EX_BIN)
                                    ptr_e.op = OP_ADD
                                    ptr_e.lhs = e
                                    ptr_e.rhs = off_e
                                    ptr_e.type = mk_ptr(ar, ft)
                                    let d_e: *Expr = mk_expr(ar, EX_DEREF)
                                    d_e.inner = ptr_e
                                    d_e.type = ft
                                    e = d_e
                                    handled = 1
                                }
                            }
                        }
                    }
                }
            }
            if handled == 0 {
                let mh: str = 'postfix no soportado'
                die_here(mh.ptr, mh.len)
                return nil
            }
        } else {
            if k == TK_AS {
                ps_advance()
                let target: *Type = parse_type(ar)
                if target == nil { return nil }
                if type_is_scalar(e.type) == 0 {
                    let mc1: str = 'cast requiere origen escalar'
                    die_here(mc1.ptr, mc1.len)
                    return nil
                }
                if type_is_scalar(target) == 0 {
                    let mc2: str = 'cast requiere destino escalar'
                    die_here(mc2.ptr, mc2.len)
                    return nil
                }
                let ce: *Expr = mk_expr(ar, EX_CAST)
                ce.inner = e
                ce.type = target
                e = ce
            } else if k == TK_LBRACK {
                ps_advance()
                let idx: *Expr = parse_expr(ar, 1)
                if idx == nil { return nil }
                ps_expect(TK_RBRACK)
                if parser_failed() == 1 { return nil }
                let bty: *Type = e.type
                if bty == nil {
                    let mb1: str = 'deref sobre expresion sin tipo'
                    die_here(mb1.ptr, mb1.len)
                    return nil
                }
                if bty.kind == T_ARRAY {
                    if e.kind != EX_VAR {
                        let mba: str = 'indexacion de array requiere local'
                        die_here(mba.ptr, mba.len)
                        return nil
                    }
                    let ae: *Expr = mk_expr(ar, EX_ADDR)
                    ae.inner = e
                    ae.type = mk_ptr(ar, bty.inner)
                    e = ae
                    bty = ae.type
                }
                if bty.kind != T_PTR {
                    let mb2: str = 'deref sobre no-puntero'
                    die_here(mb2.ptr, mb2.len)
                    return nil
                }
                let sz: u64 = type_width(bty.inner)
                let scaled: *Expr = idx
                if sz != 1 {
                    let sz_e: *Expr = mk_expr(ar, EX_INT)
                    sz_e.ival = sz
                    sz_e.type = mk_prim(ar, T_U64)
                    let m: *Expr = mk_expr(ar, EX_BIN)
                    m.op = OP_MUL
                    m.lhs = idx
                    m.rhs = sz_e
                    m.type = mk_prim(ar, T_U64)
                    scaled = m
                }
                let ptr2: *Expr = mk_expr(ar, EX_BIN)
                ptr2.op = OP_ADD
                ptr2.lhs = e
                ptr2.rhs = scaled
                ptr2.type = bty
                let de: *Expr = mk_expr(ar, EX_DEREF)
                de.inner = ptr2
                de.type = bty.inner
                e = de
            } else {
                return e
            }
        }
    }
    return e
}

// Prefijos: `@e` desreferencia y `&e` toma la direccion. Ligan mas fuerte que
// cualquier binario y mas flojo que los postfijos, o sea que `@p[0]` es
// `@(p[0])`.
fun parse_unary(ar: *Arena) -> *Expr {
    let k: u32 = ps_kind()
    if k == TK_BANG {
        ps_advance()
        let innerb: *Expr = parse_unary(ar)
        if innerb == nil { return nil }
        let zerob: *Expr = mk_expr(ar, EX_INT)
        zerob.ival = 0
        zerob.type = innerb.type
        let notb: *Expr = mk_expr(ar, EX_EQ)
        notb.lhs = innerb
        notb.rhs = zerob
        notb.type = mk_prim(ar, T_U32)
        return notb
    }
    if k == TK_MINUS {
        ps_advance()
        let inner0: *Expr = parse_unary(ar)
        if inner0 == nil { return nil }
        let zero: *Expr = mk_expr(ar, EX_INT)
        zero.ival = 0
        zero.type = inner0.type
        let neg: *Expr = mk_expr(ar, EX_BIN)
        neg.op = OP_SUB
        neg.lhs = zero
        neg.rhs = inner0
        neg.type = inner0.type
        return neg
    }
    if k == TK_AT {
        ps_advance()
        let inner: *Expr = parse_unary(ar)
        if inner == nil { return nil }
        let e: *Expr = mk_expr(ar, EX_DEREF)
        e.inner = inner
        e.is_volatile = 1
        let ity: *Type = inner.type
        if ity != nil {
            if ity.kind == T_PTR { e.type = ity.inner }
        }
        return e
    }
    if k == TK_AMP {
        ps_advance()
        let inner2: *Expr = parse_unary(ar)
        if inner2 == nil { return nil }
        if inner2.kind == EX_VAR {
            let fn: *Func = cur_func()
            if fn != nil { mark_local_initialized(fn, inner2.var_index) }
        }
        let e2: *Expr = mk_expr(ar, EX_ADDR)
        e2.inner = inner2
        e2.type = mk_ptr(ar, inner2.type)
        return e2
    }
    return parse_postfix(ar)
}

// Precedencia de los operadores binarios. 0 significa "no es un binario" y
// termina el bucle de parse_expr.
//
// Ver la tabla del encabezado. Nota: << y >> comparten nivel con + y -.
fun bin_prec(k: u32) -> u64 {
    if k == TK_STAR   { return 8 }
    if k == TK_SLASH  { return 8 }
    if k == TK_PERCENT { return 8 }
    if k == TK_PLUS   { return 7 }
    if k == TK_MINUS  { return 7 }
    if k == TK_LSHIFT { return 7 }
    if k == TK_RSHIFT { return 7 }
    if k == TK_AMP    { return 6 }
    if k == TK_CARET  { return 5 }
    if k == TK_PIPE   { return 4 }
    if k == TK_EQEQ   { return 3 }
    if k == TK_BANGEQ { return 3 }
    if k == TK_LT     { return 3 }
    if k == TK_LE     { return 3 }
    if k == TK_GT     { return 3 }
    if k == TK_GE     { return 3 }
    if k == TK_ANDAND { return 2 }
    if k == TK_PIPEPIPE { return 1 }
    return 0
}

// Escalada de precedencia (precedence climbing).
//
// Parsea un operando y luego, mientras el operador que viene ligue al menos tan
// fuerte como min_prec, lo consume y parsea el lado derecho con `pr + 1`. Ese
// +1 es lo que hace que todos los operadores sean ASOCIATIVOS POR LA IZQUIERDA:
// con `pr` a secas serian por la derecha.
//
// El tipo del resultado es el del lado izquierdo para los aritmeticos, y u32
// para las comparaciones (que producen 0 o 1).
fun parse_expr(ar: *Arena, min_prec: u64) -> *Expr {
    let lhs: *Expr = parse_unary(ar)
    if lhs == nil { return nil }
    while bin_prec(ps_kind()) >= min_prec {
        let k: u32 = ps_kind()
        let pr: u64 = bin_prec(k)
        ps_advance()
        let rhs: *Expr = parse_expr(ar, pr + 1)
        if rhs == nil { return nil }
        let e: *Expr = mk_expr(ar, EX_BIN)
        if k == TK_STAR   { e.op = OP_MUL }
        if k == TK_SLASH  { e.op = OP_DIV }
        if k == TK_PERCENT { e.op = OP_MOD }
        if k == TK_PLUS   { e.op = OP_ADD }
        if k == TK_MINUS  { e.op = OP_SUB }
        if k == TK_AMP    { e.op = OP_AND }
        if k == TK_CARET  { e.op = OP_XOR }
        if k == TK_PIPE   { e.op = OP_OR }
        if k == TK_LSHIFT { e.op = OP_SHL }
        if k == TK_RSHIFT { e.op = OP_SHR }
        if k == TK_ANDAND { e.kind = EX_LOGAND }
        if k == TK_PIPEPIPE { e.kind = EX_LOGOR }
        if k == TK_EQEQ   { e.kind = EX_EQ }
        if k == TK_BANGEQ { e.kind = EX_NE }
        if k == TK_LT     { e.kind = EX_LT }
        if k == TK_LE     { e.kind = EX_LE }
        if k == TK_GT     { e.kind = EX_GT }
        if k == TK_GE     { e.kind = EX_GE }
        e.lhs = lhs
        e.rhs = rhs
        if e.kind == EX_BIN {
            e.type = lhs.type
        } else {
            e.type = mk_prim(ar, T_U32)
        }
        lhs = e
    }
    return lhs
}

// ---------------------------------------------------------------------------
// Sentencias
//
// ST_STORE y ST_ASSIGN se distinguen por el destino: ST_ASSIGN escribe en una
// variable (`x = e`) y ST_STORE en memoria a traves de un puntero (`@p = e` o
// `p[i] = e`).
// ---------------------------------------------------------------------------
const ST_LET:    u64 = 0
const ST_STORE:  u64 = 1
const ST_ASSIGN: u64 = 2
const ST_LOOP:   u64 = 3
const ST_WHILE:  u64 = 4
const ST_IF:     u64 = 5
const ST_BREAK:  u64 = 6
const ST_RETURN: u64 = 7
const ST_EXPR:   u64 = 8
const ST_CONTINUE: u64 = 9

fun mk_stmt(ar: *Arena, kind: u64) -> *Stmt {
    let s: *Stmt = arena_take(ar, sizeof(Stmt))
    s.kind = kind
    s.name_start = 0
    s.name_len = 0
    s.type = nil
    s.init = nil
    s.cond = nil
    s.body = nil
    s.else_body = nil
    s.ret_val = nil
    s.expr = nil
    s.next = nil
    s.local_index = 0
    s.is_volatile = 0
    return s
}

// Consume un token del tipo esperado o muere. `ps_accept` es la version que no
// muere: consume y devuelve 1 si coincide, o deja el token y devuelve 0.
fun ps_expect(k: u32) {
    if ps_kind() != k {
        let m81: str = 'se esperaba token'
        die_here(m81.ptr, m81.len)
        return
    }
    ps_advance()
}

fun ps_accept(k: u32) -> u32 {
    if ps_kind() == k { ps_advance(); return 1 }
    return 0
}

fun bytes_eq_at(src_off: u64, tlen: u64, kw: *u8, kwlen: u64) -> u32 {
    if tlen != kwlen { return 0 }
    let lx: *Lexer = LX_STATE
    return bytes_eq(lx.src + src_off, kw, kwlen)
}

// Un tipo: u8, u32, u64, str, un nombre de struct, o `*` seguido de otro tipo.
// Los punteros se anidan a la izquierda, asi que `**u8` es puntero a puntero a
// byte.
fun parse_type(ar: *Arena) -> *Type {
    if ps_kind() == TK_LBRACK {
        ps_advance()
        let nt: *Tok = TOK_CUR
        if ps_kind() != TK_NUM {
            let ma2: str = 'array requiere longitud constante'
            die_here(ma2.ptr, ma2.len)
            return nil
        }
        let n: u64 = nt.ival
        if n == 0 {
            let ma3: str = 'array vacio no soportado'
            die_here(ma3.ptr, ma3.len)
            return nil
        }
        ps_advance()
        ps_expect(TK_RBRACK)
        if parser_failed() == 1 { return nil }
        let elem: *Type = parse_type(ar)
        if elem == nil { return nil }
        return mk_array(ar, elem, n)
    }
    if ps_kind() == TK_STAR {
        ps_advance()
        let inner: *Type = parse_type(ar)
        if inner == nil { return nil }
        return mk_ptr(ar, inner)
    }
    if ps_kind() != TK_IDENT {
        let m82: str = 'se esperaba tipo'
        die_here(m82.ptr, m82.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let u8kw:  str = 'u8'
    let u32kw: str = 'u32'
    let u64kw: str = 'u64'
    let i8kw:  str = 'i8'
    let i32kw: str = 'i32'
    let i64kw: str = 'i64'
    let boolkw: str = 'bool'
    let strkw: str = 'str'
    let result: *Type = nil
    if bytes_eq_at(t.start, t.tlen, u8kw.ptr, 2) == 1 { result = mk_prim(ar, T_U8) }
    if bytes_eq_at(t.start, t.tlen, u32kw.ptr, 3) == 1 { result = mk_prim(ar, T_U32) }
    if bytes_eq_at(t.start, t.tlen, u64kw.ptr, 3) == 1 { result = mk_prim(ar, T_U64) }
    if bytes_eq_at(t.start, t.tlen, i8kw.ptr, 2) == 1 { result = mk_prim(ar, T_I8) }
    if bytes_eq_at(t.start, t.tlen, i32kw.ptr, 3) == 1 { result = mk_prim(ar, T_I32) }
    if bytes_eq_at(t.start, t.tlen, i64kw.ptr, 3) == 1 { result = mk_prim(ar, T_I64) }
    if bytes_eq_at(t.start, t.tlen, boolkw.ptr, 4) == 1 { result = mk_prim(ar, T_BOOL) }
    if bytes_eq_at(t.start, t.tlen, strkw.ptr, 3) == 1 { result = mk_prim(ar, T_STR) }
    if result == nil {
        result = mk_prim(ar, T_STRUCT)
        let pg: *Program = cur_prog()
        if pg != nil {
            let d: *StructDecl = lookup_struct(pg, t.start, t.tlen)
            result.decl = d
        }
    }
    ps_advance()
    return result
}

fun ps_sync_stmt(failed_line: u64) {
    while ps_kind() != TK_EOF {
        if ps_kind() == TK_RBRACE { return }
        if ps_kind() == TK_SEMI { ps_advance()  return }
        let t: *Tok = TOK_CUR
        if t.tline > failed_line { return }
        ps_advance()
    }
}

fun parse_block(ar: *Arena) -> *Stmt {
    let fn: *Func = cur_func()
    let scope_start: u64 = 0
    if fn != nil { scope_start = fn.nlocals }
    let recover: *u64 = PARSER_RECOVER
    let previous_recover: u64 = recover[0]
    recover[0] = 1
    ps_expect(TK_LBRACE)
    if parser_failed() == 1 {
        parser_clear_failed()
        recover[0] = previous_recover
        return nil
    }
    let head: *Stmt = nil
    let tail: *Stmt = nil
    while ps_kind() != TK_RBRACE {
        if ps_kind() == TK_EOF { break }
        let current: *Tok = TOK_CUR
        let failed_line: u64 = current.tline
        let s: *Stmt = parse_stmt(ar)
        if parser_failed() == 1 {
            ps_sync_stmt(failed_line)
            parser_clear_failed()
            if diagnostics_count() == 20 { diagnostics_flush() }
        } else if s != nil {
            if head == nil { head = s } else { tail.next = s }
            tail = s
        }
        while ps_kind() == TK_SEMI { ps_advance() }
    }
    ps_expect(TK_RBRACE)
    if parser_failed() == 1 { parser_clear_failed() }
    recover[0] = previous_recover
    if fn != nil {
        let arr: **Local = fn.locals
        let i: u64 = scope_start
        while i < fn.nlocals {
            let loc: *Local = arr[i]
            loc.active = 0
            i = i + 1
        }
    }
    return head
}

fun require_initialized(e: *Expr) {
    if e == nil { return }
    if e.kind == EX_ADDR { return }
    if e.kind == EX_VAR {
        let fn: *Func = cur_func()
        let arr: **Local = fn.locals
        let loc: *Local = arr[e.var_index]
        if loc.initialized == 0 {
            let mu: str = 'lectura de local no inicializado'
            die_here(mu.ptr, mu.len)
            return
        }
        return
    }
    require_initialized(e.inner)
    require_initialized(e.lhs)
    require_initialized(e.rhs)
    if e.kind == EX_CALL {
        let args: **Expr = e.args
        let i: u64 = 0
        while i < e.nargs { require_initialized(args[i]); i = i + 1 }
    }
}

// Una sentencia. No hay punto y coma obligatorio: el final de una sentencia se
// deduce de la gramatica, lo que obliga a decidir por el primer token.
//
// El caso ambiguo es un identificador al principio: puede ser una asignacion
// (`x = ...`), una escritura indexada (`p[i] = ...`) o una expresion suelta
// (una llamada). Se resuelve parseando la expresion y mirando si despues viene
// un `=`.
fun parse_stmt(ar: *Arena) -> *Stmt {
    let k: u32 = ps_kind()
    if k == TK_LET {
        ps_advance()
        let t: *Tok = TOK_CUR
        if ps_kind() != TK_IDENT {
            let m83: str = 'let requiere identificador'
            die_here(m83.ptr, m83.len)
            return nil
        }
        let s: *Stmt = mk_stmt(ar, ST_LET)
        s.name_start = t.start
        s.name_len = t.tlen
        ps_advance()
        if ps_accept(TK_COLON) == 1 {
            s.type = parse_type(ar)
            if s.type == nil { return nil }
        }
        if ps_accept(TK_EQ) == 1 {
            if s.type != nil {
                if s.type.kind == T_ARRAY {
                    let ma4: str = 'inicializador de array no soportado'
                    die_here(ma4.ptr, ma4.len)
                    return nil
                }
            }
            s.init = parse_expr(ar, 1)
            if s.init == nil { return nil }
            require_initialized(s.init)
            if parser_failed() == 1 { return nil }
        }
        let fn: *Func = cur_func()
        if fn != nil {
            s.local_index = add_local(ar, fn, s.name_start, s.name_len, s.type)
            if s.init != nil {
                mark_local_initialized(fn, s.local_index)
            }
        }
        return s
    }
    if k == TK_RETURN {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_RETURN)
        if ps_kind() != TK_SEMI {
            if ps_kind() != TK_RBRACE {
                s.ret_val = parse_expr(ar, 1)
                if s.ret_val == nil { return nil }
                require_initialized(s.ret_val)
                if parser_failed() == 1 { return nil }
            }
        }
        return s
    }
    if k == TK_IF {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_IF)
        s.cond = parse_expr(ar, 1)
        if s.cond == nil { return nil }
        require_initialized(s.cond)
        if parser_failed() == 1 { return nil }
        s.body = parse_block(ar)
        if parser_failed() == 1 { return nil }
        if ps_kind() == TK_ELSE {
            ps_advance()
            if ps_kind() == TK_IF {
                s.else_body = parse_stmt(ar)
                if parser_failed() == 1 { return nil }
            } else {
                s.else_body = parse_block(ar)
                if parser_failed() == 1 { return nil }
            }
        }
        return s
    }
    if k == TK_WHILE {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_WHILE)
        s.cond = parse_expr(ar, 1)
        if s.cond == nil { return nil }
        require_initialized(s.cond)
        if parser_failed() == 1 { return nil }
        s.body = parse_block(ar)
        return s
    }
    if k == TK_LOOP {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_LOOP)
        s.body = parse_block(ar)
        return s
    }
    if k == TK_BREAK {
        ps_advance()
        return mk_stmt(ar, ST_BREAK)
    }
    if k == TK_CONTINUE {
        ps_advance()
        return mk_stmt(ar, ST_CONTINUE)
    }
    let e: *Expr = parse_expr(ar, 1)
    if e == nil { return nil }
    if ps_accept(TK_EQ) == 1 {
        if e.type != nil {
            if e.type.kind == T_ARRAY {
                let ma5: str = 'asignacion de array no soportada'
                die_here(ma5.ptr, ma5.len)
                return nil
            }
        }
        let rhs: *Expr = parse_expr(ar, 1)
        if rhs == nil { return nil }
        require_initialized(rhs)
        if parser_failed() == 1 { return nil }
        if e.kind == EX_DEREF {
            let s2: *Stmt = mk_stmt(ar, ST_STORE)
            s2.expr = e.inner
            s2.init = rhs
            s2.is_volatile = e.is_volatile
            return s2
        }
        let s: *Stmt = mk_stmt(ar, ST_ASSIGN)
        s.expr = e
        s.init = rhs
        if e.kind == EX_VAR {
            s.local_index = e.var_index
            let fn: *Func = cur_func()
            mark_local_initialized(fn, e.var_index)
        } else { require_initialized(e) }
        if parser_failed() == 1 { return nil }
        return s
    }
    require_initialized(e)
    if parser_failed() == 1 { return nil }
    let s: *Stmt = mk_stmt(ar, ST_EXPR)
    s.expr = e
    return s
}

fun mk_program(ar: *Arena) -> *Program {
    let p: *Program = arena_take(ar, sizeof(Program))
    p.funcs = nil
    p.consts = nil
    p.bsses = nil
    p.structs = nil
    p.strs = nil
    p.nstrs = 0
    return p
}

// Declaracion de funcion: nombre, parametros, tipo de retorno opcional tras
// `->` y cuerpo.
//
// Los parametros se registran como locales segun se parsean, de modo que ya son
// visibles dentro del cuerpo y su indice coincide con su posicion.
fun parse_fun(ar: *Arena) -> *Func {
    ps_expect(TK_FUN)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_IDENT {
        let m84: str = 'fun requiere identificador'
        die_here(m84.ptr, m84.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let f: *Func = arena_take(ar, sizeof(Func))
    f.name_start = t.start
    f.name_len = t.tlen
    f.params = nil
    f.nparams = 0
    f.ret_type = nil
    f.body = nil
    f.next = nil
    f.locals = arena_take(ar, 32768)
    f.nlocals = 0
    cur_func_set(f)
    ps_advance()
    ps_expect(TK_LPAREN)
    if parser_failed() == 1 { cur_func_set(nil)  return nil }
    let phead: *Param = nil
    let ptail: *Param = nil
    while ps_kind() != TK_RPAREN {
        if ps_kind() != TK_IDENT {
            let m85: str = 'parametro requiere identificador'
            die_here(m85.ptr, m85.len)
            cur_func_set(nil)
            return nil
        }
        let pt: *Tok = TOK_CUR
        let p: *Param = arena_take(ar, sizeof(Param))
        p.name_start = pt.start
        p.name_len = pt.tlen
        p.next = nil
        ps_advance()
        ps_expect(TK_COLON)
        if parser_failed() == 1 { cur_func_set(nil)  return nil }
        p.type = parse_type(ar)
        if p.type == nil { cur_func_set(nil)  return nil }
        if phead == nil { phead = p } else { ptail.next = p }
        ptail = p
        let pty: *Type = p.type
        if pty.kind == T_STR {
            f.nparams = f.nparams + 2
        } else {
            f.nparams = f.nparams + 1
        }
        let pidx: u64 = add_local(ar, f, p.name_start, p.name_len, p.type)
        mark_local_initialized(f, pidx)
        if ps_kind() != TK_RPAREN { ps_expect(TK_COMMA) }
        if parser_failed() == 1 { cur_func_set(nil)  return nil }
    }
    ps_expect(TK_RPAREN)
    if parser_failed() == 1 { cur_func_set(nil)  return nil }
    f.params = phead
    if ps_kind() == TK_ARROW {
        ps_advance()
        f.ret_type = parse_type(ar)
        if f.ret_type == nil { cur_func_set(nil)  return nil }
    }
    f.body = parse_block(ar)
    cur_func_set(nil)
    return f
}

fun parse_const_decl(ar: *Arena) -> *ConstItem {
    ps_expect(TK_CONST)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_IDENT {
        let m86a: str = 'const requiere identificador'
        die_here(m86a.ptr, m86a.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let c: *ConstItem = arena_take(ar, sizeof(ConstItem))
    c.name_start = t.start
    c.name_len = t.tlen
    c.next = nil
    ps_advance()
    ps_expect(TK_COLON)
    if parser_failed() == 1 { return nil }
    c.type = parse_type(ar)
    if c.type == nil { return nil }
    ps_expect(TK_EQ)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_NUM {
        let m86b: str = 'const requiere valor entero'
        die_here(m86b.ptr, m86b.len)
        return nil
    }
    let nt: *Tok = TOK_CUR
    c.value = nt.ival
    ps_advance()
    return c
}

// `bss NOMBRE: tamano`. Reserva un bloque de memoria estatica puesta a cero.
//
// Es el unico almacenamiento global del lenguaje: no hay variables globales
// inicializadas, porque eso exigiria una seccion __data con contenido y aqui
// __DATA es siempre S_ZEROFILL.
//
// El orden de declaracion determina el orden en memoria (ver cgb_bss_layout en
// codegen_bytes.tt).
fun parse_bss_decl(ar: *Arena) -> *BssItem {
    ps_expect(TK_BSS)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_IDENT {
        let m87: str = 'bss requiere identificador'
        die_here(m87.ptr, m87.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let b: *BssItem = arena_take(ar, sizeof(BssItem))
    b.name_start = t.start
    b.name_len = t.tlen
    b.next = nil
    ps_advance()
    ps_expect(TK_COLON)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_NUM {
        let m88: str = 'bss requiere tamaño'
        die_here(m88.ptr, m88.len)
        return nil
    }
    let nt: *Tok = TOK_CUR
    b.size = nt.ival
    ps_advance()
    return b
}

// `struct Nombre { campo: tipo, ... }`. Todos los campos ocupan 8 bytes; ver la
// nota sobre el layout en el encabezado.
fun parse_struct_decl(ar: *Arena) -> *StructDecl {
    ps_expect(TK_STRUCT)
    if parser_failed() == 1 { return nil }
    if ps_kind() != TK_IDENT {
        let m89: str = 'struct requiere identificador'
        die_here(m89.ptr, m89.len)
        return nil
    }
    let t: *Tok = TOK_CUR
    let sd: *StructDecl = arena_take(ar, sizeof(StructDecl))
    sd.name_start = t.start
    sd.name_len = t.tlen
    sd.fields = nil
    sd.nfields = 0
    sd.size = 0
    sd.align = 1
    sd.next = nil
    ps_advance()
    let pg: *Program = cur_prog()
    if pg != nil {
        if pg.structs == nil {
            pg.structs = sd
        } else {
            let tail: *StructDecl = pg.structs
            while tail.next != nil { tail = tail.next }
            tail.next = sd
        }
    }
    ps_expect(TK_LBRACE)
    if parser_failed() == 1 { return nil }
    let fhead: *Field = nil
    let ftail: *Field = nil
    while ps_kind() != TK_RBRACE {
        if ps_kind() != TK_IDENT {
            let m90: str = 'campo requiere identificador'
            die_here(m90.ptr, m90.len)
            return nil
        }
        let ft: *Tok = TOK_CUR
        let fd: *Field = arena_take(ar, sizeof(Field))
        fd.name_start = ft.start
        fd.name_len = ft.tlen
        fd.offset = 0
        fd.next = nil
        ps_advance()
        ps_expect(TK_COLON)
        if parser_failed() == 1 { return nil }
        fd.type = parse_type(ar)
        if fd.type == nil { return nil }
        let field_align: u64 = type_width(fd.type)
        if field_align > 8 { field_align = 8 }
        if field_align > sd.align { sd.align = field_align }
        sd.size = ((sd.size + field_align - 1) / field_align) * field_align
        fd.offset = sd.size
        sd.size = sd.size + type_width(fd.type)
        if fhead == nil { fhead = fd } else { ftail.next = fd }
        ftail = fd
        sd.nfields = sd.nfields + 1
        sd.fields = fhead
        if ps_kind() == TK_COMMA { ps_advance() }
    }
    ps_expect(TK_RBRACE)
    if parser_failed() == 1 { return nil }
    sd.fields = fhead
    sd.size = ((sd.size + sd.align - 1) / sd.align) * sd.align
    return sd
}

fun resolve_call_types_expr(pg: *Program, e: *Expr) {
    if e == nil { return }
    if e.kind == EX_CALL {
        let syskw: str = 'syscall'
        let sysck: str = 'syscall_checked'
        if bytes_eq_at(e.callee_start, e.callee_len, syskw.ptr, 7) == 0 {
            if bytes_eq_at(e.callee_start, e.callee_len, sysck.ptr, 15) == 0 {
            let f: *Func = pg.funcs
            while f != nil {
                if bytes_eq_off(f.name_start, f.name_len, e.callee_start, e.callee_len) == 1 {
                    if f.ret_type != nil { e.type = f.ret_type }
                    break
                }
                f = f.next
            }
            }
        }
        let i: u64 = 0
        while i < e.nargs {
            let args: **Expr = e.args
            resolve_call_types_expr(pg, args[i])
            i = i + 1
        }
    }
    resolve_call_types_expr(pg, e.inner)
    resolve_call_types_expr(pg, e.lhs)
    resolve_call_types_expr(pg, e.rhs)
}

fun resolve_call_types_stmt(pg: *Program, s: *Stmt) {
    let it: *Stmt = s
    while it != nil {
        resolve_call_types_expr(pg, it.init)
        resolve_call_types_expr(pg, it.cond)
        resolve_call_types_expr(pg, it.ret_val)
        resolve_call_types_expr(pg, it.expr)
        resolve_call_types_stmt(pg, it.body)
        resolve_call_types_stmt(pg, it.else_body)
        it = it.next
    }
}

fun ps_is_top(k: u32) -> u64 {
    if k == TK_FUN { return 1 }
    if k == TK_CONST { return 1 }
    if k == TK_BSS { return 1 }
    if k == TK_STRUCT { return 1 }
    return 0
}

fun ps_sync_top() {
    while ps_kind() != TK_EOF {
        if ps_is_top(ps_kind()) == 1 { return }
        ps_advance()
    }
}

// Punto de entrada: parsea un fichero entero y devuelve el Program.
//
// A nivel superior solo hay cinco cosas posibles: fun, const, bss, struct y el
// fin de fichero.
fun parse(ar: *Arena, src: *u8, srclen: u64) -> *Program {
    diagnostics_reset()
    parser_clear_failed()
    let recover: *u64 = PARSER_RECOVER
    recover[0] = 1
    ps_init(src, srclen)
    str_table_init()
    let p: *Program = mk_program(ar)
    cur_prog_set(p)
    let ftail: *Func = nil
    let ctail: *ConstItem = nil
    let btail: *BssItem = nil
    while ps_kind() != TK_EOF {
        while ps_kind() == TK_SEMI { ps_advance() }
        if ps_kind() == TK_EOF { break }
        let k: u32 = ps_kind()
        if k == TK_FUN {
            let f: *Func = parse_fun(ar)
            if parser_failed() == 0 {
                if p.funcs == nil { p.funcs = f } else { ftail.next = f }
                ftail = f
            }
        } else if k == TK_CONST {
            let c: *ConstItem = parse_const_decl(ar)
            if parser_failed() == 0 {
                if p.consts == nil { p.consts = c } else { ctail.next = c }
                ctail = c
            }
        } else if k == TK_BSS {
            let b: *BssItem = parse_bss_decl(ar)
            if parser_failed() == 0 {
                if p.bsses == nil { p.bsses = b } else { btail.next = b }
                btail = b
            }
        } else if k == TK_STRUCT {
            parse_struct_decl(ar)
        } else {
            let m97: str = 'declaracion superior invalida'
            die_here(m97.ptr, m97.len)
        }
        if parser_failed() == 1 {
            ps_sync_top()
            parser_clear_failed()
            cur_func_set(nil)
            if diagnostics_count() == 20 { diagnostics_flush() }
        }
    }
    let hh: **StrLit = STR_HEAD
    let cc: *u64 = STR_COUNT
    p.strs = hh[0]
    p.nstrs = cc[0]
    if diagnostics_count() > 0 { diagnostics_flush() }
    let rf: *Func = p.funcs
    while rf != nil {
        resolve_call_types_stmt(p, rf.body)
        rf = rf.next
    }
    return p
}
