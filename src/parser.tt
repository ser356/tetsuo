const T_U8: u64 = 0
const T_U32: u64 = 1
const T_U64: u64 = 2
const T_PTR: u64 = 3
const T_STR: u64 = 4
const T_STRUCT: u64 = 5

struct Type {
    kind:  u64,
    inner: *Type,
    decl:  *u8,
}

struct Field {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    next:       *Field,
}

struct StructDecl {
    name_start: u64,
    name_len:   u64,
    fields:     *Field,
    nfields:    u64,
    next:       *StructDecl,
}

fun mk_prim(ar: *Arena, kind: u64) -> *Type {
    let t: *Type = arena_take(ar, 24)
    t.kind = kind
    t.inner = nil
    t.decl = nil
    return t
}

fun mk_ptr(ar: *Arena, inner: *Type) -> *Type {
    let t: *Type = arena_take(ar, 24)
    t.kind = T_PTR
    t.inner = inner
    t.decl = nil
    return t
}

fun type_width(t: *Type) -> u64 {
    if t.kind == T_U8  { return 1 }
    if t.kind == T_U32 { return 4 }
    if t.kind == T_U64 { return 8 }
    if t.kind == T_PTR { return 8 }
    if t.kind == T_STR { return 16 }
    if t.kind == T_STRUCT {
        let d: *StructDecl = t.decl
        if d != nil { return d.nfields * 8 }
    }
    return 8
}

const EX_INT:    u64 = 0
const EX_VAR:    u64 = 1
const EX_CALL:   u64 = 2
const EX_DEREF:  u64 = 3
const EX_BIN:    u64 = 4
const EX_EQ:     u64 = 5
const EX_NE:     u64 = 6
const EX_LT:     u64 = 7
const EX_LE:     u64 = 8
const EX_GT:     u64 = 9
const EX_GE:     u64 = 10
const EX_STRLIT: u64 = 11
const EX_ADDR:   u64 = 12
const EX_EXTERN: u64 = 13

const OP_ADD: u64 = 0
const OP_SUB: u64 = 1
const OP_MUL: u64 = 2
const OP_DIV: u64 = 3
const OP_AND: u64 = 4
const OP_OR:  u64 = 5
const OP_XOR: u64 = 6

struct Expr {
    kind:         u64,
    type:         *Type,
    ival:         u64,
    var_start:    u64,
    var_len:      u64,
    inner:        *Expr,
    lhs:          *Expr,
    rhs:          *Expr,
    op:           u64,
    args:         **Expr,
    nargs:        u64,
    callee_start: u64,
    callee_len:   u64,
    str_bytes:    *u8,
    str_len:      u64,
    var_index:    u64,
    str_id:       u64,
}

bss LX_STATE: 32
bss TOK_CUR:  40
bss STR_HEAD: 8
bss STR_COUNT: 8
bss STR_TAIL: 8

fun die_here(msg: *u8, mlen: u64) {
    let t: *Tok = TOK_CUR
    die_line(msg, mlen, t.tline)
}

struct StrLit {
    id:    u64,
    bytes: *u8,
    slen:  u64,
    next:  *StrLit,
}

struct Stmt {
    kind:        u64,
    name_start:  u64,
    name_len:    u64,
    type:        *Type,
    init:        *Expr,
    cond:        *Expr,
    body:        *Stmt,
    else_body:   *Stmt,
    ret_val:     *Expr,
    expr:        *Expr,
    next:        *Stmt,
    local_index: u64,
}

struct Param {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    next:       *Param,
}

struct Local {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
}

struct Func {
    name_start: u64,
    name_len:   u64,
    params:     *Param,
    nparams:    u64,
    ret_type:   *Type,
    body:       *Stmt,
    next:       *Func,
    locals:     **Local,
    nlocals:    u64,
}

struct ConstItem {
    name_start: u64,
    name_len:   u64,
    type:       *Type,
    value:      u64,
    next:       *ConstItem,
}

struct BssItem {
    name_start: u64,
    name_len:   u64,
    size:       u64,
    next:       *BssItem,
}

struct Program {
    funcs:   *Func,
    consts:  *ConstItem,
    bsses:   *BssItem,
    structs: *StructDecl,
    strs:    *StrLit,
    nstrs:   u64,
}

bss CUR_FUNC: 8
bss CUR_PROG: 8

fun cur_func_set(f: *Func) {
    let p: **Func = CUR_FUNC
    p[0] = f
}

fun cur_func() -> *Func {
    let p: **Func = CUR_FUNC
    return p[0]
}

fun cur_prog_set(p: *Program) {
    let q: **Program = CUR_PROG
    q[0] = p
}

fun cur_prog() -> *Program {
    let q: **Program = CUR_PROG
    return q[0]
}

fun bytes_eq_off(a_off: u64, a_len: u64, b_off: u64, b_len: u64) -> u32 {
    if a_len != b_len { return 0 }
    let lx: *Lexer = LX_STATE
    return bytes_eq(lx.src + a_off, lx.src + b_off, a_len)
}

fun add_local(ar: *Arena, f: *Func, ns: u64, nl: u64, ty: *Type) -> u64 {
    let idx: u64 = f.nlocals
    let loc: *Local = arena_take(ar, 24)
    loc.name_start = ns
    loc.name_len = nl
    loc.type = ty
    let arr: **Local = f.locals
    arr[idx] = loc
    f.nlocals = idx + 1
    let extras: u64 = 0
    if ty != nil {
        if ty.kind == T_STR { extras = 1 }
        if ty.kind == T_STRUCT {
            let d: *StructDecl = ty.decl
            if d != nil {
                if d.nfields > 0 { extras = d.nfields - 1 }
            }
        }
    }
    let k: u64 = 0
    while k < extras {
        let loc2: *Local = arena_take(ar, 24)
        loc2.name_start = 0
        loc2.name_len = 0
        loc2.type = mk_prim(ar, T_U64)
        if ty.kind == T_STRUCT {
            let ft: *Type = struct_field_type(ty.decl, k + 1)
            if ft != nil { loc2.type = ft }
        }
        arr[f.nlocals] = loc2
        f.nlocals = f.nlocals + 1
        k = k + 1
    }
    return idx
}

fun lookup_local(f: *Func, ns: u64, nl: u64) -> u64 {
    let n: u64 = f.nlocals
    let i: u64 = n
    while i > 0 {
        i = i - 1
        let arr: **Local = f.locals
        let loc: *Local = arr[i]
        if bytes_eq_off(loc.name_start, loc.name_len, ns, nl) == 1 { return i }
    }
    return n
}

fun lookup_const(pg: *Program, ns: u64, nl: u64) -> *ConstItem {
    let c: *ConstItem = pg.consts
    while c != nil {
        if bytes_eq_off(c.name_start, c.name_len, ns, nl) == 1 { return c }
        c = c.next
    }
    return nil
}

fun lookup_bss(pg: *Program, ns: u64, nl: u64) -> *BssItem {
    let b: *BssItem = pg.bsses
    while b != nil {
        if bytes_eq_off(b.name_start, b.name_len, ns, nl) == 1 { return b }
        b = b.next
    }
    return nil
}

fun lookup_struct(pg: *Program, ns: u64, nl: u64) -> *StructDecl {
    let d: *StructDecl = pg.structs
    while d != nil {
        if bytes_eq_off(d.name_start, d.name_len, ns, nl) == 1 { return d }
        d = d.next
    }
    return nil
}

fun struct_field_index(d: *StructDecl, ns: u64, nl: u64) -> u64 {
    let i: u64 = 0
    let fd: *Field = d.fields
    while fd != nil {
        if bytes_eq_off(fd.name_start, fd.name_len, ns, nl) == 1 { return i }
        i = i + 1
        fd = fd.next
    }
    return d.nfields
}

fun struct_field_type(d: *StructDecl, idx: u64) -> *Type {
    let i: u64 = 0
    let fd: *Field = d.fields
    while fd != nil {
        if i == idx { return fd.type }
        i = i + 1
        fd = fd.next
    }
    return nil
}

fun str_table_init() {
    let h: **StrLit = STR_HEAD
    let c: *u64 = STR_COUNT
    let ta: **StrLit = STR_TAIL
    h[0] = nil
    c[0] = 0
    ta[0] = nil
}

fun str_table_add(ar: *Arena, bytes: *u8, slen: u64) -> u64 {
    let c: *u64 = STR_COUNT
    let id: u64 = c[0]
    let s: *StrLit = arena_take(ar, 32)
    s.id = id
    s.bytes = bytes
    s.slen = slen
    s.next = nil
    let h: **StrLit = STR_HEAD
    let ta: **StrLit = STR_TAIL
    if h[0] == nil {
        h[0] = s
        ta[0] = s
    } else {
        let t: *StrLit = ta[0]
        t.next = s
        ta[0] = s
    }
    c[0] = id + 1
    return id
}

fun str_unescape(ar: *Arena, e: *Expr, raw: *u8, rawlen: u64) {
    let buf: *u8 = arena_take(ar, rawlen + 8)
    let i: u64 = 0
    let n: u64 = 0
    while i < rawlen {
        let c: u8 = raw[i]
        if c == 92 {
            i = i + 1
            let d: u8 = raw[i]
            let v: u64 = 0
            if d == 110 { v = 10 }
            if d == 116 { v = 9 }
            if d == 92  { v = 92 }
            if d == 39  { v = 39 }
            if d == 120 {
                let h1: u64 = hex_val(raw[i + 1])
                let h2: u64 = hex_val(raw[i + 2])
                v = h1 * 16 + h2
                i = i + 2
            }
            buf[n] = v
            i = i + 1
            n = n + 1
        } else {
            buf[n] = c
            i = i + 1
            n = n + 1
        }
    }
    e.str_bytes = buf
    e.str_len = n
}

fun ps_init(src: *u8, srclen: u64) {
    let lx: *Lexer = LX_STATE
    lex_init(lx, src, srclen)
    let t: *Tok = TOK_CUR
    lex_next(lx, t)
}

fun ps_advance() {
    let lx: *Lexer = LX_STATE
    let t: *Tok = TOK_CUR
    lex_next(lx, t)
}

fun ps_kind() -> u32 {
    let t: *Tok = TOK_CUR
    return t.kind
}

fun mk_expr(ar: *Arena, kind: u64) -> *Expr {
    let e: *Expr = arena_take(ar, 136)
    e.kind = kind
    e.type = nil
    e.ival = 0
    e.var_start = 0
    e.var_len = 0
    e.inner = nil
    e.lhs = nil
    e.rhs = nil
    e.op = 0
    e.args = nil
    e.nargs = 0
    e.callee_start = 0
    e.callee_len = 0
    e.str_bytes = nil
    e.str_len = 0
    e.var_index = 0
    e.str_id = 0
    return e
}

fun parse_primary(ar: *Arena) -> *Expr {
    let t: *Tok = TOK_CUR
    let k: u32 = t.kind
    if k == TK_NUM {
        let e: *Expr = mk_expr(ar, EX_INT)
        e.ival = t.ival
        e.type = mk_prim(ar, T_U64)
        ps_advance()
        return e
    }
    if k == TK_NIL {
        let e: *Expr = mk_expr(ar, EX_INT)
        e.ival = 0
        e.type = mk_prim(ar, T_U64)
        ps_advance()
        return e
    }
    if k == TK_SIZEOF {
        ps_advance()
        ps_expect(TK_LPAREN)
        let ty: *Type = parse_type(ar)
        ps_expect(TK_RPAREN)
        let e: *Expr = mk_expr(ar, EX_INT)
        e.ival = type_width(ty)
        e.type = mk_prim(ar, T_U64)
        return e
    }
    if k == TK_LPAREN {
        ps_advance()
        let e: *Expr = parse_expr(ar, 1)
        ps_expect(TK_RPAREN)
        return e
    }
    if k == TK_IDENT {
        let name_start: u64 = t.start
        let name_len:   u64 = t.tlen
        ps_advance()
        if ps_kind() == TK_LPAREN {
            ps_advance()
            let e: *Expr = mk_expr(ar, EX_CALL)
            e.callee_start = name_start
            e.callee_len   = name_len
            let args: **Expr = arena_take(ar, 64)
            e.args = args
            let n: u64 = 0
            while ps_kind() != TK_RPAREN {
                let arg: *Expr = parse_expr(ar, 1)
                if n < 8 { args[n] = arg }
                n = n + 1
                if ps_kind() != TK_RPAREN { ps_expect(TK_COMMA) }
            }
            ps_expect(TK_RPAREN)
            if n > 8 {
                let m93: str = 'demasiados args (>8)'
                die_here(m93.ptr, m93.len)
            }
            e.nargs = n
            let syskw: str = 'syscall'
            if bytes_eq_at(name_start, name_len, syskw.ptr, 7) == 1 {
                e.type = mk_prim(ar, T_U64)
            } else {
                e.type = mk_prim(ar, T_U32)
            }
            return e
        }
        let fn: *Func = cur_func()
        if fn != nil {
            let idx: u64 = lookup_local(fn, name_start, name_len)
            if idx < fn.nlocals {
                let e: *Expr = mk_expr(ar, EX_VAR)
                e.var_start = name_start
                e.var_len = name_len
                e.var_index = idx
                let arr: **Local = fn.locals
                let loc: *Local = arr[idx]
                e.type = loc.type
                return e
            }
        }
        let pg: *Program = cur_prog()
        if pg != nil {
            let ci: *ConstItem = lookup_const(pg, name_start, name_len)
            if ci != nil {
                let e: *Expr = mk_expr(ar, EX_INT)
                e.ival = ci.value
                e.type = ci.type
                return e
            }
            let bi: *BssItem = lookup_bss(pg, name_start, name_len)
            if bi != nil {
                let e: *Expr = mk_expr(ar, EX_EXTERN)
                e.callee_start = name_start
                e.callee_len = name_len
                e.type = mk_ptr(ar, mk_prim(ar, T_U8))
                return e
            }
        }
        let e: *Expr = mk_expr(ar, EX_VAR)
        e.var_start = name_start
        e.var_len = name_len
        return e
    }
    if k == TK_STRING {
        let t2: *Tok = TOK_CUR
        let lx: *Lexer = LX_STATE
        let e: *Expr = mk_expr(ar, EX_STRLIT)
        str_unescape(ar, e, lx.src + t2.start + 1, t2.tlen - 2)
        e.str_id = str_table_add(ar, e.str_bytes, e.str_len)
        e.type = mk_prim(ar, T_STR)
        ps_advance()
        return e
    }
    let m80: str = 'expresion primaria invalida'
    die_here(m80.ptr, m80.len)
    return nil
}

fun parse_postfix(ar: *Arena) -> *Expr {
    let e: *Expr = parse_primary(ar)
    while 1 == 1 {
        let k: u32 = ps_kind()
        if k == TK_DOT {
            ps_advance()
            if ps_kind() != TK_IDENT {
                let m91: str = 'se esperaba identificador tras .'
                die_here(m91.ptr, m91.len)
            }
            let t: *Tok = TOK_CUR
            let fstart: u64 = t.start
            let flen: u64 = t.tlen
            ps_advance()
            let ty: *Type = e.type
            let handled: u64 = 0
            if ty != nil {
                if ty.kind == T_STR {
                    if e.kind == EX_VAR {
                        let ptrkw: str = 'ptr'
                        if bytes_eq_at(fstart, flen, ptrkw.ptr, 3) == 1 {
                            let fe: *Expr = mk_expr(ar, EX_VAR)
                            fe.var_index = e.var_index
                            fe.type = mk_ptr(ar, mk_prim(ar, T_U8))
                            e = fe
                            handled = 1
                        }
                        if handled == 0 {
                            let lenkw: str = 'len'
                            if bytes_eq_at(fstart, flen, lenkw.ptr, 3) == 1 {
                                let fe2: *Expr = mk_expr(ar, EX_VAR)
                                fe2.var_index = e.var_index + 1
                                fe2.type = mk_prim(ar, T_U64)
                                e = fe2
                                handled = 1
                            }
                        }
                    }
                }
                if handled == 0 {
                    if ty.kind == T_STRUCT {
                        let d: *StructDecl = ty.decl
                        if d != nil {
                            if e.kind == EX_VAR {
                                let fi: u64 = struct_field_index(d, fstart, flen)
                                if fi >= d.nfields {
                                    let m95a: str = 'campo desconocido en struct'
                                    die_here(m95a.ptr, m95a.len)
                                }
                                let fe3: *Expr = mk_expr(ar, EX_VAR)
                                fe3.var_index = e.var_index + fi
                                fe3.type = struct_field_type(d, fi)
                                e = fe3
                                handled = 1
                            }
                        }
                    }
                }
                if handled == 0 {
                    if ty.kind == T_PTR {
                        let it: *Type = ty.inner
                        if it != nil {
                            if it.kind == T_STRUCT {
                                let d2: *StructDecl = it.decl
                                if d2 != nil {
                                    let fi2: u64 = struct_field_index(d2, fstart, flen)
                                    if fi2 >= d2.nfields {
                                        let m95b: str = 'campo desconocido en struct'
                                        die_here(m95b.ptr, m95b.len)
                                    }
                                    let ft: *Type = struct_field_type(d2, fi2)
                                    let off_e: *Expr = mk_expr(ar, EX_INT)
                                    off_e.ival = fi2 * 8
                                    off_e.type = mk_prim(ar, T_U64)
                                    let ptr_e: *Expr = mk_expr(ar, EX_BIN)
                                    ptr_e.op = OP_ADD
                                    ptr_e.lhs = e
                                    ptr_e.rhs = off_e
                                    ptr_e.type = mk_ptr(ar, ft)
                                    let d_e: *Expr = mk_expr(ar, EX_DEREF)
                                    d_e.inner = ptr_e
                                    d_e.type = ft
                                    e = d_e
                                    handled = 1
                                }
                            }
                        }
                    }
                }
            }
            if handled == 0 {
                let mh: str = 'postfix no soportado'
                die_here(mh.ptr, mh.len)
            }
        } else {
            if k == TK_LBRACK {
                ps_advance()
                let idx: *Expr = parse_expr(ar, 1)
                ps_expect(TK_RBRACK)
                let bty: *Type = e.type
                if bty == nil {
                    let mb1: str = 'deref sobre expresion sin tipo'
                    die_here(mb1.ptr, mb1.len)
                }
                if bty.kind != T_PTR {
                    let mb2: str = 'deref sobre no-puntero'
                    die_here(mb2.ptr, mb2.len)
                }
                let sz: u64 = type_width(bty.inner)
                let scaled: *Expr = idx
                if sz != 1 {
                    let sz_e: *Expr = mk_expr(ar, EX_INT)
                    sz_e.ival = sz
                    sz_e.type = mk_prim(ar, T_U64)
                    let m: *Expr = mk_expr(ar, EX_BIN)
                    m.op = OP_MUL
                    m.lhs = idx
                    m.rhs = sz_e
                    m.type = mk_prim(ar, T_U64)
                    scaled = m
                }
                let ptr2: *Expr = mk_expr(ar, EX_BIN)
                ptr2.op = OP_ADD
                ptr2.lhs = e
                ptr2.rhs = scaled
                ptr2.type = bty
                let de: *Expr = mk_expr(ar, EX_DEREF)
                de.inner = ptr2
                de.type = bty.inner
                e = de
            } else {
                return e
            }
        }
    }
    return e
}

fun parse_unary(ar: *Arena) -> *Expr {
    let k: u32 = ps_kind()
    if k == TK_AT {
        ps_advance()
        let inner: *Expr = parse_unary(ar)
        let e: *Expr = mk_expr(ar, EX_DEREF)
        e.inner = inner
        let ity: *Type = inner.type
        if ity != nil {
            if ity.kind == T_PTR { e.type = ity.inner }
        }
        return e
    }
    if k == TK_AMP {
        ps_advance()
        let inner2: *Expr = parse_unary(ar)
        let e2: *Expr = mk_expr(ar, EX_ADDR)
        e2.inner = inner2
        e2.type = mk_ptr(ar, inner2.type)
        return e2
    }
    return parse_postfix(ar)
}

fun bin_prec(k: u32) -> u64 {
    if k == TK_STAR   { return 6 }
    if k == TK_SLASH  { return 6 }
    if k == TK_PLUS   { return 5 }
    if k == TK_MINUS  { return 5 }
    if k == TK_AMP    { return 4 }
    if k == TK_CARET  { return 3 }
    if k == TK_PIPE   { return 2 }
    if k == TK_EQEQ   { return 1 }
    if k == TK_BANGEQ { return 1 }
    if k == TK_LT     { return 1 }
    if k == TK_LE     { return 1 }
    if k == TK_GT     { return 1 }
    if k == TK_GE     { return 1 }
    return 0
}

fun parse_expr(ar: *Arena, min_prec: u64) -> *Expr {
    let lhs: *Expr = parse_unary(ar)
    while bin_prec(ps_kind()) >= min_prec {
        let k: u32 = ps_kind()
        let pr: u64 = bin_prec(k)
        ps_advance()
        let rhs: *Expr = parse_expr(ar, pr + 1)
        let e: *Expr = mk_expr(ar, EX_BIN)
        if k == TK_STAR   { e.op = OP_MUL }
        if k == TK_SLASH  { e.op = OP_DIV }
        if k == TK_PLUS   { e.op = OP_ADD }
        if k == TK_MINUS  { e.op = OP_SUB }
        if k == TK_AMP    { e.op = OP_AND }
        if k == TK_CARET  { e.op = OP_XOR }
        if k == TK_PIPE   { e.op = OP_OR }
        if k == TK_EQEQ   { e.kind = EX_EQ }
        if k == TK_BANGEQ { e.kind = EX_NE }
        if k == TK_LT     { e.kind = EX_LT }
        if k == TK_LE     { e.kind = EX_LE }
        if k == TK_GT     { e.kind = EX_GT }
        if k == TK_GE     { e.kind = EX_GE }
        e.lhs = lhs
        e.rhs = rhs
        if e.kind == EX_BIN {
            e.type = lhs.type
        } else {
            e.type = mk_prim(ar, T_U32)
        }
        lhs = e
    }
    return lhs
}

const ST_LET:    u64 = 0
const ST_STORE:  u64 = 1
const ST_ASSIGN: u64 = 2
const ST_LOOP:   u64 = 3
const ST_WHILE:  u64 = 4
const ST_IF:     u64 = 5
const ST_BREAK:  u64 = 6
const ST_RETURN: u64 = 7
const ST_EXPR:   u64 = 8

fun mk_stmt(ar: *Arena, kind: u64) -> *Stmt {
    let s: *Stmt = arena_take(ar, 96)
    s.kind = kind
    s.name_start = 0
    s.name_len = 0
    s.type = nil
    s.init = nil
    s.cond = nil
    s.body = nil
    s.else_body = nil
    s.ret_val = nil
    s.expr = nil
    s.next = nil
    s.local_index = 0
    return s
}

fun ps_expect(k: u32) {
    if ps_kind() != k {
        let m81: str = 'se esperaba token'
        die_here(m81.ptr, m81.len)
    }
    ps_advance()
}

fun ps_accept(k: u32) -> u32 {
    if ps_kind() == k { ps_advance(); return 1 }
    return 0
}

fun bytes_eq_at(src_off: u64, tlen: u64, kw: *u8, kwlen: u64) -> u32 {
    if tlen != kwlen { return 0 }
    let lx: *Lexer = LX_STATE
    return bytes_eq(lx.src + src_off, kw, kwlen)
}

fun parse_type(ar: *Arena) -> *Type {
    if ps_kind() == TK_STAR {
        ps_advance()
        let inner: *Type = parse_type(ar)
        return mk_ptr(ar, inner)
    }
    if ps_kind() != TK_IDENT {
        let m82: str = 'se esperaba tipo'
        die_here(m82.ptr, m82.len)
    }
    let t: *Tok = TOK_CUR
    let u8kw:  str = 'u8'
    let u32kw: str = 'u32'
    let u64kw: str = 'u64'
    let strkw: str = 'str'
    let result: *Type = nil
    if bytes_eq_at(t.start, t.tlen, u8kw.ptr, 2) == 1 { result = mk_prim(ar, T_U8) }
    if bytes_eq_at(t.start, t.tlen, u32kw.ptr, 3) == 1 { result = mk_prim(ar, T_U32) }
    if bytes_eq_at(t.start, t.tlen, u64kw.ptr, 3) == 1 { result = mk_prim(ar, T_U64) }
    if bytes_eq_at(t.start, t.tlen, strkw.ptr, 3) == 1 { result = mk_prim(ar, T_STR) }
    if result == nil {
        result = mk_prim(ar, T_STRUCT)
        let pg: *Program = cur_prog()
        if pg != nil {
            let d: *StructDecl = lookup_struct(pg, t.start, t.tlen)
            result.decl = d
        }
    }
    ps_advance()
    return result
}

fun parse_block(ar: *Arena) -> *Stmt {
    ps_expect(TK_LBRACE)
    let head: *Stmt = nil
    let tail: *Stmt = nil
    while ps_kind() != TK_RBRACE {
        let s: *Stmt = parse_stmt(ar)
        if head == nil { head = s } else { tail.next = s }
        tail = s
        while ps_kind() == TK_SEMI { ps_advance() }
    }
    ps_expect(TK_RBRACE)
    return head
}

fun parse_stmt(ar: *Arena) -> *Stmt {
    let k: u32 = ps_kind()
    if k == TK_LET {
        ps_advance()
        let t: *Tok = TOK_CUR
        if ps_kind() != TK_IDENT {
            let m83: str = 'let requiere identificador'
            die_here(m83.ptr, m83.len)
        }
        let s: *Stmt = mk_stmt(ar, ST_LET)
        s.name_start = t.start
        s.name_len = t.tlen
        ps_advance()
        if ps_accept(TK_COLON) == 1 {
            s.type = parse_type(ar)
        }
        if ps_accept(TK_EQ) == 1 {
            s.init = parse_expr(ar, 1)
        }
        let fn: *Func = cur_func()
        if fn != nil {
            s.local_index = add_local(ar, fn, s.name_start, s.name_len, s.type)
        }
        return s
    }
    if k == TK_RETURN {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_RETURN)
        if ps_kind() != TK_SEMI {
            if ps_kind() != TK_RBRACE {
                s.ret_val = parse_expr(ar, 1)
            }
        }
        return s
    }
    if k == TK_IF {
        ps_advance()
        let had_paren: u32 = ps_accept(TK_LPAREN)
        let s: *Stmt = mk_stmt(ar, ST_IF)
        s.cond = parse_expr(ar, 1)
        if had_paren == 1 { ps_expect(TK_RPAREN) }
        s.body = parse_block(ar)
        if ps_kind() == TK_ELSE {
            ps_advance()
            if ps_kind() == TK_IF {
                s.else_body = parse_stmt(ar)
            } else {
                s.else_body = parse_block(ar)
            }
        }
        return s
    }
    if k == TK_WHILE {
        ps_advance()
        let had_paren: u32 = ps_accept(TK_LPAREN)
        let s: *Stmt = mk_stmt(ar, ST_WHILE)
        s.cond = parse_expr(ar, 1)
        if had_paren == 1 { ps_expect(TK_RPAREN) }
        s.body = parse_block(ar)
        return s
    }
    if k == TK_LOOP {
        ps_advance()
        let s: *Stmt = mk_stmt(ar, ST_LOOP)
        s.body = parse_block(ar)
        return s
    }
    if k == TK_BREAK {
        ps_advance()
        return mk_stmt(ar, ST_BREAK)
    }
    let e: *Expr = parse_expr(ar, 1)
    if ps_accept(TK_EQ) == 1 {
        let rhs: *Expr = parse_expr(ar, 1)
        if e.kind == EX_DEREF {
            let s2: *Stmt = mk_stmt(ar, ST_STORE)
            s2.expr = e.inner
            s2.init = rhs
            return s2
        }
        let s: *Stmt = mk_stmt(ar, ST_ASSIGN)
        s.expr = e
        s.init = rhs
        if e.kind == EX_VAR { s.local_index = e.var_index }
        return s
    }
    let s: *Stmt = mk_stmt(ar, ST_EXPR)
    s.expr = e
    return s
}

fun mk_program(ar: *Arena) -> *Program {
    let p: *Program = arena_take(ar, 48)
    p.funcs = nil
    p.consts = nil
    p.bsses = nil
    p.structs = nil
    p.strs = nil
    p.nstrs = 0
    return p
}

fun parse_fun(ar: *Arena) -> *Func {
    ps_expect(TK_FUN)
    if ps_kind() != TK_IDENT {
        let m84: str = 'fun requiere identificador'
        die_here(m84.ptr, m84.len)
    }
    let t: *Tok = TOK_CUR
    let f: *Func = arena_take(ar, 72)
    f.name_start = t.start
    f.name_len = t.tlen
    f.params = nil
    f.nparams = 0
    f.ret_type = nil
    f.body = nil
    f.next = nil
    f.locals = arena_take(ar, 2048)
    f.nlocals = 0
    cur_func_set(f)
    ps_advance()
    ps_expect(TK_LPAREN)
    let phead: *Param = nil
    let ptail: *Param = nil
    while ps_kind() != TK_RPAREN {
        if ps_kind() != TK_IDENT {
            let m85: str = 'parametro requiere identificador'
            die_here(m85.ptr, m85.len)
        }
        let pt: *Tok = TOK_CUR
        let p: *Param = arena_take(ar, 32)
        p.name_start = pt.start
        p.name_len = pt.tlen
        p.next = nil
        ps_advance()
        ps_expect(TK_COLON)
        p.type = parse_type(ar)
        if phead == nil { phead = p } else { ptail.next = p }
        ptail = p
        let pty: *Type = p.type
        if pty.kind == T_STR {
            f.nparams = f.nparams + 2
        } else {
            f.nparams = f.nparams + 1
        }
        add_local(ar, f, p.name_start, p.name_len, p.type)
        if ps_kind() != TK_RPAREN { ps_expect(TK_COMMA) }
    }
    ps_expect(TK_RPAREN)
    f.params = phead
    if ps_kind() == TK_ARROW {
        ps_advance()
        f.ret_type = parse_type(ar)
    }
    f.body = parse_block(ar)
    cur_func_set(nil)
    return f
}

fun parse_const_decl(ar: *Arena) -> *ConstItem {
    ps_expect(TK_CONST)
    if ps_kind() != TK_IDENT {
        let m86a: str = 'const requiere identificador'
        die_here(m86a.ptr, m86a.len)
    }
    let t: *Tok = TOK_CUR
    let c: *ConstItem = arena_take(ar, 40)
    c.name_start = t.start
    c.name_len = t.tlen
    c.next = nil
    ps_advance()
    ps_expect(TK_COLON)
    c.type = parse_type(ar)
    ps_expect(TK_EQ)
    if ps_kind() != TK_NUM {
        let m86b: str = 'const requiere valor entero'
        die_here(m86b.ptr, m86b.len)
    }
    let nt: *Tok = TOK_CUR
    c.value = nt.ival
    ps_advance()
    return c
}

fun parse_bss_decl(ar: *Arena) -> *BssItem {
    ps_expect(TK_BSS)
    if ps_kind() != TK_IDENT {
        let m87: str = 'bss requiere identificador'
        die_here(m87.ptr, m87.len)
    }
    let t: *Tok = TOK_CUR
    let b: *BssItem = arena_take(ar, 32)
    b.name_start = t.start
    b.name_len = t.tlen
    b.next = nil
    ps_advance()
    ps_expect(TK_COLON)
    if ps_kind() != TK_NUM {
        let m88: str = 'bss requiere tamaño'
        die_here(m88.ptr, m88.len)
    }
    let nt: *Tok = TOK_CUR
    b.size = nt.ival
    ps_advance()
    return b
}

fun parse_struct_decl(ar: *Arena) -> *StructDecl {
    ps_expect(TK_STRUCT)
    if ps_kind() != TK_IDENT {
        let m89: str = 'struct requiere identificador'
        die_here(m89.ptr, m89.len)
    }
    let t: *Tok = TOK_CUR
    let sd: *StructDecl = arena_take(ar, 40)
    sd.name_start = t.start
    sd.name_len = t.tlen
    sd.fields = nil
    sd.nfields = 0
    sd.next = nil
    ps_advance()
    let pg: *Program = cur_prog()
    if pg != nil {
        if pg.structs == nil {
            pg.structs = sd
        } else {
            let tail: *StructDecl = pg.structs
            while tail.next != nil { tail = tail.next }
            tail.next = sd
        }
    }
    ps_expect(TK_LBRACE)
    let fhead: *Field = nil
    let ftail: *Field = nil
    while ps_kind() != TK_RBRACE {
        if ps_kind() != TK_IDENT {
            let m90: str = 'campo requiere identificador'
            die_here(m90.ptr, m90.len)
        }
        let ft: *Tok = TOK_CUR
        let fd: *Field = arena_take(ar, 32)
        fd.name_start = ft.start
        fd.name_len = ft.tlen
        fd.next = nil
        ps_advance()
        ps_expect(TK_COLON)
        fd.type = parse_type(ar)
        if fhead == nil { fhead = fd } else { ftail.next = fd }
        ftail = fd
        sd.nfields = sd.nfields + 1
        sd.fields = fhead
        if ps_kind() == TK_COMMA { ps_advance() }
    }
    ps_expect(TK_RBRACE)
    sd.fields = fhead
    return sd
}

fun parse(ar: *Arena, src: *u8, srclen: u64) -> *Program {
    ps_init(src, srclen)
    str_table_init()
    let p: *Program = mk_program(ar)
    cur_prog_set(p)
    let ftail: *Func = nil
    let ctail: *ConstItem = nil
    let btail: *BssItem = nil
    while ps_kind() != TK_EOF {
        while ps_kind() == TK_SEMI { ps_advance() }
        if ps_kind() == TK_EOF { break }
        let k: u32 = ps_kind()
        if k == TK_FUN {
            let f: *Func = parse_fun(ar)
            if p.funcs == nil { p.funcs = f } else { ftail.next = f }
            ftail = f
        }
        if k == TK_CONST {
            let c: *ConstItem = parse_const_decl(ar)
            if p.consts == nil { p.consts = c } else { ctail.next = c }
            ctail = c
        }
        if k == TK_BSS {
            let b: *BssItem = parse_bss_decl(ar)
            if p.bsses == nil { p.bsses = b } else { btail.next = b }
            btail = b
        }
        if k == TK_STRUCT {
            parse_struct_decl(ar)
        }
    }
    let hh: **StrLit = STR_HEAD
    let cc: *u64 = STR_COUNT
    p.strs = hh[0]
    p.nstrs = cc[0]
    return p
}
