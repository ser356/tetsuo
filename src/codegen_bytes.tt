// ============================================================================
// src/codegen_bytes.tt - BYTE backend: from IR to an executable Mach-O
// ============================================================================
//
// It is the sibling of src/codegen.tt. Both walk the same IR and emit the same
// code; the difference is the output format:
//
//     codegen.tt        -> text   "    add     x9, x10, x11\n"  -> clang/as/ld
//     codegen_bytes.tt  -> u32    0x8b0b014a                      -> Mach-O
//
// Their equivalence is neither an accident nor a matter of faith: every `enc_*`
// from asm.tt is paired with the string codegen.tt emits for the same
// instruction, and bootstrap/linux/verify_macho_linux.sh compares both paths.
// If you touch one, touch the other.
//
// HOW FORWARD REFERENCES ARE RESOLVED
//
// When a branch or a call is emitted its target is not known yet, because the
// destination may lie further ahead. Instead of two complete passes, the
// instruction is emitted with the displacement field at ZERO and the hole is
// recorded in a fixup list; at the end the list is walked and the correct
// value is ORed onto each instruction. The OR works precisely because the
// field was left at zero.
//
// There are two patching rounds, in two different address spaces:
//
//   1. cgb_resolve_branches, over offsets INSIDE CB (the code buffer). It
//      resolves b, cbz and bl, which are PC-relative and therefore do not
//      depend on where the binary ends up loaded.
//
//   2. mo_resolve_strings_bss, over offsets inside the already assembled
//      Mach-O IMAGE (that is, shifted by 704 bytes because of the headers). It
//      resolves the adrp+add pairs of string literals and bss symbols, which
//      do depend on the final layout.
//
// STRUCTURE OF THE FILE
//
//   1. Global state (CB, tables) and fixup kinds
//   2. Primitives: writing words, registering labels and fixups
//   3. b_* emitters: one instruction each, wrappers around asm.tt's enc_*
//   4. Register/slot helpers: the register split ir.tt decided
//   5. cgb_i_*: one function per IR opcode
//   6. cgb_fn / codegen_bytes: the driver
//   7. mo_*: assembly of the Mach-O image (literal layout, fixups, signature)
//
// REGISTER CONVENTION (identical to codegen.tt's)
//
//   x0..x7    arguments and return value, AArch64 ABI
//   x9..x9+N  registers assigned by the regalloc (reg_of[slot] + 9)
//   x16, x17  scratch for values spilled to the stack (and x16 also carries
//             the syscall number, and the frame size when it exceeds 4095)
//   x29, x30  frame pointer and return address
//   sp        the spilled slots live at [sp, #slot*8]
//
// The whole compiler goes through here: `--emit=macho` on tetsuo's own source
// code produces a binary with ~106KB of code and 7 pages of __TEXT.
// ============================================================================

// ---------------------------------------------------------------------------
// Global state. All in bss because these are large tables that live for the
// whole compilation and the language has no dynamic memory outside the arenas.
// ---------------------------------------------------------------------------

bss CB: 262144          // code buffer: already encoded instructions
bss CB_POS: 8           // how many bytes CB holds
bss CG_LBL: 262144      // label id -> byte offset in CB (u64)
bss CG_FNOFF: 8192      // function index -> offset of its entry in CB
bss CG_FIX: 393216      // fixups: (pos, kind, target) u64 triples
bss CG_FIXN: 8          // how many fixups there are
bss CG_STROFF: 65536    // str_id -> offset of the literal inside the image
bss CG_ENTRY: 8         // offset of _tt_start, which is the entry point
bss CG_PROG: 8          // *Program, to resolve bss by name in the fixups
bss CG_BSSOFF: 8192     // bss index -> offset inside __DATA
bss CG_BSSUSED: 8192

// ---------------------------------------------------------------------------
// Fixup kinds. `target` means something different in each one:
//
//   FX_B, FX_CBZ     target = label id       -> lbl_get
//   FX_BL            target = function index -> fnoff_get
//   FX_ADRP, FX_PGOF target = str_id         -> cgb_stroff_get
//   FX_ADRPB/PGOFB   target = bss index      -> cgb_bss_off_get
//
// The ADRP/PGOF and ADRPB/PGOFB pairs always travel together: they are the two
// halves of the canonical `adrp Xd, sym` + `add Xd, Xd, #(sym & 4095)`
// sequence.
// ---------------------------------------------------------------------------
const FX_B: u64    = 0   // b   .Llabel     (imm26)
const FX_CBZ: u64  = 1   // cbz w, .Llabel  (imm19)
const FX_BL: u64   = 2   // bl  funcindex   (imm26)
const FX_ADRP: u64 = 3   // adrp of a str_id literal (page)
const FX_PGOF: u64 = 4   // add pageoff of a str_id literal
const FX_ADRPB: u64 = 5  // adrp of a bss symbol (page)
const FX_PGOFB: u64 = 6  // add pageoff of a bss symbol
const FX_IAT: u64 = 7

fun cb_pos() -> u64 {
    let p: *u64 = CB_POS
    return p[0]
}

fun cb_set(v: u64) {
    let p: *u64 = CB_POS
    p[0] = v
}

// Writes an instruction into CB, little-endian, and advances the cursor. It is
// the emission primitive: everything else ends up here.
fun cb_word(w: u64) {
    let cb: *u8 = CB
    let c: u64 = cb_pos()
    cb[c + 0] = w & 255
    cb[c + 1] = (w >> 8) & 255
    cb[c + 2] = (w >> 16) & 255
    cb[c + 3] = (w >> 24) & 255
    cb_set(c + 4)
}

// Label table: id -> offset in CB. It is filled in when the driver reaches the
// IR_LABEL instruction, which may be AFTER branches towards it were emitted;
// that is why branches go through the fixup list.
fun lbl_set(id: u64, off: u64) {
    let p: *u64 = CG_LBL
    p[id] = off
}

fun lbl_get(id: u64) -> u64 {
    let p: *u64 = CG_LBL
    return p[id]
}

// Function table: index in the IR list -> offset of its first instruction in
// CB. Analogous to the label table, but for bl.
fun fnoff_set(idx: u64, off: u64) {
    let p: *u64 = CG_FNOFF
    p[idx] = off
}

fun fnoff_get(idx: u64) -> u64 {
    let p: *u64 = CG_FNOFF
    return p[idx]
}

// Records a hole to be filled in. `pos` is the offset IN CB of the instruction
// whose displacement field was left at zero.
//
// It does not check the CG_FIX limit (16384 triples). The compiler compiling
// itself, which is the largest program processed, uses roughly half.
fun fix_add(pos: u64, kind: u64, target: u64) {
    let n: *u64 = CG_FIXN
    let base: u64 = n[0]
    let f: *u64 = CG_FIX
    f[base * 3 + 0] = pos
    f[base * 3 + 1] = kind
    f[base * 3 + 2] = target
    n[0] = base + 1
}

// Turns a 64-bit instruction into its 32-bit variant.
//
// In AArch64 bit 31 (`sf`) tells the X version from the W one in almost every
// data instruction: clearing it turns `add x9,x10,x11` into `add w9,w10,w11`.
// 2147483647 = 0x7fffffff is the mask that clears it.
//
// It is used to operate on u32 values, where the result must truncate to 32
// bits (and the CPU zeroes the upper half of the X register, which is exactly
// the semantics we want).
fun w32(enc: u64) -> u64 {
    return enc & 2147483647
}

// ---------------------------------------------------------------------------
// Emission primitives: every b_* writes ONE instruction (or a few).
// ---------------------------------------------------------------------------

// Loads a 64-bit constant into rd.
//
// AArch64 cannot put an arbitrary u64 into a register in one go: it has to be
// done in 16-bit chunks with movz (which zeroes the rest) and movk (which
// keeps it). The function splits the immediate into four groups and SKIPS the
// ones that are zero, which is the optimization that matters: the vast
// majority of the constants in a real program fit in 16 bits and come out as
// ONE instruction.
//
// The `first` flag makes the first non-zero group use movz (clearing the rest
// of the register) and the following ones movk. Without it, if the low group
// were zero, we would start with a movk over a register holding garbage.
//
// Zero is handled separately because otherwise the loop would emit nothing.
fun b_movi(rd: u64, imm: u64) {
    if imm == 0 {
        cb_word(enc_movz(rd, 0, 0))
        return
    }
    let g0: u64 = imm & 65535
    let g1: u64 = (imm >> 16) & 65535
    let g2: u64 = (imm >> 32) & 65535
    let g3: u64 = (imm >> 48) & 65535
    let first: u64 = 1
    if g0 != 0 {
        cb_word(enc_movz(rd, g0, 0))
        first = 0
    }
    if g1 != 0 {
        if first == 1 { cb_word(enc_movz(rd, g1, 1))  first = 0 }
        else { cb_word(enc_movk(rd, g1, 1)) }
    }
    if g2 != 0 {
        if first == 1 { cb_word(enc_movz(rd, g2, 2))  first = 0 }
        else { cb_word(enc_movk(rd, g2, 2)) }
    }
    if g3 != 0 {
        if first == 1 { cb_word(enc_movz(rd, g3, 3))  first = 0 }
        else { cb_word(enc_movk(rd, g3, 3)) }
    }
}

fun b_mov_x(rd: u64, rs: u64) {
    cb_word(enc_mov_reg(rd, rs))
}

fun b_mov_w(rd: u64, rs: u64) {
    cb_word(w32(enc_mov_reg(rd, rs)))
}

// Access to locals, always relative to SP (the 31 in the Rn position).
//
// The division by 8 / 4 is no minor detail: the "unsigned offset" form of
// ldr/str encodes the displacement SCALED by the access width, so the field
// carries off/8 for an x, off/4 for a w and off as is for a byte. Passing the
// byte offset undivided would produce an access 8 times further away.
fun b_ldr_x(rt: u64, off: u64) {
    cb_word(enc_ldr_x(rt, 31, off / 8))
}

fun b_str_x(rt: u64, off: u64) {
    cb_word(enc_str_x(rt, 31, off / 8))
}

fun b_ldr_w(rt: u64, off: u64) {
    cb_word(enc_ldr_w(rt, 31, off / 4))
}

fun b_str_w(rt: u64, off: u64) {
    cb_word(enc_str_w(rt, 31, off / 4))
}

fun b_ldrb(rt: u64, off: u64) {
    cb_word(enc_ldrb(rt, 31, off))
}

fun b_strb(rt: u64, off: u64) {
    cb_word(enc_strb(rt, 31, off))
}

fun cgb_normalize(r: u64, width: u64, signed: u64) {
    if width == 1 {
        if signed == 1 { cb_word(enc_sxtb(r, r)) }
        else { cb_word(enc_uxtb(r, r)) }
        return
    }
    if width == 4 {
        if signed == 1 { cb_word(enc_sxtw(r, r)) }
        else { cb_word(enc_uxtw(r, r)) }
    }
}

// ---------------------------------------------------------------------------
// Register/slot helpers (an exact mirror of codegen.tt's)
//
// The register allocator in ir.tt leaves a slot -> register map in fn.reg_of.
// If the value is lower than NREGS, the slot lives in the physical register
// x(value+9); otherwise it is SPILLED and lives on the stack, at
// [sp, #slot*8].
//
// These four functions encapsulate that split so that the cgb_i_* do not have
// to repeat it in every opcode.
// ---------------------------------------------------------------------------

// Register to WRITE the result of a slot into. If it is spilled it returns x16
// as scratch, and cgb_spill then takes care of storing it.
fun cgb_dst_x(fn: *IrFn, slot: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { return ir_phys_reg(r) }
    return 16
}

fun cgb_stack_off(fn: *IrFn, slot: u64) -> u64 {
    if fn.stack_of != nil { return fn.stack_of[slot] * 8 }
    return slot * 8
}

// Stores to the stack if the slot is spilled; if it lives in a register, it
// does nothing. It is always called after cgb_dst_x, forming the
// write/persist pair.
fun cgb_spill(fn: *IrFn, slot: u64, xreg: u64) {
    let ro: *u64 = fn.reg_of
    if ro[slot] < NREGS { return }
    b_str_x(xreg, cgb_stack_off(fn, slot))
}

// Register to READ a slot from. If it lives in a register it is returned
// directly (emitting nothing); if it is spilled, the load is emitted into the
// `scratch` register the caller passes in and that one is returned. The caller
// picks x16 or x17 depending on how many spilled operands can be live at once.
fun cgb_src_x(fn: *IrFn, slot: u64, scratch: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { return ir_phys_reg(r) }
    b_ldr_x(scratch, cgb_stack_off(fn, slot))
    return scratch
}

fun cgb_src_w(fn: *IrFn, slot: u64, scratch: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { return ir_phys_reg(r) }
    b_ldr_w(scratch, cgb_stack_off(fn, slot))
    return scratch
}

fun cgb_load_slot_x(fn: *IrFn, slot: u64, dx: u64) {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { b_mov_x(dx, ir_phys_reg(r))  return }
    b_ldr_x(dx, cgb_stack_off(fn, slot))
}

// Dispatches an IR binop to its encoder. `wide` picks between the 64- and the
// 32-bit variant (see w32).
//
// Everything is unsigned: the language has no signed types, so division is
// udiv and right shifts are logical (lsrv).
fun cgb_alu(binop: u64, rd: u64, ra: u64, rb: u64, wide: u64, signed: u64) {
    let e: u64 = 0
    if binop == OP_ADD { e = enc_add_reg(rd, ra, rb) }
    if binop == OP_SUB { e = enc_sub_reg(rd, ra, rb) }
    if binop == OP_MUL { e = enc_mul(rd, ra, rb) }
    if binop == OP_DIV {
        if signed == 1 { e = enc_sdiv(rd, ra, rb) }
        else { e = enc_udiv(rd, ra, rb) }
    }
    if binop == OP_AND { e = enc_and(rd, ra, rb) }
    if binop == OP_OR  { e = enc_orr(rd, ra, rb) }
    if binop == OP_XOR { e = enc_eor(rd, ra, rb) }
    if binop == OP_SHL { e = enc_lslv(rd, ra, rb) }
    if binop == OP_SHR { e = enc_lsrv(rd, ra, rb) }
    if wide == 1 { cb_word(e) } else { cb_word(w32(e)) }
}

// Translates a comparison code into the INVERTED condition cset needs.
//
// cset is encoded as csinc with the operands set to wzr, and csinc writes 0
// when the condition holds, so the opposite one has to be passed (see enc_cset
// in asm.tt). The incoming cc values are the IR's: 0=eq 1=ne 2=lo 3=ls 4=hi
// 5=hs, and since the language has no signed types, ordering comparisons
// always use the unsigned conditions (lo/ls/hi/hs, not lt/le/gt/ge).
fun cgb_invcond(cc: u64) -> u64 {
    if cc == 0 { return 1 }   // eq -> inv ne
    if cc == 1 { return 0 }   // ne -> inv eq
    if cc == 2 { return 2 }   // lo -> inv hs
    if cc == 3 { return 8 }   // ls -> inv hi
    if cc == 4 { return 9 }   // hi -> inv ls
    if cc == 5 { return 3 }   // hs -> inv lo
    if cc == 6 { return 10 }  // lt -> inv ge
    if cc == 7 { return 12 }  // le -> inv gt
    if cc == 8 { return 13 }  // gt -> inv le
    return 11                 // ge -> inv lt
}

// ---------------------------------------------------------------------------
// One emitter per IR opcode. They all follow the same pattern:
//
//     read the operands with cgb_src_*  (may emit loads if they are spilled)
//     emit the operation into cgb_dst_x
//     cgb_spill the destination
//
// The dispatcher is cgb_instr, further down.
// ---------------------------------------------------------------------------

fun cgb_i_movi(fn: *IrFn, i: *Ins) {
    let xd: u64 = cgb_dst_x(fn, i.dst)
    b_movi(xd, i.imm)
    cgb_spill(fn, i.dst, xd)
}

fun cgb_i_addr_local(fn: *IrFn, i: *Ins) {
    let xd: u64 = cgb_dst_x(fn, i.dst)
    cb_word(enc_add_imm(xd, 31, cgb_stack_off(fn, i.local)))
    cgb_spill(fn, i.dst, xd)
}

fun cgb_i_load_local(fn: *IrFn, i: *Ins) {
    let xd: u64 = cgb_dst_x(fn, i.dst)
    if i.width == 1 {
        b_ldrb(xd, cgb_stack_off(fn, i.local))
    } else if i.width == 4 {
        b_ldr_w(xd, cgb_stack_off(fn, i.local))
    } else {
        b_ldr_x(xd, cgb_stack_off(fn, i.local))
    }
    cgb_normalize(xd, i.width, i.is_signed)
    cgb_spill(fn, i.dst, xd)
}

fun cgb_i_store_local(fn: *IrFn, i: *Ins) {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[i.a]
    let sreg: u64 = 16
    if r < NREGS { sreg = ir_phys_reg(r) }
    else { b_ldr_x(16, cgb_stack_off(fn, i.a)) }
    if i.width == 1 {
        b_strb(sreg, cgb_stack_off(fn, i.local))
    } else if i.width == 4 {
        b_str_w(sreg, cgb_stack_off(fn, i.local))
    } else {
        b_str_x(sreg, cgb_stack_off(fn, i.local))
    }
}

fun cgb_i_load_mem(fn: *IrFn, i: *Ins) {
    let addr: u64 = cgb_src_x(fn, i.a, 17)
    let xd: u64 = cgb_dst_x(fn, i.dst)
    if i.width == 1 {
        cb_word(enc_ldrb(xd, addr, 0))
    } else if i.width == 4 {
        cb_word(enc_ldr_w(xd, addr, 0))
    } else {
        cb_word(enc_ldr_x(xd, addr, 0))
    }
    cgb_normalize(xd, i.width, i.is_signed)
    cgb_spill(fn, i.dst, xd)
}

fun cgb_i_cast(fn: *IrFn, i: *Ins) {
    let src: u64 = cgb_src_x(fn, i.a, 16)
    let dst: u64 = cgb_dst_x(fn, i.dst)
    if dst != src { b_mov_x(dst, src) }
    cgb_normalize(dst, i.width, i.is_signed)
    cgb_spill(fn, i.dst, dst)
}

fun cgb_i_store_mem(fn: *IrFn, i: *Ins) {
    let addr: u64 = cgb_src_x(fn, i.a, 17)
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[i.b]
    let val: u64 = 16
    if r < NREGS { val = ir_phys_reg(r) }
    else { b_ldr_x(16, cgb_stack_off(fn, i.b)) }
    if i.width == 1 {
        cb_word(enc_strb(val, addr, 0))
    } else if i.width == 4 {
        cb_word(enc_str_w(val, addr, 0))
    } else {
        cb_word(enc_str_x(val, addr, 0))
    }
}

fun cgb_i_binop(fn: *IrFn, i: *Ins) {
    let wide: u64 = 0
    if i.width == 8 { wide = 1 }
    let ra: u64 = 0
    let rb: u64 = 0
    if wide == 1 {
        ra = cgb_src_x(fn, i.a, 16)
        rb = cgb_src_x(fn, i.b, 17)
    } else {
        ra = cgb_src_w(fn, i.a, 16)
        rb = cgb_src_w(fn, i.b, 17)
    }
    let rd: u64 = cgb_dst_x(fn, i.dst)
    cgb_alu(i.binop, rd, ra, rb, wide, i.is_signed)
    cgb_spill(fn, i.dst, rd)
}

// Comparison: cmp + cset. It leaves a 0 or a 1 in the destination slot, NOT in
// the flags.
//
// Materializing the condition in a register instead of branching on the flags
// is what lets the IR treat a comparison like any other value (assign it, pass
// it, store it) and makes the conditional branch always a simple cbz on that
// 0/1. It costs one extra instruction and saves having to preserve NZCV
// between IR instructions.
fun cgb_i_cmp(fn: *IrFn, i: *Ins, cc: u64) {
    if i.is_signed == 1 {
        if cc == 2 { cc = 6 }
        if cc == 3 { cc = 7 }
        if cc == 4 { cc = 8 }
        if cc == 5 { cc = 9 }
    }
    let wide: u64 = 0
    if i.width == 8 { wide = 1 }
    let ra: u64 = 0
    let rb: u64 = 0
    if wide == 1 {
        ra = cgb_src_x(fn, i.a, 16)
        rb = cgb_src_x(fn, i.b, 17)
    } else {
        ra = cgb_src_w(fn, i.a, 16)
        rb = cgb_src_w(fn, i.b, 17)
    }
    let rd: u64 = cgb_dst_x(fn, i.dst)
    if wide == 1 { cb_word(enc_cmp_reg(ra, rb)) }
    else { cb_word(w32(enc_cmp_reg(ra, rb))) }
    cb_word(enc_cset(rd, cgb_invcond(cc)))
    cgb_spill(fn, i.dst, rd)
}

// syscall(num, a0, a1, a2): the language builtin.
//
// The macOS ABI wants the number in x16 and the arguments in x0.. The first
// argument of the builtin is the number, so it goes to x16 and the rest shift
// one position (k-1). Then `svc #0x80`, and the result comes out in x0.
//
// It is the only place in the backend that emits svc, and therefore the only
// thing the Linux harness has to rewrite to run these binaries under qemu.
fun cgb_i_syscall(fn: *IrFn, i: *Ins) {
    if get_target() == TGT_WINDOWS { cgb_i_syscall_windows(fn, i); return }
    if get_target() == TGT_LINUX {
        cgb_i_syscall_linux(fn, i)
        return
    }
    let args: *u64 = i.args
    let ro: *u64 = fn.reg_of
    let s0: u64 = args[0]
    let r0: u64 = ro[s0]
    if r0 < NREGS { b_mov_x(16, ir_phys_reg(r0)) }
    else { b_ldr_x(16, cgb_stack_off(fn, s0)) }
    let k: u64 = 1
    while k < i.nargs {
        cgb_load_slot_x(fn, args[k], k - 1)
        k = k + 1
    }
    cb_word(enc_svc(128))
    let dr: u64 = ro[i.dst]
    if dr < NREGS { b_mov_x(ir_phys_reg(dr), 0)  return }
    b_str_x(0, cgb_stack_off(fn, i.dst))
}

fun cgb_windows_call(api: u64) {
    fix_add(cb_pos(), FX_IAT, api)
    cb_word(2415919120)
    fix_add(cb_pos(), FX_IAT, api)
    cb_word(4181721104)
    cb_word(3594453504)
}

fun cgb_i_syscall_windows(fn: *IrFn, i: *Ins) {
    let args: *u64 = i.args
    let k: u64 = 1
    while k < i.nargs { cgb_load_slot_x(fn, args[k], k - 1); k = k + 1 }
    let api: u64 = 0
    if i.imm == 1 { api = 0 }
    else if i.imm == 3 { api = 1 }
    else if i.imm == 4 { api = 2 }
    else if i.imm == 5 { api = 3; if i.label != 0 { b_movi(1, 33537) } else { b_movi(1, 32768) } }
    else if i.imm == 6 { api = 4 }
    else if i.imm == 20 { api = 5 }
    else if i.imm == 10 { api = 6 }
    else if i.imm == 12 { api = 7 }
    else if i.imm == 136 { api = 8 }
    cgb_windows_call(api)
    let ro: *u64 = fn.reg_of
    let dr: u64 = ro[i.dst]
    if dr < NREGS { b_mov_x(ir_phys_reg(dr), 0); return }
    b_str_x(0, cgb_stack_off(fn, i.dst))
}

fun cgb_i_syscall_linux(fn: *IrFn, i: *Ins) {
    let args: *u64 = i.args
    let k: u64 = 1
    while k < i.nargs {
        cgb_load_slot_x(fn, args[k], k - 1)
        k = k + 1
    }
    let nr: u64 = i.imm
    if nr == 1 { b_movi(8, 93) }
    else if nr == 3 { b_movi(8, 63) }
    else if nr == 4 { b_movi(8, 64) }
    else if nr == 5 {
        b_mov_x(3, 2)
        b_mov_x(1, 0)
        b_movi(0, 18446744073709551516)
        let flags: u64 = 0
        if i.label != 0 { flags = 577 }
        b_movi(2, flags)
        b_movi(8, 56)
    }
    else if nr == 6 { b_movi(8, 57) }
    else if nr == 10 { b_mov_x(1, 0); b_movi(0, 18446744073709551516); b_movi(2, 0); b_movi(8, 35) }
    else if nr == 12 { b_movi(8, 49) }
    else if nr == 20 { b_movi(8, 172) }
    else if nr == 136 { b_mov_x(2, 1); b_mov_x(1, 0); b_movi(0, 18446744073709551516); b_movi(8, 34) }
    else { b_movi(8, nr) }
    cb_word(enc_svc(0))
    let ro: *u64 = fn.reg_of
    let dr: u64 = ro[i.dst]
    if dr < NREGS { b_mov_x(ir_phys_reg(dr), 0); return }
    b_str_x(0, cgb_stack_off(fn, i.dst))
}

fun cgb_i_syscall_checked(fn: *IrFn, i: *Ins) {
    cgb_i_syscall(fn, i)
    if get_target() == TGT_LINUX {
        b_movi(15, 63)
        cb_word(enc_lsrv(17, 0, 15))
        cb_word(enc_sub_reg(17, 31, 17))
        cb_word(enc_sub_reg(16, 31, 0))
        cb_word(enc_and(17, 16, 17))
        cgb_load_slot_x(fn, i.args[4], 16)
        cb_word(enc_str_x(17, 16, 0))
        return
    }
    if get_target() == TGT_WINDOWS {
        b_movi(15, 18446744073709551615)
        cb_word(enc_cmp_reg(0, 15))
        cb_word(enc_cset(17, 1))
        cgb_load_slot_x(fn, i.args[4], 16)
        cb_word(enc_str_x(17, 16, 0))
        return
    }
    cb_word(enc_cset(17, 3))
    cgb_load_slot_x(fn, i.args[4], 16)
    cb_word(enc_str_x(17, 16, 0))
}

// Function call.
//
// `syscall` is intercepted by NAME: it is not a real function but a builtin,
// and there is no body to jump to.
//
// For the rest: the arguments are loaded into x0.. in order, an FX_BL fixup is
// recorded and `bl 0` is emitted. The real displacement is filled in by
// cgb_resolve_branches once the offset of every function is known, which
// allows forward calls and recursion with no special case.
//
// The return value arrives in x0 and is moved to the destination slot.
fun cgb_i_call(fn: *IrFn, i: *Ins, funcs: *IrFn) {
    let syskw: str = 'syscall'
    if bytes_eq_at(i.callee_start, i.callee_len, syskw.ptr, 7) == 1 {
        cgb_i_syscall(fn, i)
        return
    }
    let sysck: str = 'syscall_checked'
    if bytes_eq_at(i.callee_start, i.callee_len, sysck.ptr, 15) == 1 {
        cgb_i_syscall_checked(fn, i)
        return
    }
    let args: *u64 = i.args
    let k: u64 = 0
    while k < i.nargs {
        if k == 8 { break }
        cgb_load_slot_x(fn, args[k], k)
        k = k + 1
    }
    let stack_bytes: u64 = 0
    if i.nargs > 8 {
        stack_bytes = ((i.nargs - 8) * 8 + 15) / 16 * 16
        cb_word(enc_add_imm(17, 31, 0))
        if stack_bytes <= 4095 { cb_word(enc_sub_imm(31, 31, stack_bytes)) }
        else { b_movi(16, stack_bytes); cb_word(enc_sub_ext_sp(16)) }
        k = 8
        while k < i.nargs {
            let ro0: *u64 = fn.reg_of
            let rr: u64 = ro0[args[k]]
            if rr < NREGS { b_mov_x(16, ir_phys_reg(rr)) }
            else { cb_word(enc_ldr_x(16, 17, cgb_stack_off(fn, args[k]) / 8)) }
            cb_word(enc_str_x(16, 31, k - 8))
            k = k + 1
        }
    }
    let idx: u64 = find_fn_index(funcs, i.callee_start, i.callee_len)
    fix_add(cb_pos(), FX_BL, idx)
    cb_word(enc_bl(0))
    if stack_bytes > 0 {
        if stack_bytes <= 4095 { cb_word(enc_add_imm(31, 31, stack_bytes)) }
        else { b_movi(16, stack_bytes); cb_word(enc_add_ext_sp(16)) }
    }
    let ro: *u64 = fn.reg_of
    let dr: u64 = ro[i.dst]
    if dr < NREGS { b_mov_x(ir_phys_reg(dr), 0)  return }
    b_str_x(0, cgb_stack_off(fn, i.dst))
}

// Address of a symbol: either a string literal or a bss block.
//
// Both cases emit the same pair of instructions (adrp + add) with the fields
// at zero and two fixups; the only thing that changes is HOW the target will
// later be resolved. The discriminator is callee_len: if it carries a name it
// is a bss symbol, otherwise it is a literal identified by str_id.
//
// The adrp+add sequence is the canonical way of materializing an address in
// AArch64 and it is PC-relative, so it survives the loader sliding the image.
fun cgb_i_label_addr(fn: *IrFn, i: *Ins) {
    let xd: u64 = cgb_dst_x(fn, i.dst)
    if i.callee_len > 0 {
        let bidx: u64 = cgb_bss_index_by_name(cgb_prog_get(), i.callee_start, i.callee_len)
        fix_add(cb_pos(), FX_ADRPB, bidx)
        cb_word(enc_adrp(xd, 0))
        fix_add(cb_pos(), FX_PGOFB, bidx)
        cb_word(enc_add_pageoff(xd, xd, 0))
        cgb_spill(fn, i.dst, xd)
        return
    }
    fix_add(cb_pos(), FX_ADRP, i.str_id)
    cb_word(enc_adrp(xd, 0))
    fix_add(cb_pos(), FX_PGOF, i.str_id)
    cb_word(enc_add_pageoff(xd, xd, 0))
    cgb_spill(fn, i.dst, xd)
}

// Return. It does not emit `ret` directly: it moves the value to x0 and JUMPS
// to the epilogue.
//
// Having a single epilogue per function avoids duplicating the frame
// restoration at every `return` and, above all, guarantees that SP is restored
// exactly once for every time it was adjusted.
//
// i.imm == 0 means "there is a return value"; otherwise it is a bare return.
// The width is decided by the return type of the function.
fun cgb_i_ret(fn: *IrFn, i: *Ins, epi_label: u64) {
    if i.imm == 0 {
        let wide: u64 = 0
        let rt: *Type = fn.ret_type
        if rt != nil {
            if type_width(rt) == 8 { wide = 1 }
        }
        let ro: *u64 = fn.reg_of
        let r: u64 = ro[i.a]
        if wide == 1 {
            if r < NREGS { b_mov_x(0, ir_phys_reg(r)) }
            else { b_ldr_x(0, cgb_stack_off(fn, i.a)) }
        } else {
            if r < NREGS { b_mov_w(0, ir_phys_reg(r)) }
            else { b_ldr_w(0, cgb_stack_off(fn, i.a)) }
        }
    }
    fix_add(cb_pos(), FX_B, epi_label)
    cb_word(enc_b(0))
}

fun cgb_i_jmp(i: *Ins) {
    fix_add(cb_pos(), FX_B, i.label)
    cb_word(enc_b(0))
}

// Branch if zero. The operand is the 0/1 a comparison left behind (or any
// value, when branching on a normal expression). It is read as w because a
// 32-bit cbz is enough for a 0/1 and avoids depending on the upper half.
fun cgb_i_jz(fn: *IrFn, i: *Ins) {
    let wide: u64 = 0
    let types: **Type = fn.slot_types
    if type_width(types[i.a]) == 8 { wide = 1 }
    let sw: u64 = 0
    if wide == 1 { sw = cgb_src_x(fn, i.a, 16) }
    else { sw = cgb_src_w(fn, i.a, 16) }
    fix_add(cb_pos(), FX_CBZ, i.label)
    if wide == 1 { cb_word(enc_cbz_x(sw, 0)) }
    else { cb_word(enc_cbz_w(sw, 0)) }
}

// Dispatcher: one IR instruction -> its emitter.
//
// It is a chain of ifs and not a jump table because the language has neither
// switch nor function pointers. The order is roughly by frequency, although
// the cost is buried under the parser's.
fun cgb_instr(fn: *IrFn, i: *Ins, epi_label: u64, funcs: *IrFn) {
    let op: u64 = i.op
    if op == IR_MOVI        { cgb_i_movi(fn, i);              return }
    if op == IR_LABEL_ADDR  { cgb_i_label_addr(fn, i);        return }
    if op == IR_ADDR_LOCAL  { cgb_i_addr_local(fn, i);        return }
    if op == IR_LOAD_LOCAL  { cgb_i_load_local(fn, i);        return }
    if op == IR_STORE_LOCAL { cgb_i_store_local(fn, i);       return }
    if op == IR_LOAD_MEM    { cgb_i_load_mem(fn, i);          return }
    if op == IR_STORE_MEM   { cgb_i_store_mem(fn, i);         return }
    if op == IR_BINOP       { cgb_i_binop(fn, i);             return }
    if op == IR_CMPEQ       { cgb_i_cmp(fn, i, 0);            return }
    if op == IR_CMPNE       { cgb_i_cmp(fn, i, 1);            return }
    if op == IR_CMPLT       { cgb_i_cmp(fn, i, 2);            return }
    if op == IR_CMPLE       { cgb_i_cmp(fn, i, 3);            return }
    if op == IR_CMPGT       { cgb_i_cmp(fn, i, 4);            return }
    if op == IR_CMPGE       { cgb_i_cmp(fn, i, 5);            return }
    if op == IR_CALL        { cgb_i_call(fn, i, funcs);       return }
    if op == IR_RET         { cgb_i_ret(fn, i, epi_label);    return }
    if op == IR_JMP         { cgb_i_jmp(i);                   return }
    if op == IR_JZ          { cgb_i_jz(fn, i);                return }
    if op == IR_LABEL       { lbl_set(i.label, cb_pos());     return }
    if op == IR_CAST        { cgb_i_cast(fn, i);              return }
}

// ---------------------------------------------------------------------------
// Prologue, epilogue and function entry
// ---------------------------------------------------------------------------

// Prologue:
//
//     stp x29, x30, [sp, #-16]!    saves frame pointer and return, lowers SP
//     mov x29, sp                  (= add x29, sp, #0)
//     sub sp, sp, #frame_bytes     reserves the locals
//
// The imm7 = 126 of the stp is -2 in 7-bit two's complement, and the field is
// scaled by 8, that is -16 bytes.
//
// Reserving the frame has TWO paths because the immediate form of sub only
// reaches 4095. Above that, the size has to be loaded into x16 and the
// register form used, and there lies the important detail: it must be
// enc_sub_ext_sp (EXTENDED register), not enc_sub_reg, because in the shifted
// register form 31 encodes xzr and not SP. With enc_sub_reg the instruction
// ends up as `sub xzr, sp, x16`, which does not touch SP and makes the locals
// trample the caller's frame. That was the session C2 bug.
//
// frame_bytes is always a multiple of 16 (finalize_frame in ir.tt rounds it
// up), which keeps SP 16-byte aligned as the AArch64 ABI on Darwin requires: a
// misaligned SP makes any SP-relative access fault.
fun cgb_prologue(fn: *IrFn) {
    cb_word(enc_stp_pre(29, 30, 31, 126))
    cb_word(enc_add_imm(29, 31, 0))
    let i: u64 = 0
    while i < fn.callee_count {
        cb_word(enc_stp_pre(19 + i, 20 + i, 31, 126))
        i = i + 2
    }
    if fn.frame_bytes > 0 {
        if fn.frame_bytes <= 4095 {
            cb_word(enc_sub_imm(31, 31, fn.frame_bytes))
        } else {
            b_movi(16, fn.frame_bytes)
            cb_word(enc_sub_ext_sp(16))
        }
    }
}

// Epilogue, undoing the prologue in reverse order. It is the target of the
// branch every IR_RET emits, hence it starts by fixing its own label.
fun cgb_epilogue(fn: *IrFn, epi_label: u64) {
    lbl_set(epi_label, cb_pos())
    if fn.frame_bytes > 0 {
        if fn.frame_bytes <= 4095 {
            cb_word(enc_add_imm(31, 31, fn.frame_bytes))
        } else {
            b_movi(16, fn.frame_bytes)
            cb_word(enc_add_ext_sp(16))
        }
    }
    let i: u64 = fn.callee_count
    if i % 2 != 0 { i = i + 1 }
    while i > 0 {
        i = i - 2
        cb_word(enc_ldp_post(19 + i, 20 + i, 31, 2))
    }
    cb_word(enc_ldp_post(29, 30, 31, 2))
    cb_word(enc_ret())
}

// Stores parameter k (which arrives in xk per the ABI) into its stack slot.
//
// Spilling EVERY parameter right on entry simplifies the backend enormously:
// from then on a parameter is just another local and there is no need to track
// which argument registers are still live. The regalloc can lift them back
// into registers afterwards.
//
// The width of the store depends on the declared type: strb for u8, str w for
// u32, str x for the rest. Storing 8 bytes of a u8 parameter would write over
// the neighbouring slot.
fun cgb_param_spill(fn: *IrFn, k: u64) {
    let w: u64 = 8
    let pts: **Type = fn.param_types
    if pts != nil {
        let pt: *Type = pts[k]
        if pt != nil {
            let tw: u64 = type_width(pt)
            if tw == 1 { w = 1 }
            if tw == 4 { w = 4 }
        }
    }
    if k >= 8 {
        cb_word(enc_ldr_x(16, 29, k - 6))
        if w == 1 { b_strb(16, cgb_stack_off(fn, k)); return }
        if w == 4 { b_str_w(16, cgb_stack_off(fn, k)); return }
        b_str_x(16, cgb_stack_off(fn, k))
        return
    }
    if w == 1 { b_strb(k, cgb_stack_off(fn, k))  return }
    if w == 4 { b_str_w(k, cgb_stack_off(fn, k))  return }
    b_str_x(k, cgb_stack_off(fn, k))
}

// Emits a complete function: prologue, parameter spilling, instructions and
// epilogue.
fun cgb_fn(fn: *IrFn, epi_label: u64, funcs: *IrFn) {
    cgb_prologue(fn)
    let k: u64 = 0
    while k < fn.nparams {
        cgb_param_spill(fn, k)
        k = k + 1
    }
    let it: *Ins = fn.head
    while it != nil {
        cgb_instr(fn, it, epi_label, funcs)
        it = it.next
    }
    cgb_epilogue(fn, epi_label)
}

// Looks up the index of a function by name, walking the IR list.
//
// The name is nowhere stored as a string: `cs`/`cl` are a range inside the
// source buffer (see the note in lexer.tt), which is why LX_STATE has to be
// read to obtain the base pointer.
//
// It is a linear search per call, that is O(calls * functions). With the ~700
// functions of the compiler that is expensive but tolerable, and it avoids
// having to build a symbol table.
//
// Returning 0 when nothing is found is optimistic: a call to a non-existent
// function ends up jumping to the first one. The parser should have caught it
// earlier.
fun find_fn_index(funcs: *IrFn, cs: u64, cl: u64) -> u64 {
    let lx: *Lexer = LX_STATE
    let target: *u8 = lx.src + cs
    let idx: u64 = 0
    let fn: *IrFn = funcs
    while fn != nil {
        if fn.name_len == cl {
            if bytes_eq(lx.src + fn.name_start, target, cl) == 1 {
                return idx
            }
        }
        idx = idx + 1
        fn = fn.next
    }
    return 0
}

// Patches an instruction already emitted into CB by ORing in the missing bits.
//
// It works because the field was left at zero on emission. Were that not the
// case, it would have to be masked first, and an OR over bits already set
// would produce a different instruction.
fun cb_patch_or(pos: u64, extra: u64) {
    let cb: *u8 = CB
    let w: u64 = cb[pos] | (cb[pos + 1] << 8) | (cb[pos + 2] << 16) | (cb[pos + 3] << 24)
    w = w | extra
    cb[pos + 0] = w & 255
    cb[pos + 1] = (w >> 8) & 255
    cb[pos + 2] = (w >> 16) & 255
    cb[pos + 3] = (w >> 24) & 255
}

// FIRST PATCHING ROUND: internal branches (b, cbz, bl).
//
// It can be done here, over CB offsets, because all three are PC-relative and
// therefore independent of where the binary ends up loaded. The displacement
// is counted in instructions, hence the division by 4.
//
// The subtractions produce negative values for backward branches; since
// everything is a u64, that becomes an enormous number and masking to 26 or 19
// bits trims it to the correct two's complement.
//
// The adrp/add pairs of literals and bss are NOT touched here: they depend on
// the final virtual addresses, which are only known when the Mach-O image is
// assembled. mo_resolve_strings_bss takes care of that.
fun cgb_resolve_branches() {
    let n: *u64 = CG_FIXN
    let f: *u64 = CG_FIX
    let count: u64 = n[0]
    let i: u64 = 0
    while i < count {
        let pos: u64 = f[i * 3 + 0]
        let kind: u64 = f[i * 3 + 1]
        let target: u64 = f[i * 3 + 2]
        if kind == FX_B {
            let disp: u64 = (lbl_get(target) - pos) / 4
            cb_patch_or(pos, disp & 67108863)
        }
        if kind == FX_CBZ {
            let disp: u64 = (lbl_get(target) - pos) / 4
            cb_patch_or(pos, (disp & 524287) << 5)
        }
        if kind == FX_BL {
            let disp: u64 = (fnoff_get(target) - pos) / 4
            cb_patch_or(pos, disp & 67108863)
        }
        i = i + 1
    }
}

// Largest label id used by the control flow, plus one.
//
// It is needed because the epilogues require labels of their own and they are
// assigned AFTER the ones the lowering created: starting from this maximum,
// one epilogue per function, they collide with no existing label.
fun cgb_max_label(funcs: *IrFn) -> u64 {
    let m: u64 = 0
    let fn: *IrFn = funcs
    while fn != nil {
        let it: *Ins = fn.head
        while it != nil {
            if it.op == IR_LABEL { if it.label >= m { m = it.label + 1 } }
            if it.op == IR_JMP   { if it.label >= m { m = it.label + 1 } }
            if it.op == IR_JZ    { if it.label >= m { m = it.label + 1 } }
            it = it.next
        }
        fn = fn.next
    }
    return m
}

// str_id -> offset of the literal INSIDE THE Mach-O IMAGE (not inside CB).
// It is filled in by mo_string_layout(_bss) when deciding where each string
// goes.
fun cgb_stroff_set(id: u64, off: u64) {
    let p: *u64 = CG_STROFF
    p[id] = off
}

fun cgb_stroff_get(id: u64) -> u64 {
    let p: *u64 = CG_STROFF
    return p[id]
}

// ---------------------------------------------------------------------------
// Driver of the byte backend
//
// It leaves CB holding the complete code, CB_POS its size and CG_ENTRY the
// offset of the entry point. Afterwards emit_macho_code_bss has to be called
// to wrap it in a Mach-O.
//
// The emitted code ALWAYS starts with _tt_start, which is what the binary's
// LC_MAIN points at:
//
//     bl   _main            <- fixup by name, like any other call
//     movz x16, #1          <- SYS_exit
//     svc  #0x80
//
// That is: the value main() returns becomes the exit code of the process
// without going through libc. It is what allows almost every test in tests/ to
// be "a program that returns a number".
//
// The epilogue labels are numbered from cgb_max_label so as not to collide
// with the lowering's, and one is assigned per function (epi + 1 each round).
fun codegen_bytes(target: u64, prog: *Program, funcs: *IrFn) {
    cgb_prog_set(prog)
    set_target(target)
    cb_set(0)
    let fn0: *u64 = CG_FIXN
    fn0[0] = 0

    let maxl: u64 = cgb_max_label(funcs)

    let entry: *u64 = CG_ENTRY
    entry[0] = cb_pos()
    let main_kw: str = 'main'
    let mi: u64 = fn_index_by_name(funcs, main_kw.ptr, 4)
    if target == TGT_LINUX {
        cb_word(enc_ldr_x(0, 31, 0))
        cb_word(enc_add_imm(1, 31, 8))
    }
    if target == TGT_WINDOWS {
        cgb_windows_call(9)
        cb_word(enc_ldr_w(19, 0, 0))
        cgb_windows_call(10)
        cb_word(enc_ldr_x(1, 0, 0))
        b_mov_w(0, 19)
    }
    fix_add(cb_pos(), FX_BL, mi)
    cb_word(enc_bl(0))
    if target == TGT_LINUX {
        cb_word(enc_movz(8, 93, 0))
        cb_word(enc_svc(0))
    } else if target == TGT_WINDOWS {
        cgb_windows_call(0)
    } else {
        cb_word(enc_movz(16, 1, 0))
        cb_word(enc_svc(128))
    }

    // functions
    let epi: u64 = maxl
    let idx: u64 = 0
    let fn: *IrFn = funcs
    while fn != nil {
        fnoff_set(idx, cb_pos())
        cgb_fn(fn, epi, funcs)
        epi = epi + 1
        idx = idx + 1
        fn = fn.next
    }

    cgb_resolve_branches()
}

// --- writer with string literal relocation (__cstring inside __TEXT) ---

// ---------------------------------------------------------------------------
// Assembly of the Mach-O image
//
// From here on the work happens over MO_IMG (see src/macho.tt), not over CB.
// The offsets are FILE offsets, that is, they already include the headers: 552
// in the path without bss and 704 in the path with bss.
// ---------------------------------------------------------------------------

// The literals are 8-aligned so that a `str` can be read with aligned accesses
// and so that the layout is deterministic (which matters for the fixpoint).
fun mo_align8(v: u64) -> u64 {
    return ((v + 7) / 8) * 8
}

// in-place patch (OR) of a 32-bit word in MO_IMG
// The equivalent of cb_patch_or but over MO_IMG. Same reasoning: the field was
// left at zero, so an OR is enough.
//
// It only touches the 4 bytes of the instruction: the bits of `extra` above 32
// are discarded on rewrite, which acts as a safety net if a displacement was
// miscomputed.
fun img_or(off: u64, extra: u64) {
    let img: *u8 = MO_IMG
    let w: u64 = img[off] | (img[off + 1] << 8) | (img[off + 2] << 16) | (img[off + 3] << 24)
    w = w | extra
    img[off + 0] = w & 255
    img[off + 1] = (w >> 8) & 255
    img[off + 2] = (w >> 16) & 255
    img[off + 3] = (w >> 24) & 255
}

// Places the string literals after the code and returns the total size of the
// __text section.
//
// The strings live INSIDE __TEXT, not in a separate __cstring: they are read
// only, so they share a segment with the code and that saves a whole segment.
// Each one carries its null terminator because the runtime passes pointers to
// syscalls that expect C strings (open, above all).
//
// Version for the path WITHOUT bss (base offset 552).
fun mo_string_layout(prog: *Program, code_len: u64) -> u64 {
    let cursor: u64 = 552 + code_len
    let it: *StrLit = prog.strs
    while it != nil {
        cursor = mo_align8(cursor)
        cgb_stroff_set(it.id, cursor)
        cursor = cursor + it.slen + 1
        it = it.next
    }
    return cursor - 552
}

// SECOND PATCHING ROUND (path without bss): the adrp+add pairs of literals.
//
// The final addresses are known by now, so the page difference can be
// computed. Since __TEXT is mapped at 0x100000000, which is a multiple of
// 4096, the page difference between two positions of the image is the same as
// between their file offsets: that is why dividing the offsets by 4096 without
// adding the base is enough.
fun mo_resolve_strings() {
    let n: *u64 = CG_FIXN
    let f: *u64 = CG_FIX
    let count: u64 = n[0]
    let i: u64 = 0
    while i < count {
        let pos: u64 = f[i * 3 + 0]
        let kind: u64 = f[i * 3 + 1]
        let target: u64 = f[i * 3 + 2]
        if kind == FX_ADRP {
            let instr: u64 = 552 + pos
            let tgt: u64 = cgb_stroff_get(target)
            let imm21: u64 = ((tgt / 4096) - (instr / 4096)) & 2097151
            let lo: u64 = imm21 & 3
            let hi: u64 = (imm21 >> 2) & 524287
            img_or(instr, (lo << 29) | (hi << 5))
        }
        if kind == FX_PGOF {
            let instr2: u64 = 552 + pos
            let tgt2: u64 = cgb_stroff_get(target)
            img_or(instr2, (tgt2 & 4095) << 10)
        }
        i = i + 1
    }
}

// Assembles and writes the Mach-O of the path WITHOUT bss (a single __TEXT
// page).
//
// Order of operations, which matters: headers, code, literals, PATCHING,
// padding and finally the signature. Anything written after the signature
// would invalidate it.
fun emit_macho_code(fd: u64, prog: *Program, code_len: u64, entry_off: u64) {
    let img: *u8 = MO_IMG
    let tsize: u64 = mo_string_layout(prog, code_len)
    // this path pins __TEXT to a single 16KB page
    if 552 + tsize > 16384 {
        io_exit(72)
    }
    mo_uuid_from_code(CB, code_len)
    mc_set(0)
    mo_emit_headers(img, tsize, entry_off)
    // copies the code
    let cb: *u8 = CB
    let bi: u64 = 0
    while bi < code_len {
        e8(img, cb[bi])
        bi = bi + 1
    }
    // literals: pads to each assigned offset and writes bytes + null
    let it: *StrLit = prog.strs
    while it != nil {
        let off: u64 = cgb_stroff_get(it.id)
        while mc_get() < off {
            e8(img, 0)
        }
        let k: u64 = 0
        while k < it.slen {
            e8(img, it.bytes[k])
            k = k + 1
        }
        e8(img, 0)
        it = it.next
    }
    // patches the literal relocations
    mo_resolve_strings()
    // padding up to 0x4000, signature and write
    let cur: u64 = mc_get()
    ezeros(img, 16384 - cur)
    mo_sign_and_write(fd, img)
}

// Like find_fn_index, but comparing against a string literal instead of
// against a range of the source buffer. It is used to locate `main` from
// _tt_start.
fun fn_index_by_name(funcs: *IrFn, name: *u8, nlen: u64) -> u64 {
    let lx: *Lexer = LX_STATE
    let idx: u64 = 0
    let fn: *IrFn = funcs
    while fn != nil {
        if fn.name_len == nlen {
            if bytes_eq(lx.src + fn.name_start, name, nlen) == 1 {
                return idx
            }
        }
        idx = idx + 1
        fn = fn.next
    }
    return 0
}

// ============================================================================
// bss support (milestone 24.g): __DATA,__bss and multi-page __TEXT
// ============================================================================
//
// Everything that follows duplicates the functions above with base offset 704
// instead of 552, and adds the resolution of the fixups against bss symbols.
//
// The *Program is kept in a global because cgb_i_label_addr needs to resolve a
// bss name to its index and does not have the Program at hand in its
// signature.

fun cgb_prog_set(p: *Program) {
    let s: **Program = CG_PROG
    s[0] = p
}

fun cgb_prog_get() -> *Program {
    let s: **Program = CG_PROG
    return s[0]
}

fun cgb_bss_off_set(idx: u64, off: u64) {
    let p: *u64 = CG_BSSOFF
    p[idx] = off
}

fun cgb_bss_off_get(idx: u64) -> u64 {
    let p: *u64 = CG_BSSOFF
    return p[idx]
}

fun cgb_bss_name_before(a: *BssItem, b: *BssItem) -> u64 {
    let lx: *Lexer = LX_STATE
    let n: u64 = a.name_len
    if b.name_len < n { n = b.name_len }
    let i: u64 = 0
    while i < n {
        let ac: u8 = lx.src[a.name_start + i]
        let bc: u8 = lx.src[b.name_start + i]
        if ac < bc { return 1 }
        if ac > bc { return 0 }
        i = i + 1
    }
    if a.name_len < b.name_len { return 1 }
    return 0
}

// Assigns every bss symbol its offset inside __DATA and returns the total size
// of the segment.
//
// The order is the declaration order, that is the order of the entry point's
// `import`s: that is why IO_BUF (declared in src/runtime/io.tt, the first
// import) always lands at offset 0.
//
// Each block is 8-aligned and the total is rounded up to 16KB because an
// LC_SEGMENT_64 has to span a whole number of virtual pages, and on arm64
// macOS the page is 16KB.
//
// A program with no bss at all yields 0 here; emit_macho_code_bss corrects
// that to one page so as not to emit a zero-sized segment.
fun cgb_bss_layout(prog: *Program) -> u64 {
    let it: *BssItem = prog.bsses
    let count: u64 = 0
    while it != nil { count = count + 1; it = it.next }
    let used: *u64 = CG_BSSUSED
    let idx: u64 = 0
    while idx < count { used[idx] = 0; idx = idx + 1 }
    let cursor: u64 = 0
    let rank: u64 = 0
    while rank < count {
        it = prog.bsses
        idx = 0
        let best: *BssItem = nil
        let best_idx: u64 = 0
        while it != nil {
            if used[idx] == 0 {
                if best == nil {
                    best = it
                    best_idx = idx
                } else if cgb_bss_name_before(it, best) == 1 {
                    best = it
                    best_idx = idx
                }
            }
            idx = idx + 1
            it = it.next
        }
        cgb_bss_off_set(best_idx, cursor)
        cursor = cursor + ((best.size + 7) / 8) * 8
        used[best_idx] = 1
        rank = rank + 1
    }
    if cursor == 0 { return 0 }
    return ((cursor + 16383) / 16384) * 16384
}

// Index of a bss symbol by name. It walks the same list in the same order as
// cgb_bss_layout, which is what guarantees that the indices match.
fun cgb_bss_index_by_name(prog: *Program, s: u64, n: u64) -> u64 {
    let lx: *Lexer = LX_STATE
    let it: *BssItem = prog.bsses
    let idx: u64 = 0
    while it != nil {
        if it.name_len == n {
            if bytes_eq(lx.src + it.name_start, lx.src + s, n) == 1 {
                return idx
            }
        }
        idx = idx + 1
        it = it.next

    }
    return 0
}

// Same as mo_string_layout but with the base offset 704 of the path with bss.
fun mo_string_layout_bss(prog: *Program, code_len: u64) -> u64 {
    let cursor: u64 = 704 + code_len
    let it: *StrLit = prog.strs
    while it != nil {
        cursor = mo_align8(cursor)
        cgb_stroff_set(it.id, cursor)
        cursor = cursor + it.slen + 1
        it = it.next
    }
    return cursor - 704
}

// SECOND PATCHING ROUND (path with bss): literals AND bss symbols.
//
// This is where text_pages comes in, and where the bug that opened session C3a
// lived: the base address of __bss was computed as 16384 + offset, that is,
// assuming __TEXT took ONE page. In a 7-page binary every bss access pointed
// six 16KB pages before where it should, that is, inside __TEXT. It is now
// derived from text_pages.
//
// About the masking to 21 bits: the page subtraction can go negative (it does
// not here, because the strings sit after the code and the bss after __TEXT,
// but the arithmetic does not know that). Without the mask, a negative value
// converted to u64 would give a gigantic `hi` whose left shift would leak onto
// opcode bits.
fun mo_resolve_strings_bss(text_pages: u64) {
    let text_vmsize: u64 = text_pages * 16384
    let n: *u64 = CG_FIXN
    let f: *u64 = CG_FIX
    let count: u64 = n[0]
    let i: u64 = 0
    while i < count {
        let pos: u64 = f[i * 3 + 0]
        let kind: u64 = f[i * 3 + 1]
        let target: u64 = f[i * 3 + 2]
        if kind == FX_ADRP {
            let instr: u64 = 704 + pos
            let tgt: u64 = cgb_stroff_get(target)
            let imm21: u64 = ((tgt / 4096) - (instr / 4096)) & 2097151
            let lo: u64 = imm21 & 3
            let hi: u64 = (imm21 >> 2) & 524287
            img_or(instr, (lo << 29) | (hi << 5))
        }
        if kind == FX_PGOF {
            let instr2: u64 = 704 + pos
            let tgt2: u64 = cgb_stroff_get(target)
            img_or(instr2, (tgt2 & 4095) << 10)
        }
        if kind == FX_ADRPB {
            let instr3: u64 = 704 + pos
            let bpage: u64 = (text_vmsize + cgb_bss_off_get(target)) / 4096
            let ipage: u64 = instr3 / 4096
            let imm21b: u64 = (bpage - ipage) & 2097151
            let lob: u64 = imm21b & 3
            let hib: u64 = (imm21b >> 2) & 524287
            img_or(instr3, (lob << 29) | (hib << 5))
        }
        if kind == FX_PGOFB {
            let instr4: u64 = 704 + pos
            let bvaddr: u64 = text_vmsize + cgb_bss_off_get(target)
            img_or(instr4, (bvaddr & 4095) << 10)
        }
        i = i + 1
    }
}

// Assembles and writes the Mach-O of the path WITH bss. It is the output of
// `--emit=macho`.
//
// text_pages is computed from the real size: headers (704) plus code plus
// literals, rounded up to 16KB pages. From it come, at once, the vmsize of
// __TEXT, the base address of __DATA and the number of signature hashes; all
// three coming from the same place is what makes the binary consistent.
//
// Order: UUID (which depends on the code), headers (which carry the UUID
// inside), code, literals, patching, padding up to the end of the last page
// and signature.
fun emit_macho_code_bss(fd: u64, prog: *Program, code_len: u64, entry_off: u64, bss_vmsize: u64) {
    let img: *u8 = MO_IMG
    let tsize: u64 = mo_string_layout_bss(prog, code_len)
    let text_pages: u64 = ((704 + tsize + 16383) / 16384)
    // an LC_SEGMENT_64 with vmsize 0 would make __DATA and __LINKEDIT share a
    // vmaddr; we always reserve at least one page.
    let bvs: u64 = bss_vmsize
    if bvs == 0 { bvs = 16384 }
    mo_uuid_from_code(CB, code_len)
    mc_set(0)
    mo_emit_headers_bss(img, tsize, text_pages, entry_off, bvs)
    let cb: *u8 = CB
    let bi: u64 = 0
    while bi < code_len {
        e8(img, cb[bi])
        bi = bi + 1
    }
    let it: *StrLit = prog.strs
    while it != nil {
        let off: u64 = cgb_stroff_get(it.id)
        while mc_get() < off {
            e8(img, 0)
        }
        let k: u64 = 0
        while k < it.slen {
            e8(img, it.bytes[k])
            k = k + 1
        }
        e8(img, 0)
        it = it.next
    }
    mo_resolve_strings_bss(text_pages)
    let cur: u64 = mc_get()
    let text_end: u64 = text_pages * 16384
    ezeros(img, text_end - cur)
    mo_sign_and_write_n(fd, img, text_pages)
}
