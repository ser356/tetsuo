// ============================================================================
// src/codegen.tt - backend TEXTUAL: del IR a ensamblador AArch64
// ============================================================================
//
// Emite el .s que despues ensambla y enlaza clang. Es el backend original y
// sigue siendo el camino de referencia: cuando algo falla en el binario que
// produce src/codegen_bytes.tt, la pregunta es siempre "y por este camino que
// sale", porque este esta validado por un ensamblador de verdad.
//
// LA RELACION CON codegen_bytes.tt
//
// Los dos ficheros son la misma funcion escrita dos veces, una a texto y otra a
// bytes. Cada emit_i_* de aqui tiene su cgb_i_* alli, en el mismo orden,
// haciendo las mismas elecciones de registro y emitiendo las mismas
// instrucciones. Esa correspondencia es lo que permite comparar los dos
// caminos instruccion a instruccion, que es la prueba mas fuerte que hay de que
// el backend de bytes es correcto (ver bootstrap/linux/verify_macho_linux.sh).
//
// Si tocas uno, toca el otro. Y si dudas de cual es la verdad, es este.
//
// COMO SE EMITE EL TEXTO
//
// No hay printf ni formato: todo se construye concatenando literales y numeros
// con las funciones de lib/fmt.tt. Las funciones out_* de este fichero son los
// trozos reutilizables (un registro, una cola `, [sp, #N]`, un mnemonico con su
// sangrado). Por eso el codigo se lee raro: cada instruccion son varias
// llamadas seguidas.
//
// El formato de salida tiene que ser DETERMINISTA hasta el ultimo espacio: el
// fixpoint (tests/fixpoint_build.sh) compara el .s generado byte a byte entre
// generaciones del compilador. De ahi el sangrado de ancho fijo y los
// inmediatos siempre en hexadecimal de 4 digitos.
//
// LOS DOS TARGETS
//
//   TGT_VIRT   salida "neutra", sin secciones ni prefijo de simbolo. Es la que
//              usan las pruebas del propio codegen.
//   TGT_MACOS  Mach-O real: secciones __TEXT,__text y __TEXT,__cstring, bss con
//              .zerofill __DATA,__bss, simbolos con guion bajo delante y el
//              punto de entrada _tt_start.
//
// El target se guarda en un global (G_TARGET) por la misma razon que el parser
// guarda el suyo: evitar arrastrar un parametro por decenas de funciones.
// ============================================================================

const TGT_VIRT:  u64 = 0
const TGT_MACOS: u64 = 1
const TGT_LINUX: u64 = 2
bss G_TARGET: 8

fun set_target(t: u64) {
    let p: *u64 = G_TARGET
    p[0] = t
}

fun get_target() -> u64 {
    let p: *u64 = G_TARGET
    return p[0]
}

// ---------------------------------------------------------------------------
// Piezas de texto reutilizables
// ---------------------------------------------------------------------------

// Un registro asignado por el regalloc: el numero logico r se imprime como
// x(r+9) o w(r+9). El desplazamiento de 9 es el que reserva x0..x8 para
// argumentos y retorno. 120 = 'x', 119 = 'w'.
fun out_reg_x(o: *Out, r: u64) {
    out_byte(o, 120)
    out_u64(o, r + 9)
}

fun out_reg_w(o: *Out, r: u64) {
    out_byte(o, 119)
    out_u64(o, r + 9)
}

fun out_x_n(o: *Out, n: u64) {
    out_byte(o, 120)
    out_u64(o, n)
}

fun out_w_n(o: *Out, n: u64) {
    out_byte(o, 119)
    out_u64(o, n)
}

// Un registro fisico concreto, en su forma de 64 o de 32 bits segun `wide`.
fun out_reg_wx(o: *Out, n: u64, wide: u64) {
    if wide == 1 {
        out_x_n(o, n)
        return
    }
    out_w_n(o, n)
}

// Mnemonico de acceso a memoria, ya sangrado y con el relleno hasta la columna
// de los operandos: 0=ldr, 1=str, 2=ldrb, 3=strb.
//
// El ancho fijo del sangrado no es cosmetico: el fixpoint compara el .s byte a
// byte.
fun out_mn(o: *Out, mn: u64) {
    if mn == 0 { let s0: str = '    ldr     '; out_bytes(o, s0.ptr, s0.len); return }
    if mn == 1 { let s1: str = '    str     '; out_bytes(o, s1.ptr, s1.len); return }
    if mn == 2 { let s2: str = '    ldrb    '; out_bytes(o, s2.ptr, s2.len); return }
    let s3: str = '    strb    '
    out_bytes(o, s3.ptr, s3.len)
}

// La cola `, [sp, #N]` de un acceso a un local, y `, [xN]` de un acceso por
// puntero. Se llaman "tail" porque completan una linea que empezo con out_mn.
fun out_sp_tail(o: *Out, off: u64) {
    let s0: str = ', [sp, #'
    out_bytes(o, s0.ptr, s0.len)
    out_u64(o, off)
    let s1: str = ']\n'
    out_bytes(o, s1.ptr, s1.len)
}

fun out_mem_tail(o: *Out, addr_x: u64) {
    let s0: str = ', ['
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, addr_x)
    let s1: str = ']\n'
    out_bytes(o, s1.ptr, s1.len)
}

// Carga una constante de 64 bits, en trozos de 16 bits.
//
// Es el equivalente textual de b_movi en codegen_bytes.tt y sigue la misma
// logica: movz para el primer grupo no nulo (limpia el resto del registro) y
// movk para los demas, saltando los que valen cero.
//
// La division por 65536 sustituye a un desplazamiento porque este fichero es
// anterior a que el lenguaje tuviera >>.
fun emit_movi(o: *Out, xreg: u64, imm: u64) {
    let a: u64 = imm / 65536
    let g0: u64 = imm - a * 65536
    let b: u64 = a / 65536
    let g1: u64 = a - b * 65536
    let c: u64 = b / 65536
    let g2: u64 = b - c * 65536
    let g3: u64 = c

    if imm == 0 {
        let s0: str = '    mov     '
        out_bytes(o, s0.ptr, s0.len)
        out_x_n(o, xreg)
        let s0b: str = ', #0\n'
        out_bytes(o, s0b.ptr, s0b.len)
        return
    }

    let first_i: u64 = 4
    let first_g: u64 = 0
    if g0 != 0 { first_i = 0; first_g = g0 }
    if first_i == 4 {
        if g1 != 0 { first_i = 1; first_g = g1 }
    }
    if first_i == 4 {
        if g2 != 0 { first_i = 2; first_g = g2 }
    }
    if first_i == 4 {
        if g3 != 0 { first_i = 3; first_g = g3 }
    }

    let s1: str = '    movz    '
    out_bytes(o, s1.ptr, s1.len)
    out_x_n(o, xreg)
    let s1b: str = ', #0x'
    out_bytes(o, s1b.ptr, s1b.len)
    out_hex4(o, first_g)
    if first_i > 0 {
        let s1c: str = ', lsl #'
        out_bytes(o, s1c.ptr, s1c.len)
        out_u64(o, first_i * 16)
    }
    out_byte(o, 10)

    let idx: u64 = first_i + 1
    while idx < 4 {
        let g: u64 = 0
        if idx == 1 { g = g1 }
        if idx == 2 { g = g2 }
        if idx == 3 { g = g3 }
        if g != 0 {
            let s2: str = '    movk    '
            out_bytes(o, s2.ptr, s2.len)
            out_x_n(o, xreg)
            let s2b: str = ', #0x'
            out_bytes(o, s2b.ptr, s2b.len)
            out_hex4(o, g)
            let s2c: str = ', lsl #'
            out_bytes(o, s2c.ptr, s2c.len)
            out_u64(o, idx * 16)
            out_byte(o, 10)
        }
        idx = idx + 1
    }
}

// Puntero al buffer de fuente, para recuperar nombres de simbolo a partir de
// los rangos (start, len) que guardan el AST y el IR.
bss G_SRC: 8

fun set_src(p: *u8) {
    let sp: **u8 = G_SRC
    sp[0] = p
}

fun get_src() -> *u8 {
    let sp: **u8 = G_SRC
    return sp[0]
}

// ---------------------------------------------------------------------------
// Registro contra pila: el mismo criterio que en codegen_bytes.tt.
//
// reg_of[slot] < NREGS  ->  vive en x(reg_of[slot] + 9)
// en otro caso          ->  esta derramado, en [sp, #slot*8]
// ---------------------------------------------------------------------------

fun slot_off(fn: *IrFn, slot: u64) -> u64 {
    return slot * 8
}

fun in_reg(fn: *IrFn, slot: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    if ro[slot] < NREGS { return 1 }
    return 0
}

fun dst_x_reg(fn: *IrFn, slot: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { return r + 9 }
    return 16
}

fun emit_ldr_x(o: *Out, xreg: u64, off: u64) {
    let s0: str = '    ldr     '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, xreg)
    let s1: str = ', [sp, #'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, off)
    let s2: str = ']\n'
    out_bytes(o, s2.ptr, s2.len)
}

fun emit_str_x(o: *Out, xreg: u64, off: u64) {
    let s0: str = '    str     '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, xreg)
    let s1: str = ', [sp, #'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, off)
    let s2: str = ']\n'
    out_bytes(o, s2.ptr, s2.len)
}

fun emit_mov_x_x(o: *Out, dx: u64, sx: u64) {
    let s0: str = '    mov     '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, dx)
    let s1: str = ', '
    out_bytes(o, s1.ptr, s1.len)
    out_x_n(o, sx)
    out_byte(o, 10)
}

fun emit_mov_w_w(o: *Out, dw: u64, sw: u64) {
    let s0: str = '    mov     '
    out_bytes(o, s0.ptr, s0.len)
    out_w_n(o, dw)
    let s1: str = ', '
    out_bytes(o, s1.ptr, s1.len)
    out_w_n(o, sw)
    out_byte(o, 10)
}

fun emit_ldr_w(o: *Out, wreg: u64, off: u64) {
    out_mn(o, 0)
    out_w_n(o, wreg)
    out_sp_tail(o, off)
}

fun emit_load_slot_to_x(o: *Out, fn: *IrFn, slot: u64, dx: u64) {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS {
        emit_mov_x_x(o, dx, r + 9)
        return
    }
    emit_ldr_x(o, dx, slot * 8)
}

fun emit_spill_x(o: *Out, fn: *IrFn, slot: u64, xreg: u64) {
    let ro: *u64 = fn.reg_of
    if ro[slot] < NREGS { return }
    emit_str_x(o, xreg, slot * 8)
}

// Devuelve el registro del que leer un slot, emitiendo el load a `scratch` si
// esta derramado. Espejo de cgb_src_x.
fun ensure_src_x(o: *Out, fn: *IrFn, slot: u64, scratch: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { return r + 9 }
    emit_ldr_x(o, scratch, slot * 8)
    return scratch
}

fun ensure_src_w(o: *Out, fn: *IrFn, slot: u64, scratch: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { return r + 9 }
    emit_ldr_w(o, scratch, slot * 8)
    return scratch
}

fun out_binop_mnemonic(o: *Out, op: u64, signed: u64) {
    if op == OP_ADD { let sa: str = 'add'; out_bytes(o, sa.ptr, sa.len); return }
    if op == OP_SUB { let sb: str = 'sub'; out_bytes(o, sb.ptr, sb.len); return }
    if op == OP_MUL { let sc: str = 'mul'; out_bytes(o, sc.ptr, sc.len); return }
    if op == OP_DIV {
        if signed == 1 { let ss: str = 'sdiv'; out_bytes(o, ss.ptr, ss.len); return }
        let sd: str = 'udiv'; out_bytes(o, sd.ptr, sd.len); return
    }
    if op == OP_AND { let se: str = 'and'; out_bytes(o, se.ptr, se.len); return }
    if op == OP_OR  { let sf: str = 'orr'; out_bytes(o, sf.ptr, sf.len); return }
    if op == OP_XOR { let sg: str = 'eor'; out_bytes(o, sg.ptr, sg.len); return }
    if op == OP_SHL { let sh: str = 'lsl'; out_bytes(o, sh.ptr, sh.len); return }
    if op == OP_SHR { let si: str = 'lsr'; out_bytes(o, si.ptr, si.len); return }
}

// ---------------------------------------------------------------------------
// Un emisor por opcode del IR. Cada uno tiene su gemelo cgb_i_* en
// codegen_bytes.tt.
// ---------------------------------------------------------------------------

fun emit_i_movi(o: *Out, fn: *IrFn, i: *Ins) {
    let xd: u64 = dst_x_reg(fn, i.dst)
    emit_movi(o, xd, i.imm)
    emit_spill_x(o, fn, i.dst, xd)
}

// Direccion de un literal o de un bloque bss, con el par adrp + add.
//
// En texto se escribe con los modificadores del ensamblador:
//     adrp x9, L_str3@PAGE
//     add  x9, x9, L_str3@PAGEOFF
// y es el enlazador quien calcula los desplazamientos. El backend de bytes
// tiene que hacer esa cuenta a mano (ver mo_resolve_strings_bss).
fun emit_i_label_addr(o: *Out, fn: *IrFn, i: *Ins) {
    let xd: u64 = dst_x_reg(fn, i.dst)
    if i.callee_len > 0 {
        let n0: str = '    adrp    '
        out_bytes(o, n0.ptr, n0.len)
        out_x_n(o, xd)
        let n1: str = ', _'
        if get_target() == TGT_LINUX {
            let ln1: str = ', '
            out_bytes(o, ln1.ptr, ln1.len)
        } else {
            out_bytes(o, n1.ptr, n1.len)
        }
        let lx2: *Lexer = LX_STATE
        out_bytes(o, lx2.src + i.callee_start, i.callee_len)
        let n2: str = '@PAGE\n    add     '
        if get_target() == TGT_LINUX {
            let ln2: str = '\n    add     '
            out_bytes(o, ln2.ptr, ln2.len)
        } else {
            out_bytes(o, n2.ptr, n2.len)
        }
        out_x_n(o, xd)
        let n3: str = ', '
        out_bytes(o, n3.ptr, n3.len)
        out_x_n(o, xd)
        if get_target() == TGT_LINUX {
            let lo: str = ', :lo12:'
            out_bytes(o, lo.ptr, lo.len)
        } else {
            out_bytes(o, n1.ptr, n1.len)
        }
        out_bytes(o, lx2.src + i.callee_start, i.callee_len)
        if get_target() == TGT_LINUX {
            out_byte(o, 10)
        } else {
            let n4: str = '@PAGEOFF\n'
            out_bytes(o, n4.ptr, n4.len)
        }
        emit_spill_x(o, fn, i.dst, xd)
        return
    }
    let s0: str = '    adrp    '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, xd)
    let s1: str = ', L_str'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, i.str_id)
    if get_target() == TGT_LINUX {
        let ls2: str = '\n    add     '
        out_bytes(o, ls2.ptr, ls2.len)
    } else {
        let s2: str = '@PAGE\n    add     '
        out_bytes(o, s2.ptr, s2.len)
    }
    out_x_n(o, xd)
    let s3: str = ', '
    out_bytes(o, s3.ptr, s3.len)
    out_x_n(o, xd)
    if get_target() == TGT_LINUX {
        let lo2: str = ', :lo12:L_str'
        out_bytes(o, lo2.ptr, lo2.len)
    } else {
        out_bytes(o, s1.ptr, s1.len)
    }
    out_u64(o, i.str_id)
    if get_target() == TGT_LINUX {
        out_byte(o, 10)
    } else {
        let s4: str = '@PAGEOFF\n'
        out_bytes(o, s4.ptr, s4.len)
    }
    emit_spill_x(o, fn, i.dst, xd)
}

fun emit_i_addr_local(o: *Out, fn: *IrFn, i: *Ins) {
    let xd: u64 = dst_x_reg(fn, i.dst)
    let s0: str = '    add     '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, xd)
    let s1: str = ', sp, #'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, i.local * 8)
    out_byte(o, 10)
    emit_spill_x(o, fn, i.dst, xd)
}

fun emit_normalize(o: *Out, r: u64, width: u64, signed: u64) {
    if width == 1 {
        if signed == 1 { let s: str = '    sxtb    '; out_bytes(o, s.ptr, s.len); out_x_n(o, r); let c: str = ', '; out_bytes(o, c.ptr, c.len); out_w_n(o, r); out_byte(o, 10); return }
        let s2: str = '    uxtb    '; out_bytes(o, s2.ptr, s2.len); out_w_n(o, r); let c2: str = ', '; out_bytes(o, c2.ptr, c2.len); out_w_n(o, r); out_byte(o, 10); return
    }
    if width == 4 {
        if signed == 1 { let s3: str = '    sxtw    '; out_bytes(o, s3.ptr, s3.len); out_x_n(o, r); let c3: str = ', '; out_bytes(o, c3.ptr, c3.len); out_w_n(o, r); out_byte(o, 10); return }
        emit_mov_w_w(o, r, r)
    }
}

fun emit_i_load_local(o: *Out, fn: *IrFn, i: *Ins) {
    let xd: u64 = dst_x_reg(fn, i.dst)
    if i.width == 1 {
        out_mn(o, 2)
        out_w_n(o, xd)
        out_sp_tail(o, i.local * 8)
    } else if i.width == 4 {
        out_mn(o, 0)
        out_w_n(o, xd)
        out_sp_tail(o, i.local * 8)
    } else {
        emit_ldr_x(o, xd, i.local * 8)
    }
    emit_normalize(o, xd, i.width, i.is_signed)
    emit_spill_x(o, fn, i.dst, xd)
}

fun emit_i_store_local(o: *Out, fn: *IrFn, i: *Ins) {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[i.a]
    let sreg: u64 = 16
    if r < NREGS {
        sreg = r + 9
    } else {
        emit_ldr_x(o, 16, i.a * 8)
    }
    if i.width == 1 {
        out_mn(o, 3)
        out_w_n(o, sreg)
        out_sp_tail(o, i.local * 8)
    } else if i.width == 4 {
        out_mn(o, 1)
        out_w_n(o, sreg)
        out_sp_tail(o, i.local * 8)
    } else {
        emit_str_x(o, sreg, i.local * 8)
    }
}

fun emit_i_load_mem(o: *Out, fn: *IrFn, i: *Ins) {
    let addr: u64 = ensure_src_x(o, fn, i.a, 17)
    let xd: u64 = dst_x_reg(fn, i.dst)
    if i.width == 1 {
        out_mn(o, 2)
        out_w_n(o, xd)
        out_mem_tail(o, addr)
    } else if i.width == 4 {
        out_mn(o, 0)
        out_w_n(o, xd)
        out_mem_tail(o, addr)
    } else {
        out_mn(o, 0)
        out_x_n(o, xd)
        out_mem_tail(o, addr)
    }
    emit_normalize(o, xd, i.width, i.is_signed)
    emit_spill_x(o, fn, i.dst, xd)
}

fun emit_i_cast(o: *Out, fn: *IrFn, i: *Ins) {
    let src: u64 = ensure_src_x(o, fn, i.a, 16)
    let dst: u64 = dst_x_reg(fn, i.dst)
    if dst != src { emit_mov_x_x(o, dst, src) }
    emit_normalize(o, dst, i.width, i.is_signed)
    emit_spill_x(o, fn, i.dst, dst)
}

fun emit_i_store_mem(o: *Out, fn: *IrFn, i: *Ins) {
    let addr: u64 = ensure_src_x(o, fn, i.a, 17)
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[i.b]
    let val: u64 = 16
    if r < NREGS {
        val = r + 9
    } else {
        emit_ldr_x(o, 16, i.b * 8)
    }
    if i.width == 1 {
        out_mn(o, 3)
        out_w_n(o, val)
        out_mem_tail(o, addr)
    } else if i.width == 4 {
        out_mn(o, 1)
        out_w_n(o, val)
        out_mem_tail(o, addr)
    } else {
        out_mn(o, 1)
        out_x_n(o, val)
        out_mem_tail(o, addr)
    }
}

fun emit_i_binop(o: *Out, fn: *IrFn, i: *Ins) {
    let wide: u64 = 0
    if i.width == 8 { wide = 1 }
    let ra: u64 = 0
    let rb: u64 = 0
    if wide == 1 {
        ra = ensure_src_x(o, fn, i.a, 16)
        rb = ensure_src_x(o, fn, i.b, 17)
    } else {
        ra = ensure_src_w(o, fn, i.a, 16)
        rb = ensure_src_w(o, fn, i.b, 17)
    }
    let rd: u64 = dst_x_reg(fn, i.dst)
    let s0: str = '    '
    out_bytes(o, s0.ptr, s0.len)
    out_binop_mnemonic(o, i.binop, i.is_signed)
    let s1: str = '     '
    out_bytes(o, s1.ptr, s1.len)
    out_reg_wx(o, rd, wide)
    let s2: str = ', '
    out_bytes(o, s2.ptr, s2.len)
    out_reg_wx(o, ra, wide)
    out_bytes(o, s2.ptr, s2.len)
    out_reg_wx(o, rb, wide)
    out_byte(o, 10)
    emit_spill_x(o, fn, i.dst, rd)
}

// Sufijo de condicion para cset: eq, ne, lo, ls, hi, hs.
//
// Todas sin signo, porque el lenguaje no tiene tipos con signo. Aqui se escribe
// la condicion DIRECTA (el ensamblador ya invierte al expandir el alias cset);
// el backend de bytes tiene que invertirla el mismo, ver cgb_invcond.
fun out_cc(o: *Out, cc: u64) {
    if cc == 0 { let s: str = 'eq'; out_bytes(o, s.ptr, s.len); return }
    if cc == 1 { let s: str = 'ne'; out_bytes(o, s.ptr, s.len); return }
    if cc == 2 { let s: str = 'lo'; out_bytes(o, s.ptr, s.len); return }
    if cc == 3 { let s: str = 'ls'; out_bytes(o, s.ptr, s.len); return }
    if cc == 4 { let s: str = 'hi'; out_bytes(o, s.ptr, s.len); return }
    if cc == 5 { let s: str = 'hs'; out_bytes(o, s.ptr, s.len); return }
    if cc == 6 { let s: str = 'lt'; out_bytes(o, s.ptr, s.len); return }
    if cc == 7 { let s: str = 'le'; out_bytes(o, s.ptr, s.len); return }
    if cc == 8 { let s: str = 'gt'; out_bytes(o, s.ptr, s.len); return }
    if cc == 9 { let s: str = 'ge'; out_bytes(o, s.ptr, s.len); return }
}

fun emit_i_cmp(o: *Out, fn: *IrFn, i: *Ins, cc: u64) {
    if i.is_signed == 1 {
        if cc == 2 { cc = 6 }
        if cc == 3 { cc = 7 }
        if cc == 4 { cc = 8 }
        if cc == 5 { cc = 9 }
    }
    let wide: u64 = 0
    if i.width == 8 { wide = 1 }
    let ra: u64 = 0
    let rb: u64 = 0
    if wide == 1 {
        ra = ensure_src_x(o, fn, i.a, 16)
        rb = ensure_src_x(o, fn, i.b, 17)
    } else {
        ra = ensure_src_w(o, fn, i.a, 16)
        rb = ensure_src_w(o, fn, i.b, 17)
    }
    let rd: u64 = dst_x_reg(fn, i.dst)
    let s0: str = '    cmp     '
    out_bytes(o, s0.ptr, s0.len)
    out_reg_wx(o, ra, wide)
    let s1: str = ', '
    out_bytes(o, s1.ptr, s1.len)
    out_reg_wx(o, rb, wide)
    out_byte(o, 10)
    let s2: str = '    cset    '
    out_bytes(o, s2.ptr, s2.len)
    out_w_n(o, rd)
    out_bytes(o, s1.ptr, s1.len)
    out_cc(o, cc)
    out_byte(o, 10)
    emit_spill_x(o, fn, i.dst, rd)
}

// El builtin syscall: numero en x16, argumentos en x0.., y `svc #0x80`.
//
// Este `svc #0x80` es lo unico especifico de macOS en el codigo generado, y es
// justo lo que bootstrap/linux/macho2elf.sh reescribe como `bl _tt_sys` para
// poder ejecutar la salida bajo qemu en Linux.
fun emit_i_syscall(o: *Out, fn: *IrFn, i: *Ins) {
    let args: *u64 = i.args
    let ro: *u64 = fn.reg_of
    let s0: u64 = args[0]
    let r0: u64 = ro[s0]
    if r0 < NREGS {
        emit_mov_x_x(o, 16, r0 + 9)
    } else {
        emit_ldr_x(o, 16, s0 * 8)
    }
    let k: u64 = 1
    while k < i.nargs {
        emit_load_slot_to_x(o, fn, args[k], k - 1)
        k = k + 1
    }
    if get_target() == TGT_LINUX {
        let lv: str = '    bl      tt_sys\n'
        out_bytes(o, lv.ptr, lv.len)
    } else {
        let sv: str = '    svc     #0x80\n'
        out_bytes(o, sv.ptr, sv.len)
    }
    let dr: u64 = ro[i.dst]
    if dr < NREGS {
        emit_mov_x_x(o, dr + 9, 0)
        return
    }
    emit_str_x(o, 0, i.dst * 8)
}

fun emit_i_call(o: *Out, fn: *IrFn, i: *Ins) {
    let syskw: str = 'syscall'
    if bytes_eq_at(i.callee_start, i.callee_len, syskw.ptr, 7) == 1 {
        emit_i_syscall(o, fn, i)
        return
    }
    let args: *u64 = i.args
    let k: u64 = 0
    while k < i.nargs {
        emit_load_slot_to_x(o, fn, args[k], k)
        k = k + 1
    }
    let s0: str = '    bl      '
    out_bytes(o, s0.ptr, s0.len)
    emit_sym(o, i.callee_start, i.callee_len)
    out_byte(o, 10)
    let ro: *u64 = fn.reg_of
    let dr: u64 = ro[i.dst]
    if dr < NREGS {
        emit_mov_x_x(o, dr + 9, 0)
        return
    }
    emit_str_x(o, 0, i.dst * 8)
}

fun emit_i_ret(o: *Out, fn: *IrFn, i: *Ins, epi_label: u64) {
    if i.imm == 0 {
        let wide: u64 = 0
        let rt: *Type = fn.ret_type
        if rt != nil {
            if type_width(rt) == 8 { wide = 1 }
        }
        let ro: *u64 = fn.reg_of
        let r: u64 = ro[i.a]
        if wide == 1 {
            if r < NREGS {
                emit_mov_x_x(o, 0, r + 9)
            } else {
                emit_ldr_x(o, 0, i.a * 8)
            }
        } else {
            if r < NREGS {
                emit_mov_w_w(o, 0, r + 9)
            } else {
                emit_ldr_w(o, 0, i.a * 8)
            }
        }
    }
    let s0: str = '    b       .L'
    out_bytes(o, s0.ptr, s0.len)
    out_u64(o, epi_label)
    out_byte(o, 10)
}

fun emit_i_jmp(o: *Out, i: *Ins) {
    let s0: str = '    b       .L'
    out_bytes(o, s0.ptr, s0.len)
    out_u64(o, i.label)
    out_byte(o, 10)
}

fun emit_i_jz(o: *Out, fn: *IrFn, i: *Ins) {
    let sw: u64 = ensure_src_w(o, fn, i.a, 16)
    let s0: str = '    cbz     '
    out_bytes(o, s0.ptr, s0.len)
    out_w_n(o, sw)
    let s1: str = ', .L'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, i.label)
    out_byte(o, 10)
}

fun emit_i_label(o: *Out, i: *Ins) {
    let s0: str = '.L'
    out_bytes(o, s0.ptr, s0.len)
    out_u64(o, i.label)
    let s1: str = ':\n'
    out_bytes(o, s1.ptr, s1.len)
}

fun emit_instr(o: *Out, fn: *IrFn, i: *Ins, epi_label: u64) {
    let op: u64 = i.op
    if op == IR_MOVI        { emit_i_movi(o, fn, i);        return }
    if op == IR_LABEL_ADDR  { emit_i_label_addr(o, fn, i);  return }
    if op == IR_ADDR_LOCAL  { emit_i_addr_local(o, fn, i);  return }
    if op == IR_LOAD_LOCAL  { emit_i_load_local(o, fn, i);  return }
    if op == IR_STORE_LOCAL { emit_i_store_local(o, fn, i); return }
    if op == IR_LOAD_MEM    { emit_i_load_mem(o, fn, i);    return }
    if op == IR_STORE_MEM   { emit_i_store_mem(o, fn, i);   return }
    if op == IR_BINOP       { emit_i_binop(o, fn, i);       return }
    if op == IR_CMPEQ       { emit_i_cmp(o, fn, i, 0);      return }
    if op == IR_CMPNE       { emit_i_cmp(o, fn, i, 1);      return }
    if op == IR_CMPLT       { emit_i_cmp(o, fn, i, 2);      return }
    if op == IR_CMPLE       { emit_i_cmp(o, fn, i, 3);      return }
    if op == IR_CMPGT       { emit_i_cmp(o, fn, i, 4);      return }
    if op == IR_CMPGE       { emit_i_cmp(o, fn, i, 5);      return }
    if op == IR_CALL        { emit_i_call(o, fn, i);        return }
    if op == IR_RET         { emit_i_ret(o, fn, i, epi_label); return }
    if op == IR_JMP         { emit_i_jmp(o, i);             return }
    if op == IR_JZ          { emit_i_jz(o, fn, i);          return }
    if op == IR_LABEL       { emit_i_label(o, i);           return }
    if op == IR_CAST        { emit_i_cast(o, fn, i);        return }
}

// Escribe un nombre de simbolo, con guion bajo delante si el target es macOS.
// Es la unica diferencia de nomenclatura entre los dos targets.
fun emit_sym(o: *Out, ns: u64, nl: u64) {
    if get_target() == TGT_MACOS {
        out_byte(o, 95)
    }
    let lx: *Lexer = LX_STATE
    out_bytes(o, lx.src + ns, nl)
}

// Prologo: guardar x29/x30, fijar el frame pointer y reservar los locales.
//
// Como en cgb_prologue, la reserva tiene dos caminos porque `sub sp, sp, #imm`
// solo llega a 4095; por encima se carga el tamano en x16. Aqui basta con
// escribir `sub sp, sp, x16` y dejar que el ensamblador elija el encoding
// correcto, que es precisamente lo que el backend de bytes tuvo que aprender a
// hacer a mano (enc_sub_ext_sp).
fun emit_prologue(o: *Out, fn: *IrFn) {
    let s1: str = '\n    .globl   '
    out_bytes(o, s1.ptr, s1.len)
    emit_sym(o, fn.name_start, fn.name_len)
    out_byte(o, 10)
    emit_sym(o, fn.name_start, fn.name_len)
    let s2: str = ':\n    stp     x29, x30, [sp, #-16]!\n    mov     x29, sp\n'
    out_bytes(o, s2.ptr, s2.len)
    if fn.frame_bytes > 0 {
        if fn.frame_bytes <= 4095 {
            let s3: str = '    sub     sp, sp, #'
            out_bytes(o, s3.ptr, s3.len)
            out_u64(o, fn.frame_bytes)
            out_byte(o, 10)
        } else {
            emit_movi(o, 16, fn.frame_bytes)
            let s5: str = '    sub     sp, sp, x16\n'
            out_bytes(o, s5.ptr, s5.len)
        }
    }
}

fun emit_epilogue(o: *Out, fn: *IrFn, epi_label: u64) {
    let s1: str = '.L'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, epi_label)
    let s2: str = ':\n'
    out_bytes(o, s2.ptr, s2.len)
    if fn.frame_bytes > 0 {
        if fn.frame_bytes <= 4095 {
            let s3: str = '    add     sp, sp, #'
            out_bytes(o, s3.ptr, s3.len)
            out_u64(o, fn.frame_bytes)
            out_byte(o, 10)
        } else {
            emit_movi(o, 16, fn.frame_bytes)
            let s5: str = '    add     sp, sp, x16\n'
            out_bytes(o, s5.ptr, s5.len)
        }
    }
    let s4: str = '    ldp     x29, x30, [sp], #16\n    ret\n'
    out_bytes(o, s4.ptr, s4.len)
}

fun emit_text_section(o: *Out) {
    if get_target() == TGT_MACOS {
        let s: str = '    .section __TEXT,__text\n'
        out_bytes(o, s.ptr, s.len)
        return
    }
    if get_target() == TGT_LINUX {
        let s: str = '    .text\n'
        out_bytes(o, s.ptr, s.len)
        return
    }
    let s: str = '    .section .text.boot\n'
    out_bytes(o, s.ptr, s.len)
}

// Derrama el parametro k a su hueco de pila nada mas entrar, con el ancho de su
// tipo. Ver la explicacion en cgb_param_spill.
fun emit_param_spill(o: *Out, fn: *IrFn, k: u64) {
    let w: u64 = 8
    let pts: **Type = fn.param_types
    if pts != nil {
        let pt: *Type = pts[k]
        if pt != nil {
            let tw: u64 = type_width(pt)
            if tw == 1 { w = 1 }
            if tw == 4 { w = 4 }
        }
    }
    if w == 1 {
        out_mn(o, 3)
        out_w_n(o, k)
        out_sp_tail(o, k * 8)
        return
    }
    if w == 4 {
        out_mn(o, 1)
        out_w_n(o, k)
        out_sp_tail(o, k * 8)
        return
    }
    out_mn(o, 1)
    out_x_n(o, k)
    out_sp_tail(o, k * 8)
}

fun emit_fn(o: *Out, fn: *IrFn, epi_label: u64) {
    emit_prologue(o, fn)
    let k: u64 = 0
    while k < fn.nparams {
        emit_param_spill(o, fn, k)
        k = k + 1
    }
    let it: *Ins = fn.head
    while it != nil {
        emit_instr(o, fn, it, epi_label)
        it = it.next
    }
    emit_epilogue(o, fn, epi_label)
}

// Un byte de literal como `.byte 0xNN`.
//
// Se emiten byte a byte, y no como `.asciz`, por dos razones: permite cualquier
// byte sin escapar y evita que el ensamblador o el enlazador toquen nada.
fun emit_string_byte(o: *Out, v: u64) {
    let s: str = '    .byte   0x'
    out_bytes(o, s.ptr, s.len)
    let hi: u64 = v / 16
    let lo: u64 = v - hi * 16
    out_nibble(o, hi)
    out_nibble(o, lo)
    out_byte(o, 10)
}

// Los literales, en __TEXT,__cstring, alineados a 8 y con terminador nulo.
//
// El terminador explicito es OBLIGATORIO y no un detalle: sin el, el enlazador
// de macOS fusiona cadenas que comparten sufijo, y a partir de unas 60 cadenas
// eso corrompe el `.ptr` de los literales. Fue un bug real del hito 17.3, y
// latente hasta que el compilador tuvo suficientes cadenas para dispararlo.
fun emit_strings(o: *Out, prog: *Program) {
    if prog.strs == nil { return }
    if get_target() == TGT_LINUX {
        let ls0: str = '\n    .section .rodata\n'
        out_bytes(o, ls0.ptr, ls0.len)
    } else {
        let s0: str = '\n    .section __TEXT,__cstring\n'
        out_bytes(o, s0.ptr, s0.len)
    }
    let it: *StrLit = prog.strs
    while it != nil {
        let sb: str = '    .balign  8\nL_str'
        out_bytes(o, sb.ptr, sb.len)
        out_u64(o, it.id)
        let sc: str = ':\n'
        out_bytes(o, sc.ptr, sc.len)
        let k: u64 = 0
        while k < it.slen {
            emit_string_byte(o, it.bytes[k])
            k = k + 1
        }
        emit_string_byte(o, 0)
        it = it.next
    }
}

// El punto de entrada. Llama a main y convierte su valor de retorno en el
// codigo de salida del proceso con exit(), sin pasar por libc.
fun emit_macos_start(o: *Out) {
    let s: str = '    .globl   _tt_start\n_tt_start:\n    bl      _main\n    mov     x16, #1\n    svc     #0x80\n'
    out_bytes(o, s.ptr, s.len)
}

// Los bloques bss, como `.zerofill __DATA,__bss,_NOMBRE,tamano,3`.
// El 3 final es log2 de la alineacion, o sea 8 bytes.
fun emit_bsses(o: *Out, prog: *Program) {
    if prog.bsses == nil { return }
    out_byte(o, 10)
    let it: *BssItem = prog.bsses
    while it != nil {
        if get_target() == TGT_LINUX {
            let ls: str = '    .comm '
            out_bytes(o, ls.ptr, ls.len)
            let llx: *Lexer = LX_STATE
            out_bytes(o, llx.src + it.name_start, it.name_len)
            let lc: str = ','
            out_bytes(o, lc.ptr, lc.len)
            out_u64(o, it.size)
            let la: str = ',8\n'
            out_bytes(o, la.ptr, la.len)
            it = it.next
            continue
        }
        let s: str = '    .zerofill __DATA,__bss,_'
        out_bytes(o, s.ptr, s.len)
        let lx: *Lexer = LX_STATE
        out_bytes(o, lx.src + it.name_start, it.name_len)
        let s2: str = ','
        out_bytes(o, s2.ptr, s2.len)
        out_u64(o, it.size)
        let s3: str = ',3\n'
        out_bytes(o, s3.ptr, s3.len)
        it = it.next
    }
}

// Driver del backend textual: seccion, entrada, funciones, literales y bsses.
//
// Los labels de epilogo se numeran a partir del maximo usado por el lowering,
// igual que en codegen_bytes.tt, para que no colisionen.
fun codegen(o: *Out, target: u64, prog: *Program, funcs: *IrFn) {
    set_target(target)
    emit_text_section(o)
    if target == TGT_MACOS {
        emit_macos_start(o)
    }
    let max_label: u64 = 0
    let scan: *IrFn = funcs
    while scan != nil {
        let it: *Ins = scan.head
        while it != nil {
            if it.op == IR_LABEL {
                if it.label >= max_label { max_label = it.label + 1 }
            }
            if it.op == IR_JMP {
                if it.label >= max_label { max_label = it.label + 1 }
            }
            if it.op == IR_JZ {
                if it.label >= max_label { max_label = it.label + 1 }
            }
            it = it.next
        }
        scan = scan.next
    }
    let epi: u64 = max_label
    let fn: *IrFn = funcs
    while fn != nil {
        emit_fn(o, fn, epi)
        epi = epi + 1
        fn = fn.next
    }
    emit_strings(o, prog)
    emit_bsses(o, prog)
    out_flush(o)
}
