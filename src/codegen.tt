// ============================================================================
// src/codegen.tt - TEXTUAL backend: from IR to AArch64 assembly
// ============================================================================
//
// Emits the .s that clang later assembles and links. It is the original
// backend and it remains the reference path: when something fails in the
// binary that src/codegen_bytes.tt produces, the question is always "and what
// does this path emit", because this one is validated by a real assembler.
//
// THE RELATION WITH codegen_bytes.tt
//
// Both files are the same function written twice, once to text and once to
// bytes. Every emit_i_* here has its cgb_i_* over there, in the same order,
// making the same register choices and emitting the same instructions. That
// correspondence is what allows comparing both paths instruction by
// instruction, which is the strongest evidence there is that the byte backend
// is correct (see bootstrap/linux/verify_macho_linux.sh).
//
// If you touch one, touch the other. And if you doubt which one is the truth,
// it is this one.
//
// HOW THE TEXT IS EMITTED
//
// There is no printf and no formatting: everything is built by concatenating
// literals and numbers with the functions from lib/fmt.tt. The out_* functions
// in this file are the reusable pieces (a register, a `, [sp, #N]` tail, a
// mnemonic with its indentation). That is why the code reads oddly: every
// instruction is several calls in a row.
//
// The output format has to be DETERMINISTIC down to the last space: the
// fixpoint (tests/fixpoint_build.sh) compares the generated .s byte for byte
// across compiler generations. Hence the fixed-width indentation and the
// immediates always in 4-digit hexadecimal.
//
// THE TWO TARGETS
//
//   TGT_VIRT   "neutral" output, with no sections and no symbol prefix. It is
//              the one the codegen's own tests use.
//   TGT_MACOS  real Mach-O: __TEXT,__text and __TEXT,__cstring sections, bss
//              through .zerofill __DATA,__bss, symbols with a leading
//              underscore and the _tt_start entry point.
//
// The target is kept in a global (G_TARGET) for the same reason the parser
// keeps its own: to avoid dragging a parameter through dozens of functions.
// ============================================================================

const TGT_VIRT:  u64 = 0
const TGT_MACOS: u64 = 1
const TGT_LINUX: u64 = 2
const TGT_WINDOWS: u64 = 3
bss G_TARGET: 8

fun set_target(t: u64) {
    let p: *u64 = G_TARGET
    p[0] = t
}

fun get_target() -> u64 {
    let p: *u64 = G_TARGET
    return p[0]
}

// ---------------------------------------------------------------------------
// Reusable text pieces
// ---------------------------------------------------------------------------

// A register assigned by the regalloc: the logical number r is printed as
// x(r+9) or w(r+9). The offset of 9 is what reserves x0..x8 for arguments and
// return values. 120 = 'x', 119 = 'w'.
fun out_reg_x(o: *Out, r: u64) {
    out_byte(o, 120)
    out_u64(o, ir_phys_reg(r))
}

fun out_reg_w(o: *Out, r: u64) {
    out_byte(o, 119)
    out_u64(o, ir_phys_reg(r))
}

fun out_x_n(o: *Out, n: u64) {
    out_byte(o, 120)
    out_u64(o, n)
}

fun out_w_n(o: *Out, n: u64) {
    out_byte(o, 119)
    out_u64(o, n)
}

// A specific physical register, in its 64- or 32-bit form depending on `wide`.
fun out_reg_wx(o: *Out, n: u64, wide: u64) {
    if wide == 1 {
        out_x_n(o, n)
        return
    }
    out_w_n(o, n)
}

// Memory access mnemonic, already indented and padded up to the operand
// column: 0=ldr, 1=str, 2=ldrb, 3=strb.
//
// The fixed width of the indentation is not cosmetic: the fixpoint compares
// the .s byte for byte.
fun out_mn(o: *Out, mn: u64) {
    if mn == 0 { let s0: str = '    ldr     '; out_bytes(o, s0.ptr, s0.len); return }
    if mn == 1 { let s1: str = '    str     '; out_bytes(o, s1.ptr, s1.len); return }
    if mn == 2 { let s2: str = '    ldrb    '; out_bytes(o, s2.ptr, s2.len); return }
    let s3: str = '    strb    '
    out_bytes(o, s3.ptr, s3.len)
}

// The `, [sp, #N]` tail of an access to a local, and the `, [xN]` of an access
// through a pointer. They are called "tail" because they complete a line that
// out_mn started.
fun out_sp_tail(o: *Out, off: u64) {
    let s0: str = ', [sp, #'
    out_bytes(o, s0.ptr, s0.len)
    out_u64(o, off)
    let s1: str = ']\n'
    out_bytes(o, s1.ptr, s1.len)
}

fun out_mem_tail(o: *Out, addr_x: u64) {
    let s0: str = ', ['
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, addr_x)
    let s1: str = ']\n'
    out_bytes(o, s1.ptr, s1.len)
}

// Loads a 64-bit constant, in 16-bit chunks.
//
// It is the textual equivalent of b_movi in codegen_bytes.tt and follows the
// same logic: movz for the first non-zero group (it clears the rest of the
// register) and movk for the others, skipping the ones that are zero.
//
// The division by 65536 stands in for a shift because this file predates the
// language having >>.
fun emit_movi(o: *Out, xreg: u64, imm: u64) {
    let a: u64 = imm / 65536
    let g0: u64 = imm - a * 65536
    let b: u64 = a / 65536
    let g1: u64 = a - b * 65536
    let c: u64 = b / 65536
    let g2: u64 = b - c * 65536
    let g3: u64 = c

    if imm == 0 {
        let s0: str = '    mov     '
        out_bytes(o, s0.ptr, s0.len)
        out_x_n(o, xreg)
        let s0b: str = ', #0\n'
        out_bytes(o, s0b.ptr, s0b.len)
        return
    }

    let first_i: u64 = 4
    let first_g: u64 = 0
    if g0 != 0 { first_i = 0; first_g = g0 }
    if first_i == 4 {
        if g1 != 0 { first_i = 1; first_g = g1 }
    }
    if first_i == 4 {
        if g2 != 0 { first_i = 2; first_g = g2 }
    }
    if first_i == 4 {
        if g3 != 0 { first_i = 3; first_g = g3 }
    }

    let s1: str = '    movz    '
    out_bytes(o, s1.ptr, s1.len)
    out_x_n(o, xreg)
    let s1b: str = ', #0x'
    out_bytes(o, s1b.ptr, s1b.len)
    out_hex4(o, first_g)
    if first_i > 0 {
        let s1c: str = ', lsl #'
        out_bytes(o, s1c.ptr, s1c.len)
        out_u64(o, first_i * 16)
    }
    out_byte(o, 10)

    let idx: u64 = first_i + 1
    while idx < 4 {
        let g: u64 = 0
        if idx == 1 { g = g1 }
        if idx == 2 { g = g2 }
        if idx == 3 { g = g3 }
        if g != 0 {
            let s2: str = '    movk    '
            out_bytes(o, s2.ptr, s2.len)
            out_x_n(o, xreg)
            let s2b: str = ', #0x'
            out_bytes(o, s2b.ptr, s2b.len)
            out_hex4(o, g)
            let s2c: str = ', lsl #'
            out_bytes(o, s2c.ptr, s2c.len)
            out_u64(o, idx * 16)
            out_byte(o, 10)
        }
        idx = idx + 1
    }
}

// Pointer to the source buffer, to recover symbol names from the (start, len)
// ranges that the AST and the IR store.
bss G_SRC: 8

fun set_src(p: *u8) {
    let sp: **u8 = G_SRC
    sp[0] = p
}

fun get_src() -> *u8 {
    let sp: **u8 = G_SRC
    return sp[0]
}

// ---------------------------------------------------------------------------
// Register versus stack: the same criterion as in codegen_bytes.tt.
//
// reg_of[slot] < NREGS  ->  it lives in x(reg_of[slot] + 9)
// otherwise             ->  it is spilled, at [sp, #slot*8]
// ---------------------------------------------------------------------------

fun slot_off(fn: *IrFn, slot: u64) -> u64 {
    if fn.stack_of != nil { return fn.stack_of[slot] * 8 }
    return slot * 8
}

fun in_reg(fn: *IrFn, slot: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    if ro[slot] < NREGS { return 1 }
    return 0
}

fun dst_x_reg(fn: *IrFn, slot: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { return ir_phys_reg(r) }
    return 16
}

fun emit_ldr_x(o: *Out, xreg: u64, off: u64) {
    let s0: str = '    ldr     '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, xreg)
    let s1: str = ', [sp, #'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, off)
    let s2: str = ']\n'
    out_bytes(o, s2.ptr, s2.len)
}

fun emit_str_x(o: *Out, xreg: u64, off: u64) {
    let s0: str = '    str     '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, xreg)
    let s1: str = ', [sp, #'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, off)
    let s2: str = ']\n'
    out_bytes(o, s2.ptr, s2.len)
}

fun emit_mov_x_x(o: *Out, dx: u64, sx: u64) {
    let s0: str = '    mov     '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, dx)
    let s1: str = ', '
    out_bytes(o, s1.ptr, s1.len)
    out_x_n(o, sx)
    out_byte(o, 10)
}

fun emit_mov_w_w(o: *Out, dw: u64, sw: u64) {
    let s0: str = '    mov     '
    out_bytes(o, s0.ptr, s0.len)
    out_w_n(o, dw)
    let s1: str = ', '
    out_bytes(o, s1.ptr, s1.len)
    out_w_n(o, sw)
    out_byte(o, 10)
}

fun emit_ldr_w(o: *Out, wreg: u64, off: u64) {
    out_mn(o, 0)
    out_w_n(o, wreg)
    out_sp_tail(o, off)
}

fun emit_load_slot_to_x(o: *Out, fn: *IrFn, slot: u64, dx: u64) {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS {
        emit_mov_x_x(o, dx, ir_phys_reg(r))
        return
    }
    emit_ldr_x(o, dx, slot_off(fn, slot))
}

fun emit_spill_x(o: *Out, fn: *IrFn, slot: u64, xreg: u64) {
    let ro: *u64 = fn.reg_of
    if ro[slot] < NREGS { return }
    emit_str_x(o, xreg, slot_off(fn, slot))
}

// Returns the register to read a slot from, emitting the load into `scratch`
// if it is spilled. Mirror of cgb_src_x.
fun ensure_src_x(o: *Out, fn: *IrFn, slot: u64, scratch: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { return ir_phys_reg(r) }
    emit_ldr_x(o, scratch, slot_off(fn, slot))
    return scratch
}

fun ensure_src_w(o: *Out, fn: *IrFn, slot: u64, scratch: u64) -> u64 {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[slot]
    if r < NREGS { return ir_phys_reg(r) }
    emit_ldr_w(o, scratch, slot_off(fn, slot))
    return scratch
}

fun out_binop_mnemonic(o: *Out, op: u64, signed: u64) {
    if op == OP_ADD { let sa: str = 'add'; out_bytes(o, sa.ptr, sa.len); return }
    if op == OP_SUB { let sb: str = 'sub'; out_bytes(o, sb.ptr, sb.len); return }
    if op == OP_MUL { let sc: str = 'mul'; out_bytes(o, sc.ptr, sc.len); return }
    if op == OP_DIV {
        if signed == 1 { let ss: str = 'sdiv'; out_bytes(o, ss.ptr, ss.len); return }
        let sd: str = 'udiv'; out_bytes(o, sd.ptr, sd.len); return
    }
    if op == OP_AND { let se: str = 'and'; out_bytes(o, se.ptr, se.len); return }
    if op == OP_OR  { let sf: str = 'orr'; out_bytes(o, sf.ptr, sf.len); return }
    if op == OP_XOR { let sg: str = 'eor'; out_bytes(o, sg.ptr, sg.len); return }
    if op == OP_SHL { let sh: str = 'lsl'; out_bytes(o, sh.ptr, sh.len); return }
    if op == OP_SHR { let si: str = 'lsr'; out_bytes(o, si.ptr, si.len); return }
}

// ---------------------------------------------------------------------------
// One emitter per IR opcode. Each one has its cgb_i_* twin in
// codegen_bytes.tt.
// ---------------------------------------------------------------------------

fun emit_i_movi(o: *Out, fn: *IrFn, i: *Ins) {
    let xd: u64 = dst_x_reg(fn, i.dst)
    emit_movi(o, xd, i.imm)
    emit_spill_x(o, fn, i.dst, xd)
}

// Address of a literal or of a bss block, with the adrp + add pair.
//
// In text it is written with the assembler modifiers:
//     adrp x9, L_str3@PAGE
//     add  x9, x9, L_str3@PAGEOFF
// and it is the linker that computes the displacements. The byte backend has
// to do that arithmetic by hand (see mo_resolve_strings_bss).
fun emit_i_label_addr(o: *Out, fn: *IrFn, i: *Ins) {
    let xd: u64 = dst_x_reg(fn, i.dst)
    if i.callee_len > 0 {
        let n0: str = '    adrp    '
        out_bytes(o, n0.ptr, n0.len)
        out_x_n(o, xd)
        let n1: str = ', _'
        if get_target() == TGT_LINUX {
            let ln1: str = ', '
            out_bytes(o, ln1.ptr, ln1.len)
        } else {
            out_bytes(o, n1.ptr, n1.len)
        }
        let lx2: *Lexer = LX_STATE
        out_bytes(o, lx2.src + i.callee_start, i.callee_len)
        let n2: str = '@PAGE\n    add     '
        if get_target() == TGT_LINUX {
            let ln2: str = '\n    add     '
            out_bytes(o, ln2.ptr, ln2.len)
        } else {
            out_bytes(o, n2.ptr, n2.len)
        }
        out_x_n(o, xd)
        let n3: str = ', '
        out_bytes(o, n3.ptr, n3.len)
        out_x_n(o, xd)
        if get_target() == TGT_LINUX {
            let lo: str = ', :lo12:'
            out_bytes(o, lo.ptr, lo.len)
        } else {
            out_bytes(o, n1.ptr, n1.len)
        }
        out_bytes(o, lx2.src + i.callee_start, i.callee_len)
        if get_target() == TGT_LINUX {
            out_byte(o, 10)
        } else {
            let n4: str = '@PAGEOFF\n'
            out_bytes(o, n4.ptr, n4.len)
        }
        emit_spill_x(o, fn, i.dst, xd)
        return
    }
    let s0: str = '    adrp    '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, xd)
    let s1: str = ', L_str'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, i.str_id)
    if get_target() == TGT_LINUX {
        let ls2: str = '\n    add     '
        out_bytes(o, ls2.ptr, ls2.len)
    } else {
        let s2: str = '@PAGE\n    add     '
        out_bytes(o, s2.ptr, s2.len)
    }
    out_x_n(o, xd)
    let s3: str = ', '
    out_bytes(o, s3.ptr, s3.len)
    out_x_n(o, xd)
    if get_target() == TGT_LINUX {
        let lo2: str = ', :lo12:L_str'
        out_bytes(o, lo2.ptr, lo2.len)
    } else {
        out_bytes(o, s1.ptr, s1.len)
    }
    out_u64(o, i.str_id)
    if get_target() == TGT_LINUX {
        out_byte(o, 10)
    } else {
        let s4: str = '@PAGEOFF\n'
        out_bytes(o, s4.ptr, s4.len)
    }
    emit_spill_x(o, fn, i.dst, xd)
}

fun emit_i_addr_local(o: *Out, fn: *IrFn, i: *Ins) {
    let xd: u64 = dst_x_reg(fn, i.dst)
    let s0: str = '    add     '
    out_bytes(o, s0.ptr, s0.len)
    out_x_n(o, xd)
    let s1: str = ', sp, #'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, slot_off(fn, i.local))
    out_byte(o, 10)
    emit_spill_x(o, fn, i.dst, xd)
}

fun emit_normalize(o: *Out, r: u64, width: u64, signed: u64) {
    if width == 1 {
        if signed == 1 { let s: str = '    sxtb    '; out_bytes(o, s.ptr, s.len); out_x_n(o, r); let c: str = ', '; out_bytes(o, c.ptr, c.len); out_w_n(o, r); out_byte(o, 10); return }
        let s2: str = '    uxtb    '; out_bytes(o, s2.ptr, s2.len); out_w_n(o, r); let c2: str = ', '; out_bytes(o, c2.ptr, c2.len); out_w_n(o, r); out_byte(o, 10); return
    }
    if width == 4 {
        if signed == 1 { let s3: str = '    sxtw    '; out_bytes(o, s3.ptr, s3.len); out_x_n(o, r); let c3: str = ', '; out_bytes(o, c3.ptr, c3.len); out_w_n(o, r); out_byte(o, 10); return }
        emit_mov_w_w(o, r, r)
    }
}

fun emit_i_load_local(o: *Out, fn: *IrFn, i: *Ins) {
    let xd: u64 = dst_x_reg(fn, i.dst)
    if i.width == 1 {
        out_mn(o, 2)
        out_w_n(o, xd)
        out_sp_tail(o, slot_off(fn, i.local))
    } else if i.width == 4 {
        out_mn(o, 0)
        out_w_n(o, xd)
        out_sp_tail(o, slot_off(fn, i.local))
    } else {
        emit_ldr_x(o, xd, slot_off(fn, i.local))
    }
    emit_normalize(o, xd, i.width, i.is_signed)
    emit_spill_x(o, fn, i.dst, xd)
}

fun emit_i_store_local(o: *Out, fn: *IrFn, i: *Ins) {
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[i.a]
    let sreg: u64 = 16
    if r < NREGS {
        sreg = ir_phys_reg(r)
    } else {
        emit_ldr_x(o, 16, slot_off(fn, i.a))
    }
    if i.width == 1 {
        out_mn(o, 3)
        out_w_n(o, sreg)
        out_sp_tail(o, slot_off(fn, i.local))
    } else if i.width == 4 {
        out_mn(o, 1)
        out_w_n(o, sreg)
        out_sp_tail(o, slot_off(fn, i.local))
    } else {
        emit_str_x(o, sreg, slot_off(fn, i.local))
    }
}

fun emit_i_load_mem(o: *Out, fn: *IrFn, i: *Ins) {
    let addr: u64 = ensure_src_x(o, fn, i.a, 17)
    let xd: u64 = dst_x_reg(fn, i.dst)
    if i.width == 1 {
        out_mn(o, 2)
        out_w_n(o, xd)
        out_mem_tail(o, addr)
    } else if i.width == 4 {
        out_mn(o, 0)
        out_w_n(o, xd)
        out_mem_tail(o, addr)
    } else {
        out_mn(o, 0)
        out_x_n(o, xd)
        out_mem_tail(o, addr)
    }
    emit_normalize(o, xd, i.width, i.is_signed)
    emit_spill_x(o, fn, i.dst, xd)
}

fun emit_i_cast(o: *Out, fn: *IrFn, i: *Ins) {
    let src: u64 = ensure_src_x(o, fn, i.a, 16)
    let dst: u64 = dst_x_reg(fn, i.dst)
    if dst != src { emit_mov_x_x(o, dst, src) }
    emit_normalize(o, dst, i.width, i.is_signed)
    emit_spill_x(o, fn, i.dst, dst)
}

fun emit_i_store_mem(o: *Out, fn: *IrFn, i: *Ins) {
    let addr: u64 = ensure_src_x(o, fn, i.a, 17)
    let ro: *u64 = fn.reg_of
    let r: u64 = ro[i.b]
    let val: u64 = 16
    if r < NREGS {
        val = ir_phys_reg(r)
    } else {
        emit_ldr_x(o, 16, slot_off(fn, i.b))
    }
    if i.width == 1 {
        out_mn(o, 3)
        out_w_n(o, val)
        out_mem_tail(o, addr)
    } else if i.width == 4 {
        out_mn(o, 1)
        out_w_n(o, val)
        out_mem_tail(o, addr)
    } else {
        out_mn(o, 1)
        out_x_n(o, val)
        out_mem_tail(o, addr)
    }
}

fun emit_i_binop(o: *Out, fn: *IrFn, i: *Ins) {
    let wide: u64 = 0
    if i.width == 8 { wide = 1 }
    let ra: u64 = 0
    let rb: u64 = 0
    if wide == 1 {
        ra = ensure_src_x(o, fn, i.a, 16)
        rb = ensure_src_x(o, fn, i.b, 17)
    } else {
        ra = ensure_src_w(o, fn, i.a, 16)
        rb = ensure_src_w(o, fn, i.b, 17)
    }
    let rd: u64 = dst_x_reg(fn, i.dst)
    let s0: str = '    '
    out_bytes(o, s0.ptr, s0.len)
    out_binop_mnemonic(o, i.binop, i.is_signed)
    let s1: str = '     '
    out_bytes(o, s1.ptr, s1.len)
    out_reg_wx(o, rd, wide)
    let s2: str = ', '
    out_bytes(o, s2.ptr, s2.len)
    out_reg_wx(o, ra, wide)
    out_bytes(o, s2.ptr, s2.len)
    out_reg_wx(o, rb, wide)
    out_byte(o, 10)
    emit_spill_x(o, fn, i.dst, rd)
}

// Condition suffix for cset: eq, ne, lo, ls, hi, hs.
//
// All unsigned, because the language has no signed types. Here the DIRECT
// condition is written (the assembler already inverts it when expanding the
// cset alias); the byte backend has to invert it itself, see cgb_invcond.
fun out_cc(o: *Out, cc: u64) {
    if cc == 0 { let s: str = 'eq'; out_bytes(o, s.ptr, s.len); return }
    if cc == 1 { let s: str = 'ne'; out_bytes(o, s.ptr, s.len); return }
    if cc == 2 { let s: str = 'lo'; out_bytes(o, s.ptr, s.len); return }
    if cc == 3 { let s: str = 'ls'; out_bytes(o, s.ptr, s.len); return }
    if cc == 4 { let s: str = 'hi'; out_bytes(o, s.ptr, s.len); return }
    if cc == 5 { let s: str = 'hs'; out_bytes(o, s.ptr, s.len); return }
    if cc == 6 { let s: str = 'lt'; out_bytes(o, s.ptr, s.len); return }
    if cc == 7 { let s: str = 'le'; out_bytes(o, s.ptr, s.len); return }
    if cc == 8 { let s: str = 'gt'; out_bytes(o, s.ptr, s.len); return }
    if cc == 9 { let s: str = 'ge'; out_bytes(o, s.ptr, s.len); return }
}

fun emit_i_cmp(o: *Out, fn: *IrFn, i: *Ins, cc: u64) {
    if i.is_signed == 1 {
        if cc == 2 { cc = 6 }
        if cc == 3 { cc = 7 }
        if cc == 4 { cc = 8 }
        if cc == 5 { cc = 9 }
    }
    let wide: u64 = 0
    if i.width == 8 { wide = 1 }
    let ra: u64 = 0
    let rb: u64 = 0
    if wide == 1 {
        ra = ensure_src_x(o, fn, i.a, 16)
        rb = ensure_src_x(o, fn, i.b, 17)
    } else {
        ra = ensure_src_w(o, fn, i.a, 16)
        rb = ensure_src_w(o, fn, i.b, 17)
    }
    let rd: u64 = dst_x_reg(fn, i.dst)
    let s0: str = '    cmp     '
    out_bytes(o, s0.ptr, s0.len)
    out_reg_wx(o, ra, wide)
    let s1: str = ', '
    out_bytes(o, s1.ptr, s1.len)
    out_reg_wx(o, rb, wide)
    out_byte(o, 10)
    let s2: str = '    cset    '
    out_bytes(o, s2.ptr, s2.len)
    out_w_n(o, rd)
    out_bytes(o, s1.ptr, s1.len)
    out_cc(o, cc)
    out_byte(o, 10)
    emit_spill_x(o, fn, i.dst, rd)
}

// The syscall builtin: number in x16, arguments in x0.., and `svc #0x80`.
//
// This `svc #0x80` is the only macOS-specific thing in the generated code, and
// it is exactly what bootstrap/linux/macho2elf.sh rewrites as `bl _tt_sys` in
// order to run the output under qemu on Linux.
fun emit_i_syscall(o: *Out, fn: *IrFn, i: *Ins) {
    let args: *u64 = i.args
    let ro: *u64 = fn.reg_of
    let s0: u64 = args[0]
    let r0: u64 = ro[s0]
    if r0 < NREGS {
        emit_mov_x_x(o, 16, ir_phys_reg(r0))
    } else {
        emit_ldr_x(o, 16, slot_off(fn, s0))
    }
    let k: u64 = 1
    while k < i.nargs {
        emit_load_slot_to_x(o, fn, args[k], k - 1)
        k = k + 1
    }
    if get_target() == TGT_LINUX {
        let lv: str = '    bl      tt_sys\n'
        out_bytes(o, lv.ptr, lv.len)
    } else {
        let sv: str = '    svc     #0x80\n'
        out_bytes(o, sv.ptr, sv.len)
    }
    let dr: u64 = ro[i.dst]
    if dr < NREGS {
        emit_mov_x_x(o, ir_phys_reg(dr), 0)
        return
    }
    emit_str_x(o, 0, slot_off(fn, i.dst))
}

fun emit_i_syscall_checked(o: *Out, fn: *IrFn, i: *Ins) {
    emit_i_syscall(o, fn, i)
    let cs: str = '    cset    x17, cs\n'
    out_bytes(o, cs.ptr, cs.len)
    emit_load_slot_to_x(o, fn, i.args[4], 16)
    let st: str = '    str     x17, [x16]\n'
    out_bytes(o, st.ptr, st.len)
}

fun emit_i_call(o: *Out, fn: *IrFn, i: *Ins) {
    let syskw: str = 'syscall'
    if bytes_eq_at(i.callee_start, i.callee_len, syskw.ptr, 7) == 1 {
        emit_i_syscall(o, fn, i)
        return
    }
    let sysck: str = 'syscall_checked'
    if bytes_eq_at(i.callee_start, i.callee_len, sysck.ptr, 15) == 1 {
        emit_i_syscall_checked(o, fn, i)
        return
    }
    let args: *u64 = i.args
    let k: u64 = 0
    while k < i.nargs {
        if k == 8 { break }
        emit_load_slot_to_x(o, fn, args[k], k)
        k = k + 1
    }
    let stack_bytes: u64 = 0
    if i.nargs > 8 {
        stack_bytes = ((i.nargs - 8) * 8 + 15) / 16 * 16
        let save: str = '    mov     x17, sp\n'
        out_bytes(o, save.ptr, save.len)
        if stack_bytes <= 4095 {
            let sub: str = '    sub     sp, sp, #'
            out_bytes(o, sub.ptr, sub.len)
            out_u64(o, stack_bytes)
            out_byte(o, 10)
        } else {
            emit_movi(o, 16, stack_bytes)
            let subr: str = '    sub     sp, sp, x16\n'
            out_bytes(o, subr.ptr, subr.len)
        }
        k = 8
        while k < i.nargs {
            let ro0: *u64 = fn.reg_of
            let rr: u64 = ro0[args[k]]
            if rr < NREGS {
                emit_mov_x_x(o, 16, ir_phys_reg(rr))
            } else {
                let ld: str = '    ldr     x16, [x17, #'
                out_bytes(o, ld.ptr, ld.len)
                out_u64(o, slot_off(fn, args[k]))
                let end: str = ']\n'
                out_bytes(o, end.ptr, end.len)
            }
            let st: str = '    str     x16, [sp, #'
            out_bytes(o, st.ptr, st.len)
            out_u64(o, (k - 8) * 8)
            let end2: str = ']\n'
            out_bytes(o, end2.ptr, end2.len)
            k = k + 1
        }
    }
    let s0: str = '    bl      '
    out_bytes(o, s0.ptr, s0.len)
    emit_sym(o, i.callee_start, i.callee_len)
    out_byte(o, 10)
    if stack_bytes > 0 {
        if stack_bytes <= 4095 {
            let clean: str = '    add     sp, sp, #'
            out_bytes(o, clean.ptr, clean.len)
            out_u64(o, stack_bytes)
            out_byte(o, 10)
        } else {
            emit_movi(o, 16, stack_bytes)
            let cleanr: str = '    add     sp, sp, x16\n'
            out_bytes(o, cleanr.ptr, cleanr.len)
        }
    }
    let ro: *u64 = fn.reg_of
    let dr: u64 = ro[i.dst]
    if dr < NREGS {
        emit_mov_x_x(o, ir_phys_reg(dr), 0)
        return
    }
    emit_str_x(o, 0, slot_off(fn, i.dst))
}

fun emit_i_ret(o: *Out, fn: *IrFn, i: *Ins, epi_label: u64) {
    if i.imm == 0 {
        let wide: u64 = 0
        let rt: *Type = fn.ret_type
        if rt != nil {
            if type_width(rt) == 8 { wide = 1 }
        }
        let ro: *u64 = fn.reg_of
        let r: u64 = ro[i.a]
        if wide == 1 {
            if r < NREGS {
                emit_mov_x_x(o, 0, ir_phys_reg(r))
            } else {
                emit_ldr_x(o, 0, slot_off(fn, i.a))
            }
        } else {
            if r < NREGS {
                emit_mov_w_w(o, 0, ir_phys_reg(r))
            } else {
                emit_ldr_w(o, 0, slot_off(fn, i.a))
            }
        }
    }
    let s0: str = '    b       .L'
    out_bytes(o, s0.ptr, s0.len)
    out_u64(o, epi_label)
    out_byte(o, 10)
}

fun emit_i_jmp(o: *Out, i: *Ins) {
    let s0: str = '    b       .L'
    out_bytes(o, s0.ptr, s0.len)
    out_u64(o, i.label)
    out_byte(o, 10)
}

fun emit_i_jz(o: *Out, fn: *IrFn, i: *Ins) {
    let wide: u64 = 0
    let types: **Type = fn.slot_types
    if type_width(types[i.a]) == 8 { wide = 1 }
    let sw: u64 = 0
    if wide == 1 { sw = ensure_src_x(o, fn, i.a, 16) }
    else { sw = ensure_src_w(o, fn, i.a, 16) }
    let s0: str = '    cbz     '
    out_bytes(o, s0.ptr, s0.len)
    out_reg_wx(o, sw, wide)
    let s1: str = ', .L'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, i.label)
    out_byte(o, 10)
}

fun emit_i_label(o: *Out, i: *Ins) {
    let s0: str = '.L'
    out_bytes(o, s0.ptr, s0.len)
    out_u64(o, i.label)
    let s1: str = ':\n'
    out_bytes(o, s1.ptr, s1.len)
}

fun emit_instr(o: *Out, fn: *IrFn, i: *Ins, epi_label: u64) {
    let op: u64 = i.op
    if op == IR_MOVI        { emit_i_movi(o, fn, i);        return }
    if op == IR_LABEL_ADDR  { emit_i_label_addr(o, fn, i);  return }
    if op == IR_ADDR_LOCAL  { emit_i_addr_local(o, fn, i);  return }
    if op == IR_LOAD_LOCAL  { emit_i_load_local(o, fn, i);  return }
    if op == IR_STORE_LOCAL { emit_i_store_local(o, fn, i); return }
    if op == IR_LOAD_MEM    { emit_i_load_mem(o, fn, i);    return }
    if op == IR_STORE_MEM   { emit_i_store_mem(o, fn, i);   return }
    if op == IR_BINOP       { emit_i_binop(o, fn, i);       return }
    if op == IR_CMPEQ       { emit_i_cmp(o, fn, i, 0);      return }
    if op == IR_CMPNE       { emit_i_cmp(o, fn, i, 1);      return }
    if op == IR_CMPLT       { emit_i_cmp(o, fn, i, 2);      return }
    if op == IR_CMPLE       { emit_i_cmp(o, fn, i, 3);      return }
    if op == IR_CMPGT       { emit_i_cmp(o, fn, i, 4);      return }
    if op == IR_CMPGE       { emit_i_cmp(o, fn, i, 5);      return }
    if op == IR_CALL        { emit_i_call(o, fn, i);        return }
    if op == IR_RET         { emit_i_ret(o, fn, i, epi_label); return }
    if op == IR_JMP         { emit_i_jmp(o, i);             return }
    if op == IR_JZ          { emit_i_jz(o, fn, i);          return }
    if op == IR_LABEL       { emit_i_label(o, i);           return }
    if op == IR_CAST        { emit_i_cast(o, fn, i);        return }
}

// Writes a symbol name, with a leading underscore when the target is macOS.
// It is the only naming difference between the two targets.
fun emit_sym(o: *Out, ns: u64, nl: u64) {
    if get_target() == TGT_MACOS {
        out_byte(o, 95)
    }
    let lx: *Lexer = LX_STATE
    out_bytes(o, lx.src + ns, nl)
}

fun emit_save_callee(o: *Out, count: u64) {
    let i: u64 = 0
    while i < count {
        let s: str = '    stp     x'
        out_bytes(o, s.ptr, s.len)
        out_u64(o, 19 + i)
        let m: str = ', x'
        out_bytes(o, m.ptr, m.len)
        out_u64(o, 20 + i)
        let e: str = ', [sp, #-16]!\n'
        out_bytes(o, e.ptr, e.len)
        i = i + 2
    }
}

fun emit_restore_callee(o: *Out, count: u64) {
    let i: u64 = count
    if i % 2 != 0 { i = i + 1 }
    while i > 0 {
        i = i - 2
        let s: str = '    ldp     x'
        out_bytes(o, s.ptr, s.len)
        out_u64(o, 19 + i)
        let m: str = ', x'
        out_bytes(o, m.ptr, m.len)
        out_u64(o, 20 + i)
        let e: str = ', [sp], #16\n'
        out_bytes(o, e.ptr, e.len)
    }
}

// Prologue: save x29/x30, set the frame pointer and reserve the locals.
//
// As in cgb_prologue, the reservation has two paths because `sub sp, sp, #imm`
// only reaches 4095; above that the size is loaded into x16. Here it is enough
// to write `sub sp, sp, x16` and let the assembler pick the right encoding,
// which is precisely what the byte backend had to learn to do by hand
// (enc_sub_ext_sp).
fun emit_prologue(o: *Out, fn: *IrFn) {
    let s1: str = '\n    .globl   '
    out_bytes(o, s1.ptr, s1.len)
    emit_sym(o, fn.name_start, fn.name_len)
    out_byte(o, 10)
    emit_sym(o, fn.name_start, fn.name_len)
    let s2: str = ':\n    stp     x29, x30, [sp, #-16]!\n    mov     x29, sp\n'
    out_bytes(o, s2.ptr, s2.len)
    emit_save_callee(o, fn.callee_count)
    if fn.frame_bytes > 0 {
        if fn.frame_bytes <= 4095 {
            let s3: str = '    sub     sp, sp, #'
            out_bytes(o, s3.ptr, s3.len)
            out_u64(o, fn.frame_bytes)
            out_byte(o, 10)
        } else {
            emit_movi(o, 16, fn.frame_bytes)
            let s5: str = '    sub     sp, sp, x16\n'
            out_bytes(o, s5.ptr, s5.len)
        }
    }
}

fun emit_epilogue(o: *Out, fn: *IrFn, epi_label: u64) {
    let s1: str = '.L'
    out_bytes(o, s1.ptr, s1.len)
    out_u64(o, epi_label)
    let s2: str = ':\n'
    out_bytes(o, s2.ptr, s2.len)
    if fn.frame_bytes > 0 {
        if fn.frame_bytes <= 4095 {
            let s3: str = '    add     sp, sp, #'
            out_bytes(o, s3.ptr, s3.len)
            out_u64(o, fn.frame_bytes)
            out_byte(o, 10)
        } else {
            emit_movi(o, 16, fn.frame_bytes)
            let s5: str = '    add     sp, sp, x16\n'
            out_bytes(o, s5.ptr, s5.len)
        }
    }
    emit_restore_callee(o, fn.callee_count)
    let s4: str = '    ldp     x29, x30, [sp], #16\n    ret\n'
    out_bytes(o, s4.ptr, s4.len)
}

fun emit_text_section(o: *Out) {
    if get_target() == TGT_MACOS {
        let s: str = '    .section __TEXT,__text\n'
        out_bytes(o, s.ptr, s.len)
        return
    }
    if get_target() == TGT_LINUX {
        let s: str = '    .text\n'
        out_bytes(o, s.ptr, s.len)
        return
    }
    let s: str = '    .section .text.boot\n'
    out_bytes(o, s.ptr, s.len)
}

// Spills parameter k to its stack slot right on entry, with the width of its
// type. See the explanation in cgb_param_spill.
fun emit_param_spill(o: *Out, fn: *IrFn, k: u64) {
    let w: u64 = 8
    let pts: **Type = fn.param_types
    if pts != nil {
        let pt: *Type = pts[k]
        if pt != nil {
            let tw: u64 = type_width(pt)
            if tw == 1 { w = 1 }
            if tw == 4 { w = 4 }
        }
    }
    if k >= 8 {
        let ld: str = '    ldr     x16, [x29, #'
        out_bytes(o, ld.ptr, ld.len)
        out_u64(o, 16 + (k - 8) * 8)
        let end: str = ']\n'
        out_bytes(o, end.ptr, end.len)
        if w == 1 { out_mn(o, 3); out_w_n(o, 16); out_sp_tail(o, slot_off(fn, k)); return }
        if w == 4 { out_mn(o, 1); out_w_n(o, 16); out_sp_tail(o, slot_off(fn, k)); return }
        emit_str_x(o, 16, slot_off(fn, k))
        return
    }
    if w == 1 {
        out_mn(o, 3)
        out_w_n(o, k)
        out_sp_tail(o, slot_off(fn, k))
        return
    }
    if w == 4 {
        out_mn(o, 1)
        out_w_n(o, k)
        out_sp_tail(o, slot_off(fn, k))
        return
    }
    out_mn(o, 1)
    out_x_n(o, k)
    out_sp_tail(o, slot_off(fn, k))
}

fun emit_fn(o: *Out, fn: *IrFn, epi_label: u64) {
    emit_prologue(o, fn)
    let k: u64 = 0
    while k < fn.nparams {
        emit_param_spill(o, fn, k)
        k = k + 1
    }
    let it: *Ins = fn.head
    while it != nil {
        emit_instr(o, fn, it, epi_label)
        it = it.next
    }
    emit_epilogue(o, fn, epi_label)
}

// One literal byte as `.byte 0xNN`.
//
// They are emitted byte by byte, rather than as `.asciz`, for two reasons: it
// allows any byte without escaping and it keeps the assembler and the linker
// from touching anything.
fun emit_string_byte(o: *Out, v: u64) {
    let s: str = '    .byte   0x'
    out_bytes(o, s.ptr, s.len)
    let hi: u64 = v / 16
    let lo: u64 = v - hi * 16
    out_nibble(o, hi)
    out_nibble(o, lo)
    out_byte(o, 10)
}

// The literals, in __TEXT,__cstring, aligned to 8 and null terminated.
//
// The explicit terminator is MANDATORY and not a detail: without it, the macOS
// linker merges strings that share a suffix, and beyond about 60 strings that
// corrupts the `.ptr` of the literals. It was a real bug in milestone 17.3,
// and it stayed latent until the compiler had enough strings to trigger it.
fun emit_strings(o: *Out, prog: *Program) {
    if prog.strs == nil { return }
    if get_target() == TGT_LINUX {
        let ls0: str = '\n    .section .rodata\n'
        out_bytes(o, ls0.ptr, ls0.len)
    } else {
        let s0: str = '\n    .section __TEXT,__cstring\n'
        out_bytes(o, s0.ptr, s0.len)
    }
    let it: *StrLit = prog.strs
    while it != nil {
        let sb: str = '    .balign  8\nL_str'
        out_bytes(o, sb.ptr, sb.len)
        out_u64(o, it.id)
        let sc: str = ':\n'
        out_bytes(o, sc.ptr, sc.len)
        let k: u64 = 0
        while k < it.slen {
            emit_string_byte(o, it.bytes[k])
            k = k + 1
        }
        emit_string_byte(o, 0)
        it = it.next
    }
}

// The entry point. It calls main and turns its return value into the exit code
// of the process with exit(), without going through libc.
fun emit_macos_start(o: *Out) {
    let s: str = '    .globl   _tt_start\n_tt_start:\n    bl      _main\n    mov     x16, #1\n    svc     #0x80\n'
    out_bytes(o, s.ptr, s.len)
}

// The bss blocks, as `.zerofill __DATA,__bss,_NAME,size,3`.
// The trailing 3 is log2 of the alignment, that is 8 bytes.
fun emit_bsses(o: *Out, prog: *Program) {
    if prog.bsses == nil { return }
    out_byte(o, 10)
    let it: *BssItem = prog.bsses
    while it != nil {
        if get_target() == TGT_LINUX {
            let ls: str = '    .comm '
            out_bytes(o, ls.ptr, ls.len)
            let llx: *Lexer = LX_STATE
            out_bytes(o, llx.src + it.name_start, it.name_len)
            let lc: str = ','
            out_bytes(o, lc.ptr, lc.len)
            out_u64(o, it.size)
            let la: str = ',8\n'
            out_bytes(o, la.ptr, la.len)
            it = it.next
            continue
        }
        let s: str = '    .zerofill __DATA,__bss,_'
        out_bytes(o, s.ptr, s.len)
        let lx: *Lexer = LX_STATE
        out_bytes(o, lx.src + it.name_start, it.name_len)
        let s2: str = ','
        out_bytes(o, s2.ptr, s2.len)
        out_u64(o, it.size)
        let s3: str = ',3\n'
        out_bytes(o, s3.ptr, s3.len)
        it = it.next
    }
}

// Driver of the textual backend: section, entry point, functions, literals and
// bss blocks.
//
// The epilogue labels are numbered starting from the maximum used by the
// lowering, just as in codegen_bytes.tt, so that they do not collide.
fun codegen(o: *Out, target: u64, no_entry: u64, prog: *Program, funcs: *IrFn) {
    set_target(target)
    emit_text_section(o)
    if target == TGT_MACOS {
        if no_entry == 0 { emit_macos_start(o) }
    }
    let max_label: u64 = 0
    let scan: *IrFn = funcs
    while scan != nil {
        let it: *Ins = scan.head
        while it != nil {
            if it.op == IR_LABEL {
                if it.label >= max_label { max_label = it.label + 1 }
            }
            if it.op == IR_JMP {
                if it.label >= max_label { max_label = it.label + 1 }
            }
            if it.op == IR_JZ {
                if it.label >= max_label { max_label = it.label + 1 }
            }
            it = it.next
        }
        scan = scan.next
    }
    let epi: u64 = max_label
    let fn: *IrFn = funcs
    while fn != nil {
        emit_fn(o, fn, epi)
        epi = epi + 1
        fn = fn.next
    }
    emit_strings(o, prog)
    emit_bsses(o, prog)
    out_flush(o)
}
