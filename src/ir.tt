// ============================================================================
// src/ir.tt - representacion intermedia, lowering y asignacion de registros
// ============================================================================
//
// Es la fase que va del AST a algo que un backend pueda emitir instruccion a
// instruccion. Hace tres cosas, en este orden:
//
//   1. LOWERING (lower_expr / lower_stmt / lower_one_fn)
//      Aplana el arbol a una lista lineal de instrucciones de tres direcciones.
//      Las expresiones anidadas se convierten en una cadena de operaciones
//      sobre SLOTS temporales; el control de flujo (if, while, loop, break) se
//      convierte en labels y saltos explicitos.
//
//   2. ASIGNACION DE REGISTROS (regalloc)
//      Decide que slots viven en registro fisico y cuales se derraman a pila,
//      por analisis de rango de vida sobre la lista ya lineal.
//
//   3. CIERRE DEL FRAME (finalize_frame)
//      Fija cuantos bytes de pila necesita la funcion.
//
// EL MODELO DE SLOTS
//
// Un "slot" es un valor con nombre numerico. Los primeros nlocals slots son las
// variables declaradas del programa (parametros incluidos) y los siguientes son
// temporales creados por el lowering. Todos comparten un mismo espacio de
// numeracion y todos tienen un hueco reservado en el frame, en [sp, #slot*8].
//
// Eso significa que un slot SIEMPRE tiene sitio en pila; el regalloc solo
// decide si ademas se le da un registro para no ir a memoria. Es lo que hace
// que derramar sea trivial: no hay que buscar hueco, ya lo tiene.
//
// Un detalle que sorprende: `next_slot` se reinicia por sentencia (ver
// lower_stmt), asi que los temporales se REUTILIZAN entre sentencias. `max_slot`
// se queda con el maximo historico, que es lo que determina el tamano del
// frame. Sin eso, una funcion con muchas sentencias gastaria un hueco por cada
// temporal de cada una.
//
// LAS INSTRUCCIONES
//
// Todas comparten un unico struct Ins con todos los campos posibles, en vez de
// una union o una jerarquia: el lenguaje no tiene ninguna de las dos cosas. Que
// campos son validos depende del opcode:
//
//   IR_MOVI         dst <- imm
//   IR_LABEL_ADDR   dst <- direccion de un literal (str_id) o de un bss
//                   (callee_start/callee_len con el nombre)
//   IR_ADDR_LOCAL   dst <- direccion del hueco de pila de `local`
//   IR_LOAD_LOCAL   dst <- local, con `width`
//   IR_STORE_LOCAL  local <- a, con `width`
//   IR_LOAD_MEM     dst <- [a], con `width`
//   IR_STORE_MEM    [a] <- b, con `width`
//   IR_BINOP        dst <- a `binop` b
//   IR_CMPxx        dst <- (a cmp b) como 0 o 1
//   IR_CALL         dst <- callee(args[0..nargs))
//   IR_RET          devuelve a  (imm != 0 = return sin valor)
//   IR_JMP          salta a label
//   IR_JZ           salta a label si a es cero
//   IR_LABEL        destino de salto
//
// Se puede ver el resultado con `tetsuoc --dump-ir fichero.tt`.
//
// Los dos backends (src/codegen.tt textual y src/codegen_bytes.tt a bytes)
// consumen exactamente esta estructura, y por eso producen codigo equivalente.
// ============================================================================

bss IR_BUF: 16777216      // arena propio del IR, separado del AST
bss IR_ARENA_STORE: 24
bss IR_NEXT_LABEL: 8      // contador GLOBAL de labels, ver ir_new_label

fun ir_init() -> *Arena {
    let a: *Arena = IR_ARENA_STORE
    arena_init(a, IR_BUF, 16777216)
    return a
}

// Ancho en bytes de un tipo, con valor por defecto si no hay tipo.
//
// El "sin tipo" pasa cuando el parser no pudo inferirlo; el defecto es 8, que
// es el ancho de un puntero y de un u64, o sea el caso conservador: leer u
// escribir de mas nunca trunca un valor, mientras que asumir 1 byte si.
fun ir_width_of(t: *Type, dflt: u64) -> u64 {
    if t == nil { return dflt }
    return type_width(t)
}

// ---------------------------------------------------------------------------
// Opcodes. Ver la tabla del encabezado para saber que campos usa cada uno.
// ---------------------------------------------------------------------------
const IR_MOVI:        u64 = 0
const IR_LABEL_ADDR:  u64 = 1
const IR_ADDR_LOCAL:  u64 = 2
const IR_LOAD_LOCAL:  u64 = 3
const IR_STORE_LOCAL: u64 = 4
const IR_LOAD_MEM:    u64 = 5
const IR_STORE_MEM:   u64 = 6
const IR_BINOP:       u64 = 7
const IR_CMPEQ:       u64 = 8
const IR_CMPNE:       u64 = 9
const IR_CMPLT:       u64 = 10
const IR_CMPLE:       u64 = 11
const IR_CMPGT:       u64 = 12
const IR_CMPGE:       u64 = 13
const IR_CALL:        u64 = 14
const IR_RET:         u64 = 15
const IR_JMP:         u64 = 16
const IR_JZ:          u64 = 17
const IR_LABEL:       u64 = 18
const IR_CAST:        u64 = 19

// Una instruccion. Un solo struct para todos los opcodes: sin uniones ni
// herencia, los campos que no aplican simplemente quedan a cero.
//
// 120 bytes por instruccion (ver mk_ins) es generoso, pero el IR del compilador
// entero cabe de sobra en los 16MB de IR_BUF.
struct Ins {
    op:           u64,
    dst:          u64,
    a:            u64,
    b:            u64,
    local:        u64,
    width:        u64,
    imm:          u64,
    label:        u64,
    str_id:       u64,
    binop:        u64,
    callee_start: u64,
    callee_len:   u64,
    args:         *u64,
    nargs:        u64,
    is_signed:    u64,
    next:         *Ins,
}

// Una funcion ya bajada a IR.
//
//   nlocals      variables declaradas (parametros incluidos)
//   nslots       total de slots, o sea nlocals mas los temporales
//   slot_types   tipo de cada slot, para decidir anchos de acceso
//   frame_bytes  bytes de pila, multiplo de 16 (lo fija finalize_frame)
//   reg_of       slot -> registro fisico, o >= NREGS si esta derramado
//   last_use     indice de la ultima instruccion que usa cada slot
//   head/tail    lista enlazada de instrucciones
struct IrFn {
    name_start:  u64,
    name_len:    u64,
    nparams:     u64,
    param_types: **Type,
    nlocals:     u64,
    nslots:      u64,
    slot_types:  **Type,
    frame_bytes: u64,
    ret_type:    *Type,
    reg_of:      *u64,
    last_use:    *u64,
    head:        *Ins,
    tail:        *Ins,
    next:        *IrFn,
}

// Reserva e inicializa una instruccion. Poner TODOS los campos a cero
// explicitamente importa: el arena no garantiza memoria limpia (los bloques se
// reutilizan tras un vec_push que creciera) y un campo con basura se
// interpretaria como un slot o un label validos.
fun mk_ins(ar: *Arena, op: u64) -> *Ins {
    let i: *Ins = arena_take(ar, 128)
    i.op = op
    i.dst = 0
    i.a = 0
    i.b = 0
    i.local = 0
    i.width = 0
    i.imm = 0
    i.label = 0
    i.str_id = 0
    i.binop = 0
    i.callee_start = 0
    i.callee_len = 0
    i.args = nil
    i.nargs = 0
    i.is_signed = 0
    i.next = nil
    return i
}

fun mk_ir_fn(ar: *Arena, name_start: u64, name_len: u64) -> *IrFn {
    let f: *IrFn = arena_take(ar, 112)
    f.name_start = name_start
    f.name_len = name_len
    f.nparams = 0
    f.param_types = nil
    f.nlocals = 0
    f.nslots = 0
    f.slot_types = nil
    f.frame_bytes = 0
    f.ret_type = nil
    f.reg_of = nil
    f.last_use = nil
    f.head = nil
    f.tail = nil
    f.next = nil
    return f
}

// Anade una instruccion al final de la funcion. La lista lleva tail para que
// esto sea O(1); el IR se construye estrictamente hacia delante.
fun ir_emit(fn: *IrFn, i: *Ins) {
    if fn.head == nil {
        fn.head = i
        fn.tail = i
        return
    }
    let t: *Ins = fn.tail
    t.next = i
    fn.tail = i
}

// Estado del lowering de UNA funcion.
//
//   next_slot    proximo temporal libre; se reinicia en cada sentencia
//   max_slot     maximo historico de next_slot -> tamano real del frame
//   break_stack  pila de labels de salida de bucle, para que `break` sepa
//                adonde saltar; permite bucles anidados
struct B {
    f:           *IrFn,
    ar:          *Arena,
    next_slot:   u64,
    max_slot:    u64,
    slot_types:  **Type,
    slot_cap:    u64,
    next_label:  u64,
    break_stack: *u64,
    continue_stack: *u64,
    break_top:   u64,
}

fun mk_builder(ar: *Arena, fn: *IrFn) -> *B {
    let b: *B = arena_take(ar, 80)
    b.f = fn
    b.ar = ar
    b.next_slot = 0
    b.max_slot = 0
    b.slot_cap = 4096
    let st: **Type = arena_take(ar, 32768)
    b.slot_types = st
    b.next_label = 0
    let bs: *u64 = arena_take(ar, 128)
    b.break_stack = bs
    let cs: *u64 = arena_take(ar, 128)
    b.continue_stack = cs
    b.break_top = 0
    return b
}

// Reserva un slot temporal.
//
// La actualizacion de max_slot es lo unico que impide que la reutilizacion de
// temporales entre sentencias infradimensione el frame.
fun ir_new_slot(b: *B, ty: *Type) -> u64 {
    let dst: u64 = b.next_slot
    b.next_slot = dst + 1
    if dst >= b.max_slot { b.max_slot = dst + 1 }
    let slots: **Type = b.slot_types
    slots[dst] = ty
    return dst
}

// Nuevo id de label.
//
// El contador es GLOBAL a todo el programa, no por funcion. Podria ser por
// funcion, pero siendo global los ids son unicos en toda la compilacion y el
// backend puede usar una sola tabla plana label -> offset sin preocuparse de
// colisiones entre funciones.
fun ir_new_label(b: *B) -> u64 {
    let p: *u64 = IR_NEXT_LABEL
    let l: u64 = p[0]
    p[0] = l + 1
    return l
}

fun ir_emit_label(b: *B, l: u64) {
    let i: *Ins = mk_ins(b.ar, IR_LABEL)
    i.label = l
    ir_emit(b.f, i)
}

fun ir_emit_jmp(b: *B, l: u64) {
    let i: *Ins = mk_ins(b.ar, IR_JMP)
    i.label = l
    ir_emit(b.f, i)
}

fun ir_emit_jz(b: *B, cond_slot: u64, l: u64) {
    let i: *Ins = mk_ins(b.ar, IR_JZ)
    i.a = cond_slot
    i.label = l
    ir_emit(b.f, i)
}

// ---------------------------------------------------------------------------
// Lowering de expresiones
//
// Devuelve el SLOT donde queda el resultado. Cada caso emite las instrucciones
// necesarias y crea un temporal para el resultado; las subexpresiones se bajan
// recursivamente antes, con lo que la lista queda en orden de evaluacion.
// ---------------------------------------------------------------------------
fun lower_expr(b: *B, e: *Expr) -> u64 {
    if e.kind == EX_INT {
        let dst: u64 = ir_new_slot(b, e.type)
        let m: *Ins = mk_ins(b.ar, IR_MOVI)
        m.dst = dst
        m.imm = e.ival
        ir_emit(b.f, m)
        return dst
    }
    if e.kind == EX_VAR {
        let dst: u64 = ir_new_slot(b, e.type)
        let l: *Ins = mk_ins(b.ar, IR_LOAD_LOCAL)
        l.dst = dst
        l.local = e.var_index
        let sts: **Type = b.slot_types
        l.width = ir_width_of(sts[e.var_index], 8)
        l.is_signed = type_is_signed(sts[e.var_index])
        ir_emit(b.f, l)
        return dst
    }
    if e.kind == EX_STRLIT {
        let dst: u64 = ir_new_slot(b, e.type)
        let la: *Ins = mk_ins(b.ar, IR_LABEL_ADDR)
        la.dst = dst
        la.str_id = e.str_id
        ir_emit(b.f, la)
        return dst
    }
    if e.kind == EX_LOGAND { return lower_logical(b, e, 0) }
    if e.kind == EX_LOGOR { return lower_logical(b, e, 1) }
    if e.kind == EX_BIN {
        let la: u64 = lower_expr(b, e.lhs)
        let lb: u64 = lower_expr(b, e.rhs)
        if e.op == OP_MOD {
            let width: u64 = ir_width_of(e.type, 4)
            let signed: u64 = type_is_signed(e.type)
            let quotient: u64 = ir_new_slot(b, e.type)
            let div: *Ins = mk_ins(b.ar, IR_BINOP)
            div.dst = quotient
            div.a = la
            div.b = lb
            div.binop = OP_DIV
            div.width = width
            div.is_signed = signed
            ir_emit(b.f, div)
            let product: u64 = ir_new_slot(b, e.type)
            let mul: *Ins = mk_ins(b.ar, IR_BINOP)
            mul.dst = product
            mul.a = quotient
            mul.b = lb
            mul.binop = OP_MUL
            mul.width = width
            mul.is_signed = signed
            ir_emit(b.f, mul)
            let remainder: u64 = ir_new_slot(b, e.type)
            let sub: *Ins = mk_ins(b.ar, IR_BINOP)
            sub.dst = remainder
            sub.a = la
            sub.b = product
            sub.binop = OP_SUB
            sub.width = width
            sub.is_signed = signed
            ir_emit(b.f, sub)
            return remainder
        }
        let dst: u64 = ir_new_slot(b, e.type)
        let op: *Ins = mk_ins(b.ar, IR_BINOP)
        op.dst = dst
        op.a = la
        op.b = lb
        op.binop = e.op
        op.width = ir_width_of(e.type, 4)
        op.is_signed = type_is_signed(e.type)
        ir_emit(b.f, op)
        return dst
    }
    if e.kind == EX_CAST {
        let src: u64 = lower_expr(b, e.inner)
        let dstc: u64 = ir_new_slot(b, e.type)
        let ci: *Ins = mk_ins(b.ar, IR_CAST)
        ci.dst = dstc
        ci.a = src
        ci.width = ir_width_of(e.type, 8)
        ci.is_signed = type_is_signed(e.type)
        ir_emit(b.f, ci)
        return dstc
    }
    if e.kind == EX_EQ { return lower_cmp(b, e, IR_CMPEQ) }
    if e.kind == EX_NE { return lower_cmp(b, e, IR_CMPNE) }
    if e.kind == EX_LT { return lower_cmp(b, e, IR_CMPLT) }
    if e.kind == EX_LE { return lower_cmp(b, e, IR_CMPLE) }
    if e.kind == EX_GT { return lower_cmp(b, e, IR_CMPGT) }
    if e.kind == EX_GE { return lower_cmp(b, e, IR_CMPGE) }
    if e.kind == EX_ADDR {
        let dst2: u64 = ir_new_slot(b, e.type)
        let ai: *Ins = mk_ins(b.ar, IR_ADDR_LOCAL)
        ai.dst = dst2
        let inner: *Expr = e.inner
        ai.local = inner.var_index
        ir_emit(b.f, ai)
        return dst2
    }
    if e.kind == EX_DEREF {
        let addr: u64 = lower_expr(b, e.inner)
        let dst3: u64 = ir_new_slot(b, e.type)
        let ld: *Ins = mk_ins(b.ar, IR_LOAD_MEM)
        ld.dst = dst3
        ld.a = addr
        ld.width = ir_width_of(e.type, 8)
        ld.is_signed = type_is_signed(e.type)
        ir_emit(b.f, ld)
        return dst3
    }
    if e.kind == EX_EXTERN {
        let dst5: u64 = ir_new_slot(b, e.type)
        let xa: *Ins = mk_ins(b.ar, IR_LABEL_ADDR)
        xa.dst = dst5
        xa.callee_start = e.callee_start
        xa.callee_len = e.callee_len
        ir_emit(b.f, xa)
        return dst5
    }
    if e.kind == EX_CALL {
        let n: u64 = e.nargs
        let src: **Expr = e.args
        let cap: u64 = n * 16
        if cap == 0 { cap = 8 }
        let arg_slots: *u64 = arena_take(b.ar, cap)
        let actual: u64 = 0
        let i: u64 = 0
        while i < n {
            let ai2: *Expr = src[i]
            let expand: u64 = 0
            let at: *Type = ai2.type
            if at != nil {
                if at.kind == T_STR {
                    if ai2.kind == EX_VAR { expand = 1 }
                }
            }
            if expand == 1 {
                let pslot: u64 = ir_new_slot(b, mk_ptr(b.ar, mk_prim(b.ar, T_U8)))
                let lp: *Ins = mk_ins(b.ar, IR_LOAD_LOCAL)
                lp.dst = pslot
                lp.local = ai2.var_index
                lp.width = 8
                ir_emit(b.f, lp)
                arg_slots[actual] = pslot
                actual = actual + 1
                let lslot: u64 = ir_new_slot(b, mk_prim(b.ar, T_U64))
                let ll: *Ins = mk_ins(b.ar, IR_LOAD_LOCAL)
                ll.dst = lslot
                ll.local = ai2.var_index + 1
                ll.width = 8
                ir_emit(b.f, ll)
                arg_slots[actual] = lslot
                actual = actual + 1
            } else {
                arg_slots[actual] = lower_expr(b, ai2)
                actual = actual + 1
            }
            i = i + 1
        }
        if actual > 8 {
            let m94: str = 'demasiados params (>8)'
            die_line(m94.ptr, m94.len, 0)
        }
        let dst4: u64 = ir_new_slot(b, e.type)
        let ci: *Ins = mk_ins(b.ar, IR_CALL)
        ci.dst = dst4
        ci.callee_start = e.callee_start
        ci.callee_len = e.callee_len
        ci.args = arg_slots
        ci.nargs = actual
        ir_emit(b.f, ci)
        return dst4
    }
    return 0
}

fun lower_logical(b: *B, e: *Expr, is_or: u64) -> u64 {
    let dst: u64 = ir_new_slot(b, e.type)
    let init: *Ins = mk_ins(b.ar, IR_MOVI)
    init.dst = dst
    init.imm = is_or
    ir_emit(b.f, init)
    let lhs: u64 = lower_expr(b, e.lhs)
    let end_label: u64 = ir_new_label(b)
    if is_or == 1 {
        let rhs_label: u64 = ir_new_label(b)
        ir_emit_jz(b, lhs, rhs_label)
        ir_emit_jmp(b, end_label)
        ir_emit_label(b, rhs_label)
    } else {
        ir_emit_jz(b, lhs, end_label)
    }
    let rhs: u64 = lower_expr(b, e.rhs)
    let zero: u64 = ir_new_slot(b, e.type)
    let mov: *Ins = mk_ins(b.ar, IR_MOVI)
    mov.dst = zero
    mov.imm = 0
    ir_emit(b.f, mov)
    let cmp: *Ins = mk_ins(b.ar, IR_CMPNE)
    cmp.dst = dst
    cmp.a = rhs
    cmp.b = zero
    let right: *Expr = e.rhs
    cmp.width = ir_width_of(right.type, 4)
    cmp.is_signed = type_is_signed(right.type)
    ir_emit(b.f, cmp)
    ir_emit_label(b, end_label)
    return dst
}

// Comparacion: baja los dos lados y emite un IR_CMPxx, que deja 0 o 1 en un
// slot. El ancho sale del operando, no del resultado.
fun lower_cmp(b: *B, e: *Expr, opk: u64) -> u64 {
    let la: u64 = lower_expr(b, e.lhs)
    let lb: u64 = lower_expr(b, e.rhs)
    let dst: u64 = ir_new_slot(b, e.type)
    let ci: *Ins = mk_ins(b.ar, opk)
    ci.dst = dst
    ci.a = la
    ci.b = lb
    let le: *Expr = e.lhs
    ci.width = ir_width_of(le.type, 4)
    ci.is_signed = type_is_signed(le.type)
    ir_emit(b.f, ci)
    return dst
}

// ---------------------------------------------------------------------------
// Lowering de sentencias
//
// Aqui es donde el control de flujo estructurado se convierte en labels y
// saltos. Los esquemas:
//
//   if c { A } else { B }        while c { A }         loop { A }
//     jz c, Lelse                 Ltop:                  Ltop:
//     A                             jz c, Lend             A
//     jmp Lend                      A                      jmp Ltop
//   Lelse:                          jmp Ltop             Lend:      <- break
//     B                           Lend:                             salta aqui
//   Lend:
//
// `break` salta al label que hay en la cima de break_stack, que es lo que hace
// que funcione dentro de bucles anidados.
//
// Cada sentencia reinicia next_slot: los temporales de la anterior ya no hacen
// falta y se pueden reutilizar.
// ---------------------------------------------------------------------------
fun lower_stmt(b: *B, s: *Stmt) {
    if s.kind == ST_LET {
        if s.init != nil {
            let sts: **Type = b.slot_types
            let lty: *Type = sts[s.local_index]
            let is_strlet: u64 = 0
            if lty != nil {
                if lty.kind == T_STR {
                    let ie: *Expr = s.init
                    if ie.kind == EX_STRLIT { is_strlet = 1 }
                }
            }
            if is_strlet == 1 {
                let ie2: *Expr = s.init
                let ptr_slot: u64 = ir_new_slot(b, mk_ptr(b.ar, mk_prim(b.ar, T_U8)))
                let la: *Ins = mk_ins(b.ar, IR_LABEL_ADDR)
                la.dst = ptr_slot
                la.str_id = ie2.str_id
                ir_emit(b.f, la)
                let sp: *Ins = mk_ins(b.ar, IR_STORE_LOCAL)
                sp.local = s.local_index
                sp.a = ptr_slot
                sp.width = 8
                ir_emit(b.f, sp)
                let len_slot: u64 = ir_new_slot(b, mk_prim(b.ar, T_U64))
                let m: *Ins = mk_ins(b.ar, IR_MOVI)
                m.dst = len_slot
                m.imm = ie2.str_len
                ir_emit(b.f, m)
                let sl: *Ins = mk_ins(b.ar, IR_STORE_LOCAL)
                sl.local = s.local_index + 1
                sl.a = len_slot
                sl.width = 8
                ir_emit(b.f, sl)
                return
            }
            let v: u64 = lower_expr(b, s.init)
            let st: *Ins = mk_ins(b.ar, IR_STORE_LOCAL)
            st.local = s.local_index
            st.a = v
            st.width = ir_width_of(lty, 8)
            ir_emit(b.f, st)
        }
        return
    }
    if s.kind == ST_ASSIGN {
        if s.init != nil {
            let v: u64 = lower_expr(b, s.init)
            let st: *Ins = mk_ins(b.ar, IR_STORE_LOCAL)
            st.local = s.local_index
            st.a = v
            let sts2: **Type = b.slot_types
            st.width = ir_width_of(sts2[s.local_index], 8)
            ir_emit(b.f, st)
        }
        return
    }
    if s.kind == ST_STORE {
        let addr: u64 = lower_expr(b, s.expr)
        let val: u64 = lower_expr(b, s.init)
        let sm: *Ins = mk_ins(b.ar, IR_STORE_MEM)
        sm.a = addr
        sm.b = val
        sm.width = 8
        let pe: *Expr = s.expr
        let pty: *Type = pe.type
        if pty != nil {
            if pty.kind == T_PTR {
                sm.width = ir_width_of(pty.inner, 8)
            }
        }
        ir_emit(b.f, sm)
        return
    }
    if s.kind == ST_RETURN {
        if s.ret_val != nil {
            let v: u64 = lower_expr(b, s.ret_val)
            let r: *Ins = mk_ins(b.ar, IR_RET)
            r.a = v
            ir_emit(b.f, r)
            return
        }
        let r2: *Ins = mk_ins(b.ar, IR_RET)
        r2.a = 0
        r2.imm = 1
        ir_emit(b.f, r2)
        return
    }
    if s.kind == ST_EXPR {
        if s.expr != nil { lower_expr(b, s.expr) }
        return
    }
    if s.kind == ST_IF {
        let c: u64 = lower_expr(b, s.cond)
        let l_else: u64 = ir_new_label(b)
        ir_emit_jz(b, c, l_else)
        lower_block(b, s.body)
        if s.else_body == nil {
            ir_emit_label(b, l_else)
            return
        }
        let l_end2: u64 = ir_new_label(b)
        ir_emit_jmp(b, l_end2)
        ir_emit_label(b, l_else)
        lower_block(b, s.else_body)
        ir_emit_label(b, l_end2)
        return
    }
    if s.kind == ST_WHILE {
        let l_top: u64 = ir_new_label(b)
        let l_end3: u64 = ir_new_label(b)
        ir_emit_label(b, l_top)
        let c2: u64 = lower_expr(b, s.cond)
        ir_emit_jz(b, c2, l_end3)
        let bs: *u64 = b.break_stack
        let cs: *u64 = b.continue_stack
        bs[b.break_top] = l_end3
        cs[b.break_top] = l_top
        b.break_top = b.break_top + 1
        lower_block(b, s.body)
        b.break_top = b.break_top - 1
        ir_emit_jmp(b, l_top)
        ir_emit_label(b, l_end3)
        return
    }
    if s.kind == ST_LOOP {
        let l_top2: u64 = ir_new_label(b)
        let l_end4: u64 = ir_new_label(b)
        ir_emit_label(b, l_top2)
        let bs2: *u64 = b.break_stack
        let cs2: *u64 = b.continue_stack
        bs2[b.break_top] = l_end4
        cs2[b.break_top] = l_top2
        b.break_top = b.break_top + 1
        lower_block(b, s.body)
        b.break_top = b.break_top - 1
        ir_emit_jmp(b, l_top2)
        ir_emit_label(b, l_end4)
        return
    }
    if s.kind == ST_BREAK {
        if b.break_top == 0 {
            let m90b: str = 'break fuera de loop'
            die_line(m90b.ptr, m90b.len, 0)
        }
        let bs3: *u64 = b.break_stack
        let dst: u64 = bs3[b.break_top - 1]
        ir_emit_jmp(b, dst)
        return
    }
    if s.kind == ST_CONTINUE {
        if b.break_top == 0 {
            let m90c: str = 'continue fuera de loop'
            die_line(m90c.ptr, m90c.len, 0)
        }
        let cs3: *u64 = b.continue_stack
        let dst2: u64 = cs3[b.break_top - 1]
        ir_emit_jmp(b, dst2)
        return
    }
}

fun lower_block(b: *B, head: *Stmt) {
    let s: *Stmt = head
    while s != nil {
        lower_stmt(b, s)
        s = s.next
    }
}

// Baja una funcion entera del AST al IR: copia la firma, prepara el builder y
// recorre el cuerpo.
fun lower_one_fn(ar: *Arena, sf: *Func) -> *IrFn {
    let nloc: u64 = sf.nlocals
    let locs: **Local = sf.locals
    let np: u64 = sf.nparams
    let f: *IrFn = mk_ir_fn(ar, sf.name_start, sf.name_len)
    f.nparams = np
    f.nlocals = nloc
    f.ret_type = sf.ret_type
    let b: *B = mk_builder(ar, f)
    b.next_slot = nloc
    b.max_slot = nloc
    let sts: **Type = b.slot_types
    let i: u64 = 0
    while i < nloc {
        let lc: *Local = locs[i]
        sts[i] = lc.type
        i = i + 1
    }
    let ptb: u64 = np * 8
    if ptb == 0 { ptb = 8 }
    let pts: **Type = arena_take(ar, ptb)
    i = 0
    while i < np {
        let lc2: *Local = locs[i]
        pts[i] = lc2.type
        i = i + 1
    }
    f.param_types = pts
    lower_block(b, sf.body)
    f.nslots = b.max_slot
    f.slot_types = b.slot_types
    return f
}

// ============================================================================
// Asignacion de registros
// ============================================================================
//
// ALGORITMO: rangos de vida sobre la lista lineal, con asignacion voraz.
//
//   1. Se pasa la lista a un array para poder indexar por posicion.
//   2. Para cada slot se calcula def_idx (donde se define) y last_use (ultimo
//      uso), recorriendo las instrucciones y mirando sus operandos.
//   3. Se marca `cross`: un slot CRUZA una llamada si su rango de vida contiene
//      un IR_CALL. Como los registros que usamos son todos caller-saved, un
//      slot que cruce una llamada no puede vivir en registro y se derrama
//      directamente. Es la simplificacion clave: evita tener que guardar y
//      restaurar registros alrededor de cada llamada.
//   4. Los demas se asignan por orden a los NREGS registros disponibles,
//      liberando cada uno cuando se pasa el last_use de su slot. Si no queda
//      ninguno libre, el slot se derrama.
//
// El resultado va a fn.reg_of: un valor menor que NREGS es el registro fisico
// (los backends le suman 9, o sea x9..x15) y cualquier valor mayor o igual
// significa "en pila, en [sp, #slot*8]".
//
// No es un asignador bueno; es un asignador correcto y predecible, que es lo
// que hace falta para que los dos backends coincidan byte a byte.
const NREGS: u64 = 7

fun ir_count_ins(fn: *IrFn) -> u64 {
    let n: u64 = 0
    let it: *Ins = fn.head
    while it != nil {
        n = n + 1
        it = it.next
    }
    return n
}

// Si el opcode escribe en i.dst. Junto con collect_uses define que slots toca
// cada instruccion, que es todo lo que necesita el analisis de rangos de vida.
fun ir_has_dst(i: *Ins) -> u64 {
    if i.op == IR_MOVI { return 1 }
    if i.op == IR_LABEL_ADDR { return 1 }
    if i.op == IR_ADDR_LOCAL { return 1 }
    if i.op == IR_LOAD_LOCAL { return 1 }
    if i.op == IR_LOAD_MEM { return 1 }
    if i.op == IR_BINOP { return 1 }
    if i.op == IR_CMPEQ { return 1 }
    if i.op == IR_CMPNE { return 1 }
    if i.op == IR_CMPLT { return 1 }
    if i.op == IR_CMPLE { return 1 }
    if i.op == IR_CMPGT { return 1 }
    if i.op == IR_CMPGE { return 1 }
    if i.op == IR_CALL { return 1 }
    return 0
}

// Slots que LEE una instruccion. Los deja en `uses` y devuelve cuantos son.
//
// El llamante pasa un buffer suficiente; el caso mayor es IR_CALL, que lee
// tantos slots como argumentos tenga.
fun collect_uses(i: *Ins, uses: *u64) -> u64 {
    if i.op == IR_STORE_LOCAL {
        uses[0] = i.a
        return 1
    }
    if i.op == IR_LOAD_MEM {
        uses[0] = i.a
        return 1
    }
    if i.op == IR_STORE_MEM {
        uses[0] = i.a
        uses[1] = i.b
        return 2
    }
    if i.op == IR_BINOP {
        uses[0] = i.a
        uses[1] = i.b
        return 2
    }
    if i.op == IR_CMPEQ {
        uses[0] = i.a
        uses[1] = i.b
        return 2
    }
    if i.op == IR_CMPNE {
        uses[0] = i.a
        uses[1] = i.b
        return 2
    }
    if i.op == IR_CMPLT {
        uses[0] = i.a
        uses[1] = i.b
        return 2
    }
    if i.op == IR_CMPLE {
        uses[0] = i.a
        uses[1] = i.b
        return 2
    }
    if i.op == IR_CMPGT {
        uses[0] = i.a
        uses[1] = i.b
        return 2
    }
    if i.op == IR_CMPGE {
        uses[0] = i.a
        uses[1] = i.b
        return 2
    }
    if i.op == IR_JZ {
        uses[0] = i.a
        return 1
    }
    if i.op == IR_RET {
        if i.imm == 0 {
            uses[0] = i.a
            return 1
        }
        return 0
    }
    if i.op == IR_CALL {
        let k: u64 = 0
        let args: *u64 = i.args
        while k < i.nargs {
            uses[k] = args[k]
            k = k + 1
        }
        return i.nargs
    }
    return 0
}

// Ver la explicacion del algoritmo junto a NREGS.
//
// Los `if X == 0 { X = 8 }` de los tamanos estan porque arena_take(0) devolveria
// un puntero valido pero compartido con la siguiente reserva; pedir 8 bytes
// para un array vacio evita ese aliasing.
fun regalloc(ar: *Arena, fn: *IrFn) {
    let n: u64 = ir_count_ins(fn)
    let nslots: u64 = fn.nslots

    let arr_bytes: u64 = n * 8
    if arr_bytes == 0 { arr_bytes = 8 }
    let arr: **Ins = arena_take(ar, arr_bytes)
    let it: *Ins = fn.head
    let idx: u64 = 0
    while it != nil {
        arr[idx] = it
        idx = idx + 1
        it = it.next
    }

    let ns_bytes: u64 = nslots * 8
    if ns_bytes == 0 { ns_bytes = 8 }
    let last_use: *u64 = arena_take(ar, ns_bytes)
    let def_idx: *u64 = arena_take(ar, ns_bytes)
    let cross: *u64 = arena_take(ar, ns_bytes)
    let s: u64 = 0
    while s < nslots {
        last_use[s] = n
        def_idx[s] = n
        cross[s] = 0
        s = s + 1
    }

    let barrier_bytes: u64 = n * 8
    if barrier_bytes == 0 { barrier_bytes = 8 }
    let barriers: *u64 = arena_take(ar, barrier_bytes)
    let nbarriers: u64 = 0
    let j: u64 = 0
    while j < n {
        if arr[j].op == IR_CALL {
            barriers[nbarriers] = j
            nbarriers = nbarriers + 1
        }
        if arr[j].op == IR_JMP {
            barriers[nbarriers] = j
            nbarriers = nbarriers + 1
        }
        if arr[j].op == IR_JZ {
            barriers[nbarriers] = j
            nbarriers = nbarriers + 1
        }
        j = j + 1
    }

    let uses: *u64 = arena_take(ar, 128)
    j = n
    while j > 0 {
        j = j - 1
        let nu: u64 = collect_uses(arr[j], uses)
        let u: u64 = 0
        while u < nu {
            let sl: u64 = uses[u]
            if last_use[sl] == n { last_use[sl] = j }
            u = u + 1
        }
    }

    j = 0
    while j < n {
        let ii: *Ins = arr[j]
        if ir_has_dst(ii) != 0 {
            let d: u64 = ii.dst
            if def_idx[d] == n { def_idx[d] = j }
        }
        j = j + 1
    }

    s = 0
    while s < nslots {
        if def_idx[s] < n {
            if last_use[s] < n {
                let c: u64 = 0
                while c < nbarriers {
                    let ci: u64 = barriers[c]
                    if ci > def_idx[s] {
                        if ci < last_use[s] { cross[s] = 1 }
                    }
                    c = c + 1
                }
            }
        }
        s = s + 1
    }

    let reg_of: *u64 = arena_take(ar, ns_bytes)
    s = 0
    while s < nslots {
        reg_of[s] = NREGS
        s = s + 1
    }
    fn.reg_of = reg_of
    fn.last_use = last_use

    let nlocals: u64 = fn.nlocals
    let is_free: *u64 = arena_take(ar, 64)
    let r: u64 = 0
    while r < NREGS {
        is_free[r] = 1
        r = r + 1
    }

    j = 0
    while j < n {
        let ii2: *Ins = arr[j]
        if ir_has_dst(ii2) != 0 {
            let d2: u64 = ii2.dst
            if d2 >= nlocals {
                if last_use[d2] < n {
                    if cross[d2] == 0 {
                        let rr: u64 = 0
                        let found: u64 = NREGS
                        while rr < NREGS {
                            if is_free[rr] != 0 {
                                if found == NREGS { found = rr }
                            }
                            rr = rr + 1
                        }
                        if found < NREGS {
                            reg_of[d2] = found
                            is_free[found] = 0
                        }
                    }
                }
            }
        }
        let nu2: u64 = collect_uses(ii2, uses)
        let u2: u64 = 0
        while u2 < nu2 {
            let sl2: u64 = uses[u2]
            if last_use[sl2] == j {
                let rrr: u64 = reg_of[sl2]
                if rrr < NREGS { is_free[rrr] = 1 }
            }
            u2 = u2 + 1
        }
        j = j + 1
    }
}

// Fija el tamano del frame: un hueco de 8 bytes por slot, redondeado a 16.
//
// El redondeo a 16 NO es opcional. La ABI de AArch64 en Darwin exige SP
// alineado a 16 y el hardware falla en cualquier acceso relativo a un SP
// desalineado. Como el prologo hace `sub sp, sp, #frame_bytes`, si frame_bytes
// no fuera multiplo de 16 toda la funcion correria con SP invalido.
fun finalize_frame(fn: *IrFn) {
    let raw: u64 = fn.nslots * 8
    let fb: u64 = raw + 15
    fb = fb / 16
    fb = fb * 16
    fn.frame_bytes = fb
}

// Driver: baja todas las funciones del programa, y para cada una asigna
// registros y cierra el frame. Devuelve la lista enlazada de IrFn que consumen
// los backends.
fun lower(ar: *Arena, prog: *Program) -> *IrFn {
    let lc: *u64 = IR_NEXT_LABEL
    lc[0] = 0
    let head: *IrFn = nil
    let tail: *IrFn = nil
    let sf: *Func = prog.funcs
    while sf != nil {
        let f: *IrFn = lower_one_fn(ar, sf)
        regalloc(ar, f)
        finalize_frame(f)
        if head == nil {
            head = f
            tail = f
        } else {
            tail.next = f
            tail = f
        }
        sf = sf.next
    }
    return head
}

// Vuelca el IR en texto legible. Es lo que imprime `--dump-ir` y la forma mas
// rapida de ver por que un backend emite lo que emite.
fun dump_ir(o: *Out, funcs: *IrFn) {
    let lx: *Lexer = LX_STATE
    let fn: *IrFn = funcs
    while fn != nil {
        let sf: str = 'fn '
        out_bytes(o, sf.ptr, sf.len)
        out_bytes(o, lx.src + fn.name_start, fn.name_len)
        let sp: str = ' nparams='
        out_bytes(o, sp.ptr, sp.len)
        out_u64(o, fn.nparams)
        let ss: str = ' nslots='
        out_bytes(o, ss.ptr, ss.len)
        out_u64(o, fn.nslots)
        let sfb: str = ' frame_bytes='
        out_bytes(o, sfb.ptr, sfb.len)
        out_u64(o, fn.frame_bytes)
        out_byte(o, 10)
        let it: *Ins = fn.head
        while it != nil {
            let so: str = '  op='
            out_bytes(o, so.ptr, so.len)
            out_u64(o, it.op)
            let sd: str = ' dst='
            out_bytes(o, sd.ptr, sd.len)
            out_u64(o, it.dst)
            let sa: str = ' a='
            out_bytes(o, sa.ptr, sa.len)
            out_u64(o, it.a)
            let sb: str = ' b='
            out_bytes(o, sb.ptr, sb.len)
            out_u64(o, it.b)
            let sll: str = ' local='
            out_bytes(o, sll.ptr, sll.len)
            out_u64(o, it.local)
            let si: str = ' imm='
            out_bytes(o, si.ptr, si.len)
            out_u64(o, it.imm)
            let slb: str = ' label='
            out_bytes(o, slb.ptr, slb.len)
            out_u64(o, it.label)
            let sst: str = ' str_id='
            out_bytes(o, sst.ptr, sst.len)
            out_u64(o, it.str_id)
            out_byte(o, 10)
            it = it.next
        }
        fn = fn.next
    }
}
