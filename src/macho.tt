// ============================================================================
// src/macho.tt - ad-hoc signed AArch64 Mach-O emitter (milestones 24.d / 24.f / 24.g)
// ============================================================================
//
// Writes a complete and SIGNED macOS/arm64 executable without using as, ld or
// codesign. It is the piece that closes self-hosting: with it the compiler
// produces binaries that macOS runs directly, with no external toolchain.
//
// HOW THE IMAGE IS BUILT
//
// Everything is assembled in MO_IMG, a bss block, with a global cursor
// (MO_CUR) that only moves forward; the e8/e32/e64 functions write at the
// cursor position and advance it. At the end the hashes are computed and the
// whole block is flushed with a SINGLE write() call. Nothing is written to
// disk until the end, which makes it possible to go back and patch (see
// img_or in codegen_bytes.tt, which resolves the adrp/add pairs once the final
// addresses are known).
//
// THERE ARE TWO PATHS, AND THEY SHOULD NOT BE CONFUSED
//
//   A) mo_emit_headers + emit_macho_image     (24.d, no bss)
//      11 - 1 = 10 load commands, sizeofcmds = 520, the code starts at offset
//      552, __TEXT takes EXACTLY one 16KB page. It serves toy binaries
//      (tests/macho42_test.tt) and the byte codegen when the program declares
//      no bss at all.
//
//   B) mo_emit_headers_bss + emit_macho_code_bss  (24.g, with bss, multi-page)
//      Adds an LC_SEGMENT_64 __DATA with an S_ZEROFILL __bss section between
//      __TEXT and __LINKEDIT. That is 11 load commands, sizeofcmds = 672, the
//      code starts at 704 and __TEXT takes `text_pages` 16KB pages. It is the
//      path `--emit=macho` uses for real programs.
//
// The 552 -> 704 shift caused by adding __DATA is the reason almost every
// offset appears duplicated in codegen_bytes.tt (mo_string_layout vs
// mo_string_layout_bss, mo_resolve_strings vs mo_resolve_strings_bss).
//
// LAYOUT OF PATH B (the one that matters)
//
//   file                           memory
//   ----                           ------
//   [0]        mach_header_64      __PAGEZERO  vmaddr 0,          vmsize 4GB
//   [32]       11 load commands    __TEXT      vmaddr 0x100000000, N*16KB
//   [704]      code (__text)                   mapped r-x from the file
//   [...]      string literals                 at the end of __text, 8-aligned
//   [...]      zeros up to N*16KB
//   [N*16KB]   CS_SuperBlob        __DATA      vmaddr 0x100000000+N*16KB
//                                              vmsize = bss, filesize 0 (zerofill)
//                                  __LINKEDIT  vmaddr right after __DATA
//                                              holds only the signature
//
// Note that __DATA and __LINKEDIT share a fileoff: __DATA is S_ZEROFILL and
// takes nothing in the file, so its file range is empty.
//
// THE SIGNATURE
//
// macOS/arm64 does NOT run unsigned binaries. An ad-hoc signature (with no
// certificate) is enough, and it consists of a CS_SuperBlob holding a
// CS_CodeDirectory that stores one SHA-256 per 4KB page of the file up to
// `codeLimit`. The kernel recomputes them while paging; if one does not match,
// it kills the process.
//
// Two things are expensive to get wrong:
//   - the hashed bytes have to be EXACTLY those of the final file, so every
//     patch must happen BEFORE mo_sign_and_write_n;
//   - nCodeSlots has to be exactly ceil(codeLimit / 4096).
//
// bootstrap/linux/check_macho.py revalidates both by recomputing the hashes
// against the file, which is what `codesign -v` does.
//
// Depends on src/asm.tt (encoders) and lib/sha256.tt (hashes).
// ============================================================================

// The complete image. 1MB is enough for a __TEXT of 64 16KB pages plus the
// signature; the whole compiler fits in 7. mo_sign_and_write_n aborts if it
// overflows.
bss MO_IMG: 1048576
bss MO_CUR: 8      // write cursor inside MO_IMG
bss MO_UUID: 16    // LC_UUID already computed, ready to emit
bss MO_DIGEST: 32  // scratch for the SHA-256 the UUID comes from

// capacity of MO_IMG: the complete image (__TEXT pages + signature) has to fit
// here. If it does not, we would write past the buffer and the binary would
// come out truncated/corrupt with no warning at all.
fun mo_img_cap() -> u64 {
    return 1048576
}

// Derives the UUID from the CONTENT (SHA-256 of the code, truncated to 16
// bytes, with the RFC 4122 version/variant bits). A constant UUID would make
// two different binaries present themselves to the kernel with the same
// identity; macOS caches load information per UUID and can validate one binary
// against another's cached data (symptom: SIGKILL with a clean `codesign -v`).
fun mo_uuid_from_code(code: *u8, code_len: u64) {
    let dg: *u8 = MO_DIGEST
    sha256(code, code_len, dg)
    let u: *u8 = MO_UUID
    let i: u64 = 0
    while i < 16 {
        u[i] = dg[i]
        i = i + 1
    }
    u[6] = (u[6] & 15) | 64
    u[8] = (u[8] & 63) | 128
}

// Dumps the 16 bytes of the already computed UUID. It is kept apart from
// mo_uuid_from_code because the UUID has to be known BEFORE emitting the
// headers (it goes inside them) but it is derived from the code, which is
// copied AFTERWARDS. The flow is always: compute the UUID -> emit headers ->
// copy code.
fun mo_emit_uuid(img: *u8) {
    let u: *u8 = MO_UUID
    let i: u64 = 0
    while i < 16 {
        e8(img, u[i])
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// Cursor and write primitives
//
// The cursor lives in a bss slot rather than in a parameter so that e8/e32/e64
// have the same signature everywhere and the emission code reads as a list of
// fields, without dragging a position pointer through every call.
// ---------------------------------------------------------------------------

fun mc_get() -> u64 {
    let p: *u64 = MO_CUR
    return p[0]
}

fun mc_set(v: u64) {
    let p: *u64 = MO_CUR
    p[0] = v
}

// Writes a byte at the cursor and advances it. All emission goes through here.
//
// It does not check the MO_IMG limit: that check is done once, on the total
// size, in mo_sign_and_write_n and in emit_macho_image.
fun e8(img: *u8, v: u64) {
    let c: u64 = mc_get()
    img[c] = v & 255
    mc_set(c + 1)
}

// Little-endian: the order of the Mach-O structures (header, load commands,
// sections). Everything that describes the file goes this way.
fun e32(img: *u8, v: u64) {
    e8(img, v)
    e8(img, v >> 8)
    e8(img, v >> 16)
    e8(img, v >> 24)
}

fun e64(img: *u8, v: u64) {
    e32(img, v)
    e32(img, v >> 32)
}

// Big-endian: the order of the SIGNATURE structures. Apple's code signing
// format is big-endian for historical reasons, the opposite of the rest of the
// file. Having both families of functions avoids mistakes: if you are writing
// the signature you use eb*, otherwise e*.
fun eb32(img: *u8, v: u64) {
    e8(img, v >> 24)
    e8(img, v >> 16)
    e8(img, v >> 8)
    e8(img, v)
}

fun eb64(img: *u8, v: u64) {
    eb32(img, v >> 32)
    eb32(img, v)
}

// n zero bytes. Used for the padding of the last __TEXT page and for the
// reserved fields of the load commands.
fun ezeros(img: *u8, n: u64) {
    let i: u64 = 0
    while i < n {
        e8(img, 0)
        i = i + 1
    }
}

// Segment or section name: a fixed 16 bytes, zero padded. It carries no
// terminator if the name is exactly 16 long; that is how the format defines
// it.
fun ename16(img: *u8, name: *u8, nlen: u64) {
    let i: u64 = 0
    while i < nlen {
        e8(img, name[i])
        i = i + 1
    }
    while i < 16 {
        e8(img, 0)
        i = i + 1
    }
}

// PATH A: headers without __DATA. __TEXT is exactly one 16KB page.
//
// Emits the mach_header_64 and 10 load commands, 520 bytes in total, so the
// code starts at offset 552 (= 32 + 520). text_size is the size of the __text
// section (code plus literals) and entry_off the displacement of the entry
// point inside it.
//
// The values are in decimal because the language had no hex literals when this
// was written. The ones that appear bare:
//
//   4277009103 = 0xfeedfacf  MH_MAGIC_64
//   16777228   = 0x0100000c  CPU_TYPE_ARM64
//   2          = MH_EXECUTE
//   2097285    = 0x00200085  MH_NOUNDEFS|MH_DYLDLINK|MH_TWOLEVEL|MH_PIE
//   4294967296 = 0x100000000 size of __PAGEZERO and base of __TEXT
//   4294967848 = 0x100000228 address of __text (= base + 552)
//   2147484672 = 0x80000400  S_ATTR_PURE_INSTRUCTIONS|S_ATTR_SOME_INSTRUCTIONS
//   25 = LC_SEGMENT_64   14 = LC_LOAD_DYLINKER   2 = LC_SYMTAB
//   11 = LC_DYSYMTAB     27 = LC_UUID            50 = LC_BUILD_VERSION
//   29 = LC_CODE_SIGNATURE                       2147483688 = LC_MAIN
//
// MH_PIE is set and it is safe: every reference the codegen emits is
// PC-relative (adrp/add, bl), so the binary works the same if the loader
// slides the image, as long as it slides all of it.
fun mo_emit_headers(img: *u8, text_size: u64, entry_off: u64) {
    // --- mach_header_64: magic, cpu, type, ncmds, sizeofcmds, flags ---
    e32(img, 4277009103)
    e32(img, 16777228)
    e32(img, 0)
    e32(img, 2)
    e32(img, 10)
    e32(img, 520)
    e32(img, 2097285)
    e32(img, 0)

    // --- LC_SEGMENT_64 __PAGEZERO ---
    e32(img, 25)
    e32(img, 72)
    let pz2: str = '__PAGEZERO'
    ename16(img, pz2.ptr, pz2.len)
    e64(img, 0)
    e64(img, 4294967296)
    e64(img, 0)
    e64(img, 0)
    e32(img, 0)
    e32(img, 0)
    e32(img, 0)
    e32(img, 0)

    // --- LC_SEGMENT_64 __TEXT ---
    e32(img, 25)
    e32(img, 152)
    let tx2: str = '__TEXT'
    ename16(img, tx2.ptr, tx2.len)
    e64(img, 4294967296)
    e64(img, 16384)
    e64(img, 0)
    e64(img, 16384)
    e32(img, 7)
    e32(img, 5)
    e32(img, 1)
    e32(img, 0)
    let sn2: str = '__text'
    ename16(img, sn2.ptr, sn2.len)
    ename16(img, tx2.ptr, tx2.len)
    e64(img, 4294967848)
    e64(img, text_size)
    e32(img, 552)
    e32(img, 2)
    e32(img, 0)
    e32(img, 0)
    e32(img, 2147484672)
    e32(img, 0)
    e32(img, 0)
    e32(img, 0)

    // --- LC_SEGMENT_64 __LINKEDIT ---
    e32(img, 25)
    e32(img, 72)
    let le2: str = '__LINKEDIT'
    ename16(img, le2.ptr, le2.len)
    e64(img, 4294983680)
    e64(img, 16384)
    e64(img, 16384)
    e64(img, 238)
    e32(img, 3)
    e32(img, 1)
    e32(img, 0)
    e32(img, 0)

    // --- LC_LOAD_DYLINKER ---
    e32(img, 14)
    e32(img, 32)
    e32(img, 12)
    let dy2: str = '/usr/lib/dyld'
    let di2: u64 = 0
    while di2 < dy2.len {
        e8(img, dy2.ptr[di2])
        di2 = di2 + 1
    }
    while di2 < 20 {
        e8(img, 0)
        di2 = di2 + 1
    }

    // --- LC_SYMTAB ---
    e32(img, 2)
    e32(img, 24)
    e32(img, 16384)
    e32(img, 0)
    e32(img, 16384)
    e32(img, 0)

    // --- LC_DYSYMTAB ---
    e32(img, 11)
    e32(img, 80)
    ezeros(img, 72)

    // --- LC_UUID (derived from the content) ---
    e32(img, 27)
    e32(img, 24)
    mo_emit_uuid(img)

    // --- LC_BUILD_VERSION ---
    e32(img, 50)
    e32(img, 24)
    e32(img, 1)
    e32(img, 720896)
    e32(img, 720896)
    e32(img, 0)

    // --- LC_MAIN ---
    e32(img, 2147483688)
    e32(img, 24)
    e64(img, 552 + entry_off)
    e64(img, 0)

    // --- LC_CODE_SIGNATURE ---
    e32(img, 29)
    e32(img, 16)
    e32(img, 16384)
    e32(img, 238)
}

// Complete PATH A: headers + body + padding + signature, and out to disk.
//
// The body is copied verbatim from code_ptr; there are no relocations because
// this path supports neither literals nor bss. It is used by emit_macho_signed
// (the 24.f smoke test) and, when the program declares no bss, by
// emit_macho_code.
fun emit_macho_image(fd: u64, code_ptr: *u8, code_len: u64, entry_off: u64) {
    let img: *u8 = MO_IMG
    // this path is not parameterized by pages: __TEXT is exactly one 16KB
    // page. If the body does not fit, emit_macho_code_bss has to be used.
    if 552 + code_len > 16384 {
        io_exit(72)
    }
    mo_uuid_from_code(code_ptr, code_len)
    mc_set(0)
    mo_emit_headers(img, code_len, entry_off)

    // --- __text body: copies code_len bytes ---
    let bi: u64 = 0
    while bi < code_len {
        e8(img, code_ptr[bi])
        bi = bi + 1
    }

    // zero padding up to 0x4000, ad-hoc signature and write
    let cur2: u64 = mc_get()
    ezeros(img, 16384 - cur2)
    mo_sign_and_write(fd, img)
}

// writes the CS_SuperBlob, computes the page hashes and flushes to file
// Shortcut for the single 16KB page case.
fun mo_sign_and_write(fd: u64, img: *u8) {
    mo_sign_and_write_n(fd, img, 1)
}

// Writes the CS_SuperBlob at the end of the image, computes the page hashes
// and flushes everything to disk.
//
// STRUCTURE THAT IS EMITTED (all big-endian)
//
//   CS_SuperBlob            20 bytes
//     magic      0xfade0cc0
//     length     total size of the blob
//     count      1            a single blob inside
//     index[0]   type 0 = CSSLOT_CODEDIRECTORY, offset 20
//   CS_CodeDirectory        90 header bytes + the hashes
//     magic      0xfade0c02
//     length     cd_len
//     version    0x20400      (132096) includes the exec segment fields
//     flags      2            CS_ADHOC: signature with no certificate
//     hashOffset 90           where the hashes start, relative to the CD
//     identOffset 88          where the identifier ("a") starts
//     nSpecialSlots 0         no negative slots (requirements, entitlements)
//     nCodeSlots  text_pages*4
//     codeLimit   text_vmsize  how many file bytes the signature covers
//     hashSize 32, hashType 2 (SHA-256), platform 0, pageShift 12 (4KB)
//     ... reserved and version fields ...
//     execSegBase 0, execSegLimit text_vmsize, execSegFlags 1 (MAIN_BINARY)
//     ident       "a\0"
//     hashes      nCodeSlots * 32 bytes
//
// DELICATE POINTS
//
//   - pageShift is 12 (4KB pages) even though the VIRTUAL pages of arm64 macOS
//     are 16KB. They are different things: the signature page size is fixed by
//     Apple at 4KB and that is why there are FOUR hashes per 16KB page of
//     __TEXT. Hence n_hashes = text_pages * 4.
//
//   - codeLimit has to match the dataoff of the LC_CODE_SIGNATURE, that is,
//     where the signature itself starts: the signature does not sign itself.
//
//   - The hashes are computed AFTER emitting the blob header, reading from the
//     image itself (img + slot*4096). Since by then the __TEXT pages are
//     already complete and patched, the hashed bytes are exactly those that
//     will go to the file. Any modification after this function would
//     invalidate the signature silently.
//
//   - hbase = text_vmsize + 110 comes from: the signature starts at
//     text_vmsize, the SuperBlob takes 20, the CodeDirectory header 90, 110 in
//     total.
//
// The identifier is a plain "a". It could be anything non-empty; neither the
// kernel nor codesign interpret it in an ad-hoc signature.
fun mo_sign_and_write_n(fd: u64, img: *u8, text_pages: u64) {
    let n_hashes: u64 = text_pages * 4
    let cd_len: u64 = 88 + 2 + n_hashes * 32
    let cs_len: u64 = 20 + cd_len
    let text_vmsize: u64 = text_pages * 16384
    if text_vmsize + cs_len > mo_img_cap() {
        io_exit(71)
    }
    eb32(img, 0xfade0cc0)
    eb32(img, cs_len)
    eb32(img, 1)
    eb32(img, 0)
    eb32(img, 20)
    eb32(img, 0xfade0c02)
    eb32(img, cd_len)
    eb32(img, 132096)
    eb32(img, 2)
    eb32(img, 90)
    eb32(img, 88)
    eb32(img, 0)
    eb32(img, n_hashes)
    eb32(img, text_vmsize)
    e8(img, 32)
    e8(img, 2)
    e8(img, 0)
    e8(img, 12)
    eb32(img, 0)
    eb32(img, 0)
    eb32(img, 0)
    eb32(img, 0)
    eb64(img, 0)
    eb64(img, 0)
    eb64(img, text_vmsize)
    eb64(img, 1)
    e8(img, 97)
    e8(img, 0)
    ezeros(img, n_hashes * 32)
    let hbase: u64 = text_vmsize + 110
    let slot: u64 = 0
    while slot < n_hashes {
        sha256(img + slot * 4096, 4096, img + hbase + slot * 32)
        slot = slot + 1
    }
    io_write(fd, img, text_vmsize + cs_len)
}

// Buffer for the 12-byte body of emit_macho_signed.
bss MO_CODE: 64

// Smoke test of milestone 24.f: emits a binary whose only content is
// `exit(code)`.
//
//     movz x0, #code
//     movz x16, #1      (SYS_exit)
//     svc  #0x80
//
// It is assembled by hand, byte by byte, because it predates the code buffer
// of codegen_bytes.tt. It is used by tests/macho42_test.tt, which produces a
// binary that returns 42 and is the first executable tetsuo generated without
// any external tool.
fun emit_macho_signed(fd: u64, exit_code: u64) {
    let code: *u8 = MO_CODE
    let w0: u64 = enc_movz(0, exit_code, 0)
    let w1: u64 = enc_movz(16, 1, 0)
    let w2: u64 = enc_svc(128)
    code[0] = w0 & 255
    code[1] = (w0 >> 8) & 255
    code[2] = (w0 >> 16) & 255
    code[3] = (w0 >> 24) & 255
    code[4] = w1 & 255
    code[5] = (w1 >> 8) & 255
    code[6] = (w1 >> 16) & 255
    code[7] = (w1 >> 24) & 255
    code[8] = w2 & 255
    code[9] = (w2 >> 8) & 255
    code[10] = (w2 >> 16) & 255
    code[11] = (w2 >> 24) & 255
    emit_macho_image(fd, code, 12, 0)
}

// ============================================================================
// PATH B: headers with __DATA/__bss and multi-page __TEXT (milestone 24.g)
// ============================================================================
//
// Injects an LC_SEGMENT_64 __DATA with an S_ZEROFILL __bss section between
// __TEXT and __LINKEDIT. Header size arithmetic:
//
//     32   mach_header_64
//     72   LC_SEGMENT_64 __PAGEZERO   (no sections)
//    152   LC_SEGMENT_64 __TEXT       (72 + 80 for the __text section)
//    152   LC_SEGMENT_64 __DATA       (72 + 80 for the __bss section)
//     72   LC_SEGMENT_64 __LINKEDIT   (no sections)
//     32   LC_LOAD_DYLINKER
//     24   LC_SYMTAB
//     80   LC_DYSYMTAB
//     24   LC_UUID
//     24   LC_BUILD_VERSION
//     24   LC_MAIN
//     16   LC_CODE_SIGNATURE
//    ---
//    704   total  ->  ncmds = 11, sizeofcmds = 672, code at offset 704
//
// PARAMETERS
//
//   text_size    size of the __text section (code + literals)
//   text_pages   how many 16KB pages __TEXT takes. This is the parameter that
//                was missing before session C3a: it was pinned to 1 page and
//                the base address of __bss was computed as 16384 + offset,
//                which broke any binary larger than one page.
//   entry_off    entry point, relative to the start of __text
//   bss_vmsize   total size of the bss, already rounded up to 16KB
//
// ADDRESSES THAT ARE DERIVED
//
//   __TEXT      0x100000000                       (right after __PAGEZERO)
//   __DATA      0x100000000 + text_pages*16384
//   __LINKEDIT  __DATA + bss_vmsize
//
// All three vmaddr are multiples of 16KB because text_pages and bss_vmsize
// are; the loader requires vmaddr and fileoff to be congruent modulo the page
// size.
//
// __DATA and __LINKEDIT share a fileoff (= text_vmsize) and do not overlap
// because __DATA has filesize 0: it is S_ZEROFILL, the kernel maps it as
// zeroed anonymous memory and reads nothing from the file.
//
// Literal values specific to this path:
//   4294968000 = 0x1000002c0  address of __text (= 0x100000000 + 704)
//   704 + entry_off           LC_MAIN entryoff, relative to the file start
//   1 in the section flags    S_ZEROFILL
//   cs_datasize = 110 + text_pages*128
//        110 = 20 (SuperBlob) + 90 (CodeDirectory header)
//        128 = 4 hashes of 32 bytes per 16KB page
fun mo_emit_headers_bss(img: *u8, text_size: u64, text_pages: u64, entry_off: u64, bss_vmsize: u64) {
    let text_vmsize: u64 = text_pages * 16384
    let data_vmaddr: u64 = 4294967296 + text_vmsize
    let linkedit_vmaddr: u64 = data_vmaddr + bss_vmsize
    let cs_datasize: u64 = 110 + text_pages * 128

    // --- mach_header_64 ---
    // magic, cputype, cpusubtype, filetype, ncmds, sizeofcmds, flags, reserved
    e32(img, 4277009103)
    e32(img, 16777228)
    e32(img, 0)
    e32(img, 2)
    e32(img, 11)
    e32(img, 672)
    e32(img, 2097285)
    e32(img, 0)

    // --- LC_SEGMENT_64 __PAGEZERO ---
    // The first 4GB left unmapped. It is what makes dereferencing nil (or any
    // badly extended 32-bit pointer) fault cleanly instead of reading garbage.
    e32(img, 25)
    e32(img, 72)
    let pz: str = '__PAGEZERO'
    ename16(img, pz.ptr, pz.len)
    e64(img, 0)
    e64(img, 4294967296)
    e64(img, 0)
    e64(img, 0)
    e32(img, 0)
    e32(img, 0)
    e32(img, 0)
    e32(img, 0)

    // --- LC_SEGMENT_64 __TEXT (r-x) with the __text section ---
    // vmaddr/vmsize/fileoff/filesize, maxprot=7 (rwx), initprot=5 (r-x),
    // nsects=1, flags=0. The segment starts at offset 0 of the file, which
    // means the Mach-O header itself is mapped inside __TEXT; that is normal
    // and it is what lets adrp reach the strings.
    e32(img, 25)
    e32(img, 152)
    let tx: str = '__TEXT'
    ename16(img, tx.ptr, tx.len)
    e64(img, 4294967296)
    e64(img, text_vmsize)
    e64(img, 0)
    e64(img, text_vmsize)
    e32(img, 7)
    e32(img, 5)
    e32(img, 1)
    e32(img, 0)
    let sn: str = '__text'
    ename16(img, sn.ptr, sn.len)
    ename16(img, tx.ptr, tx.len)
    e64(img, 4294968000)
    e64(img, text_size)
    e32(img, 704)
    e32(img, 2)
    e32(img, 0)
    e32(img, 0)
    e32(img, 2147484672)
    e32(img, 0)
    e32(img, 0)
    e32(img, 0)

    // --- LC_SEGMENT_64 __DATA (rw-) with the __bss section ---
    // filesize = 0: it takes nothing in the file. vmsize = bss_vmsize, which
    // the kernel maps as zeroed anonymous memory.
    e32(img, 25)
    e32(img, 152)
    let da: str = '__DATA'
    ename16(img, da.ptr, da.len)
    e64(img, data_vmaddr)
    e64(img, bss_vmsize)
    e64(img, text_vmsize)
    e64(img, 0)
    e32(img, 7)
    e32(img, 3)
    e32(img, 1)
    e32(img, 0)
    let bn: str = '__bss'
    ename16(img, bn.ptr, bn.len)
    ename16(img, da.ptr, da.len)
    e64(img, data_vmaddr)
    e64(img, bss_vmsize)
    e32(img, 0)
    e32(img, 3)
    e32(img, 0)
    e32(img, 0)
    e32(img, 1)
    e32(img, 0)
    e32(img, 0)
    e32(img, 0)

    // --- LC_SEGMENT_64 __LINKEDIT (r--) ---
    // Only the signature lives here. A fixed vmsize of 16KB (one page) because
    // cs_datasize never comes close to that: it is ~1KB for 7 __TEXT pages.
    e32(img, 25)
    e32(img, 72)
    let le: str = '__LINKEDIT'
    ename16(img, le.ptr, le.len)
    e64(img, linkedit_vmaddr)
    e64(img, 16384)
    e64(img, text_vmsize)
    e64(img, cs_datasize)
    e32(img, 3)
    e32(img, 1)
    e32(img, 0)
    e32(img, 0)

    // --- LC_LOAD_DYLINKER ---
    // The binary links against no dylib at all (everything is direct
    // syscalls), but macOS expects a "dynamic" executable with dyld declared.
    // Offset 12 is where the path starts inside the load command itself.
    e32(img, 14)
    e32(img, 32)
    e32(img, 12)
    let dy: str = '/usr/lib/dyld'
    let di: u64 = 0
    while di < dy.len {
        e8(img, dy.ptr[di])
        di = di + 1
    }
    while di < 20 {
        e8(img, 0)
        di = di + 1
    }

    // --- LC_SYMTAB ---
    // symoff, nsyms, stroff, strsize. There is no symbol table: nsyms and
    // strsize are 0. The offsets point at the start of __LINKEDIT because the
    // format requires them to fall inside that segment even when unused.
    e32(img, 2)
    e32(img, 24)
    e32(img, text_vmsize)
    e32(img, 0)
    e32(img, text_vmsize)
    e32(img, 0)

    // --- LC_DYSYMTAB ---
    // All 18 fields at zero. With no symbols there is nothing to partition
    // into local/external/undefined.
    e32(img, 11)
    e32(img, 80)
    ezeros(img, 72)

    e32(img, 27)
    e32(img, 24)
    mo_emit_uuid(img)

    // --- LC_BUILD_VERSION ---
    // platform=1 (macOS), minos=0x0b0000 (11.0), sdk=0x0b0000, ntools=0.
    // Declaring 11.0 is the minimum for arm64.
    e32(img, 50)
    e32(img, 24)
    e32(img, 1)
    e32(img, 720896)
    e32(img, 720896)
    e32(img, 0)

    // --- LC_MAIN ---
    // entryoff (relative to the start of the FILE, not of __text) and
    // stacksize=0 to accept the default stack size.
    e32(img, 2147483688)
    e32(img, 24)
    e64(img, 704 + entry_off)
    e64(img, 0)

    // --- LC_CODE_SIGNATURE ---
    // dataoff = where the signature starts = end of __TEXT = codeLimit.
    // It has to come LAST: the signature covers everything before it.
    e32(img, 29)
    e32(img, 16)
    e32(img, text_vmsize)
    e32(img, cs_datasize)
}
