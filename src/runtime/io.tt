// ============================================================================
// src/runtime/io.tt - runtime minimo: syscalls de macOS y asignador de arena
// ============================================================================
//
// Es el fichero mas bajo de la pila: no depende de nada y todo lo demas depende
// de el. Por eso encabeza la lista de `import` de todos los entries del
// compilador (tests/fixpoint_entry.tt, tests/macos_build.sh, etc.).
//
// Contiene dos cosas sin relacion entre si mas que "ser el suelo":
//
//   1. Los envoltorios de syscall. tetsuo no enlaza contra libSystem: llama al
//      kernel directamente. La ABI de macOS/arm64 es
//
//          x16 = numero de syscall BSD
//          x0..x5 = argumentos
//          svc #0x80
//          x0 = resultado (carry flag = error, que aqui se ignora)
//
//      El builtin `syscall(num, a0, a1, a2)` que se usa aqui lo emite el
//      codegen (ver emit_syscall en codegen.tt y cgb_i_call en
//      codegen_bytes.tt); no es una funcion normal.
//
//      Los numeros son los de <sys/syscall.h> de BSD: 1=exit, 3=read, 4=write,
//      5=open, 6=close. En Linux (harness de qemu) el shim de
//      bootstrap/linux/shim.s traduce estos numeros a los de Linux, por eso
//      macho2elf.sh reescribe `svc #0x80` como `bl _tt_sys`.
//
//   2. El arena. tetsuo no tiene malloc ni free: toda la memoria dinamica sale
//      de bloques bss fijos repartidos por un puntero que solo avanza. Se
//      libera todo de golpe al terminar el proceso, que para un compilador de
//      un solo disparo es exactamente lo que hace falta.
//
// IO_BUF es el bloque generico de 16MB que usan los tests y el que sirve de
// respaldo cuando alguien necesita un buffer grande sin declarar el suyo. Es
// tambien el PRIMER simbolo bss del programa enlazado, asi que en el Mach-O
// emitido cae en el offset 0 de __DATA (vaddr = base de __bss). Ver
// cgb_bss_layout en codegen_bytes.tt.
// ============================================================================

bss IO_BUF: 16777216

// ---------------------------------------------------------------------------
// Arena: asignador de bump. `base` apunta a un bloque bss, `pos` es el primer
// byte libre y `cap` el tamano total. No hay free individual.
// ---------------------------------------------------------------------------
struct Arena {
    base: *u8,
    pos: u64,
    cap: u64,
}

// Prepara un arena sobre un bloque ya existente. `a` suele apuntar a un bss de
// 24 bytes (el tamano del struct) para no necesitar memoria dinamica antes de
// tener memoria dinamica; ver ast_init en lib/ast.tt o ir_init en src/ir.tt.
fun arena_init(a: *Arena, base: *u8, cap: u64) {
    a.base = base
    a.pos = 0
    a.cap = cap
}

// Reserva n bytes y devuelve el puntero. El tamano se redondea a multiplo de 8
// para que todo lo que salga de aqui este alineado a 8 y sirva para structs con
// campos u64 o punteros (AArch64 falla en accesos u64 desalineados dentro de
// algunos contextos, y en cualquier caso es mas lento).
//
// Agotar el arena es un error fatal, no un nil: devolver nil obligaria a cada
// llamada a comprobarlo y el compilador no tiene ninguna forma sensata de
// recuperarse. El codigo de salida 70 identifica el caso al depurar.
fun arena_take(a: *Arena, n: u64) -> *u8 {
    let aligned: u64 = ((n + 7) / 8) * 8
    if a.pos + aligned > a.cap {
        io_exit(70)
    }
    let p: *u8 = a.base + a.pos
    a.pos = a.pos + aligned
    return p
}

// ---------------------------------------------------------------------------
// Syscalls. Todas devuelven el x0 crudo del kernel; no se inspecciona el carry
// flag, asi que un error se manifiesta como un valor absurdo (fd 0, 0 bytes
// leidos). Los llamantes lo tratan como "fallo" y salen.
// ---------------------------------------------------------------------------

// open(path, O_RDONLY, 0). Devuelve 0 si falla (fd 0 es stdin, que nunca se
// abre aqui, asi que 0 es un centinela seguro).
fun io_open_read(path: *u8) -> u64 {
    return syscall(5, path, 0, 0)
}

// open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644).
// 0x601 = O_WRONLY(0x001) | O_CREAT(0x200) | O_TRUNC(0x400) en macOS.
// 420 = 0644 en decimal.
//
// Nota: O_TRUNC reescribe el fichero SIN cambiar de inodo. Para binarios Mach-O
// firmados eso es peligroso (macOS cachea la firma por vnode y puede matar el
// proceso con SIGKILL al ejecutarlos), por lo que los scripts de tests/ emiten
// a un temporal y hacen rename(), o borran el destino antes.
fun io_open_write(path: *u8) -> u64 {
    return syscall(5, path, 0x601, 420)
}

// read(fd, buf, cap). Devuelve el numero de bytes leidos; 0 = EOF.
fun io_read(fd: u64, buf: *u8, cap: u64) -> u64 {
    return syscall(3, fd, buf, cap)
}

// write(fd, buf, len). Se ignora la escritura parcial: en la practica todas las
// escrituras aqui van a un fichero regular o a un tty y salen completas.
fun io_write(fd: u64, buf: *u8, len: u64) {
    syscall(4, fd, buf, len)
}

fun io_close(fd: u64) {
    syscall(6, fd, 0, 0)
}

// exit(code). No retorna. El codigo de salida es el contrato de casi todos los
// tests de tests/: el programa devuelve un numero y bootstrap/verify.sh lo
// compara.
fun io_exit(code: u64) {
    syscall(1, code, 0, 0)
}
