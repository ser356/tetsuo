import 'lib/arena.tt'

// ============================================================================
// src/runtime/io.tt - minimal runtime: macOS syscalls and arena allocator
// ============================================================================
//
// It is the lowest file in the stack: it depends on nothing and everything
// else depends on it. That is why it heads the `import` list of every compiler
// entry point (tests/fixpoint_entry.tt, tests/macos_build.sh, etc.).
//
// It holds two things unrelated to each other beyond "being the floor":
//
//   1. The syscall wrappers. tetsuo does not link against libSystem: it calls
//      the kernel directly. The macOS/arm64 ABI is
//
//          x16 = BSD syscall number
//          x0..x5 = arguments
//          svc #0x80
//          x0 = result (carry flag = error, ignored here)
//
//      The `syscall(num, a0, a1, a2)` builtin used here is emitted by the
//      codegen (see emit_syscall in codegen.tt and cgb_i_call in
//      codegen_bytes.tt); it is not a normal function.
//
//      The numbers are the BSD ones from <sys/syscall.h>: 1=exit, 3=read,
//      4=write, 5=open, 6=close. On Linux (the qemu harness) the shim in
//      bootstrap/linux/shim.s translates these numbers into the Linux ones,
//      which is why macho2elf.sh rewrites `svc #0x80` as `bl _tt_sys`.
//
//   2. The arena. tetsuo has neither malloc nor free: all dynamic memory comes
//      from fixed bss blocks handed out by a pointer that only moves forward.
//      Everything is released at once when the process ends, which for a
//      one-shot compiler is exactly what is needed.
//
// IO_BUF is the generic 16MB block that the tests use and the fallback for
// anyone who needs a large buffer without declaring their own. It is also the
// FIRST bss symbol of the linked program, so in the emitted Mach-O it lands at
// offset 0 of __DATA (vaddr = base of __bss). See cgb_bss_layout in
// codegen_bytes.tt.
// ============================================================================

bss IO_BUF: 16777216

// ---------------------------------------------------------------------------
// Syscalls. They all return the raw x0 from the kernel; the carry flag is not
// inspected, so an error shows up as an absurd value (fd 0, 0 bytes read). The
// callers treat that as "failure" and exit.
// ---------------------------------------------------------------------------

// open(path, O_RDONLY, 0). Returns 0 on failure (fd 0 is stdin, which is never
// opened here, so 0 is a safe sentinel).
fun io_open_read(path: *u8) -> u64 {
    return syscall(5, path, 0, 0)
}

fun io_open_read_checked(path: *u8, err: *u64) -> u64 {
    return syscall_checked(5, path, 0, 0, err)
}

// open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644).
// 0x601 = O_WRONLY(0x001) | O_CREAT(0x200) | O_TRUNC(0x400) on macOS.
// 420 = 0644 in decimal.
//
// Note: O_TRUNC rewrites the file WITHOUT changing its inode. For signed
// Mach-O binaries that is dangerous (macOS caches the signature per vnode and
// may kill the process with SIGKILL when running them), which is why the
// scripts in tests/ emit to a temporary and rename(), or delete the
// destination first.
fun io_open_write(path: *u8) -> u64 {
    return syscall(5, path, 0x601, 420)
}

fun io_open_write_checked(path: *u8, err: *u64) -> u64 {
    return syscall_checked(5, path, 0x601, 420, err)
}

// read(fd, buf, cap). Returns the number of bytes read; 0 = EOF.
fun io_read(fd: u64, buf: *u8, cap: u64) -> u64 {
    return syscall(3, fd, buf, cap)
}

fun io_read_checked(fd: u64, buf: *u8, cap: u64, err: *u64) -> u64 {
    return syscall_checked(3, fd, buf, cap, err)
}

// write(fd, buf, len). Partial writes are ignored: in practice every write
// here goes to a regular file or a tty and completes in full.
fun io_write(fd: u64, buf: *u8, len: u64) {
    syscall(4, fd, buf, len)
}

fun io_close(fd: u64) {
    syscall(6, fd, 0, 0)
}

fun io_getpid() -> u64 {
    return syscall(20, 0, 0, 0)
}

fun io_unlink(path: *u8) -> u64 {
    return syscall(10, path, 0, 0)
}

fun io_chdir(path: *u8) -> u64 {
    return syscall(12, path, 0, 0)
}

fun io_mkdir(path: *u8, mode: u64) -> u64 {
    return syscall(136, path, mode, 0)
}

// exit(code). Does not return. The exit code is the contract of almost every
// test in tests/: the program returns a number and bootstrap/verify.sh
// compares it.
fun io_exit(code: u64) {
    syscall(1, code, 0, 0)
}
