// ============================================================================
// lib/ast.tt - syntax tree arena
// ============================================================================
//
// The compiler splits dynamic memory into separate arenas, one per stage,
// instead of having a single heap. The three big ones are:
//
//     AST_BUF  (here, 16MB)  parser.tt nodes: Expr, Stmt, Func, Type, StrLit
//     IR_BUF   (src/ir.tt)   IR instructions and functions
//     PP_ARENA (src/main.tt) sources read by the preprocessor
//
// Splitting them is not about hygiene: it is what lets every stage reason
// about its own consumption separately and makes an overflow say WHICH stage
// went over. The three blocks together dominate the __bss size of the emitted
// binary (~57MB of which 48MB are these three), which is what shows up as
// `__DATA vmsize` in `otool -l` on any binary produced with --emit=macho.
//
// 16MB is plenty: the compiler itself (the largest combined .tt file that gets
// parsed, ~139KB of source) consumes on the order of 3MB of nodes.
//
// The Arena struct and arena_take live in src/runtime/io.tt.
// ============================================================================

bss AST_BUF: 268435456
bss AST_ARENA_STORE: 24

// Returns the AST arena, already initialized. AST_ARENA_STORE is a 24-byte bss
// block (sizeof Arena) rather than a local variable so that the struct
// outlives the return: there is no heap to put it in, and returning a pointer
// to a local would be returning a pointer to an already released stack.
fun ast_init() -> *Arena {
    let a: *Arena = AST_ARENA_STORE
    arena_init(a, AST_BUF, 268435456)
    return a
}
