bss DIGITS: 32

struct Out {
    fd:  u64,
    buf: *u8,
    pos: u64,
    cap: u64,
}

fun out_init(o: *Out, fd: u64, buf: *u8, cap: u64) {
    o.fd = fd
    o.buf = buf
    o.pos = 0
    o.cap = cap
}

fun out_flush(o: *Out) {
    if o.pos > 0 {
        io_write(o.fd, o.buf, o.pos)
        o.pos = 0
    }
}

fun out_byte(o: *Out, c: u8) {
    if o.pos >= o.cap {
        out_flush(o)
    }
    o.buf[o.pos] = c
    o.pos = o.pos + 1
}

fun out_bytes(o: *Out, p: *u8, n: u64) {
    let i: u64 = 0
    while i < n {
        out_byte(o, p[i])
        i = i + 1
    }
}

fun out_u64(o: *Out, v: u64) {
    if v == 0 {
        out_byte(o, 48)
        return
    }
    let n: u64 = 0
    while v > 0 {
        let q: u64 = v / 10
        DIGITS[n] = 48 + (v - q * 10)
        v = q
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        out_byte(o, DIGITS[n])
    }
}

fun out_nibble(o: *Out, n: u64) {
    if n < 10 {
        out_byte(o, 48 + n)
        return
    }
    out_byte(o, 87 + n)
}

fun out_hex4(o: *Out, v: u64) {
    let d0: u64 = v / 4096
    let r0: u64 = v - d0 * 4096
    let d1: u64 = r0 / 256
    let r1: u64 = r0 - d1 * 256
    let d2: u64 = r1 / 16
    let d3: u64 = r1 - d2 * 16
    out_nibble(o, d0)
    out_nibble(o, d1)
    out_nibble(o, d2)
    out_nibble(o, d3)
}

bss ERR_STORAGE: 64
bss ERR_BUF: 4096

fun die_line(msg: *u8, mlen: u64, line: u64) {
    let o: *Out = ERR_STORAGE
    out_init(o, 2, ERR_BUF, 4096)
    let s: str = 'error linea '
    out_bytes(o, s.ptr, s.len)
    out_u64(o, line)
    let s2: str = ': '
    out_bytes(o, s2.ptr, s2.len)
    out_bytes(o, msg, mlen)
    out_byte(o, 10)
    out_flush(o)
    io_exit(2)
}
