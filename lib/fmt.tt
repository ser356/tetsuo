// ============================================================================
// lib/fmt.tt - salida con buffer y formato de numeros
// ============================================================================
//
// Toda la salida del compilador pasa por aqui. Hay dos razones para no llamar a
// io_write directamente:
//
//   1. Rendimiento. El backend textual (src/codegen.tt) emite el asm byte a
//      byte; una syscall por byte serian millones de syscalls para el fichero
//      de 700KB que produce el compilador compilandose a si mismo.
//
//   2. Uniformidad. `Out` es el unico sitio donde se decide a que fd va algo,
//      asi que redirigir la salida (a stdout, a un fichero, a stderr para los
//      errores) es cambiar un campo.
//
// El buffer NO se vacia solo al terminar: hay que llamar a out_flush(). Olvidar
// ese flush es la forma clasica de producir un fichero truncado; ver
// src/main.tt, donde cada rama que abre un Out lo cierra.
//
// El backend de bytes (src/codegen_bytes.tt) no usa Out: construye la imagen
// completa en memoria y la vuelca de una sola escritura.
// ============================================================================

// Scratch para out_u64: los digitos salen del algoritmo en orden inverso y hay
// que darles la vuelta. 32 bytes cubren de sobra los 20 digitos de un u64.
// Es un bss global y no un local porque una variable local de 32 bytes forzaria
// un frame mas grande en un camino que se ejecuta millones de veces.
bss DIGITS: 32

// ---------------------------------------------------------------------------
// Out: fichero con buffer. `buf`/`cap` los aporta el llamante (siempre un bss),
// asi que Out no reserva memoria y puede vivir en un bss de 64 bytes.
// ---------------------------------------------------------------------------
struct Out {
    fd:  u64,
    buf: *u8,
    pos: u64,   // bytes pendientes en buf
    cap: u64,
}

fun out_init(o: *Out, fd: u64, buf: *u8, cap: u64) {
    o.fd = fd
    o.buf = buf
    o.pos = 0
    o.cap = cap
}

// Escribe lo pendiente y vacia el buffer. Idempotente: llamarlo con el buffer
// vacio no hace nada, asi que se puede llamar sin miedo al terminar.
fun out_flush(o: *Out) {
    if o.pos > 0 {
        io_write(o.fd, o.buf, o.pos)
        o.pos = 0
    }
}

// Encola un byte, vaciando antes si el buffer esta lleno. Esta es la primitiva:
// todo lo demas en este fichero acaba llamando aqui.
fun out_byte(o: *Out, c: u8) {
    if o.pos >= o.cap {
        out_flush(o)
    }
    o.buf[o.pos] = c
    o.pos = o.pos + 1
}

// Encola n bytes. Va de uno en uno en vez de hacer un mem_copy con corte por
// el borde del buffer: mas simple, y el coste queda enterrado bajo el del
// propio codegen.
fun out_bytes(o: *Out, p: *u8, n: u64) {
    let i: u64 = 0
    while i < n {
        out_byte(o, p[i])
        i = i + 1
    }
}

// Imprime un u64 en decimal.
//
// Divide por 10 acumulando digitos en DIGITS (que salen de menos a mas
// significativo) y luego los emite al reves. El resto se calcula como
// `v - q * 10` en lugar de con un operador de modulo porque el lenguaje no
// tiene `%`; el codegen emite udiv y msub igualmente.
//
// El cero se trata aparte: el bucle `while v > 0` no daria ningun digito.
fun out_u64(o: *Out, v: u64) {
    if v == 0 {
        out_byte(o, 48)
        return
    }
    let n: u64 = 0
    while v > 0 {
        let q: u64 = v / 10
        DIGITS[n] = 48 + (v - q * 10)
        v = q
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        out_byte(o, DIGITS[n])
    }
}

// Un digito hexadecimal en minuscula. 48 = '0', 87 = 'a' - 10.
fun out_nibble(o: *Out, n: u64) {
    if n < 10 {
        out_byte(o, 48 + n)
        return
    }
    out_byte(o, 87 + n)
}

// Cuatro digitos hexadecimales, con ceros a la izquierda.
//
// Lo usa el codegen textual para los inmediatos de movz/movk, que se emiten
// siempre como `#0xNNNN` de ancho fijo. Ancho fijo importa: el fixpoint compara
// la salida .s byte a byte, asi que el formato tiene que ser determinista.
//
// Va dividiendo por 4096/256/16 en vez de desplazando porque este fichero es
// anterior al hito 24.a (que anadio << y >>) y cambiarlo ahora obligaria a
// regenerar las seeds sin ganar nada.
fun out_hex4(o: *Out, v: u64) {
    let d0: u64 = v / 4096
    let r0: u64 = v - d0 * 4096
    let d1: u64 = r0 / 256
    let r1: u64 = r0 - d1 * 256
    let d2: u64 = r1 / 16
    let d3: u64 = r1 - d2 * 16
    out_nibble(o, d0)
    out_nibble(o, d1)
    out_nibble(o, d2)
    out_nibble(o, d3)
}

// ---------------------------------------------------------------------------
// Errores fatales
// ---------------------------------------------------------------------------

// Buffers propios para el canal de error. Separados de los de la salida normal
// porque die_line se llama con la salida a medias y no queremos mezclarlas ni
// vaciar un Out que quiza este en un estado inconsistente.
bss ERR_STORAGE: 64
bss ERR_BUF: 4096

// Imprime "error linea N: mensaje" en stderr (fd 2) y termina con codigo 2.
//
// No retorna. Es el unico mecanismo de error del compilador: no hay excepciones
// ni codigos de retorno propagados, asi que cualquier fase que detecte algo
// imposible llama aqui y se acaba el proceso. El envoltorio die_here de
// src/parser.tt rellena la linea con la del token actual.
//
// Linea 0 significa "sin posicion util" y lo usan los errores del
// preprocesador, que ocurren antes de que exista un lexer.
fun die_line(msg: *u8, mlen: u64, line: u64) {
    let o: *Out = ERR_STORAGE
    out_init(o, 2, ERR_BUF, 4096)
    let s: str = 'error linea '
    out_bytes(o, s.ptr, s.len)
    out_u64(o, line)
    let s2: str = ': '
    out_bytes(o, s2.ptr, s2.len)
    out_bytes(o, msg, mlen)
    out_byte(o, 10)
    out_flush(o)
    io_exit(2)
}
