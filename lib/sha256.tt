// ============================================================================
// lib/sha256.tt - SHA-256 (hito 24.c)
// ============================================================================
//
// Implementacion directa de FIPS 180-4. Existe por una sola razon: firmar los
// binarios Mach-O ad-hoc sin llamar a `codesign`. El CS_CodeDirectory que
// escribe src/macho.tt guarda un SHA-256 por cada pagina de 4KB del binario, y
// el kernel de macOS los recalcula al paginar; si no cuadran, mata el proceso.
// Ver mo_sign_and_write_n en src/macho.tt.
//
// Tambien es la fuente del UUID del binario: mo_uuid_from_code hashea el codigo
// y usa los 16 primeros bytes como LC_UUID.
//
// ARITMETICA DE 32 BITS SOBRE u64
//
// tetsuo solo tiene u64 como tipo aritmetico util, y SHA-256 se define sobre
// palabras de 32 bits con desbordamiento envolvente. La solucion es trabajar en
// u64 y enmascarar con 4294967295 (0xffffffff) DESPUES de cada operacion que
// pueda desbordar: sumas, rotaciones y xor. Un enmascarado que falte no rompe
// nada visible hasta que un acarreo se propaga por encima del bit 31, momento
// en el que el hash sale mal y `codesign -v` falla; por eso el patron es
// mecanico y esta en todas partes.
//
// ESTADO EN BSS
//
// Las cuatro tablas son globales, no locales, porque son grandes y esta funcion
// se llama en bucle (una vez por pagina del binario). Consecuencia: sha256() NO
// es reentrante ni se puede usar de forma incremental desde dos sitios a la
// vez. En el compilador se usa siempre de una en una, de principio a fin.
//
//     SHA_K   64 constantes de ronda (K[0..63]), 8 bytes por hueco
//     SHA_W   el "message schedule" expandido, 64 palabras
//     SHA_H   los 8 acumuladores del estado (H[0..7])
//     SHA_BLK bloque de 64 bytes para el relleno final
//
// Se prueba contra los vectores oficiales en tests/sha256_test.tt.
// ============================================================================

bss SHA_K: 512
bss SHA_W: 512
bss SHA_H: 64
bss SHA_BLK: 64

// Rotacion a la derecha de 32 bits (ROTR^n). Como el valor vive en un u64, hay
// que reconstruir la rotacion a mano: los bits que salen por la derecha se
// meten por el bit 31 con `x << (32 - n)`, y el enmascarado final descarta la
// basura que ese desplazamiento a la izquierda deja por encima del bit 31.
//
// Solo es correcta para 0 < n < 32; SHA-256 nunca usa otros valores.
fun sha_rotr(x: u64, n: u64) -> u64 {
    return (x >> n | x << (32 - n)) & 4294967295
}

// Las 64 constantes de ronda: los 32 bits fraccionarios de la raiz cubica de
// los 64 primeros primos. Se escriben en decimal porque el lenguaje no tenia
// literales hexadecimales cuando se escribio el fichero.
//
// Se reinicializan en cada llamada a sha256() en vez de precalcularse una vez,
// porque no hay inicializadores estaticos: el bss arranca a cero y la unica
// forma de rellenarlo es codigo. El coste (64 escrituras por bloque hasheado)
// es despreciable frente a las 64 rondas de mezcla.
fun sha_k_init() {
    let kp: *u64 = SHA_K
    kp[0] = 1116352408
    kp[1] = 1899447441
    kp[2] = 3049323471
    kp[3] = 3921009573
    kp[4] = 961987163
    kp[5] = 1508970993
    kp[6] = 2453635748
    kp[7] = 2870763221
    kp[8] = 3624381080
    kp[9] = 310598401
    kp[10] = 607225278
    kp[11] = 1426881987
    kp[12] = 1925078388
    kp[13] = 2162078206
    kp[14] = 2614888103
    kp[15] = 3248222580
    kp[16] = 3835390401
    kp[17] = 4022224774
    kp[18] = 264347078
    kp[19] = 604807628
    kp[20] = 770255983
    kp[21] = 1249150122
    kp[22] = 1555081692
    kp[23] = 1996064986
    kp[24] = 2554220882
    kp[25] = 2821834349
    kp[26] = 2952996808
    kp[27] = 3210313671
    kp[28] = 3336571891
    kp[29] = 3584528711
    kp[30] = 113926993
    kp[31] = 338241895
    kp[32] = 666307205
    kp[33] = 773529912
    kp[34] = 1294757372
    kp[35] = 1396182291
    kp[36] = 1695183700
    kp[37] = 1986661051
    kp[38] = 2177026350
    kp[39] = 2456956037
    kp[40] = 2730485921
    kp[41] = 2820302411
    kp[42] = 3259730800
    kp[43] = 3345764771
    kp[44] = 3516065817
    kp[45] = 3600352804
    kp[46] = 4094571909
    kp[47] = 275423344
    kp[48] = 430227734
    kp[49] = 506948616
    kp[50] = 659060556
    kp[51] = 883997877
    kp[52] = 958139571
    kp[53] = 1322822218
    kp[54] = 1537002063
    kp[55] = 1747873779
    kp[56] = 1955562222
    kp[57] = 2024104815
    kp[58] = 2227730452
    kp[59] = 2361852424
    kp[60] = 2428436474
    kp[61] = 2756734187
    kp[62] = 3204031479
    kp[63] = 3329325298
}

// Estado inicial: los 32 bits fraccionarios de la raiz cuadrada de los 8
// primeros primos. Al reinicializarse aqui, cada llamada a sha256() empieza
// limpia aunque la anterior dejara SHA_H con el hash previo.
fun sha_h_init() {
    let hp: *u64 = SHA_H
    hp[0] = 1779033703
    hp[1] = 3144134277
    hp[2] = 1013904242
    hp[3] = 2773480762
    hp[4] = 1359893119
    hp[5] = 2600822924
    hp[6] = 528734635
    hp[7] = 1541459225
}

// Lee 4 bytes como un u32 BIG-endian. SHA-256 se define sobre big-endian y la
// maquina es little-endian, asi que el reordenado es explicito.
fun sha_w32be(p: *u8) -> u64 {
    let b0: u64 = p[0]
    let b1: u64 = p[1]
    let b2: u64 = p[2]
    let b3: u64 = p[3]
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

// Escribe un u64 big-endian. Solo se usa para la longitud en bits del mensaje,
// que va en los ultimos 8 bytes del ultimo bloque.
fun sha_put_be64(p: *u8, off: u64, v: u64) {
    p[off + 0] = (v >> 56) & 255
    p[off + 1] = (v >> 48) & 255
    p[off + 2] = (v >> 40) & 255
    p[off + 3] = (v >> 32) & 255
    p[off + 4] = (v >> 24) & 255
    p[off + 5] = (v >> 16) & 255
    p[off + 6] = (v >> 8) & 255
    p[off + 7] = v & 255
}

// Procesa UN bloque de 64 bytes y actualiza SHA_H. Es el nucleo del algoritmo.
//
// Tiene dos mitades:
//
//   1. Expansion del mensaje. Las 16 palabras del bloque se copian a W[0..15] y
//      las otras 48 se derivan con dos funciones de mezcla (s0 y s1) que
//      combinan rotaciones y un desplazamiento. Esto es lo que hace que un
//      cambio de un bit en la entrada afecte a todas las rondas.
//
//   2. Las 64 rondas de compresion. Ocho variables a..h rotan de posicion en
//      cada ronda y solo dos reciben valor nuevo (a y e), a partir de:
//        - be/ba: las funciones Sigma mayusculas (rotaciones puras)
//        - ch:    "choose", elige bit a bit entre f y g segun e.
//                 El `e ^ 4294967295` es el NOT de 32 bits, que el lenguaje no
//                 tiene: xor con todo unos.
//        - mj:    "majority", el bit mayoritario entre a, b y c.
//
// Al final los ocho acumuladores se SUMAN al estado anterior (construccion de
// Davies-Meyer), que es lo que impide invertir la funcion.
fun sha256_block(blk: *u8) {
    let wp: *u64 = SHA_W
    let kp: *u64 = SHA_K
    let hp: *u64 = SHA_H
    let t: u64 = 0
    while t < 16 {
        wp[t] = sha_w32be(blk + t * 4)
        t = t + 1
    }
    t = 16
    while t < 64 {
        let w15: u64 = wp[t - 15]
        let s0: u64 = (sha_rotr(w15, 7) ^ sha_rotr(w15, 18) ^ (w15 >> 3)) & 4294967295
        let w2: u64 = wp[t - 2]
        let s1: u64 = (sha_rotr(w2, 17) ^ sha_rotr(w2, 19) ^ (w2 >> 10)) & 4294967295
        wp[t] = (wp[t - 16] + s0 + wp[t - 7] + s1) & 4294967295
        t = t + 1
    }
    let a: u64 = hp[0]
    let b: u64 = hp[1]
    let c: u64 = hp[2]
    let d: u64 = hp[3]
    let e: u64 = hp[4]
    let f: u64 = hp[5]
    let g: u64 = hp[6]
    let h: u64 = hp[7]
    t = 0
    while t < 64 {
        let be: u64 = (sha_rotr(e, 6) ^ sha_rotr(e, 11) ^ sha_rotr(e, 25)) & 4294967295
        let ch: u64 = ((e & f) ^ ((e ^ 4294967295) & g)) & 4294967295
        let t1: u64 = (h + be + ch + kp[t] + wp[t]) & 4294967295
        let ba: u64 = (sha_rotr(a, 2) ^ sha_rotr(a, 13) ^ sha_rotr(a, 22)) & 4294967295
        let mj: u64 = ((a & b) ^ (a & c) ^ (b & c)) & 4294967295
        let t2: u64 = (ba + mj) & 4294967295
        h = g
        g = f
        f = e
        e = (d + t1) & 4294967295
        d = c
        c = b
        b = a
        a = (t1 + t2) & 4294967295
        t = t + 1
    }
    hp[0] = (hp[0] + a) & 4294967295
    hp[1] = (hp[1] + b) & 4294967295
    hp[2] = (hp[2] + c) & 4294967295
    hp[3] = (hp[3] + d) & 4294967295
    hp[4] = (hp[4] + e) & 4294967295
    hp[5] = (hp[5] + f) & 4294967295
    hp[6] = (hp[6] + g) & 4294967295
    hp[7] = (hp[7] + h) & 4294967295
}

// Hashea mlen bytes desde msg y escribe 32 bytes big-endian en out.
//
// El relleno sigue la norma: un byte 0x80, luego ceros, y en los ultimos 8
// bytes del ultimo bloque la longitud del mensaje EN BITS, big-endian.
//
// El caso `rem >= 56` es el que suele olvidarse: si tras el 0x80 no quedan 8
// bytes libres, la longitud no cabe en ese bloque, asi que se procesa el bloque
// tal cual (con el 0x80 y ceros), se limpia y se emite un bloque extra que solo
// lleva la longitud. Sin esa rama, cualquier mensaje cuyo resto modulo 64 sea
// 56..63 daria un hash incorrecto.
//
// Nota sobre el uso desde macho.tt: alli siempre se hashean exactamente 4096
// bytes, o sea 64 bloques completos y rem = 0, con lo que el relleno acaba
// siendo un bloque entero de padding. Es el camino menos interesante, pero
// tests/sha256_test.tt cubre los demas con los vectores oficiales.
fun sha256(msg: *u8, mlen: u64, out: *u8) {
    sha_k_init()
    sha_h_init()
    let full: u64 = mlen / 64
    let i: u64 = 0
    while i < full {
        sha256_block(msg + i * 64)
        i = i + 1
    }
    let rem: u64 = mlen - full * 64
    let bp: *u8 = SHA_BLK
    let j: u64 = 0
    while j < rem {
        bp[j] = msg[full * 64 + j]
        j = j + 1
    }
    bp[rem] = 128
    j = rem + 1
    while j < 64 {
        bp[j] = 0
        j = j + 1
    }
    let bitlen: u64 = mlen * 8
    if rem >= 56 {
        sha256_block(bp)
        j = 0
        while j < 64 {
            bp[j] = 0
            j = j + 1
        }
    }
    sha_put_be64(bp, 56, bitlen)
    sha256_block(bp)
    let hp: *u64 = SHA_H
    let o: u64 = 0
    while o < 8 {
        let v: u64 = hp[o]
        out[o * 4 + 0] = (v >> 24) & 255
        out[o * 4 + 1] = (v >> 16) & 255
        out[o * 4 + 2] = (v >> 8) & 255
        out[o * 4 + 3] = v & 255
        o = o + 1
    }
}
