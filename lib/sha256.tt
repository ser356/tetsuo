    kp[10] = 607225278
    kp[11] = 1426881987
    kp[12] = 1925078388
    kp[13] = 2162078206
    kp[14] = 2614888103
    kp[15] = 3248222580
    kp[16] = 3835390401
    kp[17] = 4022224774
    kp[18] = 264347078
    kp[19] = 604807628
    kp[20] = 770255983
    kp[21] = 1249150122
    kp[22] = 1555081692
    kp[23] = 1996064986
    kp[24] = 2554220882
    kp[25] = 2821834349
    kp[26] = 2952996808
    kp[27] = 3210313671
    kp[28] = 3336571891
    kp[29] = 3584528711
    kp[30] = 113926993
    kp[31] = 338241895
    kp[32] = 666307205
    kp[33] = 773529912
    kp[34] = 1294757372
    kp[35] = 1396182291
    kp[36] = 1695183700
    kp[37] = 1986661051
    kp[38] = 2177026350
