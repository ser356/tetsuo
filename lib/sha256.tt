    kp[41] = 2820302411
    kp[42] = 3259730800
    kp[43] = 3345764771
    kp[44] = 3516065817
    kp[45] = 3600352804
    kp[46] = 4094571909
    kp[47] = 275423344
    kp[48] = 430227734
    kp[49] = 506948616
    kp[50] = 659060556
    kp[51] = 883997877
    kp[52] = 958139571
    kp[53] = 1322822218
