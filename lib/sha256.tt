// SHA-256 sobre 32 bits emulados en u64 (enmascarado a 0xffffffff).
// sha256(msg, mlen, out) escribe 32 bytes de hash big-endian en out.

bss SHA_K: 512
bss SHA_W: 512
bss SHA_H: 64
bss SHA_BLK: 64

fun sha_rotr(x: u64, n: u64) -> u64 {
    return (x >> n | x << (32 - n)) & 4294967295
}

fun sha_k_init() {
    let kp: *u64 = SHA_K
    kp[0] = 1116352408
    kp[1] = 1899447441
    kp[2] = 3049323471
    kp[3] = 3921009573
    kp[4] = 961987163
    kp[5] = 1508970993
    kp[6] = 2453635748
    kp[7] = 2870763221
    kp[8] = 3624381080
