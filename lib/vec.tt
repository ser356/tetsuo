// ============================================================================
// lib/vec.tt - dynamic array over an arena
// ============================================================================
//
// Vec is the only generic container in the tree. It is used wherever a list
// whose size is unknown at parse time is needed (parameters of a function,
// locals of a frame, arguments of a call).
//
// It is "generic" by way of bytes: there are no parametric types in tetsuo, so
// Vec stores the element size (`esz`) and treats the elements as opaque
// blocks. An element is put in by passing a POINTER to it (vec_push copies esz
// bytes from there) and taken out as a pointer to its slot (vec_get). The
// caller casts:
//
//     let slot: *u64 = vec_get(v, i)
//     let value: u64 = @slot
//
// Growth: since the arena has neither realloc nor free, "growing" means asking
// for a new block twice the size, copying and ABANDONING the old one. The
// memory of the previous block is lost until the process ends. For a one-shot
// compiler that is a deliberate trade: the total waste is bounded by 2x the
// final size of all the vectors together, and in exchange there is not a
// single pointer to free in the whole tree.
//
// Hence the name of the test that exercises this: tests/vec_test.tt (arena
// grow).
// ============================================================================

struct Vec {
    data: *u8,   // current block, owned by the arena
    len:  u64,   // elements in use
    cap:  u64,   // elements that fit in `data`
    esz:  u64,   // bytes per element
}

// Initializes over an already reserved block. `buf` must have room for at
// least `cap` elements of `esz` bytes; the usual pattern is
//
//     let head: *u8 = arena_take(ar, 8)
//     vec_init(v, 8, head, 1)
//
// that is, start with capacity 1 and let vec_push do the rest.
fun vec_init(v: *Vec, esz: u64, buf: *u8, cap: u64) {
    v.data = buf
    v.len  = 0
    v.cap  = cap
    v.esz  = esz
}

// Appends an element by copying esz bytes from `elem`.
//
// If the vector is full it doubles the capacity: it asks the arena for a new
// block, copies the contents and keeps the new one. The old block is orphaned
// (see the note above). Doubling gives a constant amortized cost per push and
// bounds the total waste to less than twice what is live.
//
// The arena is passed as an argument instead of being stored in the Vec so
// that a single Vec can live in one arena and its data in another, and above
// all so that the struct does not carry a pointer that almost never changes.
fun vec_push(ar: *Arena, v: *Vec, elem: *u8) {
    if v.len == v.cap {
        let nc: u64 = v.cap * 2
        let nd: *u8 = arena_take(ar, nc * v.esz)
        mem_copy(nd, v.data, v.len * v.esz)
        v.data = nd
        v.cap = nc
    }
    mem_copy(v.data + v.len * v.esz, elem, v.esz)
    v.len = v.len + 1
}

// Returns a pointer to slot i. It does NOT bounds check: the caller has
// already looked at `v.len`. Returning the pointer and not the value is what
// lets Vec be generic without parametric types, and it also allows writing in
// place.
fun vec_get(v: *Vec, i: u64) -> *u8 {
    return v.data + i * v.esz
}
