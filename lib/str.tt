// ============================================================================
// lib/str.tt - operations on byte blocks
// ============================================================================
//
// tetsuo has neither a standard library nor a "string" type with operations:
// the language's `str` type is just a (ptr, len) pair that the parser desugars
// into two fields, and everything else is done by hand over *u8.
//
// These two functions are the minimum the rest of the compiler needs:
// comparing identifiers (the lexer does not intern, so every comparison of a
// function or variable name ends up here) and copying bytes (arenas, output
// buffers, literals).
//
// Both are deliberately naive, byte by byte. Copying 8 at a time would be
// faster but would require handling alignment and overlap, and the compiler
// spends far more time in the parser than here.
// ============================================================================

// Compares n bytes. Returns 1 if they are equal, 0 otherwise.
//
// It returns u32 and not a bool because the language has no bool; the
// convention across the tree is 1 = yes, 0 = no, and the callers write `== 1`.
//
// It does not check lengths: it is the caller's responsibility to have already
// verified that both sides hold at least n bytes. The usual pattern in
// parser.tt is
//     if it.name_len == n { if bytes_eq(...) == 1 { ... } }
fun bytes_eq(a: *u8, b: *u8, n: u64) -> u32 {
    let i: u64 = 0
    while i < n {
        if a[i] != b[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Copies n bytes from src to dst.
//
// It copies forwards, so it is only safe if dst <= src or if the ranges do not
// overlap. Every use in the tree copies from one buffer into a different one
// (from a source into an arena, from an arena into an output buffer), never
// upwards within the same block.
fun mem_copy(dst: *u8, src: *u8, n: u64) {
    let i: u64 = 0
    while i < n {
        dst[i] = src[i]
        i = i + 1
    }
}
